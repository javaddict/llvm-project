# REQUIRES: haydn
# RUN: yaml2obj %s -o %t.o
# Stamp product ELFFlagsValue (e_flags=0x1). yaml2obj has no Haydn e_flags
# bit names; LLD rejects unprofiled zero flags fail-closed.
# RUN: %python -c "import struct,sys;f=open(sys.argv[1],'r+b');f.seek(36);f.write(struct.pack('<I',1));f.close()" %t.o
# RUN: llvm-readobj -r %t.o | FileCheck %s --check-prefix=OBJ
# RUN: not ld.lld %t.o -o %t.out --section-start=.text=0x10000 2>&1 | FileCheck %s --check-prefix=ERR

# ISA-69 assembler-independent pin: a crafted R_HAYDN_JALRSImm12 /
# _E3E0 / _E3E1 must fail the link. getRelExpr/relocate refuse (R_NONE,
# no patched bytes). If this regresses to R_PC, `not ld.lld` fails
# because the link succeeds. Types 0x16/0x20/0x21 are ELF 22/32/33
# (Haydn.def); yaml2obj has no Haydn reloc names. Do not remint.

# OBJ: Relocations [
# OBJ:   R_HAYDN_JALRSImm12 target
# OBJ:   R_HAYDN_JALRSImm12_E3E0 target
# OBJ:   R_HAYDN_JALRSImm12_E3E1 target
# OBJ-NOT: R_HAYDN_WIDE_BranchSImm12

# ERR: Haydn symbolic JALR is unsupported (ISA-69: no golden relocation base)
# ERR: refusing silent PC-relative R_HAYDN_JALRSImm12
# ERR-NOT: error: {{.*}}undefined

--- !ELF
FileHeader:
  Class:   ELFCLASS32
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: 0x103
Sections:
  - Name:    .text
    Type:    SHT_PROGBITS
    Flags:   [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 4
    Content: '070000000000000000000000070000000000000000000000070000000000000000000000'
  - Name:    .rela.text
    Type:    SHT_RELA
    Link:    .symtab
    Info:    .text
    Relocations:
      - Offset: 0
        Symbol: target
        Type:   0x16
      - Offset: 12
        Symbol: target
        Type:   0x20
      - Offset: 24
        Symbol: target
        Type:   0x21
Symbols:
  - Name:    _start
    Section: .text
    Value:   0
    Size:    36
    Binding: STB_GLOBAL
    Type:    STT_FUNC
  - Name:    target
    Section: .text
    Value:   36
    Size:    0
    Binding: STB_GLOBAL
