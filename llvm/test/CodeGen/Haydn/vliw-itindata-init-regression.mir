# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postmisched -verify-machineinstrs %s -o - | FileCheck %s

# Role: MIR — ItinData must be initialized for VLIW DFA + D-class format compatibility (prior revision).


# REBASELINED : / pipeline reorder (ExpandPseudos/BitSimplify pre-scheduler + materialize at leaveRegion) — bundles regrouped, ops unchanged.
# REBASELINED : dual-sched pre-RA — trailing NOP before JALR (delay-slot fill order).
# REBASELINED : / FLEX cutover — ST32 renders as ST32_S0, ADD32 as ADD32_S1. test1 (two ST32) stays un-bundled (SLOT0_LS conflict preserved); test2 (ST32+ADD32) bundles (S0+S1).
# REBASELINED 2026-08-13 W3 store mayLoad=0 — test2 leaveRegion order is ADD32_S2 then ST32_S0 (still S2+S0 co-issue; two ST32 remain unbundled).
#
# REGRESSION TEST: ItinData must be initialized for VLIW DFA + D-class format
# compatibility (prior revision).
#
# Bug: ItinData was not initialized because the MC_DESC section was included in
# both HaydnMCTargetDesc.cpp and HaydnSubtarget.cpp, causing an ODR violation
# with BUILD_SHARED_LIBS=ON. The ItineraryData member was a default-constructed
# object with no stage/latency information. The VLIW DFA packetizer relies on
# ItinData to determine which functional units each instruction uses. Without
# ItinData, the DFA couldn't track resources and every instruction appeared to
# use no resources, leading to incorrect bundling (or no bundling at all).
#
# Fix: Initialize ItinData in the HaydnSubtarget constructor body using
# MCSubtargetInfo::getSchedModel + the extern arrays from the CTOR section
# instead of including MC_DESC in HaydnSubtarget.cpp.
#
# This test verifies that the packetizer correctly uses DFA resource tracking
# by checking that instructions with conflicting functional units are NOT
# bundled together. Specifically:
# Two Slot0_LS instructions (ST32) cannot be in the same bundle because
# they both need the SLOT0_LS functional unit (only one SLOT0 in the DFA).
# An ALU32 (Slot012_ALU) and a ST32 (Slot0_LS) CAN be bundled because
# they use different DFA functional units.
#
# If ItinData initialization regresses, the DFA loses resource tracking and
# may incorrectly bundle conflicting instructions, or fail to bundle compatible
# ones. This test catches both failure modes.
#
# Do NOT update CHECK lines without understanding the root cause.

--- |
  define void @test_ls_conflict() { ret void }
  define void @test_alu_ls_compatible() { ret void }
...
---
# ============================================================================
# Test 1: Two Slot0_LS instructions -- must NOT bundle (resource conflict)
# ============================================================================
#
# Two ST32 instructions both require the SLOT0_LS functional unit.
# The DFA has only one SLOT0. If ItinData is initialized, the DFA
# tracks resource usage and rejects the second ST32 in the same packet.
#
# If ItinData is broken, both ST32 might incorrectly bundle together.
name:            test_ls_conflict
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r3

    ; Two ST32 both need SLOT0_LS -- cannot share the same packet.
    ; The first ST32 claims SLOT0_LS. The second ST32 also needs SLOT0_LS
    ; which is already occupied. The DFA must reject this.
    ; With Slot012_ALU availability, ADDI32 can go in any slot, so it bundles
    ; with the first ST32.
    ; Expected: ST32 + ADDI32 in first bundle, then ST32 in second.
    ; (The exact bundle structure depends on ADDI32's Slot012_ALU itinerary
    ; which allows it in any slot including SLOT0. The DFA will try to bundle
    ; ST32 with ADDI32, then ST32 alone.)
    ; Key check: the two ST32 instructions must NOT be in the same bundle.
    ; Since both need SLOT0_LS (only one SLOT0 in DFA), neither can be bundled
    ; with the other. They remain as separate, unbundled instructions.

    ; CHECK-LABEL: name: test_ls_conflict
    ; CHECK: liveins: $r0, $r1, $r2, $r3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: S_SW_WITH_IMM_E{{[23]}}_E{{[0-2]}}_LOADSTORE0_RI6 killed $r1, $r0, 0, implicit-def dead $sfr
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: S_SW_WITH_IMM_E{{[23]}}_E{{[0-2]}}_LOADSTORE0_RI6 killed $r3, killed $r2, 0, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    ST32 $r1, $r0, 0, implicit-def dead $sfr
    ST32 $r3, $r2, 0, implicit-def dead $sfr

    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 2: ALU32 + Slot0_LS -- CAN bundle (different DFA functional units)
# ============================================================================
#
# ADD32 (Slot012_ALU, can use SLOT0/1/2) + ST32 (Slot0_LS, uses SLOT0_LS).
# The DFA models these as separate functional units. If ItinData is properly
# initialized, ADD32 uses SLOT0_ALU and ST32 uses SLOT0_LS -- no conflict.
#
# If ItinData is broken, the DFA might incorrectly reject this bundle.
name:            test_alu_ls_compatible
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r3

    ; ADD32 (Slot012_ALU) + ST32 (Slot0_LS) -- different DFA FUs.
    ; The DFA should allow them in the same bundle.
    ; Note: ADD32 has no register dependency with ST32 here (different regs).
    ; W3 (store mayLoad=0): order is ADD32_S2 then ST32_S0; co-issue unchanged.

    ; CHECK-LABEL: name: test_alu_ls_compatible
    ; CHECK: liveins: $r0, $r1, $r2, $r3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r4 = ADD32_E{{[23]}}_E{{[0-2]}}_{{.*}} $r0, killed $r1, implicit-def dead $sfr
    ; CHECK-NEXT: S_SW_WITH_IMM_E{{[23]}}_E{{[0-2]}}_LOADSTORE0_RI6 killed $r3, killed $r2, 0, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r4 = ADD32 $r0, $r1, implicit-def dead $sfr
    ST32 $r3, $r2, 0, implicit-def dead $sfr

    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
