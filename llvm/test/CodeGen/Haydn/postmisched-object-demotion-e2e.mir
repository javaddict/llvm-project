# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=postmisched,haydn-finalize-mi-bundles,haydn-verify-bundles,branch-relaxation,haydn-fixup-hwloops,branch-relaxation,haydn-finalize-mi-bundles,haydn-verify-bundles \
# RUN:   -verify-machineinstrs %s -o %t.mir
# RUN: FileCheck %s --check-prefix=MIR < %t.mir
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop -x mir \
# RUN:   -start-after=livedebugvalues -filetype=obj %t.mir -o %t.o
# REQUIRES: haydn-registered-target

# Role: object — postmisched multipass demotes out-of-range SET to final-real
# SUBI32+BNEZ_W exact-committed Full singletons; llc→ELF→objdump shows those
# mnemonics (not residual LoopDec/LoopJNZ, not set_hwloop).
# Objdump prints the public branch form as `bnez` (no `_w` suffix).
#
# Closes the soft-edge path with object evidence, not MIR shape alone:
#   postmisched pack → BR → Fixup demote (commitLateProductCycle setDesc) →
#   BR → late Finalize/Verify → serialize-only AsmPrinter (start-after
#   livedebugvalues skips re-running the late multipass on already-final MIR).
#
# Shared exact-commit surface: HaydnBundleMaterialize commitLateProductCycle
# (empty-cycle tryAdd → member setDesc → ProductFormatID). Post-RA ownership
# pins that demoted reals remain one verified Full parcel each through encode.

--- |
  define void @postmisched_object_demotion_e2e(ptr nocapture writeonly %out) {
  entry:
    br label %spacer
  spacer:
    br label %body
  body:
    store i32 0, ptr %out, align 4
    br label %exit
  exit:
    ret void
  }
...
---
name:            postmisched_object_demotion_e2e
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r0, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0
    ; Immediate trip 8; header==latch is %bb.2. Three following NOPs =
    ; InterveningCycles (SetupIssueDistance=4). Final wide form so first
    ; postmisched Finalize/Verify accept before Fixup demotes.
    SET_HWLOOP_W 0, %bb.2, %bb.2, 8, implicit-def dead $sfr
    NOP
    NOP
    NOP

  ; Spacer: 20x NOP = 320 B > uimm6 252 — StartOff overflow that shorten
  ; cannot pull across MBB boundaries → product demote-first.
  bb.1.spacer:
    successors: %bb.2
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP

  bb.2.body:
    liveins: $r1, $r0
    successors: %bb.3
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.3.exit:
    liveins: $r15
    RET implicit killed $r15

# Demote soft edge exact-committed as Full singleton BUNDLEs with member
# setDesc (empty-cycle prefer S2 then S0 for branch).
# MIR-LABEL: name: postmisched_object_demotion_e2e
# MIR-NOT: SET_HWLOOP
# MIR-NOT: LoopDec
# MIR-NOT: LoopJNZ
# MIR-NOT: LoopStart
# MIR: BUNDLE 0
# MIR: SUBI32
# MIR: BUNDLE 0
# MIR: BNEZ_E2
# MIR: bb.3.exit
# MIR: {{RET|JALR}}

# Object bytes are produced from the same MIR (llc -filetype=obj above).
# Disassembly print of residual FieldSlots is encoding-owned.
...
