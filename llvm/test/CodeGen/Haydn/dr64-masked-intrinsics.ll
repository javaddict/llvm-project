; Full scalar predication: compare, then conditionally move
define dso_local i64 @test_scalar_predication(i64 %a) {
; CHECK-LABEL: test_scalar_predication:
; CHECK:       // %bb.0:
; CHECK-NEXT:    { nop; xor32 r0, r0, r0 }
