; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    { nop; nop; slt64 d0, d0 }
; CHECK-NEXT:    { nop; nop; movt64 d0, d0 }
; CHECK-NEXT:    { nop; addi32 sp, sp, 8 }
