# RUN: not llc -mtriple=haydn-unknown-elf \
# RUN:   -run-pass=haydn-finalize-mi-bundles,haydn-verify-bundles \
# RUN:   %s -o - 2>&1 | FileCheck %s

# Role: verifier — Late-MC residual SETCBR_END at late firewall is fatal (ExpandPseudos → CSRW_W).

# Late-MC residual SETCBR_END at late firewall is fatal (ExpandPseudos → CSRW_W).

--- |
  define void @residual_setcbr_end() { ret void }
...
---
name:            residual_setcbr_end
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r15
    ; CHECK: residual cycle-forming pseudo
    SETCBR_END 0, $r1
    RET implicit $r15
