# ============================================================================
# Test 3: three 1W ADDI32 — write-port limit (2W) must fire a Hazard.
# Independent vreg writers; HR reports Hazard when a third tries the same cycle.
# one-above write capacity (at 2W → third is Hazard).
# ============================================================================
name:            vreg_three_writes_port_limit
tracksRegLiveness: true
selected:        true
body:             |
  bb.0:
    liveins: $r1
    ; CHECK-LABEL: name: vreg_three_writes_port_limit
    ; CHECK: liveins: $r1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r1
    ; CHECK-NEXT: [[ADDI32_:%[0-9]+]]:gpr32 = ADDI32 [[COPY]], 10, implicit-def dead $sfr
    ; CHECK-NEXT: [[ADDI32_1:%[0-9]+]]:gpr32 = ADDI32 [[COPY]], 20, implicit-def dead $sfr
    ; CHECK-NEXT: [[ADDI32_2:%[0-9]+]]:gpr32 = ADDI32 [[COPY]], 30, implicit-def dead $sfr
    ; CHECK-NEXT: [[ADD32_:%[0-9]+]]:gpr32 = ADD32 [[ADDI32_]], [[ADDI32_1]], implicit-def dead $sfr
    ; CHECK-NEXT: [[ADD32_1:%[0-9]+]]:gpr32 = ADD32 [[ADD32_]], [[ADDI32_2]], implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY [[ADD32_1]]
    ; CHECK-NEXT: RET implicit $r0, implicit $r15
    ;
    ; DBG-LABEL: name: vreg_three_writes_port_limit
    ; DBG: liveins: $r1
    ; DBG-NEXT: {{  $}}
    ; DBG-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r1
    ; DBG-NEXT: [[ADDI32_:%[0-9]+]]:gpr32 = ADDI32 [[COPY]], 10, implicit-def dead $sfr
    ; DBG-NEXT: [[ADDI32_1:%[0-9]+]]:gpr32 = ADDI32 [[COPY]], 20, implicit-def dead $sfr
    ; DBG-NEXT: [[ADDI32_2:%[0-9]+]]:gpr32 = ADDI32 [[COPY]], 30, implicit-def dead $sfr
    ; DBG-NEXT: [[ADD32_:%[0-9]+]]:gpr32 = ADD32 [[ADDI32_]], [[ADDI32_1]], implicit-def dead $sfr
    ; DBG-NEXT: [[ADD32_1:%[0-9]+]]:gpr32 = ADD32 [[ADD32_]], [[ADDI32_2]], implicit-def dead $sfr
    ; DBG-NEXT: $r0 = COPY [[ADD32_1]]
    ; DBG-NEXT: RET implicit $r0, implicit $r15
    ;
    ; PREGREEDY-LABEL: name: vreg_three_writes_port_limit
    ; PREGREEDY: liveins: $r1
    ; PREGREEDY-NEXT: {{  $}}
    ; PREGREEDY-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r1
    ; PREGREEDY-NEXT: [[ADDI32_:%[0-9]+]]:gpr32 = ADDI32 [[COPY]], 10, implicit-def dead $sfr
    ; PREGREEDY-NEXT: [[ADDI32_1:%[0-9]+]]:gpr32 = ADDI32 [[COPY]], 20, implicit-def dead $sfr
    ; PREGREEDY-NEXT: [[ADDI32_2:%[0-9]+]]:gpr32 = ADDI32 [[COPY]], 30, implicit-def dead $sfr
    ; PREGREEDY-NEXT: [[ADD32_:%[0-9]+]]:gpr32 = ADD32 [[ADDI32_]], [[ADDI32_1]], implicit-def dead $sfr
    ; PREGREEDY-NEXT: [[ADD32_1:%[0-9]+]]:gpr32 = ADD32 [[ADD32_]], [[ADDI32_2]], implicit-def dead $sfr
    ; PREGREEDY-NEXT: $r0 = COPY [[ADD32_1]]
    ; PREGREEDY-NEXT: RET implicit $r0, implicit $r15
    %0:gpr32 = COPY $r1
    %1:gpr32 = ADDI32 %0:gpr32, 10, implicit-def dead $sfr
    %2:gpr32 = ADDI32 %0:gpr32, 20, implicit-def dead $sfr
    %3:gpr32 = ADDI32 %0:gpr32, 30, implicit-def dead $sfr
    ; Keep all three live so none are DCE'd before scheduling.
    %4:gpr32 = ADD32 %1:gpr32, %2:gpr32, implicit-def dead $sfr
    %5:gpr32 = ADD32 %4:gpr32, %3:gpr32, implicit-def dead $sfr
    $r0 = COPY %5:gpr32
    RET implicit $r0, implicit $r15

  ; Still logical only — no member setDesc under three-write port pressure.
  ; Port-forced multi-cycle: three independent 1W ops exceed GPR 2W in one
  ; cycle (port ResMII lower bound ≥ 2). Pre-RA HR must Hazard rather than
  ; pretend Full three-slot format makes them co-issue clean.

...
