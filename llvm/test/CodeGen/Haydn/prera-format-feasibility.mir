    ; PREGREEDY-NEXT: $r0 = COPY [[ADD32_]]
    ; PREGREEDY-NEXT: RET implicit $r0, implicit $r15
    %0:gpr32 = COPY $r1
    %1:gpr32 = COPY $r2
    %2:gpr32 = COPY $r3
    ; Program order: constrained store before flexible add (reverse of test 8).
    ST32 %2:gpr32, %0:gpr32, 0
    %3:gpr32 = ADD32 %0:gpr32, %1:gpr32, implicit-def dead $sfr
    $r0 = COPY %3:gpr32
    RET implicit $r0, implicit $r15

  ; Matching-frontier may prefer flexible ADD over constrained ST; pin both
  ; remain logical only (no private member setDesc either direction).

