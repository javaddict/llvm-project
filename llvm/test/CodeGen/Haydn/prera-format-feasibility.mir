tracksRegLiveness: true
selected:        true
body:             |
  bb.0:
    liveins: $r1, $r2, $r4
    ; CHECK-LABEL: name: physreg_parity_add
    ; CHECK: liveins: $r1, $r2, $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r5 = ADDI32 $r4, 7, implicit-def dead $sfr
    ; CHECK-NEXT: $r3 = ADD32 $r1, $r2, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = ADD32 $r3, $r5, implicit-def dead $sfr
    ; CHECK-NEXT: RET implicit $r0, implicit $r15
    ;
    ; DBG-LABEL: name: physreg_parity_add
    ; DBG: liveins: $r1, $r2, $r4
    ; DBG-NEXT: {{  $}}
    ; DBG-NEXT: $r5 = ADDI32 $r4, 7, implicit-def dead $sfr
    ; DBG-NEXT: $r3 = ADD32 $r1, $r2, implicit-def dead $sfr
    ; DBG-NEXT: $r0 = ADD32 $r3, $r5, implicit-def dead $sfr
    ; DBG-NEXT: RET implicit $r0, implicit $r15
    ;
    ; PREGREEDY-LABEL: name: physreg_parity_add
    ; PREGREEDY: liveins: $r1, $r2, $r4
    ; PREGREEDY-NEXT: {{  $}}
    ; PREGREEDY-NEXT: $r5 = ADDI32 $r4, 7, implicit-def dead $sfr
    ; PREGREEDY-NEXT: $r3 = ADD32 $r1, $r2, implicit-def dead $sfr
    ; PREGREEDY-NEXT: $r0 = ADD32 $r3, $r5, implicit-def dead $sfr
    ; PREGREEDY-NEXT: RET implicit $r0, implicit $r15
    $r3 = ADD32 $r1, $r2, implicit-def dead $sfr
    $r5 = ADDI32 $r4, 7, implicit-def dead $sfr
    $r0 = ADD32 $r3, $r5, implicit-def dead $sfr
    RET implicit $r0, implicit $r15

  ; Phys ADD32 footprint matches vreg ADD32 (2R/1W). ADDI32 vreg 1R/1W is
  ; pinned in tests 1/2/3; here emit may co-issue so cycle totals accumulate.

...
