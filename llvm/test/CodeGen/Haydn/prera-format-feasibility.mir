    ; PREGREEDY-NEXT: [[ADD32_:%[0-9]+]]:gpr32 = ADD32 [[COPY]], [[COPY1]], implicit-def dead $sfr
    ; PREGREEDY-NEXT: [[XOR32_:%[0-9]+]]:gpr32 = XOR32 [[COPY2]], [[COPY3]], implicit-def dead $sfr
    ; PREGREEDY-NEXT: [[OR32_:%[0-9]+]]:gpr32 = OR32 [[COPY4]], [[COPY5]], implicit-def dead $sfr
    ; PREGREEDY-NEXT: [[ADD32_1:%[0-9]+]]:gpr32 = ADD32 [[ADD32_]], [[XOR32_]], implicit-def dead $sfr
    ; PREGREEDY-NEXT: [[ADD32_2:%[0-9]+]]:gpr32 = ADD32 [[ADD32_1]], [[OR32_]], implicit-def dead $sfr
    ; PREGREEDY-NEXT: $r0 = COPY [[ADD32_2]]
    ; PREGREEDY-NEXT: RET implicit $r0, implicit $r15
    %0:gpr32 = COPY $r1
    %1:gpr32 = COPY $r2
    %2:gpr32 = COPY $r3
    %3:gpr32 = COPY $r4
    %4:gpr32 = COPY $r5
    %5:gpr32 = COPY $r6
    ; Three independent ready ALU ops — co-issue packable under Full.
    %6:gpr32 = ADD32 %0:gpr32, %1:gpr32, implicit-def dead $sfr
    %7:gpr32 = XOR32 %2:gpr32, %3:gpr32, implicit-def dead $sfr
    %8:gpr32 = OR32 %4:gpr32, %5:gpr32, implicit-def dead $sfr
    %9:gpr32 = ADD32 %6:gpr32, %7:gpr32, implicit-def dead $sfr
    %10:gpr32 = ADD32 %9:gpr32, %8:gpr32, implicit-def dead $sfr
    $r0 = COPY %10:gpr32
    RET implicit $r0, implicit $r15

