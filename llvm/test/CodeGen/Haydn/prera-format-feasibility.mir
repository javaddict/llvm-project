tracksRegLiveness: true
selected:        true
body:             |
  bb.0:
    liveins: $r1, $r2, $r3
    ; CHECK-LABEL: name: vreg_movt32_tied
    ; CHECK: liveins: $r1, $r2, $r3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r1
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $r2
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gpr32 = COPY $r3
    ; CHECK-NEXT: [[MOVT32_:%[0-9]+]]:gpr32 = MOVT32 [[COPY]], [[COPY1]], [[COPY2]], implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY [[MOVT32_]]
    ; CHECK-NEXT: RET implicit $r0, implicit $r15
    ;
    ; DBG-LABEL: name: vreg_movt32_tied
    ; DBG: liveins: $r1, $r2, $r3
    ; DBG-NEXT: {{  $}}
    ; DBG-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r1
    ; DBG-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $r2
    ; DBG-NEXT: [[COPY2:%[0-9]+]]:gpr32 = COPY $r3
    ; DBG-NEXT: [[MOVT32_:%[0-9]+]]:gpr32 = MOVT32 [[COPY]], [[COPY1]], [[COPY2]], implicit-def dead $sfr
    ; DBG-NEXT: $r0 = COPY [[MOVT32_]]
    ; DBG-NEXT: RET implicit $r0, implicit $r15
    ;
    ; PREGREEDY-LABEL: name: vreg_movt32_tied
    ; PREGREEDY: liveins: $r1, $r2, $r3
    ; PREGREEDY-NEXT: {{  $}}
    ; PREGREEDY-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r1
    ; PREGREEDY-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $r2
    ; PREGREEDY-NEXT: [[COPY2:%[0-9]+]]:gpr32 = COPY $r3
    ; PREGREEDY-NEXT: [[MOVT32_:%[0-9]+]]:gpr32 = MOVT32 [[COPY]], [[COPY1]], [[COPY2]], implicit-def dead $sfr
    ; PREGREEDY-NEXT: $r0 = COPY [[MOVT32_]]
    ; PREGREEDY-NEXT: RET implicit $r0, implicit $r15
    %0:gpr32 = COPY $r1
    %1:gpr32 = COPY $r2
    %2:gpr32 = COPY $r3
    %3:gpr32 = MOVT32 %0:gpr32, %1:gpr32, %2:gpr32, implicit-def dead $sfr
    $r0 = COPY %3:gpr32
    RET implicit $r0, implicit $r15

  ; Tied rd/rd_src + two free sources → 3 distinct reads, 1 write.

