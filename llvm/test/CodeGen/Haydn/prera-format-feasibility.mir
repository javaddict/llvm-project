# ============================================================================
# Test 10: three-ready rematch product MIR — ADD32 + 2×ADD64.
#
# Preferred first-fit freezes ADD32 on high slot (S2) then ADD64 on S1 and
# loses the second ADD64. Exact matching-frontier rematch keeps all three
# members in one cycle (ADD32 → S0). Pre-RA list-sched still emits only
# logical opcodes (no setDesc / FormatID / member stamp). Unit pin:
# MatchingFrontierThreeReadyRematchADD32_2xADD64.
# ============================================================================
name:            vreg_three_ready_rematch_add32_2xadd64
tracksRegLiveness: true
selected:        true
body:             |
  bb.0:
    liveins: $r1, $r2, $d0, $d1, $d2, $d3
    ; CHECK-LABEL: name: vreg_three_ready_rematch_add32_2xadd64
    ; CHECK: liveins: $r1, $r2, $d0, $d1, $d2, $d3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r1
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $r2
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:dr64 = COPY $d1
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:dr64 = COPY $d2
    ; CHECK-NEXT: [[COPY4:%[0-9]+]]:dr64 = COPY $d3
    ; CHECK-NEXT: [[COPY5:%[0-9]+]]:dr64 = COPY $d0
    ; CHECK-NEXT: [[ADD64_:%[0-9]+]]:dr64 = ADD64 [[COPY5]], [[COPY2]], implicit-def dead $sfr
    ; CHECK-NEXT: [[ADD64_1:%[0-9]+]]:dr64 = ADD64 [[COPY3]], [[COPY4]], implicit-def dead $sfr
    ; CHECK-NEXT: [[ADD32_:%[0-9]+]]:gpr32 = ADD32 [[COPY]], [[COPY1]], implicit-def dead $sfr
    ; CHECK-NEXT: [[COPY6:%[0-9]+]]:gpr32 = COPY [[ADD32_]]
    ; CHECK-NEXT: [[ADD64_2:%[0-9]+]]:dr64 = ADD64 [[ADD64_]], [[ADD64_1]], implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY [[COPY6]]
    ; CHECK-NEXT: $d0 = COPY [[ADD64_2]]
    ; CHECK-NEXT: RET implicit $r0, implicit $d0, implicit $r15
    ;
    ; DBG-LABEL: name: vreg_three_ready_rematch_add32_2xadd64
    ; DBG: liveins: $r1, $r2, $d0, $d1, $d2, $d3
    ; DBG-NEXT: {{  $}}
    ; DBG-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r1
    ; DBG-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $r2
    ; DBG-NEXT: [[COPY2:%[0-9]+]]:dr64 = COPY $d1
    ; DBG-NEXT: [[COPY3:%[0-9]+]]:dr64 = COPY $d2
    ; DBG-NEXT: [[COPY4:%[0-9]+]]:dr64 = COPY $d3
    ; DBG-NEXT: [[COPY5:%[0-9]+]]:dr64 = COPY $d0
    ; DBG-NEXT: [[ADD64_:%[0-9]+]]:dr64 = ADD64 [[COPY5]], [[COPY2]], implicit-def dead $sfr
    ; DBG-NEXT: [[ADD64_1:%[0-9]+]]:dr64 = ADD64 [[COPY3]], [[COPY4]], implicit-def dead $sfr
    ; DBG-NEXT: [[ADD32_:%[0-9]+]]:gpr32 = ADD32 [[COPY]], [[COPY1]], implicit-def dead $sfr
    ; DBG-NEXT: [[COPY6:%[0-9]+]]:gpr32 = COPY [[ADD32_]]
    ; DBG-NEXT: [[ADD64_2:%[0-9]+]]:dr64 = ADD64 [[ADD64_]], [[ADD64_1]], implicit-def dead $sfr
    ; DBG-NEXT: $r0 = COPY [[COPY6]]
    ; DBG-NEXT: $d0 = COPY [[ADD64_2]]
    ; DBG-NEXT: RET implicit $r0, implicit $d0, implicit $r15
    ;
    ; PREGREEDY-LABEL: name: vreg_three_ready_rematch_add32_2xadd64
    ; PREGREEDY: liveins: $r1, $r2, $d0, $d1, $d2, $d3
    ; PREGREEDY-NEXT: {{  $}}
    ; PREGREEDY-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r1
    ; PREGREEDY-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $r2
    ; PREGREEDY-NEXT: [[COPY2:%[0-9]+]]:dr64 = COPY $d1
    ; PREGREEDY-NEXT: [[COPY3:%[0-9]+]]:dr64 = COPY $d2
    ; PREGREEDY-NEXT: [[COPY4:%[0-9]+]]:dr64 = COPY $d3
    ; PREGREEDY-NEXT: [[COPY5:%[0-9]+]]:dr64 = COPY $d0
    ; PREGREEDY-NEXT: [[ADD64_:%[0-9]+]]:dr64 = ADD64 [[COPY5]], [[COPY2]], implicit-def dead $sfr
    ; PREGREEDY-NEXT: [[ADD64_1:%[0-9]+]]:dr64 = ADD64 [[COPY3]], [[COPY4]], implicit-def dead $sfr
    ; PREGREEDY-NEXT: [[ADD32_:%[0-9]+]]:gpr32 = ADD32 [[COPY]], [[COPY1]], implicit-def dead $sfr
    ; PREGREEDY-NEXT: [[COPY6:%[0-9]+]]:gpr32 = COPY [[ADD32_]]
    ; PREGREEDY-NEXT: [[ADD64_2:%[0-9]+]]:dr64 = ADD64 [[ADD64_]], [[ADD64_1]], implicit-def dead $sfr
    ; PREGREEDY-NEXT: $r0 = COPY [[COPY6]]
    ; PREGREEDY-NEXT: $d0 = COPY [[ADD64_2]]
    ; PREGREEDY-NEXT: RET implicit $r0, implicit $d0, implicit $r15
    %0:gpr32 = COPY $r1
    %1:gpr32 = COPY $r2
    %2:dr64 = COPY $d0
    %3:dr64 = COPY $d1
    %4:dr64 = COPY $d2
    %5:dr64 = COPY $d3
    ; Three independent ready ops — no data edges between them.
    %6:gpr32 = ADD32 %0:gpr32, %1:gpr32, implicit-def dead $sfr
    %7:dr64 = ADD64 %2:dr64, %3:dr64, implicit-def dead $sfr
    %8:dr64 = ADD64 %4:dr64, %5:dr64, implicit-def dead $sfr
    ; Keep all three results live so none are DCE'd before scheduling.
    %9:gpr32 = COPY %6:gpr32
    %10:dr64 = ADD64 %7:dr64, %8:dr64, implicit-def dead $sfr
    $r0 = COPY %9:gpr32
    $d0 = COPY %10:dr64
    RET implicit $r0, implicit $d0, implicit $r15

  ; Logical rematch triple only — no private member descriptors before RA.
  ; Metrics-only HANDOFF law: no durable BUNDLE from pre-RA list-sched.
  ; Port footprints: ADD32 is gpr 2R/1W; each ADD64 is dr 2R/1W. Rematch
  ; feasibility is unit-pinned; here pin MRI bank accounting still fires.

...
