# ============================================================================
# Test 1: logical ADDI32 only after pre-RA schedule (no member setDesc).
# ============================================================================
name:            vreg_gpr_addi_no_member
tracksRegLiveness: true
selected:        true
body:             |
  bb.0:
    liveins: $r1
    ; CHECK-LABEL: name: vreg_gpr_addi_no_member
    ; CHECK: liveins: $r1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r1
    ; CHECK-NEXT: [[ADDI32_:%[0-9]+]]:gpr32 = ADDI32 [[COPY]], 1, implicit-def dead $sfr
    ; CHECK-NEXT: [[ADDI32_1:%[0-9]+]]:gpr32 = ADDI32 [[COPY]], 2, implicit-def dead $sfr
    ; CHECK-NEXT: [[ADD32_:%[0-9]+]]:gpr32 = ADD32 [[ADDI32_]], [[ADDI32_1]], implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY [[ADD32_]]
    ; CHECK-NEXT: RET implicit $r0, implicit $r15
    ;
    ; DBG-LABEL: name: vreg_gpr_addi_no_member
    ; DBG: liveins: $r1
    ; DBG-NEXT: {{  $}}
    ; DBG-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r1
    ; DBG-NEXT: [[ADDI32_:%[0-9]+]]:gpr32 = ADDI32 [[COPY]], 1, implicit-def dead $sfr
    ; DBG-NEXT: [[ADDI32_1:%[0-9]+]]:gpr32 = ADDI32 [[COPY]], 2, implicit-def dead $sfr
    ; DBG-NEXT: [[ADD32_:%[0-9]+]]:gpr32 = ADD32 [[ADDI32_]], [[ADDI32_1]], implicit-def dead $sfr
    ; DBG-NEXT: $r0 = COPY [[ADD32_]]
    ; DBG-NEXT: RET implicit $r0, implicit $r15
    ;
    ; PREGREEDY-LABEL: name: vreg_gpr_addi_no_member
    ; PREGREEDY: liveins: $r1
    ; PREGREEDY-NEXT: {{  $}}
    ; PREGREEDY-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r1
    ; PREGREEDY-NEXT: [[ADDI32_:%[0-9]+]]:gpr32 = ADDI32 [[COPY]], 1, implicit-def dead $sfr
    ; PREGREEDY-NEXT: [[ADDI32_1:%[0-9]+]]:gpr32 = ADDI32 [[COPY]], 2, implicit-def dead $sfr
    ; PREGREEDY-NEXT: [[ADD32_:%[0-9]+]]:gpr32 = ADD32 [[ADDI32_]], [[ADDI32_1]], implicit-def dead $sfr
    ; PREGREEDY-NEXT: $r0 = COPY [[ADD32_]]
    ; PREGREEDY-NEXT: RET implicit $r0, implicit $r15
    %0:gpr32 = COPY $r1
    %1:gpr32 = ADDI32 %0:gpr32, 1, implicit-def dead $sfr
    %2:gpr32 = ADDI32 %0:gpr32, 2, implicit-def dead $sfr
    %3:gpr32 = ADD32 %1:gpr32, %2:gpr32, implicit-def dead $sfr
    $r0 = COPY %3:gpr32
    RET implicit $r0, implicit $r15

  ; Logical opcodes only — no private member descriptors before RA.

