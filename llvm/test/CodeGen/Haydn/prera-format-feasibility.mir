# ============================================================================
# Test 2: MOVE32 is dest+src (1R1W — logical/member schema agreement).
# Pre-RA HR uses PortModel MI accounting only. Descriptor shape is the
# same 1R1W. No member setDesc.
# ============================================================================
name:            vreg_move32_dedup
tracksRegLiveness: true
selected:        true
body:             |
  bb.0:
    liveins: $r1, $r2
    ; CHECK-LABEL: name: vreg_move32_dedup
    ; CHECK: liveins: $r1, $r2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r1
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $r2
    ; CHECK-NEXT: [[MOVE32_:%[0-9]+]]:gpr32 = MOVE32 [[COPY]], implicit-def dead $sfr
    ; CHECK-NEXT: [[MOVE32_1:%[0-9]+]]:gpr32 = MOVE32 [[COPY1]], implicit-def dead $sfr
    ; CHECK-NEXT: [[ADD32_:%[0-9]+]]:gpr32 = ADD32 [[MOVE32_]], [[MOVE32_1]], implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY [[ADD32_]]
    ; CHECK-NEXT: RET implicit $r0, implicit $r15
    ;
    ; DBG-LABEL: name: vreg_move32_dedup
    ; DBG: liveins: $r1, $r2
    ; DBG-NEXT: {{  $}}
    ; DBG-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r1
    ; DBG-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $r2
    ; DBG-NEXT: [[MOVE32_:%[0-9]+]]:gpr32 = MOVE32 [[COPY]], implicit-def dead $sfr
    ; DBG-NEXT: [[MOVE32_1:%[0-9]+]]:gpr32 = MOVE32 [[COPY1]], implicit-def dead $sfr
    ; DBG-NEXT: [[ADD32_:%[0-9]+]]:gpr32 = ADD32 [[MOVE32_]], [[MOVE32_1]], implicit-def dead $sfr
    ; DBG-NEXT: $r0 = COPY [[ADD32_]]
    ; DBG-NEXT: RET implicit $r0, implicit $r15
    ;
    ; PREGREEDY-LABEL: name: vreg_move32_dedup
    ; PREGREEDY: liveins: $r1, $r2
    ; PREGREEDY-NEXT: {{  $}}
    ; PREGREEDY-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r1
    ; PREGREEDY-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $r2
    ; PREGREEDY-NEXT: [[MOVE32_:%[0-9]+]]:gpr32 = MOVE32 [[COPY]], implicit-def dead $sfr
    ; PREGREEDY-NEXT: [[MOVE32_1:%[0-9]+]]:gpr32 = MOVE32 [[COPY1]], implicit-def dead $sfr
    ; PREGREEDY-NEXT: [[ADD32_:%[0-9]+]]:gpr32 = ADD32 [[MOVE32_]], [[MOVE32_1]], implicit-def dead $sfr
    ; PREGREEDY-NEXT: $r0 = COPY [[ADD32_]]
    ; PREGREEDY-NEXT: RET implicit $r0, implicit $r15
    %0:gpr32 = COPY $r1
    %1:gpr32 = COPY $r2
    ; MOVE32 modeled as rd, rs — PortModel MI path is 1R/1W (dest+src).
    %2:gpr32 = MOVE32 %0:gpr32, implicit-def dead $sfr
    %3:gpr32 = MOVE32 %1:gpr32, implicit-def dead $sfr
    %4:gpr32 = ADD32 %2:gpr32, %3:gpr32, implicit-def dead $sfr
    $r0 = COPY %4:gpr32
    RET implicit $r0, implicit $r15

  ; MI path (pre-RA HR): MOVE32 is 1R/1W (dest+src), matching descriptor.

...
