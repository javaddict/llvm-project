---
name:            test_select_brcond_true
legalized:       true
regBankSelected: false
# CHECK-LABEL: name: test_select_brcond_true
# CHECK: BNEZ
body:             |
  bb.0:
    liveins: $r0, $r1
    %0:_(s32) = COPY $r0
    %1:_(s32) = COPY $r1
    %2:_(s1) = G_ICMP intpred(sgt), %0(s32), %1(s32)
    G_BRCOND %2(s1), %bb.1
    G_BR %bb.2

  bb.1:
    %3:_(s32) = G_ADD %0, %1
    $r0 = COPY %3(s32)
    RET implicit $r0, implicit $r15

  bb.2:
    %4:_(s32) = G_SUB %0, %1
    $r0 = COPY %4(s32)
    RET implicit $r0, implicit $r15
...

---
name:            test_select_brcond_false
legalized:       true
regBankSelected: false
