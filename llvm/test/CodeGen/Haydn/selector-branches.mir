# RUN: llc -mtriple=haydn-unknown-elf -run-pass=regbankselect,instruction-select %s -o - | FileCheck %s

# Role: MIR — that G_ICMP is selected to compare instructions and G_BRCOND to branches.

# Test that G_ICMP is selected to compare instructions and G_BRCOND to branches.
# Haydn uses SLT32/SLTU32/SEQ32 with operand swapping for comparison lowering.

---
name:            test_select_icmp_eq
legalized:       true
regBankSelected: false
# CHECK-LABEL: name: test_select_icmp_eq
# CHECK: SEQ32
body:             |
  bb.0.entry:
    liveins: $r0, $r1
    %0:_(s32) = COPY $r0
    %1:_(s32) = COPY $r1
    %2:_(s1) = G_ICMP intpred(eq), %0(s32), %1(s32)
    %3:_(s32) = G_SELECT %2(s1), %0, %1
    $r0 = COPY %3(s32)
    RET implicit $r0, implicit $r15
...

---
name:            test_select_icmp_ne
legalized:       true
regBankSelected: false
# CHECK-LABEL: name: test_select_icmp_ne
# CHECK: SEQ32
body:             |
  bb.0.entry:
    liveins: $r0, $r1
    %0:_(s32) = COPY $r0
    %1:_(s32) = COPY $r1
    %2:_(s1) = G_ICMP intpred(ne), %0(s32), %1(s32)
