---
name:            test_select_icmp_sgt
legalized:       true
regBankSelected: false
# CHECK-LABEL: name: test_select_icmp_sgt
# sgt(a,b) → SLT32(b,a) with swapped operands
# CHECK: SLT32
body:             |
  bb.0.entry:
    liveins: $r0, $r1
    %0:_(s32) = COPY $r0
    %1:_(s32) = COPY $r1
    %2:_(s1) = G_ICMP intpred(sgt), %0(s32), %1(s32)
    %3:_(s32) = G_SELECT %2(s1), %0, %1
    $r0 = COPY %3(s32)
    RET implicit $r0, implicit $r15
...

---
