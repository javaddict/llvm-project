legalized:       true
regBankSelected: false
# CHECK-LABEL: name: test_select_icmp_sge
# sge(a,b) → NOT SLT32(a,b) → SLT32 with invert
# CHECK: SLT32
body:             |
  bb.0.entry:
    liveins: $r0, $r1
    %0:_(s32) = COPY $r0
    %1:_(s32) = COPY $r1
