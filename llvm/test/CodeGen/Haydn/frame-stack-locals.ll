;Simple local variable (one i32 alloca)

define i32 @one_local(i32 %x) {
; Stack allocation for local
; (SFR-strip) changed bundle layout (denser packing) — the SP restore may
; be hoisted above the local st32/ld32 (anti-dep); use CHECK-DAG. Rebaselined.
; NOTE: this sentence named two load spellings that a bulk rename collapsed
; into one, leaving "both ld32 and ld32". It was about Bundle128 slot
; promotion; under format E a load's unit comes from the member the packer
; chose, not from a slot.
; CHECK-LABEL: one_local:
; CHECK:       // #<spill-kpi> @one_local spills=0 spill-bytes=0 reloads=0 reload-bytes=0
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    { xor32 r0, r0, r0; nop; nop }
; CHECK-NEXT:    { subi32 sp, sp, 16; nop }
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    { addi32 r2, sp, 12; nop }
; CHECK-NEXT:    { nop; nop; s_sw_with_imm r1, r2, 0 }
; CHECK-NEXT:    { s_lw_with_imm r1, r2, 0; nop; nop }
; CHECK-NEXT:    { xor32 r0, r0, r0; nop; nop }
; CHECK-NEXT:    { addi32 sp, sp, 16; nop }
; CHECK-NEXT:    { nop; jalr r0, lr, 0; nop }
  %p = alloca i32
  store i32 %x, ptr %p
  %v = load i32, ptr %p
  ret i32 %v
}

;Multiple local variables (3 i32 allocas)

define i32 @three_locals(i32 %a, i32 %b, i32 %c) {
; 3 x i32 = 12 bytes, rounded to 16 (8-byte alignment)
; (post-RA scheduler) hoists the SP restore above the store/load (anti-dep on sp); the
; stores/loads use pre-computed address registers, so semantics are unchanged. CHECK-DAG.
; CHECK-LABEL: three_locals:
; CHECK:       // #<spill-kpi> @three_locals spills=0 spill-bytes=0 reloads=0 reload-bytes=0
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    { xor32 r0, r0, r0; nop; nop }
; CHECK-NEXT:    { subi32 sp, sp, 24; nop }
; CHECK-NEXT:    .cfi_def_cfa_offset 24
; CHECK-NEXT:    { addi32 r4, sp, 20; addi32 r5, sp, 16 }
; CHECK-NEXT:    { addi32 r6, sp, 12; s_sw_with_imm r1, r4, 0 }
; CHECK-NEXT:    { nop; nop; s_sw_with_imm r2, r5, 0 }
; CHECK-NEXT:    { s_lw_with_imm r1, r4, 0; nop; s_lw_with_imm r2, r5, 0 }
; CHECK-NEXT:    { nop; nop; s_sw_with_imm r3, r6, 0 }
; CHECK-NEXT:    { s_lw_with_imm r3, r6, 0; add32 r1, r1, r2; nop }
; CHECK-NEXT:    { nop; nop; nop }
; CHECK-NEXT:    { add32 r1, r1, r3; nop; nop }
; CHECK-NEXT:    { xor32 r0, r0, r0; nop; nop }
; CHECK-NEXT:    { addi32 sp, sp, 24; nop }
; CHECK-NEXT:    { nop; jalr r0, lr, 0; nop }
  %p1 = alloca i32
  %p2 = alloca i32
  %p3 = alloca i32
  store i32 %a, ptr %p1
  store i32 %b, ptr %p2
  store i32 %c, ptr %p3
  %v1 = load i32, ptr %p1
  %v2 = load i32, ptr %p2
  %v3 = load i32, ptr %p3
  %s = add i32 %v1, %v2
  %r = add i32 %s, %v3
  ret i32 %r
}

