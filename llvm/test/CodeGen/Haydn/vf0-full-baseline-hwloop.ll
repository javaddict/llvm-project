; Full-only residual baseline — hardware loop setup + Full-only
; cycle/format-histogram shape under INFRASTRUCTURE_ONLY (product
; BUNDLE_E96 only).
;
; Captures the immutable Full-row setup floor and parcel histogram for later
; multi-format waves:
;   * set_hwloop_f2_w emitted (Role A / expand)
;   * InterveningCycles=2 size-bearing Full parcels after SET before body label
;   * Each issue cycle prints as a 3-slot Full parcel `{ a; b; c }` (format
;     histogram is 100% BUNDLE_E96 — no compact widths)
;   * Inclusive END labels (start + end)
;   * Fixed zero spill-kpi on this kernel
;
; No second FormatDesc, pad-drop, HWLOOP-SU completion, or SMS product enable.
; Hand FileCheck only — setup-distance law is t-3 (SetupIssueDistance=3).

define i32 @vf0_full_hwloop_baseline(i32 %n, ptr %p) {
; CHECK-LABEL: vf0_full_hwloop_baseline:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    { xor32 r0, r0, r0; nop }
; CHECK-NEXT:    { subi32 sp, sp, 8; nop }
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    { move32 r3, r1; addi32_w r1, r0, 0 }
; CHECK-NEXT:    { slt32 r4, r1, r3; nop }
; CHECK-NEXT:    { xori32 r4, r4, 1; nop }
; CHECK-NEXT:    { bnez_w r4, .LBB0_3; nop }
; CHECK-NEXT:  // %bb.1: // %loop.preheader
; CHECK-NEXT:    { set_hwloop_f2_w 1, .LLhwloop_start0, .LLhwloop_end0, r3; nop }
; CHECK-NEXT:    { nop; nop }
; CHECK-NEXT:    { nop; nop }
; CHECK-NEXT:  .LBB0_2: // %loop
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    // Label of block must be emitted
; CHECK-NEXT:  .LLhwloop_start0:
; CHECK-NEXT:    { s_lw_post_imm r3, r2, 1; nop }
; CHECK-NEXT:    { add32 r1, r1, r3; nop }
; CHECK-NEXT:  .LLhwloop_end0:
; CHECK-NEXT:    { nop; nop }
; CHECK-NEXT:  .LBB0_3: // %exit
; CHECK-NEXT:    { xor32 r0, r0, r0; nop }
; CHECK-NEXT:    { addi32_w sp, sp, 8; nop }
; CHECK-NEXT:    { jalr_w r0, lr, 0; nop }
entry:
  %cmp = icmp sgt i32 %n, 0
  br i1 %cmp, label %loop, label %exit

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %acc = phi i32 [ 0, %entry ], [ %acc.next, %loop ]
  %ge = getelementptr inbounds i32, ptr %p, i32 %i
  %v = load i32, ptr %ge, align 4
  %acc.next = add i32 %acc, %v
  %i.next = add i32 %i, 1
  %cont = icmp slt i32 %i.next, %n
  br i1 %cont, label %loop, label %exit

exit:
  %r = phi i32 [ 0, %entry ], [ %acc.next, %loop ]
  ret i32 %r
}

