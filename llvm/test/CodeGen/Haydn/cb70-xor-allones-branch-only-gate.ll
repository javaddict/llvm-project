; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=haydn-unknown-elf -global-isel-abort=1 -o - %s | FileCheck %s

; Role: semantic — `~(comparison)` as a VALUE must be bitwise complement
; (not32 / xor-with-all-ones), not a 0/1 logical not (xor-with-1).

; matchXorAllOnesBoolean used to rewrite `xor %bool, -1` into
; `xor (and %bool, 1), 1` for every boolean. That is sound only for
; G_ANYEXT of i1 (undef upper bits). For a clean G_ZEXT icmp, C `~(a>b)`
; must yield -2 when a>b (bitwise not of 1), not 0.
;
; Contract: compare + mask may exist, but the value path must end in not32
; (or equivalent all-ones xor). A lone `xori32 ..., 1` as the not is wrong.


define i32 @f_value_not(i32 %a, i32 %b) {
; CHECK-LABEL: f_value_not:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    { xor32 r0, r0, r0; subi32 sp, sp, 8 }
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    { nop; slt32 r1, r2, r1 }
; CHECK-NEXT:    { nop; andi32 r1, r1, 1 }
; CHECK-NEXT:    { nop; not32 r1, r1 }
; CHECK-NEXT:    { nop; addi32 sp, sp, 8 }
; CHECK-NEXT:    .cfi_def_cfa sp, 0
; CHECK-NEXT:    { nop; jalr r0, lr, 0 }
entry:
  %c = icmp sgt i32 %a, %b
  %z = zext i1 %c to i32
  %r = xor i32 %z, -1
  ret i32 %r
}
