# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postmisched -verify-machineinstrs %s -o - | FileCheck %s

# Role: MIR — (/): same-bundle RAW must NOT be formed on Haydn.


# REBASELINED : / pipeline reorder (ExpandPseudos/BitSimplify pre-scheduler + materialize at leaveRegion) — bundles regrouped, ops unchanged.
# REBASELINED : / FLEX cutover — test3 control (independent ADDI32+ADD32) now bundles (S0+S1); test1/test2 RAW pairs stay un-bundled (regression intent preserved).
#
# REGRESSION TEST (/): same-bundle RAW must NOT be formed on Haydn.
#
# Background: Haydn spec (VLIW_Engine_Compiler_Constraints.md §Constraints) says
# "All instructions within the same bundle read their source registers
# simultaneously" — there is NO intra-bundle forwarding. So a reader placed in
# the same cycle as its writer observes the OLD value. The post-RA scheduler
# must never co-issue a register writer with a same-cycle reader of that reg.
#
# root cause: HaydnHazardRecognizer::getHazardType had no RAW check (only
# WAW,), so the scheduler co-issued a writer and reader in the PROLOGUE
# constant-init stores (`{ ST8 $r6,$r2,2; $r1=ADDI32 $r0,65; ST8 $r1,$r5,4 }`)
# corrupting stored values. adds hasSameBundleRAW (candidate reads a reg in
# CurrentCycleDefs). This test locks the contract: a RAW pair is forced into
# SEPARATE bundles (no BUNDLE wraps the writer+reader). The scheduler DAG's RAW
# edge is the primary mechanism; is the belt-and-suspenders gate.
#
# What breaks if regresses AND the DAG stops serializing: the RAW pair
# lands in ONE BUNDLE 0, -> the CHECK (two standalone instrs, no BUNDLE) fails.
#
# Tests:
# 1. GPR RAW: `$r1 = ADDI32` then `$r7 = ADD32 $r1, $r2` (reads new r1) -> no bundle.
# 2. DR64 RAW: `$d1 = ADD64` then `$d7 = ADD64 $d1, $d2` -> no bundle.
# 3. CONTROL: independent (different regs) -> SHOULD bundle (no over-reject).

--- |
  define void @test1_raw_same_gpr_no_bundle() { ret void }
  define void @test2_raw_same_dr64_no_bundle() { ret void }
  define void @test3_independent_can_bundle() { ret void }
...
---
# Test 1: `$r1 = ADDI32 $r0, 65` defs r1; `$r7 = ADD32 $r1, $r2` reads r1 (RAW).
# No memory, ports fit, slots free. Only the RAW on r1 forbids the bundle ->
# two standalone instrs (no BUNDLE).
name:            test1_raw_same_gpr_no_bundle
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r2

    ; CHECK-LABEL: name: test1_raw_same_gpr_no_bundle
    ; CHECK: liveins: $r0, $r2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r1 = ADDI32{{.*}} $r0, 65, implicit-def dead $sfr
    ; CHECK-NEXT: $r7 = ADD32{{.*}} killed $r1, killed $r2, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY{{.*}} killed $r7
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r1 = ADDI32 $r0, 65, implicit-def dead $sfr
    $r7 = ADD32 $r1, $r2, implicit-def dead $sfr

    $r0 = COPY $r7
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# Test 2: DR64 RAW. `$d1 = ADD64 $d0,$d3` defs d1; `$d7 = ADD64 $d1,$d2` reads d1.
name:            test2_raw_same_dr64_no_bundle
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$d2', virtual-reg: '' }
  - { reg: '$d3', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $d0, $d2, $d3

    ; CHECK-LABEL: name: test2_raw_same_dr64_no_bundle
    ; CHECK: liveins: $d0, $d2, $d3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $d1 = ADD64{{.*}} killed $d0, killed $d3, implicit-def dead $sfr
    ; CHECK-NEXT: $d7 = ADD64{{.*}} killed $d1, killed $d2, implicit-def dead $sfr
    ; CHECK-NEXT: $d0 = COPY{{.*}} killed $d7
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $d1 = ADD64 $d0, $d3, implicit-def dead $sfr
    $d7 = ADD64 $d1, $d2, implicit-def dead $sfr

    $d0 = COPY $d7
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# Test 3 (CONTROL): independent writes to DIFFERENT dests, no RAW, no WAW ->
# SHOULD bundle. Guards against the fix over-rejecting (a legal bundle
# must still form).
name:            test3_independent_can_bundle
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r2, $r3, $r4

    ; CHECK-LABEL: name: test3_independent_can_bundle
    ; CHECK: liveins: $r0, $r2, $r3, $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r1 = ADDI32{{.*}} $r0, 65, implicit-def dead $sfr
    ; CHECK-NEXT: $r7 = ADD32{{.*}} killed $r3, killed $r4, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY{{.*}} killed $r1
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r1 = ADDI32 $r0, 65, implicit-def dead $sfr
    $r7 = ADD32 $r3, $r4, implicit-def dead $sfr

    $r0 = COPY $r1
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
