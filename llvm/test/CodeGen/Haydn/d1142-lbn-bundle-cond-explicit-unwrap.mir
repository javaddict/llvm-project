    NOP
    RET implicit killed $r15

  bb.2.far:
    liveins: $r15
    RET implicit killed $r15

# CHECK-LABEL: name:            one_way_bundle_far_cond
# CHECK: bb.0.entry
# CHECK: LUI{{.*}}%bb.2{{$}}
# CHECK: ADDI32{{.*}}%bb.2{{$}}
# CHECK-NOT: BEQZ{{.*}} $r7
# CHECK: BNEZ{{.*}} $r7, %bb.1
# CHECK-NOT: B %bb.
# CHECK: JALR
# CHECK-NOT: B %bb.
# CHECK: bb.1.near
