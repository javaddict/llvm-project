# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postmisched -verify-machineinstrs %s -o - | FileCheck %s

# Role: MIR — VLIW STRESS TEST: Dependency chains forcing single-issue and interleaving.


# REBASELINED : / pipeline reorder (ExpandPseudos/BitSimplify pre-scheduler + materialize at leaveRegion) — bundles regrouped, ops unchanged.
# REBASELINED : / FLEX cutover — test4 interleaved case now packs the three independent ops (ADD32_S0+ADD64+ADD64) into one bundle; SUB32 (RAW on $r2) still correctly forced into a standalone instr. RAW-chain and reduction-pattern intents (tests 1, 3) preserved.
#
# VLIW STRESS TEST: Dependency chains forcing single-issue and interleaving.
#
# Tests scenarios where instructions MUST be single-issue due to dependency
# chains, and verifies correct packet boundaries.
#
# Covers:
# 1. Long RAW chain forcing all single-issue packets
# 2. Two independent chains interleaved — can cross-pack
# 3. Loop-carried dependency (reduction pattern)
# 4. Interleaved independent ops: some can pack, some cannot
#

--- |
  define void @test1_long_raw_chain() { ret void }
  define void @test2_two_independent_chains() { ret void }
  define void @test3_reduction_pattern() { ret void }
  define void @test4_interleaved_deps() { ret void }
...
---
# ============================================================================
# Test 1: Long RAW chain — 6 instructions, all single-issue
# ============================================================================
#
# Six ADD32 instructions forming a single dependency chain:
# r2 = ADD32 r0, r1
# r3 = ADD32 r2, r0
# r4 = ADD32 r3, r0
# r5 = ADD32 r4, r0
# r6 = ADD32 r5, r0
# r7 = ADD32 r6, r0
# Each depends on the previous -> no two can bundle.
#
name:            test1_long_raw_chain
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1

    ; All RAW-dependent. Every instruction is a separate packet.

    ; CHECK-LABEL: name: test1_long_raw_chain
    ; CHECK: liveins: $r0, $r1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2 = ADD32{{.*}} $r0, killed $r1, implicit-def dead $sfr
    ; CHECK-NEXT: $r3 = ADD32{{.*}} killed $r2, $r0, implicit-def dead $sfr
    ; CHECK-NEXT: $r4 = ADD32{{.*}} killed $r3, $r0, implicit-def dead $sfr
    ; CHECK-NEXT: $r5 = ADD32{{.*}} killed $r4, $r0, implicit-def dead $sfr
    ; CHECK-NEXT: $r6 = ADD32{{.*}} killed $r5, $r0, implicit-def dead $sfr
    ; CHECK-NEXT: $r7 = ADD32{{.*}} killed $r6, $r0, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY{{.*}}$r7
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    $r3 = ADD32 $r2, $r0, implicit-def dead $sfr
    $r4 = ADD32 $r3, $r0, implicit-def dead $sfr
    $r5 = ADD32 $r4, $r0, implicit-def dead $sfr
    $r6 = ADD32 $r5, $r0, implicit-def dead $sfr
    $r7 = ADD32 $r6, $r0, implicit-def dead $sfr

    $r0 = COPY $r7
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 2: Two independent chains — cross-chain packing
# ============================================================================
#
# Chain A (GPR32): r2 = ADD32 r0, r1 -> r4 = ADD32 r2, r0
# Chain B (DR64): d0 = ADD64 d2, d3 -> d4 = SUB64 d0, d5
#
# Instructions from chain A and chain B can interleave and bundle
# because they use completely different register banks:
# Bundle 1: ADD32 r2 (chain A) + ADD64 d0 (chain B) -- independent
# Bundle 2: ADD32 r4 (chain A, reads r2) + SUB64 d4 (chain B, reads d0)
#
# Wait — ADD32 r4 reads r2 (from chain A step 1). SUB64 d4 reads d0 (from
# chain B step 1). These are cross-bank independent, so they can bundle.
# But within each bundle, the two instructions have no RAW between them
# (GPR32 vs DR64). The RAW within chain A (r2) and within chain B (d0)
# is between bundles, not within.
#
name:            test2_two_independent_chains
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$d2', virtual-reg: '' }
  - { reg: '$d3', virtual-reg: '' }
  - { reg: '$d5', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $d2, $d3, $d5

    ; Step 1 of both chains — independent, cross-bank -> bundle.

    ; Step 2 of both chains — independent, cross-bank -> bundle.
    ; (r4 reads r2 from step 1, d4 reads d0 from step 1 — but r2 and d0
    ; are in the PREVIOUS bundle, not this one. No intra-bundle RAW.)

    ; CHECK-LABEL: name: test2_two_independent_chains
    ; CHECK: liveins: $r0, $r1, $d2, $d3, $d5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2 = ADD32{{.*}} $r0, killed $r1, implicit-def dead $sfr
    ; CHECK-NEXT: $d0 = ADD64{{.*}} killed $d2, killed $d3, implicit-def dead $sfr
    ; CHECK-NEXT: $r4 = ADD32{{.*}} killed $r2, $r0, implicit-def dead $sfr
    ; CHECK-NEXT: $d4 = SUB64{{.*}} killed $d0, killed $d5, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY{{.*}}$r4
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    $d0 = ADD64 $d2, $d3, implicit-def dead $sfr
    $r4 = ADD32 $r2, $r0, implicit-def dead $sfr
    $d4 = SUB64 $d0, $d5, implicit-def dead $sfr

    $r0 = COPY $r4
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 3: Reduction pattern — accumulator dependency
# ============================================================================
#
# Simulates a sum reduction:
# d0 = ADD64 d0, d1
# d0 = ADD64 d0, d2
# d0 = ADD64 d0, d3
# All write d0, and each reads d0 from the previous. Both RAW and WAW.
# Must be sequential.
#
name:            test3_reduction_pattern
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$d1', virtual-reg: '' }
  - { reg: '$d2', virtual-reg: '' }
  - { reg: '$d3', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $d0, $d1, $d2, $d3

    ; Accumulator reduction: RAW + WAW on d0.

    ; CHECK-LABEL: name: test3_reduction_pattern
    ; CHECK: liveins: $r0, $d0, $d1, $d2, $d3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $d0 = ADD64{{.*}} killed $d0, killed $d1, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY{{.*}} $r0
    ; CHECK-NEXT: $d0 = ADD64{{.*}} killed $d0, killed $d2, implicit-def dead $sfr
    ; CHECK-NEXT: $d0 = ADD64{{.*}} killed $d0, killed $d3, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $d0 = ADD64 $d0, $d1, implicit-def dead $sfr
    $d0 = ADD64 $d0, $d2, implicit-def dead $sfr
    $d0 = ADD64 $d0, $d3, implicit-def dead $sfr

    $r0 = COPY $r0
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 4: Interleaved independent and dependent ops
# ============================================================================
#
# Pattern: independent, independent, dependent on first, independent
# ADD32 r2, r0, r1 (independent)
# ADD64 d0, d2, d3 (independent, DR64)
# SUB32 r3, r2, r0 (RAW on r2 from ADD32)
# ADD64 d4, d5, d6 (independent, DR64)
#
# Expected:
# Bundle 1: ADD32 r2 + ADD64 d0 (independent, 2R/1W GPR + 0 GPR)
# Bundle 2: SUB32 r3 + ADD64 d4 (SUB32 reads r2 from prev bundle, not
# this one; d4 is independent)
#
name:            test4_interleaved_deps
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$d2', virtual-reg: '' }
  - { reg: '$d3', virtual-reg: '' }
  - { reg: '$d5', virtual-reg: '' }
  - { reg: '$d6', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $d2, $d3, $d5, $d6

    ; Bundle 1: ADD32 + ADD64 (independent, cross-bank).

    ; SUB32 reads r2 from above. ADD64 d4 is independent.
    ; No RAW between SUB32 and ADD64 (different banks).

    ; CHECK-LABEL: name: test4_interleaved_deps
    ; CHECK: liveins: $r0, $r1, $d2, $d3, $d5, $d6
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2 = ADD32{{.*}} $r0, killed $r1, implicit-def dead $sfr
    ; CHECK-NEXT: $r3 = SUB32{{.*}} killed $r2, $r0, implicit-def dead $sfr
    ; CHECK-NEXT: $d0 = ADD64{{.*}} killed $d2, killed $d3, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY{{.*}}$r3
    ; CHECK-NEXT: $d4 = ADD64{{.*}} killed $d5, killed $d6, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    $d0 = ADD64 $d2, $d3, implicit-def dead $sfr
    $r3 = SUB32 $r2, $r0, implicit-def dead $sfr
    $d4 = ADD64 $d5, $d6, implicit-def dead $sfr

    $r0 = COPY $r3
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
