# D1.34 control fixture for gr27-d134-latch-before-header.mir: the
# Header-then-Latch twin of the sentinel arm. Sized past the short
# window (175 NOP body = 2100 B raw span > 2000 = 2048 - 48 buffer) so
# the demote installs the legal TERMINAL long latch (LUI+ADDI32_W+
# BEQZ_W+JALR_W, no BNEZ backedge) instead of refusing. Consumed only
# by that test's CTL RUN arm.
--- |
  define dso_local i32 @header_first() {
  entry:
    br label %body
  body:
    br label %exit
  exit:
    ret i32 0
  }
---
name:            header_first
alignment:       1
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r2, $r15
    successors: %bb.1
    SET_HWLOOP_F2_W 2, %bb.1, %bb.1, $r2, implicit-def dead $sfr

  bb.1.body:
    liveins: $r2
    successors: %bb.2
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
