# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postmisched -verify-machineinstrs %s -o - | FileCheck %s

# Role: MIR — exact no-split post-RA pack regression.

# G-BUNDLE-FORMAT / VF5 exact no-split post-RA pack regression.
# Production materialize commits one legal Format E or fails closed —
# no greedy multi-MI split repair (NumScheduledCyclesSplit == 0).
#
# 1. Independent ALU ops may BUNDLE (control — exact multi-MI commit).
# 2. Dual S0-only stores must NOT share one BUNDLE (HR serializes to
#    separate cycles; materialize never invents a multi-MI split bundle).
# 3. Dual LD32 may BUNDLE (dual-load product).
# 4. ST32 + independent ADD32: both present; co-issue optional.
# 5. ARCTAN stays alone vs independent ALU (issue-alone schedule rule).
# 6. LD + MAC independent may BUNDLE (DSP density / AIE multi-slot class).
# 7. Dual MAC may BUNDLE (S1|S2).

--- |
  define void @pack_two_alu() { ret void }
  define void @split_dual_store() { ret void }
  define void @pack_dual_load() { ret void }
  define void @pack_store_alu() { ret void }
  define void @arctan_alone() { ret void }
  define void @pack_ld_mac() { ret void }
  define void @pack_dual_mac() { ret void }
...
---
name:            pack_two_alu
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r3, $r4

    ; B1.1: multi-MI BUNDLE root carries durable FormatID imm (FormatE96=0).
    ; CHECK-LABEL: name: pack_two_alu
    ; CHECK: liveins: $r0, $r3, $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2 = ADDI32{{.*}} $r0, 10, implicit-def dead $sfr
    ; CHECK-NEXT: $r7 = ADD32{{.*}} killed $r3, killed $r4, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY{{.*}}$r2
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADDI32 $r0, 10, implicit-def dead $sfr
    $r7 = ADD32 killed $r3, killed $r4, implicit-def dead $sfr
    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15

...
---
name:            split_dual_store
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r1, $r2, $r3, $r4

    ; Two ST32 are S0-only — must not co-issue in one BUNDLE.
    ; CHECK-LABEL: name: split_dual_store
    ; CHECK: liveins: $r1, $r2, $r3, $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: {{ST32|S_SW_WITH_IMM}}{{.*}} killed $r1, killed $r2, 0
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: {{ST32|S_SW_WITH_IMM}}{{.*}} killed $r3, killed $r4, 4
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    ST32 $r1, $r2, 0
    ST32 $r3, $r4, 4
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15

...
---
name:            pack_dual_load
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r1, $r2

    ; Dual LD32 (S0|S1) should pack when independent.
    ; CHECK-LABEL: name: pack_dual_load
    ; CHECK: liveins: $r1, $r2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE{{.*}}{
    ; (Coherent exact solve: the LOAD1/e1 member prints first — entry order
    ; is emission order, high entry first.)
    ; CHECK-DAG:    $r4 = {{LD32|S_LW_WITH_IMM}}{{.*}} killed $r2, 0
    ; CHECK-DAG:    $r3 = {{LD32|S_LW_WITH_IMM}}{{.*}} killed $r1, 0
    ; CHECK-NEXT: }
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: $r0 = ADD32{{.*}} killed $r3, killed $r4, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r3 = LD32 $r1, 0
    $r4 = LD32 $r2, 0
    $r0 = ADD32 killed $r3, killed $r4, implicit-def dead $sfr
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15

...
---
name:            pack_store_alu
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r1, $r2, $r3, $r4

    ; ST32 + ADD32 both survive; co-issue is QoR (not required for correctness).
    ; CHECK-LABEL: name: pack_store_alu
    ; CHECK: liveins: $r1, $r2, $r3, $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-DAG: $r5 = ADD32{{.*}} killed $r3, killed $r4, implicit-def dead $sfr
    ; CHECK-DAG: {{ST32|S_SW_WITH_IMM}}{{.*}} killed $r1, killed $r2, 0
    ; CHECK: $r0 = COPY{{.*}}$r5
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    ST32 $r1, $r2, 0
    $r5 = ADD32 killed $r3, killed $r4, implicit-def dead $sfr
    $r0 = COPY $r5
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15

...
---
name:            arctan_alone
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$r0', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $d0, $r0

    ; ARCTAN issue-alone: no BUNDLE wrapping ARCTAN with ADDI32.
    ; CHECK-LABEL: name: arctan_alone
    ; CHECK: liveins: $d0, $r0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r1 = ARCTAN{{.*}} killed $d0, 2
    ; CHECK-NEXT: $r5 = ADDI32{{.*}} $r0, 10, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY{{.*}}$r1
    ; Dest-read window after ARCTAN may insert idle NOP before JALR.
    ; CHECK: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r1 = ARCTAN $d0, 2
    $r5 = ADDI32 $r0, 10, implicit-def dead $sfr
    $r0 = COPY $r1
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15

...
