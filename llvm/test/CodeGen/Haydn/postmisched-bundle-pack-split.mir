name:            pack_ld_mac
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$d4', virtual-reg: '' }
  - { reg: '$d5', virtual-reg: '' }
  - { reg: '$d6', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r1, $d4, $d5, $d6

    ; LD32 (S0|S1) + F2MULAA32R_HHLL (S1|S2) — AIE-style multi-slot density.
    ; CHECK-LABEL: name: pack_ld_mac
    ; CHECK: liveins: $r1, $d4, $d5, $d6
    ; CHECK-NEXT: {{  $}}
    ; CHECK-DAG: $d4 = F2MULAA32R_HHLL{{.*}} killed $d5, killed $d6, implicit-def dead $sfr
    ; CHECK-DAG: $r3 = {{LD32|S_LW_WITH_IMM}}{{.*}} killed $r1, 0
    ; CHECK: $r0 = COPY{{.*}}$r3
    ; CHECK: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r3 = LD32 $r1, 0
    $d4 = F2MULAA32R_HHLL $d4, $d5, $d6, implicit-def dead $sfr
    $r0 = COPY $r3
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15

...
