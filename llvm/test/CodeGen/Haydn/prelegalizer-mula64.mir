# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-prelegalizer-combiner -global-isel-abort=1 %s -o - | FileCheck %s

# Role: MIR — Wave T5 / T5.1: PreLegalizer widening MAC fusion.

# Wave T5 / T5.1: PreLegalizer widening MAC fusion.
#   ss (SEXT x SEXT) -> G_MULA64  -> (select) MULA64_LL
#   uu (ZEXT x ZEXT) -> G_MULA64U -> (select) MULA64_ULUL
# Mixed SEXT x ZEXT is intentionally not fused (needs ordered LUL/ULL).
# Use liveins (not G_IMPLICIT_DEF) — undef_combines collapses dead undef trees.

---
name: mula64_ss_fuse
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1, $d2
    ; CHECK-LABEL: name: mula64_ss_fuse
    %a:_(s32) = COPY $r0
    %b:_(s32) = COPY $r1
    %acc:_(s64) = COPY $d2
    %ea:_(s64) = G_SEXT %a
    %eb:_(s64) = G_SEXT %b
    ; CHECK-NOT: G_MUL
    ; CHECK: G_MULA64
    %m:_(s64) = G_MUL %ea, %eb
    %r:_(s64) = G_ADD %m, %acc
    $d0 = COPY %r
...

---
name: mula64_uu_fuse
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1, $d2
    ; CHECK-LABEL: name: mula64_uu_fuse
    %a:_(s32) = COPY $r0
    %b:_(s32) = COPY $r1
    %acc:_(s64) = COPY $d2
    %ea:_(s64) = G_ZEXT %a
    %eb:_(s64) = G_ZEXT %b
    ; CHECK-NOT: G_MUL
    ; CHECK: G_MULA64U
    %m:_(s64) = G_MUL %ea, %eb
    %r:_(s64) = G_ADD %acc, %m
    $d0 = COPY %r
...

---
name: mula64_mixed_no_fuse
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1, $d2
    ; CHECK-LABEL: name: mula64_mixed_no_fuse
    %a:_(s32) = COPY $r0
    %b:_(s32) = COPY $r1
    %acc:_(s64) = COPY $d2
    %ea:_(s64) = G_SEXT %a
    %eb:_(s64) = G_ZEXT %b
    ; CHECK: G_MUL
    ; CHECK: G_ADD
    ; CHECK-NOT: G_MULA64
    %m:_(s64) = G_MUL %ea, %eb
    %r:_(s64) = G_ADD %m, %acc
    $d0 = COPY %r
...
