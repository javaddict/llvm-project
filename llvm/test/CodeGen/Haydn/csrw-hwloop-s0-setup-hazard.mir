# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postmisched -verify-machineinstrs %s -o - | FileCheck %s
#
# REGRESSION TEST: committed SET_HWLOOP_W / Format E members must still
# trip the CSRW↔SET_HWLOOP same-cycle hazard.
#
# Bug: HaydnHazardRecognizer used a local five-opcode setup list
# (logical SET_HWLOOP / SET_HWLOOP_REG / SET_HWLOOP_W / SET_HWLOOP_F2_W /
# SET_HWLOOP_REG_W only). TII isHardwareLoopSetupOpcode is the sole list and
# also covers Format E SET_HWLOOP members plus LoopStart. A committed
# SET_HWLOOP_W was treated as a non-setup op, so a same-cycle CSRW to HWLR
# 0x20-0x25 was not hazarded.
#
# Why this test: postmisched input already has the selected-member opcode
# SET_HWLOOP_W (leaveRegion setDesc shape), paired with CSRW_W to HWLR
# 0x20. CSRW_W stays logical so UnmodeledSideEffects on the member does not
# DAG-serialize the pair before the recognizer (same lesson as
# csrw-hwloop-hazard.mir). The gate must reject coissue. Control uses CSR
# 0x10 (outside 0x20-0x25) so the setup predicate does not over-reject.
#
# What breaks if this regresses: SET_HWLOOP_W + CSRW_W 32 share a BUNDLE
# (CHECK-NOT: BUNDLE fails). Hardware races the implicit HWLR write against
# the CSRW of HWLR_BEGIN/END/COUNT.

--- |
  define void @s0_csrw_hwlr_set_no_bundle() { ret void }
  define void @s0_csrw_non_hwlr_set_survives() { ret void }
...
---
name:            s0_csrw_hwlr_set_no_bundle
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r15', virtual-reg: '' }
body:             |
  bb.0:
    liveins: $r1, $r15

    ; Standalone sequence (not wrapped in BUNDLE). HWLOOP-SU may insert NOP
    ; after SET before the JALR boundary. Member names are Format E after
    ; leaveMBB setDesc.
    ; CHECK-LABEL: name: s0_csrw_hwlr_set_no_bundle
    ; CHECK: successors: %bb.0(0x80000000)
    ; CHECK-NEXT: liveins: $r1, $r15
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: CSRW_E2_E0_ALU0_I8 32, $r1
    ; CHECK-NEXT: SET_HWLOOP_E2_E0_ALU0_HWLRIII 0, %bb.0, %bb.0, 1
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    CSRW_W 32, $r1, implicit-def $sfr
    SET_HWLOOP_W 0, %bb.0, %bb.0, 1, implicit-def dead $sfr

    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15

...
---
name:            s0_csrw_non_hwlr_set_survives
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r15', virtual-reg: '' }
body:             |
  bb.0:
    liveins: $r1, $r15

    ; Non-HWLR CSR 0x10 is outside 0x20-0x25; both instructions survive.
    ; CHECK-LABEL: name: s0_csrw_non_hwlr_set_survives
    ; CHECK: successors: %bb.0(0x80000000)
    ; CHECK-NEXT: liveins: $r1, $r15
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: CSRW_E2_E0_ALU0_I8 16, $r1
    ; CHECK-NEXT: SET_HWLOOP_E2_E0_ALU0_HWLRIII 0, %bb.0, %bb.0, 1
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    CSRW_W 16, $r1, implicit-def $sfr
    SET_HWLOOP_W 0, %bb.0, %bb.0, 1, implicit-def dead $sfr

    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
