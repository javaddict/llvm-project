# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postmisched -verify-machineinstrs %s -o - | FileCheck %s
#
# REGRESSION TEST : ARCTAN / SIN_COS must issue alone (single-instruction
# bundle). They are the DSP math ops that lock their issuing slot's D-ALU for
# (uimm4+2) consecutive bundles (spec §Special). The minimal guard forces them
# into a standalone bundle; nothing else may join, and they may not join a
# non-empty cycle. (Deliberately over-conservative — the spec still allows
# OTHER slots in the issue bundle; the precise variable (uimm4+2) slot
# reservation is deferred to milestone M5.)
#
# Without the guard the scheduler treats ARCTAN/SIN_COS as NoItinerary
# (zero-resource) and packs an independent op into the same bundle.
#
# Tests:
# 1. ARCTAN + independent ADDI32 -> NOT bundled (ARCTAN standalone).
# 2. CONTROL: two independent ADDI32 (no locked op) -> SHOULD bundle.

--- |
  define void @test_arctan_forced_alone() { ret void }
  define void @test_control_independent_can_bundle() { ret void }
...
---
name:            test_arctan_forced_alone
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$r0', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $d0, $r0

    ; ARCTAN locks its slot; the independent ADDI32 must NOT join its bundle.
    ; CHECK-LABEL: name: test_arctan_forced_alone
    ; CHECK: liveins: $d0, $r0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r1 = ARCTAN_P32_ALU2 killed $d0, 2
    ; CHECK-NEXT: $r5 = ADDI32_P21_ALU1 $r0, 10, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY killed $r1
    ; CHECK-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r1 = ARCTAN $d0, 2
    $r5 = ADDI32 $r0, 10, implicit-def dead $sfr

    $r0 = COPY $r1
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
name:            test_control_independent_can_bundle
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r3, $r4

    ; Two independent ADDI32 (no locked op) -> SHOULD bundle (guard must not
    ; over-reject ordinary ops).
    ; CHECK-LABEL: name: test_control_independent_can_bundle
    ; CHECK: liveins: $r0, $r3, $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE 0, implicit-def $r2, implicit-def dead $sfr, implicit-def $r7, implicit $r0, implicit killed $r3, implicit killed $r4 {
    ; CHECK-NEXT:   $r2 = ADDI32_P21_ALU1 $r0, 10, implicit-def dead $sfr
    ; CHECK-NEXT:   $r7 = ADD32_P20_ALU0 killed $r3, killed $r4, implicit-def dead $sfr
    ; CHECK-NEXT: }
    ; CHECK-NEXT: $r0 = COPY killed $r2
    ; CHECK-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADDI32 $r0, 10, implicit-def dead $sfr
    $r7 = ADD32 $r3, $r4, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
