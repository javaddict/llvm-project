# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf \
# RUN:   -run-pass=haydn-finalize-mi-bundles,haydn-verify-bundles \
# RUN:   -verify-machineinstrs %s -o %t.mir
# RUN: FileCheck %s --check-prefix=MIR --input-file=%t.mir
# RUN: llc -mtriple=haydn-unknown-elf -start-after=livedebugvalues \
# RUN:   -filetype=obj %t.mir -o %t.o
# RUN: llvm-objdump -d -z --triple=haydn-unknown-elf %t.o | FileCheck %s --check-prefix=OBJ
# REQUIRES: haydn-registered-target
# Object CHECKs pin live Format E 12-byte disasm mnemonics only;
# do not pin provisional branch-scale immediates (golden open).
# Role: object — Late-MC one-to-one: demotion final reals serialize through
# AsmPrinter to ELF and disassemble by identity (no residual cycle-forming
# pseudo, no multi-cycle repair, no FlexMap).
#
# This is the printer/MC half of object-demotion e2e. Upstream demote/Fixup
# ownership is sealed by hwloop-object-demotion-e2e / postmisched-object-demotion-e2e
# (final-real SUBI32+BNEZ_W / retained SET_HWLOOP_W). Here the input is already
# final-real machine code:
#   * CSRW_W     — ExpandPseudos form of residual SETCBR_*
#   * SUBI32     — Fixup demotion form of residual LoopDec
#   * BNEZ_W     — Fixup demotion form of residual LoopJNZ
#   * SET_HWLOOP_W — retained hardware final (not residual SET_HWLOOP / LoopStart)
#
# Pass order under test:
#   late FinalizeBundle + VerifyBundles (exact-commit / residual ban firewall)
#   → start-after livedebugvalues AsmPrinter serialize-only → objdump.
# Residual LOADI32 / LOAD_ADDR / SETCBR / Loop* / SET_HWLOOP{,_REG} stay fatal
# via the shared isResidualCycleFormingPseudo law (negative peer lits).

--- |
  define void @late_mc_csrw_soft_edge() { ret void }
  define void @late_mc_set_hwloop_final() { ret void }
...
---
# Final SETCBR demotion form + software soft edge (SUBI32 + BNEZ_W).
name:            late_mc_csrw_soft_edge
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r3, $r15
    successors: %bb.1
    CSRW_W 44, $r1, implicit-def dead $sfr
  bb.1:
    liveins: $r3, $r15
    successors: %bb.1, %bb.2
    $r3 = SUBI32 $r3, 1
    BNEZ_W $r3, %bb.1
  bb.2:
    liveins: $r15
    RET implicit $r15

# MIR-LABEL: name: late_mc_csrw_soft_edge
# Exact-committed Full parcels (member setDesc after finalize).
# MIR: BUNDLE 0
# MIR: CSRW_E2_E0_ALU0_I8
# MIR: BUNDLE 0
# MIR: SUBI32
# MIR: BUNDLE 0
# MIR: BNEZ_E2
# MIR-NOT: SETCBR
# MIR-NOT: LoopDec
# MIR-NOT: LoopJNZ
# MIR-NOT: LoopStart
# MIR-NOT: LOADI32
# MIR-NOT: LOAD_ADDR

# OBJ-LABEL: <late_mc_csrw_soft_edge>:
# Serialize-only identity: final reals encode/decode; no residual mnemonics.
# OBJ: csrw{{.*}}44{{.*}}r1
# OBJ: subi32{{.*}}r3
# OBJ: bnez{{.*}}r3
# OBJ-NOT: setcbr
# OBJ-NOT: loopdec
# OBJ-NOT: loopjnz
# OBJ-NOT: <unknown>

...
---
# Retained hardware SET final (counter-example to always-demote); one-to-one.
name:            late_mc_set_hwloop_final
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r0, $r15
    successors: %bb.1
    SET_HWLOOP_W 0, %bb.1, %bb.1, 4, implicit-def dead $sfr
    NOP
    NOP
    NOP
  bb.1:
    liveins: $r1, $r0
    successors: %bb.2
    ST32 $r0, $r1, 0
  bb.2:
    liveins: $r15
    RET implicit $r15

# MIR-LABEL: name: late_mc_set_hwloop_final
# MIR: BUNDLE 0
# MIR: SET_HWLOOP_E2
# MIR-NOT: {{^    SET_HWLOOP }}
# MIR-NOT: LoopStart
# MIR-NOT: SET_HWLOOP_REG

# OBJ-LABEL: <late_mc_set_hwloop_final>:
# OBJ: set_hwloop
# OBJ-NOT: setcbr
# OBJ-NOT: loopstart
# OBJ-NOT: <unknown>
