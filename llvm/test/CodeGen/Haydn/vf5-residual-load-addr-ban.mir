# RUN: not llc -mtriple=haydn-unknown-elf \
# RUN:   -run-pass=haydn-finalize-mi-bundles,haydn-verify-bundles \
# RUN:   %s -o - 2>&1 | FileCheck %s

# Role: verifier — Late-MC residual LOAD_ADDR at late firewall is fatal (ExpandPseudos owns expand).

# Late-MC residual LOAD_ADDR at late firewall is fatal (ExpandPseudos owns expand).

--- |
  define void @residual_load_addr() { ret void }
...
---
name:            residual_load_addr
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r15
    ; CHECK: residual cycle-forming pseudo
    $r1 = LOAD_ADDR 0
    RET implicit $r15
