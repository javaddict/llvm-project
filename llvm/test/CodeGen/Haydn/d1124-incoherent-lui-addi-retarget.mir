---
name:            destless_jalr_ret
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r15', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        false
body:             |
  bb.0:
    liveins: $r15
    ; CHECK-LABEL: name: destless_jalr_ret
    ; CHECK: JALR
    ; CHECK-NOT: LUI
    $r0 = JALR_W $r15, 0
