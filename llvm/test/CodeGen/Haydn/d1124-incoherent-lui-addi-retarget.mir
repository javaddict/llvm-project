# D1.124 / D1.117: retarget uses getJalrAddrMaterializeChain. A complete
# LUI+ADDI pair with the same %bb dest is rewritten together. Missing half
# or dest-mismatched same-register pair named-refuses (skip, no one-half
# rewrite). Dest-less / returning JALR is empty/incomplete, not UNREACHABLE.
#
# Layout (d164/d176): 180 NOP parcels in bb.1 (~2160B) put TBB %bb.2 past
# WIDE_BranchSImm12 (buffer=4) while FBB %bb.1 stays near.
#
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-longbranch-normalize \
# RUN:   -haydn-branch-relax-safety-buffer=4 -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s
# REQUIRES: haydn-registered-target

--- |
  define void @complete_retarget(i32 %c) {
  entry:
    br i1 undef, label %far, label %near
  near:
    ret void
  far:
    ret void
  }
  define void @incoherent_refuse(i32 %c) {
  entry:
    br i1 undef, label %far, label %near
  near:
    ret void
  far:
    ret void
  other:
    ret void
  }
  define void @addi_only_refuse(i32 %c) {
  entry:
    br i1 undef, label %far, label %near
  near:
    ret void
  far:
    ret void
  }
  define void @lui_only_refuse(i32 %c) {
  entry:
    br i1 undef, label %far, label %near
  near:
    ret void
  far:
    ret void
  }
  define void @destless_jalr_ret() {
    ret void
  }
...
---
name:            complete_retarget
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r6', virtual-reg: '' }
  - { reg: '$r15', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        false
body:             |
  bb.0.entry:
    successors: %bb.2, %bb.1
    liveins: $r1, $r6, $r15
    ; CHECK-LABEL: name: complete_retarget
    ; CHECK: bb.0.entry
    ; CHECK: $r6 = LUI %bb.2
    ; CHECK: $r6 = ADDI32{{.*}}%bb.2
    ; CHECK: BEQZ{{.*}}%bb.1
    ; CHECK: JALR
    $r6 = LUI %bb.1
    $r6 = ADDI32_W $r6, %bb.1
    BNEZ_W $r1, %bb.2
    $r6 = JALR_W $r6, 0

  bb.1.near:
    liveins: $r15
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
