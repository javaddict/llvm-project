# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=postmisched -verify-machineinstrs %s -o - | FileCheck %s

# Role: MIR — SET is not a TII scheduling boundary.

# SET is not a TII scheduling boundary. A bare SET_HWLOOP_W in a preheader
# region with independent ALU must remain schedulable in the same post-RA
# region (may coissue or stay sequential). This lit proves the pipeline does
# not assert/reject when SET is a region SU:
#   - SET form survives postmisched
#   - independent ADD is still present

--- |
  define void @su_set() { ret void }
...
---
name:            su_set
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
body:             |
  ; CHECK-LABEL: name: su_set
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r1, $r2, $r15
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SET_HWLOOP_W_S0 0, %bb.1, %bb.1, 2, implicit-def dead $sfr
  ; CHECK-NEXT:   $r3 = ADD32_E{{[23]}}_E{{[0-2]}}_{{.*}} killed $r1, killed $r2, implicit-def dead $sfr
  ; CHECK-NEXT:   NOP_S0
  ; CHECK-NEXT:   NOP_S0
  ; CHECK-NEXT:   NOP_S0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $r3, $r15
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r1 = COPY killed $r3
  ; CHECK-NEXT:   NOP_S0
  ; CHECK-NEXT:   NOP_S0
  ; CHECK-NEXT:   NOP_S0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $r1, $r15
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r1 = COPY killed $r1
  ; CHECK-NEXT:   RET implicit $r15, implicit killed $r1
  bb.0:
    liveins: $r1, $r2, $r15
    successors: %bb.1

    ; Independent ALU + SET in same MBB (no intervening boundary).
    ; Both are region SUs; ExitSU latency from SET is SetupIssueDistance
    ; (mutation). leaveRegion flushes trailing empties; Fixup residual-pads.
    $r3 = ADD32 $r1, $r2, implicit-def dead $sfr
    SET_HWLOOP_W 0, %bb.1, %bb.1, 2, implicit-def dead $sfr
    NOP
    NOP
    NOP

  bb.1:
    liveins: $r3, $r15
    successors: %bb.2
    $r1 = COPY $r3
    NOP
    NOP
    NOP

  bb.2:
    liveins: $r1, $r15
    $r1 = COPY $r1
    RET implicit killed $r15, implicit $r1

# SET is a region SU and may coissue with independent ALU.
