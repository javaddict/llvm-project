# CB-161 rebaseline (2026-08-21): dropped legacy "implicit-def dead $sfr" operands. Live codegen
# emits none (the every-ALU-writes-SFR modeling is gone), and golden Constraints
# §Registers allows ONE SFR writer per bundle, so a finalize-stamped member pack
# carrying two such operands fails the SFR 1W port law at verify. The bundles were
# illegal under golden all along; the fixtures now mirror real committed MIR.
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-finalize-mi-bundles,haydn-verify-bundles -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=FIN

# Role: MIR — — Fail-closed committed-bundle invariant verifier (opt-in lit).

# B1.4 — Fail-closed committed-bundle invariant verifier (opt-in lit).
#
# AIE peers:
#   AIEBundle.h:150-156 getFormatOrNull
#   AIEHazardRecognizer.cpp:278-312 applyFormatOrdering assert + finalizeBundle
#   AIEBaseInstrInfo.cpp:1440-1459 verifyInstruction fail-closed pattern
#   AIEFinalizeBundle.cpp:40-59 — verify immediately after finalize
#
# haydn-verify-bundles is analysis-only: accepts product BUNDLE + FormatID imm 0
# with legal members; does not rewrite MIR. No MCFlags / no setDesc (BF3).

--- |
  define void @legal_singleton() { ret void }
  define void @legal_multi() { ret void }
  define void @finalize_then_verify() { ret void }
...
---
# Pre-stamped singleton BUNDLE (B1.2 shape) — verifier must accept.
name:            legal_singleton
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r3, $r4

    ; CHECK-LABEL: name: legal_singleton
    ; CHECK: BUNDLE 0
    ; CHECK: ADDI32
    ; CHECK: BUNDLE 0
    ; CHECK: JALR
    BUNDLE 0, 0 {
      $r2 = ADDI32 $r0, 10
    }
    BUNDLE 0, 0 {
      $r0 = JALR $r15, 0, implicit $r15
    }

...
---
# Pre-stamped multi-MI BUNDLE (B1.1 shape) — FormatID + inverse-table pack.
# Member order IS entry order: ADD32@e0/ALU0 then ADDI32@e1/ALU1 (both
# catalog placements under E2; two ALU32s would need the E3 restamp).
name:            legal_multi
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r3, $r4

    ; CHECK-LABEL: name: legal_multi
    ; CHECK: BUNDLE {{[01]}}
    ; CHECK: ADD32
    ; CHECK: ADDI32
    ; CHECK: BUNDLE {{[01]}}
    ; CHECK: JALR
    BUNDLE 0, 0 {
      $r7 = ADD32 killed $r3, killed $r4
      $r2 = ADDI32 $r0, 10
    }
    BUNDLE 0, 0 {
      $r0 = JALR $r15, 0, implicit $r15
    }

...
---
# Bare MIs → finalize stamps FormatID → verify accepts (pipeline peer).
name:            finalize_then_verify
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r3, $r4

    ; FIN-LABEL: name: finalize_then_verify
    ; FIN: BUNDLE {{[01]}}
    ; FIN: ADD32
    ; FIN: ADDI32
    ; FIN: BUNDLE {{[01]}}
    ; FIN: JALR
    $r7 = ADD32 killed $r3, killed $r4
    $r2 = ADDI32 $r0, 10
    $r0 = JALR $r15, 0, implicit $r15

...
