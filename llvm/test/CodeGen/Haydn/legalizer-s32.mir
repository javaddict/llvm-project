---
name:            test_icmp_s32
legalized:       false
# CHECK-LABEL: name: test_icmp_s32
# CHECK: %{{[0-9]+}}:_(s1) = G_ICMP intpred(sgt)
# CHECK: G_SELECT
body:             |
  bb.0.entry:
    liveins: $r0, $r1
    %0:_(s32) = COPY $r0
    %1:_(s32) = COPY $r1
    %2:_(s1) = G_ICMP intpred(sgt), %0(s32), %1(s32)
    %3:_(s32) = G_SELECT %2(s1), %0, %1
    $r0 = COPY %3(s32)
    RET implicit $r0, implicit $r15
...
