    liveins: $r0, $r1
    %0:_(s32) = COPY $r0
    %1:_(s32) = COPY $r1
    %2:_(s32) = G_SUB %0, %1
    $r0 = COPY %2(s32)
    RET implicit $r0, implicit $r15
...

