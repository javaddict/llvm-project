# RUN: llc -mtriple=haydn-unknown-elf -run-pass=legalizer %s -o - | FileCheck %s

# Test that 32-bit integer arithmetic operations are legal
# These should pass through the legalizer unchanged

---
name:            test_add_s32
legalized:       false
# CHECK-LABEL: name: test_add_s32
# CHECK: %{{[0-9]+}}:_(s32) = G_ADD
body:             |
  bb.0.entry:
    liveins: $r0, $r1
    %0:_(s32) = COPY $r0
    %1:_(s32) = COPY $r1
    %2:_(s32) = G_ADD %0, %1
    $r0 = COPY %2(s32)
    RET implicit $r0, implicit $r15
...

---
name:            test_sub_s32
legalized:       false
# CHECK-LABEL: name: test_sub_s32
# CHECK: %{{[0-9]+}}:_(s32) = G_SUB
body:             |
