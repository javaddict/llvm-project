# RUN: llc -mtriple=haydn-unknown-elf -run-pass=branch-relaxation \
# RUN:   -haydn-branch-relax-safety-buffer=0 -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s
# REQUIRES: haydn-registered-target
#
# W68.3R TII surface: BranchRelaxation LAST promotes short B/cond to
# LUI+ADDI32_W+JALR_W and must inherit debug-location; already-long JALR
# sites must not shrink back to B. Forward and backward far sites both
# promote. CFG successors on the trampoline stay valid.

--- |
  define void @fwd_dl(i32 %c) !dbg !4 {
  entry:
    br i1 undef, label %exit, label %pad
  pad:
    br label %exit
  exit:
    ret void
  }
  define void @keep_jalr(i32 %c) {
  entry:
    br label %exit
  pad:
    br label %exit
  exit:
    ret void
  }
  define void @bwd_dl(i32 %c) !dbg !9 {
  entry:
    br label %pad
  pad:
    br i1 undef, label %exit, label %exit
  exit:
    ret void
  }

  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, producer: "llvm", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "w68-3r-branch-preservation.mir", directory: "/tmp")
  !2 = !DISubroutineType(types: !3)
  !3 = !{null}
  !4 = distinct !DISubprogram(name: "fwd_dl", scope: !1, file: !1, line: 1, type: !2, isLocal: false, isDefinition: true, scopeLine: 1, flags: DIFlagPrototyped, isOptimized: true, unit: !0)
  !5 = !DILocation(line: 7, column: 3, scope: !4)
  !6 = !DILocation(line: 11, column: 3, scope: !9)
  !9 = distinct !DISubprogram(name: "bwd_dl", scope: !1, file: !1, line: 9, type: !2, isLocal: false, isDefinition: true, scopeLine: 9, flags: DIFlagPrototyped, isOptimized: true, unit: !0)
  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!7, !8}
  !7 = !{i32 2, !"Dwarf Version", i32 4}
  !8 = !{i32 2, !"Debug Info Version", i32 3}
...
---
name:            fwd_dl
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r15', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        false
body:             |
  bb.0.entry:
    successors: %bb.1, %bb.2
    liveins: $r0, $r15
    ; CHECK-LABEL: name: fwd_dl
    ; CHECK: bb.0.entry
    ; CHECK: JALR{{[^ ]*}} {{.*}}debug-location !DILocation(line: 7
    BEQZ_W $r0, %bb.2, implicit-def dead $sfr, debug-location !5

  bb.1.pad:
    successors: %bb.2
    liveins: $r15
    INLINEASM &".space 2500", 1 /* sideeffect attdialect */

  bb.2.exit:
    liveins: $r15
    RET implicit $r15

...
---
name:            keep_jalr
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r11', virtual-reg: '' }
  - { reg: '$r15', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        false
body:             |
  bb.0.entry:
    successors: %bb.2
    liveins: $r11, $r15
    ; CHECK-LABEL: name: keep_jalr
    ; CHECK: bb.0.entry
    ; CHECK: $r11 = LUI %bb.2
    ; CHECK-NEXT: $r11 = ADDI32_W $r11, %bb.2
    ; CHECK-NEXT: $r11 = JALR_W $r11, 0
    ; CHECK-NOT: B %bb.2
    $r11 = LUI %bb.2
    $r11 = ADDI32_W $r11, %bb.2
    $r11 = JALR_W $r11, 0

  bb.1.pad:
    successors: %bb.2
    liveins: $r15
    INLINEASM &".space 2500", 1 /* sideeffect attdialect */

  bb.2.exit:
    liveins: $r15
    RET implicit $r15

...
---
name:            bwd_dl
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r15', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        false
body:             |
  bb.0.entry:
    successors: %bb.1
    liveins: $r0, $r15
    ; CHECK-LABEL: name: bwd_dl
    B %bb.1

  bb.1.pad:
    successors: %bb.0, %bb.2
    liveins: $r0, $r15
    INLINEASM &".space 2500", 1 /* sideeffect attdialect */
    ; CHECK: JALR{{[^ ]*}} {{.*}}debug-location !DILocation(line: 11
    BEQZ_W $r0, %bb.0, implicit-def dead $sfr, debug-location !6

  bb.2.exit:
    liveins: $r15
    RET implicit $r15

...
