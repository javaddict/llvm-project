# RUN: llc -mtriple=haydn-unknown-elf -run-pass=branch-relaxation \
# RUN:   -haydn-branch-relax-safety-buffer=0 %s -o - | FileCheck %s

# Role: MIR — T-TII4 seed-3434-shape branch-size model at buffer=0.
#
# REGRESSION TEST: getInstSizeInBytes must charge named late-layout growth
# for SET_HWLOOP* (InterveningCycles parcels of Fixup setup/align pads).
# Generic BranchRelaxation only sums that hook (AIE1InstrInfo.cpp:646-651
# getSize; HexagonBranchRelaxation.cpp:95-114 computeOffset peer). The
# 1024-byte BranchRelaxSafetyBuffer used to hide this undercount.
#
# Shape: lone BEQZ_W to exit; pad block is INLINEASM .space 2012 plus
# SET_HWLOOP_W. WIDE_BranchSImm12 is GE96-03 signed 12-bit byte PC+imm
# (±2048). At buffer=0:
#   pre-fix (SET = 12 B):  12 + 2012 + 12 = 2036  → in range
#   post-fix (SET = 36 B): 12 + 2012 + 36 = 2060  → must relax
# FileCheck for JALR fails at buffer=0 before the size-model charge.
#
# Do not run haydn-verify-bundles here: SET_HWLOOP_W is a size-oracle
# stand-in, not a finalized product cycle.

--- |
  define void @seed3434_shape(i32 %c) {
  entry:
    br i1 undef, label %exit, label %pad
  pad:
    br label %exit
  exit:
    ret void
  }
...
---
name:            seed3434_shape
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r15', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        false
body:             |
  bb.0.entry:
    successors: %bb.1, %bb.2
    liveins: $r0, $r15
    ; CHECK-LABEL: name: seed3434_shape
    ; CHECK: bb.0.entry
    ; Named SET growth pushes the cond out of WIDE_BranchSImm12 at buffer=0.
    ; CHECK: JALR
    BEQZ_W $r0, %bb.2, implicit-def dead $sfr

  bb.1.pad:
    successors: %bb.2
    liveins: $r15
    INLINEASM &".space 2012", 1 /* sideeffect attdialect */
    SET_HWLOOP_W 0, %bb.1, %bb.1, 8, implicit-def dead $sfr

  bb.2.exit:
    liveins: $r15
    ; CHECK: bb.2.exit
    ; CHECK: RET
    RET implicit $r15

...
