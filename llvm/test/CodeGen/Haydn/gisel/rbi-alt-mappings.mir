# REQUIRES: asserts
# RUN: llc -mtriple=haydn-unknown-elf -global-isel-abort=1 \
# RUN:     -run-pass=regbankselect -regbankselect-greedy \
# RUN:     -debug-only=haydn-regbankinfo,regbankselect \
# RUN:     -verify-machineinstrs %s -o - 2>&1 | FileCheck %s
#
# Role: MIR — no PTR-vs-GPR alternatives (Haydn has no PTR bank).
# Identity G_OR is a Cost=0 same-bank copy (greedy); G_ADD stays Cost 1.

# CHECK: HaydnRBI copyCost table: same-GPR=0 same-DR=0 GPR-DR=8 DR-GPR=8
# CHECK: Evaluating mapping cost for: {{.*}}G_ADD
# CHECK-NEXT: With: ID: 4294967295 Cost: 1
# CHECK: Best Mapping: ID: 4294967295 Cost: 1 {{.*}}GPR32RegBank
# CHECK: Evaluating mapping cost for: {{.*}}G_OR
# CHECK: With: ID: 1 Cost: 0
# CHECK: Best Mapping: ID: 1 Cost: 0
# CHECK: name: add_s32
# CHECK: %{{[0-9]+}}:gpr32regbank(s32) = G_ADD
# CHECK: name: or_identity_s64
# CHECK: %{{[0-9]+}}:dr64regbank(s64) = G_OR

---
name:            add_s32
legalized:       true
regBankSelected: false
body:             |
  bb.0.entry:
    liveins: $r1, $r2
    %0:_(s32) = COPY $r1
    %1:_(s32) = COPY $r2
    %2:_(s32) = G_ADD %0, %1
    $r1 = COPY %2(s32)
    RET implicit $r1, implicit $r15
...

---
name:            or_identity_s64
legalized:       true
regBankSelected: false
body:             |
  bb.0.entry:
    liveins: $d0
    %0:_(s64) = COPY $d0
    %1:_(s64) = G_OR %0, %0
    $d0 = COPY %1(s64)
    RET implicit $d0, implicit $r15
...
