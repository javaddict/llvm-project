# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postrapseudos \
# RUN:     -verify-machineinstrs %s -o - | FileCheck %s
#
# Role: MIR — LOADI64 emitConst32 seeds Cur=R0. A dirty R0 at expansion
# must be restored (XOR32 r0,r0,r0) before the seed is read. Same local
# cleanliness rule as withDR64PackBase / LOADI32 / LOAD_ADDR.
#
# Imm 42 is hi==0 (register-only half), so the pack slot is not required.

--- |
  define i64 @loadi64_dirty_r0() { ret i64 0 }
...
---
name:            loadi64_dirty_r0
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r15
    $r0 = ADDI32_W $r1, 1
    $d0 = LOADI64 42
    RET implicit $r15
...
# CHECK-LABEL: name: loadi64_dirty_r0
# CHECK: $r0 = ADDI32_W $r1, 1
# CHECK-NEXT: $r0 = XOR32 $r0, $r0
# CHECK-NOT: LOADI64
