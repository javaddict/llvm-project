    ; COMBINE-NOT: G_OR
    ; ISEL-LABEL: name: pair_pack_align4
    ; ISEL-NOT: LD64
    ; ISEL: LD32
    ; ISEL: LD32
    ; ISEL: MOV_GPR_TO_DR64
    ; ISEL-NOT: LD64
...

---
name:            pair_pack_align4_off4
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1
    %base:_(p0) = COPY $r1
    %c4:_(s32) = G_CONSTANT i32 4
    %c8:_(s32) = G_CONSTANT i32 8
    %c32:_(s32) = G_CONSTANT i32 32
    %plo:_(p0) = G_PTR_ADD %base, %c4(s32)
    %phi:_(p0) = G_PTR_ADD %base, %c8(s32)
    %lo:_(s32) = G_LOAD %plo(p0) :: (load (s32), align 4)
    %hi:_(s32) = G_LOAD %phi(p0) :: (load (s32), align 4)
    %lo64:_(s64) = G_ZEXT %lo(s32)
    %hi64:_(s64) = G_ZEXT %hi(s32)
    %his:_(s64) = G_SHL %hi64, %c32(s32)
    %d:_(s64) = G_OR %his, %lo64
    $d0 = COPY %d(s64)
    RET implicit $r15, implicit $d0
    ; COMBINE-LABEL: name: pair_pack_align4_off4
    ; COMBINE: G_LOAD {{.*}}(s64){{.*}}align 4
    ; COMBINE-NOT: G_OR
    ; ISEL-LABEL: name: pair_pack_align4_off4
    ; ISEL-NOT: LD64
    ; ISEL: LD32
    ; ISEL: LD32
    ; ISEL: MOV_GPR_TO_DR64
    ; ISEL-NOT: LD64
...

---
name:            pair_underaligned_2_no_combine
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1
    %base:_(p0) = COPY $r1
    %c8:_(s32) = G_CONSTANT i32 8
    %c12:_(s32) = G_CONSTANT i32 12
    %c32:_(s32) = G_CONSTANT i32 32
    %plo:_(p0) = G_PTR_ADD %base, %c8(s32)
    %phi:_(p0) = G_PTR_ADD %base, %c12(s32)
    %lo:_(s32) = G_LOAD %plo(p0) :: (load (s32), align 2)
    %hi:_(s32) = G_LOAD %phi(p0) :: (load (s32), align 2)
    %lo64:_(s64) = G_ZEXT %lo(s32)
    %hi64:_(s64) = G_ZEXT %hi(s32)
    %his:_(s64) = G_SHL %hi64, %c32(s32)
    %d:_(s64) = G_OR %his, %lo64
    $d0 = COPY %d(s64)
    RET implicit $r15, implicit $d0
    ; COMBINE-LABEL: name: pair_underaligned_2_no_combine
    ; COMBINE: G_OR
    ; COMBINE-NOT: {{(G_LOAD|G_HAYDN_.*INC_LOAD).*\(s64\)}}
    ; Align-2 G_LOAD is illegal at ISEL; not an ISEL pin.
...
