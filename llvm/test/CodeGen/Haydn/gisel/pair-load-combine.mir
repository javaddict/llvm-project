# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-postlegalizer-combiner \
# RUN:     -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=COMBINE
# RUN: llc -mtriple=haydn-unknown-elf \
# RUN:     -run-pass=haydn-postlegalizer-combiner,regbankselect,instruction-select \
# RUN:     -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=ISEL
#
# Role: MIR — the combiner layer of DR64 pair-load promotion (bkfir report
# §7 ask #3): the software-pack idiom becomes ONE wide s64 load; the
# existing AGU rule (same pass) then folds the address into the
# G_HAYDN_PREINC_LOAD shape, and selection emits the golden D_LDW_PRE_IMM
# pair load (imm 1 = 8 bytes).
#
# REGRESSION TEST: pins form_pair_load's contract at its own layer,
# independent of IR-level canonicalization luck:
#   At the combiner layer the two G_LOAD (s32) + G_ZEXT/G_SEXT/G_SHL/G_OR
#            pack collapses to ONE s64 memory access (the AGU rule of the
#            same pass folds the offset G_PTR_ADD, so the shape is the
#            G_HAYDN_PREINC_LOAD spelling); no G_OR survives.
#   At select: D_LDW_PRE_IMM (golden pair-load family), never an LD32 pair.
# Negative bodies: non-adjacent (gap 8) and aliasing-store forms must keep
# the scalar G_OR pack + LD32 pair. If a negative body ever produces an s64
# access, the matcher is unsound — fix the closed condition, not this CHECK.

---
name:            pair_pack_off8
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1
    %base:_(p0) = COPY $r1
    %c8:_(s32) = G_CONSTANT i32 8
    %c12:_(s32) = G_CONSTANT i32 12
    %c32:_(s32) = G_CONSTANT i32 32
    %plo:_(p0) = G_PTR_ADD %base, %c8(s32)
    %phi:_(p0) = G_PTR_ADD %base, %c12(s32)
    %lo:_(s32) = G_LOAD %plo(p0) :: (load (s32), align 8)
    %hi:_(s32) = G_LOAD %phi(p0) :: (load (s32), align 8)
    %lo64:_(s64) = G_ZEXT %lo(s32)
    %hi64:_(s64) = G_ZEXT %hi(s32)
    %his:_(s64) = G_SHL %hi64, %c32(s32)
    %d:_(s64) = G_OR %his, %lo64
    $d0 = COPY %d(s64)
    RET implicit $r15, implicit $d0
    ; COMBINE-LABEL: name: pair_pack_off8
    ; COMBINE: G_HAYDN_PREINC_LOAD {{.*}}(s64)
    ; COMBINE-NOT: G_OR
    ; COMBINE-NOT: G_SHL
    ; COMBINE-NOT: G_ZEXT
    ; ISEL-LABEL: name: pair_pack_off8
    ; ISEL: D_LDW_PRE_IMM {{.*}}, 1
    ; ISEL-NOT: LD32
...

---
name:            pair_pack_sext_hi
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1
    %base:_(p0) = COPY $r1
    %c8:_(s32) = G_CONSTANT i32 8
    %c12:_(s32) = G_CONSTANT i32 12
    %c32:_(s32) = G_CONSTANT i32 32
    %plo:_(p0) = G_PTR_ADD %base, %c8(s32)
    %phi:_(p0) = G_PTR_ADD %base, %c12(s32)
    %lo:_(s32) = G_LOAD %plo(p0) :: (load (s32), align 8)
    %hi:_(s32) = G_LOAD %phi(p0) :: (load (s32), align 8)
    %lo64:_(s64) = G_ZEXT %lo(s32)
    %hi64:_(s64) = G_SEXT %hi(s32)
    %his:_(s64) = G_SHL %hi64, %c32(s32)
    %d:_(s64) = G_OR %his, %lo64
    $d0 = COPY %d(s64)
    RET implicit $r15, implicit $d0
    ; COMBINE-LABEL: name: pair_pack_sext_hi
    ; COMBINE: G_HAYDN_PREINC_LOAD {{.*}}(s64)
    ; COMBINE-NOT: G_OR
    ; ISEL-LABEL: name: pair_pack_sext_hi
    ; ISEL: D_LDW_PRE_IMM {{.*}}, 1
    ; ISEL-NOT: LD32
...

---
name:            pair_gap8_no_combine
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1
    %base:_(p0) = COPY $r1
    %c8:_(s32) = G_CONSTANT i32 8
    %c16:_(s32) = G_CONSTANT i32 16
    %c32:_(s32) = G_CONSTANT i32 32
    %plo:_(p0) = G_PTR_ADD %base, %c8(s32)
    %phi:_(p0) = G_PTR_ADD %base, %c16(s32)
    %lo:_(s32) = G_LOAD %plo(p0) :: (load (s32), align 8)
    %hi:_(s32) = G_LOAD %phi(p0) :: (load (s32), align 8)
    %lo64:_(s64) = G_ZEXT %lo(s32)
    %hi64:_(s64) = G_ZEXT %hi(s32)
    %his:_(s64) = G_SHL %hi64, %c32(s32)
    %d:_(s64) = G_OR %his, %lo64
    $d0 = COPY %d(s64)
    RET implicit $r15, implicit $d0
    ; COMBINE-LABEL: name: pair_gap8_no_combine
    ; COMBINE: G_OR
    ; COMBINE-NOT: {{(G_LOAD|G_HAYDN_.*INC_LOAD).*\(s64\)}}
    ; ISEL-LABEL: name: pair_gap8_no_combine
    ; ISEL: LD32
    ; ISEL: LD32
...

---
name:            pair_aliasing_store_no_combine
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1
    %base:_(p0) = COPY $r1
    %c8:_(s32) = G_CONSTANT i32 8
    %c12:_(s32) = G_CONSTANT i32 12
    %c32:_(s32) = G_CONSTANT i32 32
    %plo:_(p0) = G_PTR_ADD %base, %c8(s32)
    %phi:_(p0) = G_PTR_ADD %base, %c12(s32)
    %lo:_(s32) = G_LOAD %plo(p0) :: (load (s32), align 8)
    G_STORE %lo(s32), %phi(p0) :: (store (s32), align 8)
    %hi:_(s32) = G_LOAD %phi(p0) :: (load (s32), align 8)
    %lo64:_(s64) = G_ZEXT %lo(s32)
    %hi64:_(s64) = G_ZEXT %hi(s32)
    %his:_(s64) = G_SHL %hi64, %c32(s32)
    %d:_(s64) = G_OR %his, %lo64
    $d0 = COPY %d(s64)
    RET implicit $r15, implicit $d0
    ; COMBINE-LABEL: name: pair_aliasing_store_no_combine
    ; COMBINE: G_STORE
    ; COMBINE: G_OR
    ; COMBINE-NOT: {{(G_LOAD|G_HAYDN_.*INC_LOAD).*\(s64\)}}
    ; ISEL-LABEL: name: pair_aliasing_store_no_combine
    ; ISEL: LD32
    ; ISEL: LD32
...
