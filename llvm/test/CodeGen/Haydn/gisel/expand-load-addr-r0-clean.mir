# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-expand-pseudos \
# RUN:     -verify-machineinstrs %s -o - | FileCheck %s
#
# Role: MIR — LOAD_ADDR MatInt/LUI seeds Cur=R0. A dirty R0 at the
# expansion point must be restored (XOR32 r0,r0,r0) before the seed is
# read. Same local cleanliness rule as withDR64PackBase.
#
# If the restore is dropped, CHECK-NOT loses and the subsequent LUI/ADDI
# chain reads a non-zero R0 (wrong address).

--- |
  define i32 @load_addr_dirty_r0() { ret i32 0 }
...
---
name:            load_addr_dirty_r0
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r15
    ; Dirty R0 (not XOR r0,r0,r0).
    $r0 = ADDI32_W $r1, 1
    $r2 = LOAD_ADDR @load_addr_dirty_r0
    RET implicit $r15
...
# CHECK-LABEL: name: load_addr_dirty_r0
# CHECK: $r0 = ADDI32_W $r1, 1
# CHECK-NEXT: $r0 = XOR32 $r0, $r0
# CHECK: LUI
# CHECK-NOT: LOAD_ADDR
