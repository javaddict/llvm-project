# D1.49: stored successor liveins when nonempty, computed walk only when
# empty. Walking the successor body unions OTHER predecessors' live-ins
# through that block's addLiveOuts — a backedge to the site then occupies
# every loop-carried GPR (bkfir32x16_process bb.3). Stored liveins of the
# far successor omit $r5; the computed walk would pull $r5 from bb.0's
# liveins via the backedge. Hybrid picks $r5.
#
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-longbranch-normalize -haydn-branch-relax-safety-buffer=4 -verify-machineinstrs %s -o - | FileCheck %s
# REQUIRES: haydn-registered-target

--- |
  define dso_local void @backedge() {
  entry:
    br label %latch
  latch:
    br i1 undef, label %far, label %near
  near:
    br label %far
  far:
    br label %latch
  }
...
---
name:            backedge
alignment:       1
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    successors: %bb.1
    B %bb.1

  bb.1.latch:
    liveins: $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r12, $r15
    successors: %bb.2, %bb.3
    BEQZ_W $r1, %bb.3, implicit-def dead $sfr
    B %bb.2

  bb.2.near:
    successors: %bb.3
    liveins: $r15
    $d0 = LOADI64 1
    $d0 = LOADI64 1
    $d0 = LOADI64 1
    $d0 = LOADI64 1
    $d0 = LOADI64 1
    $d0 = LOADI64 1
    $d0 = LOADI64 1
    $d0 = LOADI64 1
    $d0 = LOADI64 1
    $d0 = LOADI64 1
    $d0 = LOADI64 1
    $d0 = LOADI64 1
    $d0 = LOADI64 1
    $d0 = LOADI64 1
    $d0 = LOADI64 1
    $d0 = LOADI64 1

  bb.3.far:
    successors: %bb.1
    liveins: $r2, $r3, $r6, $r7, $r12, $r15
    ST32 $r2, $r2, 0, implicit-def dead $sfr
    ST32 $r3, $r3, 0, implicit-def dead $sfr
    ST32 $r6, $r6, 0, implicit-def dead $sfr
    ST32 $r7, $r7, 0, implicit-def dead $sfr
    ST32 $r12, $r12, 0, implicit-def dead $sfr
    B %bb.1

# CHECK-LABEL: name: backedge
# CHECK-NOT: $r1 = LUI
# CHECK-NOT: $r4 = LUI
# CHECK: $r5 = LUI
# CHECK: JALR_W $r5
