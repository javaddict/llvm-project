# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postmisched -verify-machineinstrs %s -o - | FileCheck %s

# Role: MIR — VLIW packetizer MUST reject WAW (write-after-write) hazards.


# REBASELINED : / pipeline reorder (ExpandPseudos/BitSimplify pre-scheduler + materialize at leaveRegion) — bundles regrouped, ops unchanged.
# REBASELINED : / FLEX cutover — test4 control (different-dest ADD32 pair) now bundles (S0+S1); test1/test2 WAW GPR pairs and test3 LD32_POST WAW stay un-bundled (regression intent preserved).
#
# REGRESSION TEST: VLIW packetizer MUST reject WAW (write-after-write) hazards.
#
# Bug : two instructions writing the SAME destination register were
# allowed into the same VLIW bundle. In a VLIW bundle all members issue in
# parallel, so two writes to one register produce an undefined result
# (hardware picks one writer) — silent wrong-code.
#
# Root cause: HaydnVLIWPacketizer::hasWAWHazard skipped dead defs on BOTH the
# candidate and the member side (`if (MO.isDead) continue;`) and used exact
# register equality (`Reg1 == Reg2`) instead of alias-aware overlap. The
# dead-def skip was the primary leak: a dead-def candidate writing R1 plus a
# live member writing R1 clobbered the live value.
#
# Fix : rewrite hasWAWHazard to use MachineInstr::modifiesRegister(Reg
# HRI) — alias-aware (TRI->regsOverlap), scans ALL defs (explicit + implicit +
# tied writeback $rs_wb), and does NOT skip dead defs. SFR stays excluded
# (slot-ordered, architecturally safe parallel writes).
#
# This test is structured so that if hasWAWHazard regresses to the old buggy
# form, the two writes land in ONE BUNDLE and a CHECK-NOT: BUNDLE line fails.
# The instructions in each WAW pair are otherwise independent (no RAW, no
# memory alias), so WITHOUT the WAW fix the packetizer WOULD bundle them
# that is exactly the wrong-code condition being prevented.
#
# Note: the base VLIWPacketizerList only emits a BUNDLE instruction for
# multi-instruction packets (size > 1); a rejected (sequential) pair shows up
# as two un-bundled instructions. So "no BUNDLE" between the pair == the WAW
# was correctly detected and they were forced sequential.

--- |
  define void @test1_waw_same_dest_no_bundle() { ret void }
  define void @test2_waw_dead_def_clobber_no_bundle() { ret void }
  define void @test3_waw_postinc_data_dest_no_bundle() { ret void }
  define void @test4_independent_diff_dest_can_bundle() { ret void }
...
---
# ============================================================================
# Test 1: classic WAW — two ADD32 to the SAME dest, no RAW, must NOT bundle.
# ============================================================================
#
# $r2 = ADD32 $r0, $r1; def $r2
# $r2 = ADD32 $r3, $r4; def $r2 again -- WAW (no RAW: $r3,$r4 != $r2)
#
# Both are ALU32 (any-slot), 4R2W ports fit (2R2W total), DFA has free slots.
# Without the WAW fix these bundle into one 3-slot packet and one ADD's result
# is lost. The packetizer MUST force them sequential (no BUNDLE).
#
name:            test1_waw_same_dest_no_bundle
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $r3, $r4

    ; First WAW member — must stand alone, no BUNDLE wraps it together with the
    ; next ADD32.
    ; CHECK-LABEL: name: test1_waw_same_dest_no_bundle
    ; CHECK: liveins: $r0, $r1, $r3, $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2 = ADD32_E{{[23]}}_E{{[0-2]}}_{{.*}} $r0, killed $r1, implicit-def dead $sfr
    ; CHECK-NEXT: $r2 = ADD32_E{{[23]}}_E{{[0-2]}}_{{.*}} killed $r3, killed $r4, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY killed $r2
    ; CHECK-NEXT: $r0 = JALR{{(_E2_E0_ALU0_RI12)?}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    $r2 = ADD32 $r3, $r4, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 2: WAW via DEAD def — the primary leak from.
# ============================================================================
#
# $r2 = ADD32 $r0, $r1; def $r2 (first write)
# $r2 = ADD32 $r3, $r4; def $r2 again -- WAW (no RAW: $r3,$r4 != $r2)
#
# Note (amendment / pitfall): an EARLIER draft of this test marked the
# second ADD32 `dead`, intending to exercise the dead-def branch of the old
# hasWAWHazard. But that made the MIR self-inconsistent: `$r0 = COPY $r2` at the
# end reads $r2, so $r2 cannot be dead after the second ADD32 -- the verifier
# rejects "Using an undefined physical register" at parse time, before the
# packetizer even runs. The WAW (two writes to $r2) is still real with both defs
# live, and the trailing COPY keeps $r2 observable, so the WAW-hazard CHECK
# (no BUNDLE between the pair) still holds. The hasWAWHazard fix is correct;
# only this test's MIR was self-inconsistent.
#
name:            test2_waw_dead_def_clobber_no_bundle
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $r3, $r4

    ; CHECK-LABEL: name: test2_waw_dead_def_clobber_no_bundle
    ; CHECK: liveins: $r0, $r1, $r3, $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2 = ADD32_E{{[23]}}_E{{[0-2]}}_{{.*}} $r0, killed $r1, implicit-def dead $sfr
    ; CHECK-NEXT: $r2 = ADD32_E{{[23]}}_E{{[0-2]}}_{{.*}} killed $r3, killed $r4, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY killed $r2
    ; CHECK-NEXT: $r0 = JALR{{(_E2_E0_ALU0_RI12)?}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    $r2 = ADD32 $r3, $r4, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 3: WAW on the 2-def fused post-increment load's data dest ($rt).
# ============================================================================
#
# Two LD32_POST (fused post-inc loads,) that write the SAME data dest $r2
# but load from DIFFERENT base registers ($r5 vs $r6), so their memory accesses
# do not alias. The only hazard is the WAW on the shared $rt=$r2 def.
#
# LD32_POST has outs (GPR32:$rt, GPR32:$rs_wb) — two defs. The fix must see
# BOTH defs: $rt (data) and $rs_wb (tied base writeback). This case WAWs on
# $rt; $rs_wb differs ($r5_wb vs $r6_wb), so the conflict is solely on $rt.
# The old equality check (`Reg1 == Reg2`) happened to catch this specific case
# but the dead-def skip would have missed it if either $rt def were dead. The
# modifiesRegister-based fix covers all def kinds uniformly.
#
# This pair MUST NOT bundle (WAW on $r2). If the WAW machinery regresses, the
# two loads would packetize (different memory, different bases, slots free) and
# one loaded value would be lost.
#
name:            test3_waw_postinc_data_dest_no_bundle
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r5', virtual-reg: '' }
  - { reg: '$r6', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r5, $r6

    ; CHECK-LABEL: name: test3_waw_postinc_data_dest_no_bundle
    ; CHECK: liveins: $r5, $r6
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2, $r5 = S_LW_POST_IMM{{.*}} killed $r5, 1
    ; CHECK-NEXT: $r2, $r6 = S_LW_POST_IMM{{.*}} killed $r6, 1
    ; CHECK-NEXT: $r0 = COPY killed $r2
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: $r0 = JALR{{(_E2_E0_ALU0_RI12)?}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2, $r5 = LD32_POST $r5, 1
    $r2, $r6 = LD32_POST $r6, 1

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 4 (CONTROL): independent writes to DIFFERENT dests CAN bundle.
# ============================================================================
#
# $r2 = ADD32 $r0, $r1; def $r2
# $r7 = ADD32 $r3, $r4; def $r7 (different reg)
#
# No RAW, no WAW, no memory, ports fit (2R2W), slots free. These SHOULD bundle.
# This guards against the WAW fix over-rejecting (e.g. treating every pair as a
# hazard). A BUNDLE must appear.
#
name:            test4_independent_diff_dest_can_bundle
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $r3, $r4

    ; The two independent ADD32 should be wrapped in ONE BUNDLE.
    ; CHECK-LABEL: name: test4_independent_diff_dest_can_bundle
    ; CHECK: liveins: $r0, $r1, $r3, $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2 = ADD32_E{{[23]}}_E{{[0-2]}}_{{.*}} $r0, killed $r1, implicit-def dead $sfr
    ; CHECK-NEXT: $r7 = ADD32_E{{[23]}}_E{{[0-2]}}_{{.*}} killed $r3, killed $r4, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY killed $r2
    ; CHECK-NEXT: $r0 = JALR{{(_E2_E0_ALU0_RI12)?}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    $r7 = ADD32 $r3, $r4, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
