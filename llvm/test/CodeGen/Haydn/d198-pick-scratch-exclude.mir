# D1.98: rewriteBothFarCondOntoJalr scratches go through pickInBlockScratch
# with Exclude. Pristine CSRs (unused R8-R11/R14) and tail-overlap registers
# are refused; the forked take() used to smash them.
#
# Both-far overlay (d164-lbn): 180 NOP parcels in bb.1 put TBB %bb.2 and
# already-long FBB %bb.3 past WIDE_BranchSImm12 (buffer=4).
#
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-longbranch-normalize \
# RUN:   -haydn-branch-relax-safety-buffer=4 -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s
# REQUIRES: haydn-registered-target

--- |
  define void @pristine_csr_skip(i32 %c) {
  entry:
    br i1 undef, label %tbb, label %fbb
  pad:
    ret void
  tbb:
    ret void
  fbb:
    ret void
  }
  define void @tail_overlap_skip(i32 %c) {
  entry:
    br i1 undef, label %tbb, label %fbb
  pad:
    ret void
  tbb:
    ret void
  fbb:
    ret void
  }
...
---
name:            pristine_csr_skip
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r6', virtual-reg: '' }
  - { reg: '$r15', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        false
body:             |
  bb.0.entry:
    successors: %bb.2, %bb.3
    liveins: $r1, $r6, $r15
    ; CHECK-LABEL: name: pristine_csr_skip
    ; CHECK: bb.0.entry
    ; CHECK-NOT: $r11 = LUI
    ; CHECK-NOT: $r10 = LUI
    ; CHECK-NOT: $r9 = LUI
    ; CHECK-NOT: $r8 = LUI
    ; CHECK-NOT: $r14 = LUI
    ; CHECK: $r7 = LUI
    ; CHECK: $r7 = ADDI32
    ; CHECK: $r5 = XOR32
    ; CHECK: SEQ32
    ; CHECK: MOVF32
    ; CHECK: JALR
    $r6 = LUI %bb.3
    $r6 = ADDI32_W $r6, %bb.3
    BNEZ_W $r1, %bb.2
    $r6 = JALR_W $r6, 0

  bb.1.pad:
    liveins: $r15
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
