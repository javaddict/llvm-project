---
name:            tail_overlap_skip
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r6', virtual-reg: '' }
  - { reg: '$r11', virtual-reg: '' }
  - { reg: '$r15', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        false
body:             |
  bb.0.entry:
    successors: %bb.2, %bb.3
    liveins: $r1, $r6, $r11, $r15
    ; CHECK-LABEL: name: tail_overlap_skip
    ; CHECK: bb.0.entry
    ; CHECK-NOT: $r11 = LUI
    ; CHECK: $r7 = LUI
    ; CHECK: $r7 = ADDI32
    ; CHECK: $r5 = XOR32
    ; CHECK: JALR
    $r6 = LUI %bb.3
    $r6 = ADDI32_W $r6, %bb.3
    BNEZ_W $r1, %bb.2, implicit killed $r11
    $r6 = JALR_W $r6, 0

  bb.1.pad:
