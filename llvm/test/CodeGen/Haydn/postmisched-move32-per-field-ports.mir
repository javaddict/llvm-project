# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postmisched -verify-machineinstrs %s -o - | FileCheck %s
# REQUIRES: haydn-registered-target
#
# Role: MIR — MOVE32 rd,rs is 1R1W (logical dest+src; W68.0b dropped the
# duplicated second source). Two MOVE32 plus one independent GPR-reading
# store is 4R2W: at cap, port-admissible, so the port cap alone no longer
# forbids the 3-wide. The binding constraint for a store reading a MOVE32
# destination is the no-forwarding RAW law (see
# postra-move32-per-field-ports.mir). Peer: AIE
# AIEHazardRecognizer.cpp:181-222 books itinerary resources with no
# operand-identity dedup; HexagonVLIWPacketizer.cpp walks operands
# per field.

--- |
  define void @two_move32_store_not_three_wide() { ret void }
  define void @two_move32_still_dual() { ret void }
...
---
name:            two_move32_store_not_three_wide
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
  - { reg: '$r5', virtual-reg: '' }
  - { reg: '$r6', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r1, $r2, $r5, $r6

    ; CHECK-LABEL: name: two_move32_store_not_three_wide
    ; Per-field: each logical MOVE32 is 1R1W. Two plus ST32 (2R) is 4R2W
    ; — port-admissible at cap. The greedy packer still forms a 2-wide
    ; here; nothing packs all three in one BUNDLE today.
    ; CHECK-NOT: BUNDLE{{.*}}MOVE32{{.*}}MOVE32{{.*}}{{ST32|S_SW}}
    ; CHECK: MOVE32
    ; CHECK: MOVE32
    ; CHECK: {{ST32|S_SW}}
    $r3 = MOVE32 $r1
    $r4 = MOVE32 $r2
    ST32 $r5, $r6, 0
    $r0 = COPY $r3
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
name:            two_move32_still_dual
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r1, $r2

    ; CHECK-LABEL: name: two_move32_still_dual
    ; Two MOVE32 are 2R2W — one legal cycle with headroom.
    ; CHECK: BUNDLE
    ; CHECK-DAG: $r3 = MOVE32
    ; CHECK-DAG: $r4 = MOVE32
    ; CHECK: }
    $r3 = MOVE32 $r1
    $r4 = MOVE32 $r2
    $r0 = COPY $r3
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
