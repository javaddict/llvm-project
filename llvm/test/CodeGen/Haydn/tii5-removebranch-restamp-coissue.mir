# RUN: llc -mtriple=haydn-unknown-elf \
# RUN:   -run-pass=haydn-longbranch-normalize,branch-relaxation,haydn-finalize-mi-bundles,haydn-verify-bundles \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# Role: MIR — T-TII5 selected-member restamp. A coissued ALU sibling must
# survive strip of the selected branch (HaydnInstrInfo::eraseSelectedBranch;
# HaydnHWLoopDemote.cpp:742-773 eraseSetMemberAndRecommitSiblings peer).
# Generic removeBranch still reverse-walks the trailing analyzable tail
# (AIEBaseInstrInfo.cpp:237-266; HexagonInstrInfo.cpp:605-625;
# RISCVInstrInfo.cpp:1361-1390) — do not narrow that walk.
#
# REGRESSION: stripping a BUNDLE{ADD32, branch} child used to leave the
# root's pre-strip FormatID/CompletionStateID. Finalize skips already-
# bundled roots, so MC serialized the stale two-entry identity. The helper
# re-solves survivors like recommitSurvivingCycleMembers.
#
# coissue_far_strip: far cond in BUNDLE{ADD32, BEQZ_W}. ALU survives; the
# selected cond is gone from the coissue (invert/long-form, not leftover
# short BEQZ). Far ADD32-parcel pad (420 x 12B) forces the rewrite (the
# prior `.space` INLINEASM pad is rejected by the inline-asm admission
# law).
#
# coissue_far_uncond_preceding: two preceding conds + BUNDLE{ADD32, B}.
# Only the selected uncond member is replaced; ADD32 and both BEQZ
# survive. Broad removeBranch would erase the preceding conds.

--- |
  define void @coissue_far_strip(i1 %c) {
  entry:
    br i1 %c, label %exit, label %pad
  pad:
    br label %exit
  exit:
    ret void
  }
  define void @coissue_far_uncond_preceding(i1 %c) {
  entry:
    br i1 %c, label %near, label %far
  near:
    br label %far
  far:
    ret void
  }
...
---
name:            coissue_far_strip
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
  - { reg: '$r15', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        false
body:             |
  bb.0.entry:
    successors: %bb.1, %bb.2
    liveins: $r0, $r1, $r2, $r15
    ; CHECK-LABEL: name: coissue_far_strip
    ; CHECK: bb.0.entry
    ; ALU sibling survives in bb.0 (not the pad ADD32); selected cond is
    ; gone from the coissue; no leftover short uncond beside JALR.
    ; Surviving ADD32 is not an SFR writer — header implicit-def dead $sfr
    ; from the neutralized BEQZ is dropped.
    ; CHECK-NOT: BUNDLE{{.*}}$sfr
    ; CHECK: $r3 = ADD32
    ; CHECK-NOT: BEQZ_W
    ; CHECK-NOT: B %bb.1
    ; CHECK: JALR
    ; CHECK-NOT: B %bb.1
    ; CHECK: bb.1.pad
    BUNDLE 0, 0, implicit-def $r3, implicit $r0, implicit $r1, implicit $r2 {
      $r3 = ADD32 $r1, $r2
      BEQZ_W $r0, %bb.2, implicit-def dead $sfr
    }
    BUNDLE 0 {
      B %bb.1
    }

  bb.1.pad:
    successors: %bb.2
    liveins: $r15
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
