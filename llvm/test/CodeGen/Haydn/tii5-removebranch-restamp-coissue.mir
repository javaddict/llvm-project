# RUN: llc -mtriple=haydn-unknown-elf \
# RUN:   -run-pass=haydn-longbranch-normalize,branch-relaxation,haydn-finalize-mi-bundles,haydn-verify-bundles \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# Role: MIR — T-TII5 PreEmit relaxation strips a coissued branch and the
# surviving ALU must be re-stamped (or verify fail-closes).
#
# REGRESSION TEST: removeBranch on BUNDLE{ADD32, BEQZ_W} used to erase only
# the branch child and leave the root's pre-strip FormatID/CompletionStateID.
# HaydnFinalizeBundle skips already-bundled roots, so MC would serialize the
# stale two-entry identity. Fix: removeBranch re-solves like
# HaydnFixupHwLoops.cpp:338-388 recommitSurvivingCycleMembers
# (AIEBaseInstrInfo.cpp:236-266 removeBranch BytesRemoved peer).
#
# Far ADD32-parcel pad (420 x 12B) forces BranchRelaxation to call
# removeBranch (the prior `.space` INLINEASM pad is rejected by the
# W68.4 inline-asm admission law). After
# restamp + Finalize, ADD32 remains in a product-legal BUNDLE, BEQZ_W is
# gone from the coissue, and haydn-verify-bundles must not fatal.

--- |
  define void @coissue_far_strip(i1 %c) {
  entry:
    br i1 %c, label %exit, label %pad
  pad:
    br label %exit
  exit:
    ret void
  }
...
---
name:            coissue_far_strip
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
  - { reg: '$r15', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        false
body:             |
  bb.0.entry:
    successors: %bb.1, %bb.2
    liveins: $r0, $r1, $r2, $r15
    ; CHECK-LABEL: name: coissue_far_strip
    ; CHECK: bb.0.entry
    ; ALU sibling survives; branch child is stripped and the root restamped.
    ; CHECK: BUNDLE
    ; CHECK: ADD32
    ; CHECK-NOT: BEQZ_W
    ; CHECK: JALR
    BUNDLE 0, 0, implicit-def $r3, implicit-def dead $sfr, implicit $r0, implicit $r1, implicit $r2 {
      $r3 = ADD32 $r1, $r2, implicit-def dead $sfr
      BEQZ_W $r0, %bb.2, implicit-def dead $sfr
    }
    BUNDLE 0 {
      B %bb.1
    }

  bb.1.pad:
    successors: %bb.2
    liveins: $r15
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
    $r2 = ADD32 $r0, $r15, implicit-def dead $sfr
