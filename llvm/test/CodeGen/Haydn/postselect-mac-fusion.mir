# RUN: llc -mtriple=haydn-unknown-elf -run-pass=regbankselect,instruction-select -verify-machineinstrs %s -o - | FileCheck %s
#
# Instruction-select: G_MUL s32 + G_ADD → MULL + ADD32.

---
name:            test_scalar_mul_add
legalized:       true
regBankSelected: false
# CHECK-LABEL: name: test_scalar_mul_add
# CHECK: MULL
# CHECK: ADD32
body:             |
  bb.0.entry:
    liveins: $r0, $r1, $r2
    %0:_(s32) = COPY $r0
    %1:_(s32) = COPY $r1
    %2:_(s32) = COPY $r2
    %3:_(s32) = G_MUL %0, %1
    %4:_(s32) = G_ADD %3, %2
    $r0 = COPY %4(s32)
    RET implicit $r0, implicit $r15
...
