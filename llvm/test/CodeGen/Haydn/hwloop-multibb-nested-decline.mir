# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop -run-pass=haydn-hwloops \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# Role: MIR — multi-BB outer soft; single-BB inner Role-A expand only.
#
# Nested outer is not innermost — declined. Inner single-BB Role A expands.
# Never late physical rediscovery.
#
# Inner: retained Role A (LoopStart + PLE) → expand to SET sel=0.
# Outer: multi-BB soft residual → must stay soft (no second SET).
#
# CHECK-LABEL: name: multibb_nested_decline
# Inner Role A expands to real wide SET (sel=0, golden inner seat) before pack; outer stays soft.
# CHECK: SET_HWLOOP_F2_W 0
# CHECK-NOT: SET_HWLOOP_F2_W 1
# Soft outer back-edge retained:
# CHECK: BEQZ_W {{.*}}%bb.1

--- |
  define dso_local void @multibb_nested_decline(i32 %n, ptr %p) {
  entry:
    %cmp = icmp eq i32 %n, 0
    br i1 %cmp, label %exit, label %outer
  outer:
    %i = phi i32 [ 0, %entry ], [ %i.next, %outer.latch ]
    br label %inner
  inner:
    %j = phi i32 [ 0, %outer ], [ %j.next, %inner ]
    %j.next = add i32 %j, 1
    %inner.done = icmp eq i32 %j.next, %n
    br i1 %inner.done, label %outer.latch, label %inner
  outer.latch:
    %i.next = add i32 %i, 1
    %outer.done = icmp eq i32 %i.next, %n
    br i1 %outer.done, label %exit, label %outer
  exit:
    ret void
  }
...
---
name:            multibb_nested_decline
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r2, $r15
    successors: %bb.4, %bb.1

    $r0 = frame-setup XOR32 $r0, $r0
    $r4 = ADDI32_W $r0, 0
    $r5 = SEQ32 $r1, $r4
    BNEZ_W killed $r5, %bb.4

  bb.1.outer:
    successors: %bb.2
    liveins: $r1, $r2, $r4, $r15

    $r3 = MOVE32 $r2, $r2
    ; Inner IR ZOL (will expand to SET sel=0, golden inner seat).
    LoopStart $r1, 0
    NOP
    NOP
    NOP

  bb.2.inner:
    successors: %bb.2, %bb.3
    liveins: $r1, $r2, $r3, $r4, $r15

    $r6 = LD32 $r3, 0
    $r6 = ADD32 $r6, $r6
    ST32 $r6, $r3, 0
    $r3 = ADDI32 $r3, 4
    PseudoLoopEnd %bb.2
    B %bb.3

  bb.3.outer.latch:
    successors: %bb.4, %bb.1
    liveins: $r1, $r2, $r4, $r15

    $r7 = ADDI32_W $r0, 1
    $r4 = ADD32 $r4, $r7
    $r5 = SEQ32 $r4, $r1
    ; Soft outer back-edge — multi-BB residual must remain (KPI-gated).
    BEQZ_W killed $r5, %bb.1
    B %bb.4

  bb.4.exit:
    liveins: $r15
    $r0 = JALR_W $r15, 0, implicit $r15
