name:            hard_root_internal_read
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r15

    ; Same-cycle def→use: second member reads $r4 defined by the first.
    ; Entry already carries InternalRead (required for physreg liveness
    ; inside a BUNDLE). Exact-commit must clear/rebuild markers and keep
    ; `internal $r4` after transactional refinalize (and keep $r4 off the
    ; external-use list of the consolidated root).
    ; COMMIT-LABEL: name: hard_root_internal_read
    ; COMMIT: liveins: $r0, $r1, $r2, $r15
    ; COMMIT-NEXT: {{  $}}
    ; COMMIT-NEXT: BUNDLE 0, 0, implicit-def $r4, implicit-def dead $sfr, implicit-def $r5, implicit $r0, implicit killed $r1, implicit killed $r2 {
    ; COMMIT-NEXT:   $r4 = ADD32_S2 $r0, killed $r1, implicit-def dead $sfr
    ; COMMIT-NEXT:   $r5 = ADD32_S1 internal $r4, killed $r2, implicit-def dead $sfr
    ; COMMIT-NEXT: }
    ; COMMIT-NEXT: $r6 = XOR32 killed $r5, $r5, implicit-def dead $sfr
    ; COMMIT-NEXT: RET implicit $r15
    ;
    ; OPS-LABEL: name: hard_root_internal_read
    ; OPS: liveins: $r0, $r1, $r2, $r15
    ; OPS-NEXT: {{  $}}
    ; OPS-NEXT: BUNDLE 0, 0, implicit-def $r4, implicit-def dead $sfr, implicit-def $r5, implicit $r0, implicit killed $r1, implicit killed $r2 {
    ; OPS-NEXT:   $r4 = ADD32_S2 $r0, killed $r1, implicit-def dead $sfr
    ; OPS-NEXT:   $r5 = ADD32_S1 internal $r4, killed $r2, implicit-def dead $sfr
    ; OPS-NEXT: }
    ; OPS-NEXT: $r6 = XOR32 killed $r5, $r5, implicit-def dead $sfr
    ; OPS-NEXT: RET implicit $r15
    BUNDLE implicit-def $r4, implicit-def $r5, implicit-def dead $sfr, implicit $r0, implicit $r1, implicit $r2 {
      $r4 = ADD32 $r0, $r1, implicit-def dead $sfr
      $r5 = ADD32 internal $r4, $r2, implicit-def dead $sfr
    }
    $r6 = XOR32 $r5, $r5, implicit-def dead $sfr
    RET implicit $r15



# Child use of $r4 is InternalRead after transactional refinalize
# (must appear on a format-member ADD32 in the recommitted root).

