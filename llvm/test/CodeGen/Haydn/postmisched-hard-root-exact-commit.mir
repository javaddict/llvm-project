; XFAIL: *

# Role: MIR — Gated hard-root exact-commit at post-RA leaveMBB.
#
# Multi-member TargetOpcode::BUNDLE roots (approved producer / architectural
# rematch shape) enter postmisched as isSchedulingBoundary fences. leaveMBB
# transactionally exact-commits them: same children, member setDesc where
# alts apply, canonical field order, ProductFormatID imm 0 (FormatE96).
# Membership is never split; illegal roots fail closed.
#
# Recommit also rebuilds consolidated BUNDLE-root operands, kill flags, and
# child InternalRead markers (stale handoff shell is erased). OPS pins the
# two-ALU rebuild surface; INTERNAL pins same-cycle def→use InternalRead.
#
# Companion: postmisched-hard-root-cross-boundary-replay.mir (latency/Req/Res
# stalls around a hard root). Pre-handoff product path still has zero hard
# roots (postmisched-exact-nosplit-pre-handoff.ll).

--- |
  define void @hard_root_two_alu() { ret void }
  define void @hard_root_three_alu() { ret void }
  define void @hard_root_internal_read() { ret void }
...
---
name:            hard_root_two_alu
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r15

    ; Independent neighbor before the hard root.
    ; COMMIT-LABEL: name: hard_root_two_alu
    ; COMMIT: liveins: $r0, $r1, $r2, $r3, $r15
    ; COMMIT-NEXT: {{  $}}
    ; COMMIT-NEXT: $r6 = ADDI32 $r0, 1, implicit-def dead $sfr
    ; COMMIT-NEXT: BUNDLE 0, 0, implicit-def $r4, implicit-def dead $sfr, implicit-def $r5, implicit $r0, implicit killed $r1, implicit killed $r2, implicit killed $r3 {
    ; COMMIT-NEXT:   $r4 = ADD32_S2 $r0, killed $r1, implicit-def dead $sfr
    ; COMMIT-NEXT:   $r5 = ADD32_S1 killed $r2, killed $r3, implicit-def dead $sfr
    ; COMMIT-NEXT: }
    ; COMMIT-NEXT: $r7 = XOR32 killed $r4, killed $r5, implicit-def dead $sfr
    ; COMMIT-NEXT: RET implicit $r15
    ;
    ; OPS-LABEL: name: hard_root_two_alu
    ; OPS: liveins: $r0, $r1, $r2, $r3, $r15
    ; OPS-NEXT: {{  $}}
    ; OPS-NEXT: $r6 = ADDI32 $r0, 1, implicit-def dead $sfr
    ; OPS-NEXT: BUNDLE 0, 0, implicit-def $r4, implicit-def dead $sfr, implicit-def $r5, implicit $r0, implicit killed $r1, implicit killed $r2, implicit killed $r3 {
    ; OPS-NEXT:   $r4 = ADD32_S2 $r0, killed $r1, implicit-def dead $sfr
    ; OPS-NEXT:   $r5 = ADD32_S1 killed $r2, killed $r3, implicit-def dead $sfr
    ; OPS-NEXT: }
    ; OPS-NEXT: $r7 = XOR32 killed $r4, killed $r5, implicit-def dead $sfr
    ; OPS-NEXT: RET implicit $r15
    $r6 = ADDI32 $r0, 1, implicit-def dead $sfr
    ; Unstamped multi-member hard root (SMS handoff / rematch shape).
    ; Deliberately omit kill flags on the shell — recommit rebuilds them
    ; from live children (may also add kills via postmisched liveness).
    BUNDLE implicit-def $r4, implicit-def $r5, implicit-def dead $sfr, implicit $r0, implicit $r1, implicit $r2, implicit $r3 {
      $r4 = ADD32 $r0, $r1, implicit-def dead $sfr
      $r5 = ADD32 $r2, $r3, implicit-def dead $sfr
    }
    ; Independent neighbor after the hard root.
    $r7 = XOR32 $r4, $r5, implicit-def dead $sfr
    RET implicit $r15

...
