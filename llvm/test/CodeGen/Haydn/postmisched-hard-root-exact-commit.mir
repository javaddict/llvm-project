# Role: MIR — Residual unstamped multi-member exact-commit at post-RA leaveMBB.
#
# Multi-member TargetOpcode::BUNDLE shells (synthetic residual / rematch shape)
# enter postmisched as isSchedulingBoundary fences. leaveMBB exact-commits
# jointly legal membership: member setDesc where alts apply, canonical field
# order, ProductFormatID Format E. Same-cycle true RAW cannot coissue under
# product no-forwarding law — those shells sequentialize in schedule order
# (def before use) with InternalRead cleared. Independent ALU packs recommit.
# SET_HWLOOP + trip remat ADDI coissue is refused the same way (snapshot
# no-forwarding; stamped peels re-probed).
#
# Companion: postmisched-hard-root-cross-boundary-replay.mir (latency/Req/Res
# stalls around a multi-member shell). Product path still has zero pre-RA
# multi-member SMS BUNDLE freeze (postmisched-exact-nosplit-pre-handoff.ll).

--- |
  define void @hard_root_two_alu() { ret void }
  define void @hard_root_three_alu() { ret void }
  define void @hard_root_internal_read() { ret void }
  define void @set_trip_addi_no_coissue() { ret void }
  define void @set_trip_stamped_no_coissue() { ret void }
...
---
name:            hard_root_two_alu
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r15

    ; Independent neighbor before the hard root.
    ; COMMIT-LABEL: name: hard_root_two_alu
    ; COMMIT: liveins: $r0, $r1, $r2, $r3, $r15
    ; COMMIT-NEXT: {{  $}}
    ; COMMIT-NEXT: $r6 = ADDI32 $r0, 1, implicit-def dead $sfr
    ; COMMIT-NEXT: BUNDLE 1, 0, implicit-def $r4, implicit-def dead $sfr, implicit-def $r5, implicit $r0, implicit killed $r1, implicit killed $r2, implicit killed $r3 {
    ; COMMIT-NEXT:   $r4 = ADD32_E{{[23]}}_E{{[0-2]}}_{{.*}} $r0, killed $r1, implicit-def dead $sfr
    ; COMMIT-NEXT:   $r5 = ADD32_E{{[23]}}_E{{[0-2]}}_{{.*}} killed $r2, killed $r3, implicit-def dead $sfr
    ; COMMIT-NEXT: }
    ; COMMIT-NEXT: $r7 = XOR32 killed $r4, killed $r5, implicit-def dead $sfr
    ; COMMIT-NEXT: RET implicit $r15
    ;
    ; OPS-LABEL: name: hard_root_two_alu
    ; OPS: liveins: $r0, $r1, $r2, $r3, $r15
    ; OPS-NEXT: {{  $}}
    ; OPS-NEXT: $r6 = ADDI32 $r0, 1, implicit-def dead $sfr
    ; OPS-NEXT: BUNDLE 1, 0, implicit-def $r4, implicit-def dead $sfr, implicit-def $r5, implicit $r0, implicit killed $r1, implicit killed $r2, implicit killed $r3 {
    ; OPS-NEXT:   $r4 = ADD32_E{{[23]}}_E{{[0-2]}}_{{.*}} $r0, killed $r1, implicit-def dead $sfr
    ; OPS-NEXT:   $r5 = ADD32_E{{[23]}}_E{{[0-2]}}_{{.*}} killed $r2, killed $r3, implicit-def dead $sfr
    ; OPS-NEXT: }
    ; OPS-NEXT: $r7 = XOR32 killed $r4, killed $r5, implicit-def dead $sfr
    ; OPS-NEXT: RET implicit $r15
    $r6 = ADDI32 $r0, 1, implicit-def dead $sfr
    ; Unstamped multi-member hard root (SMS handoff / rematch shape).
    ; Deliberately omit kill flags on the shell — recommit rebuilds them
    ; from live children (may also add kills via postmisched liveness).
    BUNDLE implicit-def $r4, implicit-def $r5, implicit-def dead $sfr, implicit $r0, implicit $r1, implicit $r2, implicit $r3 {
      $r4 = ADD32 $r0, $r1, implicit-def dead $sfr
      $r5 = ADD32 $r2, $r3, implicit-def dead $sfr
    }
    ; Independent neighbor after the hard root.
    $r7 = XOR32 $r4, $r5, implicit-def dead $sfr
    RET implicit $r15

...
---
name:            hard_root_three_alu
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r4, $r5, $r15

    ; COMMIT-LABEL: name: hard_root_three_alu
    ; Three GPR writes exceed the 2W cap, so leaveMBB sequentializes.
    ; COMMIT: liveins: $r0, $r1, $r2, $r3, $r4, $r5, $r15
    ; COMMIT-NEXT: {{  $}}
    ; COMMIT-NEXT: $r6 = ADD32 $r0, killed $r1, implicit-def dead $sfr
    ; COMMIT-NEXT: $r7 = ADD32 killed $r2, killed $r3, implicit-def dead $sfr
    ; COMMIT-NEXT: $r8 = ADD32 killed $r4, killed $r5, implicit-def dead $sfr
    ; COMMIT-NEXT: RET implicit $r15
    ;
    ; OPS-LABEL: name: hard_root_three_alu
    ; OPS: liveins: $r0, $r1, $r2, $r3, $r4, $r5, $r15
    ; OPS-NEXT: {{  $}}
    ; OPS-NEXT: $r6 = ADD32 $r0, killed $r1, implicit-def dead $sfr
    ; OPS-NEXT: $r7 = ADD32 killed $r2, killed $r3, implicit-def dead $sfr
    ; OPS-NEXT: $r8 = ADD32 killed $r4, killed $r5, implicit-def dead $sfr
    ; OPS-NEXT: RET implicit $r15
    BUNDLE implicit-def $r6, implicit-def $r7, implicit-def $r8, implicit-def dead $sfr, implicit $r0, implicit $r1, implicit $r2, implicit $r3, implicit $r4, implicit $r5 {
      $r6 = ADD32 $r0, $r1, implicit-def dead $sfr
      $r7 = ADD32 $r2, $r3, implicit-def dead $sfr
      $r8 = ADD32 $r4, $r5, implicit-def dead $sfr
    }
    RET implicit $r15

