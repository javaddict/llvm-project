---
name:            hard_root_internal_read
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r15

    ; Same-cycle def→use true RAW: second member reads $r4 defined by the
    ; first. Product no-forwarding law refuses coissue; leaveMBB sequentializes
    ; in schedule (def-before-use) order and clears stale InternalRead so the
    ; multi-cycle RAW is a normal physreg read.
    ; COMMIT-LABEL: name: hard_root_internal_read
    ; COMMIT: liveins: $r0, $r1, $r2, $r15
    ; COMMIT-NEXT: {{  $}}
    ; COMMIT-NEXT: $r4 = ADD32 $r0, killed $r1, implicit-def dead $sfr
    ; COMMIT-NEXT: $r5 = ADD32 killed $r4, killed $r2, implicit-def dead $sfr
    ; COMMIT-NEXT: $r6 = XOR32 killed $r5, $r5, implicit-def dead $sfr
    ; COMMIT-NEXT: RET implicit $r15
    ;
    ; OPS-LABEL: name: hard_root_internal_read
    ; OPS: liveins: $r0, $r1, $r2, $r15
    ; OPS-NEXT: {{  $}}
    ; OPS-NEXT: $r4 = ADD32 $r0, killed $r1, implicit-def dead $sfr
    ; OPS-NEXT: $r5 = ADD32 killed $r4, killed $r2, implicit-def dead $sfr
    ; OPS-NEXT: $r6 = XOR32 killed $r5, $r5, implicit-def dead $sfr
    ; OPS-NEXT: RET implicit $r15
    BUNDLE implicit-def $r4, implicit-def $r5, implicit-def dead $sfr, implicit $r0, implicit $r1, implicit $r2 {
      $r4 = ADD32 $r0, $r1, implicit-def dead $sfr
      $r5 = ADD32 internal $r4, $r2, implicit-def dead $sfr
    }
    $r6 = XOR32 $r5, $r5, implicit-def dead $sfr
    RET implicit $r15

...
---
name:            set_trip_addi_no_coissue
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r5, $r15
    successors: %bb.1

    ; Unstamped ADDI trip remat + SET: leaveMBB sequentializes (def then use).
    ; COMMIT-LABEL: name: set_trip_addi_no_coissue
    ; COMMIT: $r6 = ADDI32_W {{.*}}$r5, -1
    ; COMMIT-NEXT: SET_HWLOOP_F2_W 1, %bb.1, %bb.1, {{.*}}$r6
    ; COMMIT-NEXT: RET implicit $r15
    ;
    ; OPS-LABEL: name: set_trip_addi_no_coissue
    ; OPS: $r6 = ADDI32_W {{.*}}$r5, -1
    ; OPS-NEXT: SET_HWLOOP_F2_W 1, %bb.1, %bb.1, {{.*}}$r6
    ; OPS-NEXT: RET implicit $r15
    BUNDLE implicit-def $r6, implicit-def $sfr, implicit $r5 {
      $r6 = ADDI32_W $r5, -1, implicit-def dead $sfr
      SET_HWLOOP_F2_W 1, %bb.1, %bb.1, internal killed $r6, implicit-def $sfr
    }
    RET implicit $r15

  bb.1:
    RET implicit $r15

...
---
name:            set_trip_stamped_no_coissue
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r5, $r15
    successors: %bb.1

    ; Format-E stamped illegal trip coissue: leaveMBB re-probes and sequentializes.
    ; COMMIT-LABEL: name: set_trip_stamped_no_coissue
    ; COMMIT: $r6 = ADDI32_W_S0 {{.*}}$r5, -1
    ; COMMIT-NEXT: SET_HWLOOP_F2_W_S0 1, %bb.1, %bb.1, {{.*}}$r6
    ; COMMIT-NEXT: RET implicit $r15
    ;
    ; OPS-LABEL: name: set_trip_stamped_no_coissue
    ; OPS: $r6 = ADDI32_W_S0 {{.*}}$r5, -1
    ; OPS-NEXT: SET_HWLOOP_F2_W_S0 1, %bb.1, %bb.1, {{.*}}$r6
    ; OPS-NEXT: RET implicit $r15
    BUNDLE 0, 0, implicit-def dead $r6, implicit-def $sfr, implicit $r5 {
      $r6 = ADDI32_W_S0 $r5, -1, implicit-def dead $sfr
      SET_HWLOOP_F2_W_S0 1, %bb.1, %bb.1, internal killed $r6, implicit-def $sfr
    }
    RET implicit $r15

  bb.1:
    RET implicit $r15

