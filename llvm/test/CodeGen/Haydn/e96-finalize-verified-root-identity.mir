# RUN: split-file %s %t
# RUN: llc -mtriple=haydn-unknown-elf \
# RUN:   -run-pass=haydn-finalize-mi-bundles,haydn-finalize-mi-bundles \
# RUN:   -verify-machineinstrs %t/verified.mir -o - | FileCheck %s --check-prefix=VERIFIED
# RUN: llc -mtriple=haydn-unknown-elf \
# RUN:   -run-pass=haydn-finalize-mi-bundles,haydn-finalize-mi-bundles \
# RUN:   -verify-machineinstrs %t/stale.mir -o - | FileCheck %s --check-prefix=STALE
# RUN: llc -mtriple=haydn-unknown-elf \
# RUN:   -run-pass=haydn-finalize-mi-bundles,haydn-finalize-mi-bundles \
# RUN:   -verify-machineinstrs %t/fieldslot.mir -o - | FileCheck %s --check-prefix=SLOT
# REQUIRES: haydn-registered-target

# Role: MIR — late Finalize is identity on already-bundled roots
# (AIEFinalizeBundle.cpp:49-56). A second Finalize must not E2/E3 restamp,
# FieldSlot-cutover, or Mode-retry. Inverse-rejected stale stamps stay
# as-is; VerifyBundles is the independent inverse, not this pass.

#--- verified.mir
--- |
  define void @verified_e2_singleton_identity() { ret void }
...
---
name:            verified_e2_singleton_identity
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r15
    ; VERIFIED-LABEL: name: verified_e2_singleton_identity
    ; VERIFIED: BUNDLE 0, 0
    ; VERIFIED: ADD32_E2_E0_ALU0_RR
    ; VERIFIED-NOT: ADD32_E3_
    BUNDLE 0, 0, implicit-def $r2, implicit-def dead $sfr, implicit $r0, implicit $r1 {
      $r2 = ADD32_E2_E0_ALU0_RR $r0, $r1, implicit-def dead $sfr
    }
    RET implicit $r15

#--- stale.mir
--- |
  define void @stale_e2_e3_member_identity() { ret void }
...
---
# E3 member under an E2 stamp. Construction-only Finalize must not rebind.
name:            stale_e2_e3_member_identity
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r15
    ; STALE-LABEL: name: stale_e2_e3_member_identity
    ; STALE: BUNDLE 0, 0
    ; STALE: ADD32_E3_E0_ALU2_RR
    ; STALE-NOT: ADD32_E2_E0_ALU0_RR
    BUNDLE 0, 0, implicit-def $r2, implicit-def dead $sfr, implicit $r0, implicit $r1 {
      $r2 = ADD32_E3_E0_ALU2_RR $r0, $r1, implicit-def dead $sfr
    }
    RET implicit $r15

#--- fieldslot.mir
--- |
  define void @residual_fieldslot_identity() { ret void }
...
---
# Residual logical FieldSlot stays logical. No MemberId cutover.
name:            residual_fieldslot_identity
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r15
    ; SLOT-LABEL: name: residual_fieldslot_identity
    ; SLOT: BUNDLE 0, 0
    ; SLOT: $r2 = ADD32_E2_E0_ALU0_RR $r0, $r1
    BUNDLE 0, 0, implicit-def $r2, implicit-def dead $sfr, implicit $r0, implicit $r1 {
      $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    }
    RET implicit $r15
