  %p2 = getelementptr [4 x i32], ptr %arr, i32 0, i32 2
  %p3 = getelementptr [4 x i32], ptr %arr, i32 0, i32 3
  store i32 10, ptr %p0
  store i32 20, ptr %p1
  store i32 30, ptr %p2
