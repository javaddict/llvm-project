; Recursive function (Fibonacci).
; C: int fib(int n) { if (n <= 1) return n; return fib(n-1) + fib(n-2); }
define i32 @fib(i32 %n) {
; CondOpt may absorb slt+invert into fused bge (AIE xor(setcc,1) style).
; n-1/n-2 are addi32 -1/-2 now that constants fold into the immediate form
; (previously materialize + sub32/add32).
; CHECK-LABEL: fib:
; CHECK:       // #<spill-kpi> @fib spills=3 spill-bytes=12 reloads=3 reload-bytes=12
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    { xor32 r0, r0, r0; nop; nop }
; CHECK-NEXT:    { subi32 sp, sp, 24; nop }
; CHECK-NEXT:    { addi32 r2, sp, 12; nop }
; CHECK-NEXT:    { nop; nop; s_sw_with_imm lr, r2, 0 }
; CHECK-NEXT:    { nop; nop; s_sw_with_imm r9, r2, 1 }
; CHECK-NEXT:    { nop; nop; s_sw_with_imm r8, r2, 2 }
; CHECK-NEXT:    .cfi_def_cfa_offset 24
; CHECK-NEXT:    .cfi_offset r8, 20
; CHECK-NEXT:    .cfi_offset r9, 16
; CHECK-NEXT:    .cfi_offset lr, 12
; CHECK-NEXT:    { addi32 r2, r0, 1; nop }
; CHECK-NEXT:    { slt32 r2, r2, r1; nop; nop }
; CHECK-NEXT:    { beqz r2, .LBB4_2; nop; nop }
; CHECK-NEXT:  // %bb.1: // %recurse
; CHECK-NEXT:    { addi32 r2, r1, -1; addi32 r8, r1, -2 }
; CHECK-NEXT:    { move32 r1, r2; nop; nop }
; CHECK-NEXT:    { nop; jal lr, fib; nop }
; CHECK-NEXT:    { move32 r9, r1; move32 r1, r8; nop }
; CHECK-NEXT:    { xor32 r0, r0, r0; nop; nop }
; CHECK-NEXT:    { nop; jal lr, fib; nop }
; CHECK-NEXT:    { add32 r1, r9, r1; xor32 r0, r0, r0; nop }
; CHECK-NEXT:  .LBB4_2: // %base
; CHECK-NEXT:    { xor32 r0, r0, r0; nop; nop }
; CHECK-NEXT:    { s_lw_with_imm lr, sp, 3; nop; nop }
; CHECK-NEXT:    { s_lw_with_imm r9, sp, 4; nop; nop }
; CHECK-NEXT:    { s_lw_with_imm r8, sp, 5; nop; nop }
; CHECK-NEXT:    { addi32 sp, sp, 24; nop }
; CHECK-NEXT:    { nop; jalr r0, lr, 0; nop }
entry:
  %cmp = icmp sle i32 %n, 1
  br i1 %cmp, label %base, label %recurse
base:
  ret i32 %n
recurse:
  %n1 = sub i32 %n, 1
  %n2 = sub i32 %n, 2
  %f1 = call i32 @fib(i32 %n1)
  %f2 = call i32 @fib(i32 %n2)
  %r = add i32 %f1, %f2
  ret i32 %r
}

