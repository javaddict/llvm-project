# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=haydn-expand-pseudos,haydn-finalize-mi-bundles,haydn-longbranch-normalize \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# Role: MIR — ExpandPseudos rewrites generic SET_HWLOOP{,_REG}; Fixup keeps the wide form.

# REGRESSION TEST: generic SET_HWLOOP / SET_HWLOOP_REG injected into late
# layout must run ExpandPseudos first. Expand rewrites to SET_HWLOOP_W /
# SET_HWLOOP_F2_W; Fixup is Hexagon-style range recheck / pad / fatal only
# (HexagonFixupHwLoops.cpp:75-81, 136-148) and must not rewrite generics.
# Bundled generic SET is not ExpandPseudos' rewrite surface (top-level only);
# that residual fatals at Fixup — see hwloop-fixup-residual-set-hwloop-fatal.mir.
# Coissued wide SET preservation is hwloop-fixup-bundle-preserving.mir.

--- |
  define dso_local void @imm_generic_to_wide() {
  entry:
    ret void
  }
  define dso_local void @reg_generic_to_f2w() {
  entry:
    ret void
  }

...
---
name:            imm_generic_to_wide
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r0, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0, implicit-def dead $sfr
    ; Generic imm-trip form — ExpandPseudos rewrites before Fixup.
    SET_HWLOOP 0, %bb.1, %bb.1, 4, implicit-def dead $sfr
    NOP
    NOP
    NOP

  bb.1:
    liveins: $r1, $r0
    successors: %bb.2
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.2:
    liveins: $r15
    RET implicit killed $r15

# CHECK-LABEL: name: imm_generic_to_wide
# CHECK: SET_HWLOOP{{(_W|_E[0-9]_[^ ]+)?}} 0, %bb.1, %bb.1, 4
# CHECK-NOT: SET_HWLOOP{{[^_]}}
# CHECK-NOT: LoopStart

...
---
name:            reg_generic_to_f2w
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r0, $r2, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0, implicit-def dead $sfr
    ; Generic reg-trip form — ExpandPseudos rewrites to F2_W (not REG_W).
    SET_HWLOOP_REG 0, %bb.1, %bb.1, $r2, implicit-def dead $sfr
    NOP
    NOP
    NOP

  bb.1:
    liveins: $r1, $r0, $r2
    successors: %bb.2
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.2:
    liveins: $r15
    RET implicit killed $r15

# CHECK-LABEL: name: reg_generic_to_f2w
# CHECK: SET_HWLOOP{{(_F2_W|_F2_E[0-9]_[^ ]+)?}} 0, %bb.1, %bb.1, $r2
# CHECK-NOT: SET_HWLOOP_REG
