# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop -run-pass=haydn-fixup-hwloops \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# Role: MIR — Late layout must not leave residual cycle-forming setup pseudos when the hardware form is retained.

# Late layout must not leave residual cycle-forming setup pseudos when the
# hardware form is retained. ExpandPseudos normally rewrites SET_HWLOOP and
# SET_HWLOOP_REG to SET_HWLOOP_W / SET_HWLOOP_F2_W before post-RA pack; Fixup
# is the defense-in-depth peer for MIR that still injects the generic forms
# (and any residual that slips past expand).
#
# Both functions already satisfy InterveningCycles Following and Off1/Off2, so
# Fixup keeps the SET — only the opcode must become the final wide form.

--- |
  define dso_local void @imm_generic_to_wide() {
  entry:
    ret void
  }
  define dso_local void @reg_generic_to_f2w() {
  entry:
    ret void
  }
  define dso_local void @coissue_generic_preserves_root_ops() {
  entry:
    ret void
  }

...
---
name:            imm_generic_to_wide
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r0, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0, implicit-def dead $sfr
    ; Generic imm-trip form (ExpandPseudos residual).
    SET_HWLOOP 0, %bb.1, %bb.1, 4, implicit-def dead $sfr
    NOP
    NOP
    NOP

  bb.1:
    liveins: $r1, $r0
    successors: %bb.2
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.2:
    liveins: $r15
    RET implicit killed $r15

# CHECK-LABEL: name: imm_generic_to_wide
# CHECK: SET_HWLOOP_W
# CHECK-NOT: {{^    SET_HWLOOP }}
# CHECK: bb.1

...
---
name:            reg_generic_to_f2w
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r0, $r2, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0, implicit-def dead $sfr
    ; Generic reg-trip form → final F2_W (not REG_W / member invent).
    SET_HWLOOP_REG 0, %bb.1, %bb.1, $r2, implicit-def dead $sfr
    NOP
    NOP
    NOP

  bb.1:
    liveins: $r1, $r0, $r2
    successors: %bb.2
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.2:
    liveins: $r15
    RET implicit killed $r15

# CHECK-LABEL: name: reg_generic_to_f2w
# CHECK: SET_HWLOOP_F2_W
# CHECK-NOT: SET_HWLOOP_REG
# CHECK: bb.1

...
---
name:            coissue_generic_preserves_root_ops
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r15
    successors: %bb.1

    ; FormatID-stamped coissue with residual generic SET. Normalize rewrites
    ; SET → wide final form without destroying consolidated root operands or
    ; unbundling the coissued ADD member.
    BUNDLE 0, implicit-def $r4, implicit-def dead $sfr, implicit $r0, implicit $r1 {
      SET_HWLOOP 0, %bb.1, %bb.1, 2, implicit-def dead $sfr
      $r4 = ADD32_S2 $r0, $r1, implicit-def dead $sfr
    }
    BUNDLE 0 {
      NOP_S0
    }
    BUNDLE 0 {
      NOP_S0
    }
    BUNDLE 0 {
      NOP_S0
    }
    RET implicit $r15

  bb.1:
    liveins: $r4, $r15
    ST32 $r4, $r4, 0
    RET implicit $r15

# CHECK-LABEL: name: coissue_generic_preserves_root_ops
# CHECK: BUNDLE 0, implicit-def $r4, implicit-def dead $sfr, implicit $r0, implicit $r1 {
# CHECK: SET_HWLOOP_W
# CHECK: ADD32
# CHECK: }
# CHECK-NOT: {{^    SET_HWLOOP }}
