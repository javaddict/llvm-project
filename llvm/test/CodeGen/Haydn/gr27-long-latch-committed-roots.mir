  bb.2.exit:
    liveins: $r1, $r15
    $r0 = JALR_W killed $r15, 0, implicit killed $r1

# CHECK-LABEL: name: long_latch_roots
# Hardware setup erased.
# CHECK-NOT: SET_HWLOOP
# Countdown (free-counter arm): SUBI32 on the countdown register.
# CHECK: BUNDLE
# CHECK: SUBI32{{.*}} $r2, 1
# Address materialization FIRST: committed singleton BUNDLE root, LUI on
# the Header block symbol in the SCRATCH register; then ADDI32 in the same
# LUI-defined scratch. The scratch is a DIFFERENT register from the
# countdown (computed-dead probe, D1.32).
# CHECK: BUNDLE
# CHECK: $r11 = LUI{{.*}} %bb.1
# CHECK: BUNDLE
# CHECK: ADDI32{{.*}} $r11, %bb.1
# The exit edge reads the COUNTDOWN ($r2), never the scratch ($r11).
# CHECK: BUNDLE
# CHECK: BEQZ{{.*}} $r2, %bb.2
# Final terminator: the unconditional long backedge on the scratch.
# CHECK: BUNDLE
# CHECK: JALR{{.*}} $r11
# No short backedge survives.
# CHECK-NOT: BNEZ
