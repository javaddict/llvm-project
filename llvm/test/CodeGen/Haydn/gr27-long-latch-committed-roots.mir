# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=haydn-hwloops -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s
# REQUIRES: haydn-registered-target
#
# GR2.7 / D1.32 class 1 pin: the demote long-latch template lands as
# COMMITTED SINGLETON BUNDLE ROOTS in the exact corrected order —
# LUI(Header) ; ADDI32_W(Header) ; BEQZ_W(countdown, Exit) ; JALR_W —
# with the BEQZ reading the COUNTDOWN register and the LUI/ADDI/JALR on a
# DIFFERENT computed-dead scratch. Asm text alone cannot prove committed
# cycle shape (CLAUDE.md law); this MIR arm pins the BUNDLE roots.
#
# The whole-body loop (~26KB of parcels) overflows the Off2 uimm12x4
# window, forcing the demote; the demoted BNEZ backedge then overflows
# WIDE_BranchSImm12, selecting the long-latch template at the demote seat.
# Trip $r2 is dead after the loop (exit returns via $r1), so the FREE
# counter arm keeps the countdown in $r2; the template scratch is the
# computed-dead $r11.

--- |
  define dso_local i32 @long_latch_roots(ptr nocapture %p, i32 %n) {
  entry:
    br label %body
  body:
    br label %exit
  exit:
    ret i32 0
  }
...
---
name:            long_latch_roots
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r2, $r15
    successors: %bb.1
    SET_HWLOOP_F2_W 0, %bb.1, %bb.1, $r2, implicit-def dead $sfr

  bb.1.body:
    liveins: $r1, $r2
    successors: %bb.2
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
