# RUN: llc -mtriple=haydn-unknown-elf -mattr=-hwloop -run-pass=pipeliner \
# RUN:   -debug-only=pipeliner -verify-machineinstrs \
# RUN:   %S/sms-format-shoulduse-reject.mir -o - 2>&1 \
# RUN:   | FileCheck %s --check-prefixes=PIPE,GROUPS
# REQUIRES: asserts

# Role: Option C pre-RA multi-stage containment (no SMS BUNDLE freeze).
# Multi-stage schedule found then rejected; no multi-member logical BUNDLE.

# PIPE-NOT: SMS-HOOK: reject
# PIPE-NOT: SMS-RESMII: reject
# PIPE-NOT: SMS-HANDOFF: reject
# PIPE-DAG: Schedule Found? 1 (II={{[1-9][0-9]*}})
# PIPE-DAG: SMS-SHOULDUSE: reject multi-stage stages={{[2-9]|[1-9][0-9]+}} II={{[0-9]+}} (pre-RA StageCount>1 containment; post-RA multi-stage only)
# PIPE-DAG: Target rejected schedule
# PIPE-NOT: SMS-SHOULDUSE: accept multi-stage durable
# PIPE-NOT: SMS-HANDOFF: materialize cycle={{[0-9]+}} members={{[2-9]|[1-9][0-9]+}} logical BUNDLE
# PIPE-NOT: SMS-HANDOFF: materialize done groups={{[1-9][0-9]*}}

# GROUPS-LABEL: name: sms_shoulduse_multistage_mac
# GROUPS-DAG: SEQ32
# GROUPS-DAG: {{%[0-9]+}}:gpr32 = LD32
# GROUPS-DAG: {{%[0-9]+}}:gpr32 = LD32
# GROUPS-NOT: BUNDLE{{.*}}:: (load{{.*}}{
# GROUPS-NOT: {{LD32|MOV_GPR_TO_DR64|ADD32|ADDI32|F2MULAA32RS_HHLL}}_S
