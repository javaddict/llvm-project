# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postmisched -verify-machineinstrs %s -o - | FileCheck %s
#
# VLIW STRESS TEST: GPR port constraints (4R2W) and DR64 port freedom.
#
# GPR port constraint: 4 read ports, 2 write ports shared across all slots.
# DR64 uses separate register file with own ports — not counted toward GPR limits.
# R0 reads don't count (hardwired zero — but the code counts them, so they DO
# count toward the 4R limit).
#
# Tests:
# 1. Exactly at 4R2W limit — should pack
# 2. Exceed 4 reads — should NOT pack
# 3. Exceed 2 writes — should NOT pack
# 4. DR64 ops don't count toward GPR ports — pack freely
# 5. Mixed GPR + DR64: only GPR ops consume port budget
# 6. S_LW_WITH_IMM + S_SW_WITH_IMM + ADD32: exactly at 4R2W with memory ops
#

--- |
  define void @test1_at_4r2w_limit() { ret void }
  define void @test2_exceed_4_reads() { ret void }
  define void @test3_exceed_2_writes() { ret void }
  define void @test4_dr64_no_port_conflict() { ret void }
  define void @test5_mixed_gpr_dr64_ports() { ret void }
  define void @test6_ld_st_alu_at_limit() { ret void }
...
---
# ============================================================================
# Test 1: Exactly at 4R2W limit — should bundle
# ============================================================================
#
# Two ADD32 instructions:
# ADD32 r2, r0, r1 -> 2 reads (r0, r1), 1 write (r2)
# ADD32 r3, r4, r5 -> 2 reads (r4, r5), 1 write (r3)
# Total: 4 reads, 2 writes. Exactly at limit -> should bundle.
#
name:            test1_at_4r2w_limit
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
  - { reg: '$r5', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $r4, $r5

    ; Exactly 4R, 2W -> bundles.

    ; CHECK-LABEL: name: test1_at_4r2w_limit
    ; CHECK: liveins: $r0, $r1, $r4, $r5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE 1, implicit-def $r2, implicit-def dead $sfr, implicit-def $r3, implicit $r0, implicit killed $r1, implicit killed $r4, implicit killed $r5 {
    ; CHECK-NEXT:   $r2 = ADD32_P32_ALU0 $r0, killed $r1, implicit-def dead $sfr
    ; CHECK-NEXT:   $r3 = ADD32_P31_ALU1 killed $r4, killed $r5, implicit-def dead $sfr
    ; CHECK-NEXT: }
    ; CHECK-NEXT: $r0 = COPY killed $r2
    ; CHECK-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    $r3 = ADD32 $r4, $r5, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 2: Exceed 4 GPR reads — third instruction should NOT join bundle
# ============================================================================
#
# Two ADD32 (4R, 2W) already in bundle. ADDI32 would add 1 read + 1 write.
# That would be 5R, 3W -> exceeds both limits. So ADDI32 gets its own bundle.
#
name:            test2_exceed_4_reads
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
  - { reg: '$r5', virtual-reg: '' }
  - { reg: '$r6', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $r4, $r5, $r6

    ; Two ADD32: 4R, 2W (at limit). ADDI32 adds 1R, 1W -> 5R, 3W (over).

    ; CHECK-LABEL: name: test2_exceed_4_reads
    ; CHECK: liveins: $r0, $r1, $r4, $r5, $r6
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE 1, implicit-def $r2, implicit-def dead $sfr, implicit-def $r3, implicit $r0, implicit killed $r1, implicit killed $r4, implicit killed $r5 {
    ; CHECK-NEXT:   $r2 = ADD32_P32_ALU0 $r0, killed $r1, implicit-def dead $sfr
    ; CHECK-NEXT:   $r3 = ADD32_P31_ALU1 killed $r4, killed $r5, implicit-def dead $sfr
    ; CHECK-NEXT: }
    ; CHECK-NEXT: $r7 = ADDI32_P21_ALU1 killed $r6, 100, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY killed $r2
    ; CHECK-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    $r3 = ADD32 $r4, $r5, implicit-def dead $sfr
    $r7 = ADDI32 $r6, 100, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 3: Exceed 2 GPR writes — third write should NOT join bundle
# ============================================================================
#
# Three ADDI32 each writing different registers:
# ADDI32 r2, r0, 10 -> 1R (r0), 1W (r2)
# ADDI32 r3, r0, 20 -> 1R (r0), 1W (r3)
# ADDI32 r4, r0, 30 -> 1R (r0), 1W (r4)
# First two: 2R, 2W (at write limit). Third would be 3R, 3W (over both).
#
name:            test3_exceed_2_writes
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0

    ; Two ADDI32: 2R, 2W (at write limit). Third ADDI32: would be 3R, 3W.

    ; CHECK-LABEL: name: test3_exceed_2_writes
    ; CHECK: liveins: $r0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE 0, implicit-def $r2, implicit-def dead $sfr, implicit-def $r3, implicit $r0 {
    ; CHECK-NEXT:   $r2 = ADDI32_P21_ALU1 $r0, 10, implicit-def dead $sfr
    ; CHECK-NEXT:   $r3 = ADDI32_P20_ALU0 $r0, 20, implicit-def dead $sfr
    ; CHECK-NEXT: }
    ; CHECK-NEXT: $r4 = ADDI32_P21_ALU1 $r0, 30, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY killed $r2
    ; CHECK-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADDI32 $r0, 10, implicit-def dead $sfr
    $r3 = ADDI32 $r0, 20, implicit-def dead $sfr
    $r4 = ADDI32 $r0, 30, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 4: DR64 ops don't count toward GPR ports — pack freely
# ============================================================================
#
# ADD64, SUB64, OR64 all use DR64 registers only. countGPRPorts returns (0,0)
# for each. GPR port budget is unaffected. The limit is DFA slots:
# Slot12_ALU provides SLOT1+SLOT2 (max 2 DR64 ALU ops per bundle).
#
name:            test4_dr64_no_port_conflict
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$d1', virtual-reg: '' }
  - { reg: '$d2', virtual-reg: '' }
  - { reg: '$d3', virtual-reg: '' }
  - { reg: '$d4', virtual-reg: '' }
  - { reg: '$d5', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $d0, $d1, $d2, $d3, $d4, $d5

    ; Two DR64 ops bundle (SLOT1 + SLOT2). GPR ports: 0R, 0W.
    ; Third DR64 op needs a slot, but both SLOT1 and SLOT2 are taken.

    ; CHECK-LABEL: name: test4_dr64_no_port_conflict
    ; CHECK: liveins: $r0, $d0, $d1, $d2, $d3, $d4, $d5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE 1, implicit-def $d6, implicit-def dead $sfr, implicit-def $d7, implicit-def $d8, implicit killed $d0, implicit killed $d1, implicit killed $d2, implicit killed $d3, implicit killed $d4, implicit killed $d5 {
    ; CHECK-NEXT:   $d6 = ADD64_P32_ALU0 killed $d0, killed $d1, implicit-def dead $sfr
    ; CHECK-NEXT:   $d7 = SUB64_P31_ALU1 killed $d2, killed $d3, implicit-def dead $sfr
    ; CHECK-NEXT:   $d8 = OR64_P30_ALU2 killed $d4, killed $d5, implicit-def dead $sfr
    ; CHECK-NEXT: }
    ; CHECK-NEXT: $r0 = COPY $r0
    ; CHECK-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $d6 = ADD64 $d0, $d1, implicit-def dead $sfr
    $d7 = SUB64 $d2, $d3, implicit-def dead $sfr
    $d8 = OR64 $d4, $d5, implicit-def dead $sfr

    $r0 = COPY $r0
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 5: Mixed GPR + DR64 — only GPR ops consume port budget
# ============================================================================
#
# ADD32 (2R, 1W GPR) + ADD64 (0R, 0W GPR) + SUB64 (0R, 0W GPR).
# GPR total: 2R, 1W — well within 4R2W.
# DFA: ADD32 -> SLOT0, ADD64 -> SLOT1, SUB64 -> SLOT2.
# All independent registers -> full 3-issue bundle.
#
name:            test5_mixed_gpr_dr64_ports
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$d1', virtual-reg: '' }
  - { reg: '$d2', virtual-reg: '' }
  - { reg: '$d3', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $d0, $d1, $d2, $d3

    ; Post-: the GPR-port-FuncUnits model is reverted; the DFA uses
    ; the slot-only itinerary. DR64-only ops in Slot12_ALU are NOT charged
    ; against GPR ports, so all three (ADD32 + ADD64 + SUB64) pack into one
    ; bundle (2R1W GPR + 2 DR64 pairs — within the 4R2W GPR gate enforced by
    ; countGPRPorts).

    ; CHECK-LABEL: name: test5_mixed_gpr_dr64_ports
    ; CHECK: liveins: $r0, $r1, $d0, $d1, $d2, $d3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE 1, implicit-def $r2, implicit-def dead $sfr, implicit-def $d4, implicit-def $d5, implicit $r0, implicit killed $r1, implicit killed $d0, implicit killed $d1, implicit killed $d2, implicit killed $d3 {
    ; CHECK-NEXT:   $r2 = ADD32_P32_ALU0 $r0, killed $r1, implicit-def dead $sfr
    ; CHECK-NEXT:   $d4 = ADD64_P31_ALU1 killed $d0, killed $d1, implicit-def dead $sfr
    ; CHECK-NEXT:   $d5 = SUB64_P30_ALU2 killed $d2, killed $d3, implicit-def dead $sfr
    ; CHECK-NEXT: }
    ; CHECK-NEXT: $r0 = COPY killed $r2
    ; CHECK-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    $d4 = ADD64 $d0, $d1, implicit-def dead $sfr
    $d5 = SUB64 $d2, $d3, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 6: S_LW_WITH_IMM + S_SW_WITH_IMM + ADD32 — GPR ports with memory operations
# ============================================================================
#
# S_LW_WITH_IMM r2, r0, 0 -> reads r0 (1R), writes r2 (1W), uses SLOT0
# S_SW_WITH_IMM r3, r1, 0 -> reads r3, r1 (2R), writes nothing visible (0W), uses SLOT0
# Wait — both S_LW_WITH_IMM and S_SW_WITH_IMM need SLOT0. Can't pack both.
#
# Instead: S_LW_WITH_IMM + ADD32 (cross-slot). Then S_SW_WITH_IMM separately.
# S_LW_WITH_IMM r2, r0, 0 -> 1R(r0), 1W(r2), SLOT0
# ADD32 r3, r4, r5 -> 2R(r4,r5), 1W(r3), SLOT1
# Total: 3R, 2W. Within 4R2W. DFA: SLOT0 + SLOT1 -> bundle.
# S_SW_WITH_IMM r2, r1, 0 -> 2R(r2,r1), 0W, SLOT0. RAW on r2 (written by S_LW_WITH_IMM).
# Wait — S_SW_WITH_IMM reads r2, and S_LW_WITH_IMM writes r2. RAW hazard! Separate bundle.
#
# Let me redesign: use independent registers.
# S_LW_WITH_IMM r2, r0, 0 -> 1R(r0), 1W(r2), SLOT0
# ADD32 r3, r4, r5 -> 2R(r4,r5), 1W(r3), SLOT1
# Total: 3R, 2W. Within limits. No RAW (all different regs).
# S_SW_WITH_IMM r6, r7, 0 -> 2R(r6,r7), SLOT0. No RAW with above (different regs).
# But S_SW_WITH_IMM + S_LW_WITH_IMM both need SLOT0. And S_SW_WITH_IMM is a store after load.
# This goes into a new bundle.
#
name:            test6_ld_st_alu_at_limit
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
  - { reg: '$r5', virtual-reg: '' }
  - { reg: '$r6', virtual-reg: '' }
  - { reg: '$r7', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r4, $r5, $r6, $r7

    ; S_LW_WITH_IMM (SLOT0) + ADD32 (SLOT1) bundle: 3R, 2W.
    ; No RAW hazard: S_LW_WITH_IMM writes r2, ADD32 reads r4,r5.
    ; S_SW_WITH_IMM uses SLOT0. No dependency with above (r6,r7 are independent).

    ; CHECK-LABEL: name: test6_ld_st_alu_at_limit
    ; CHECK: liveins: $r0, $r4, $r5, $r6, $r7
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE 1, implicit-def $r2, implicit-def dead $sfr, implicit-def $r3, implicit $r0, implicit killed $r4, implicit killed $r5 {
    ; CHECK-NEXT:   $r2 = S_LW_WITH_IMM_P32_LOAD1 $r0, 0, implicit-def dead $sfr
    ; CHECK-NEXT:   $r3 = ADD32_P31_ALU0 killed $r4, killed $r5, implicit-def dead $sfr
    ; CHECK-NEXT: }
    ; CHECK-NEXT: S_SW_WITH_IMM_P30_LOADSTORE0 killed $r6, killed $r7, 0, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY killed $r2
    ; CHECK-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = S_LW_WITH_IMM $r0, 0, implicit-def dead $sfr
    $r3 = ADD32 $r4, $r5, implicit-def dead $sfr
    S_SW_WITH_IMM $r6, $r7, 0, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
