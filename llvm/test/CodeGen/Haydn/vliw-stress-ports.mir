# ============================================================================
# Test 4: DR64 ops don't count toward GPR ports — pack freely
# ============================================================================
#
# ADD64, SUB64, OR64 all use DR64 registers only. countGPRPorts returns (0,0)
# for each. GPR port budget is unaffected. The limit is DFA slots:
# Slot12_ALU provides SLOT1+SLOT2 (max 2 DR64 ALU ops per bundle).
#
name:            test4_dr64_no_port_conflict
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$d1', virtual-reg: '' }
  - { reg: '$d2', virtual-reg: '' }
  - { reg: '$d3', virtual-reg: '' }
  - { reg: '$d4', virtual-reg: '' }
  - { reg: '$d5', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $d0, $d1, $d2, $d3, $d4, $d5

    ; Two DR64 ops bundle (SLOT1 + SLOT2). GPR ports: 0R, 0W.
    ; Third DR64 op needs a slot, but both SLOT1 and SLOT2 are taken.

    ; CHECK-LABEL: name: test4_dr64_no_port_conflict
    ; CHECK: liveins: $r0, $d0, $d1, $d2, $d3, $d4, $d5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $d6 = ADD64{{.*}} killed $d0, killed $d1, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY{{.*}} $r0
    ; CHECK-NEXT: $d7 = SUB64{{.*}} killed $d2, killed $d3, implicit-def dead $sfr
    ; CHECK-NEXT: $d8 = OR64{{.*}} killed $d4, killed $d5, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $d6 = ADD64 $d0, $d1, implicit-def dead $sfr
    $d7 = SUB64 $d2, $d3, implicit-def dead $sfr
    $d8 = OR64 $d4, $d5, implicit-def dead $sfr

    $r0 = COPY $r0
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 5: Mixed GPR + DR64 — only GPR ops consume port budget
# ============================================================================
#
# ADD32 (2R, 1W GPR) + ADD64 (0R, 0W GPR) + SUB64 (0R, 0W GPR).
# GPR total: 2R, 1W — well within 4R2W.
# DFA: ADD32 -> SLOT0, ADD64 -> SLOT1, SUB64 -> SLOT2.
# All independent registers -> full 3-issue bundle.
#
name:            test5_mixed_gpr_dr64_ports
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$d1', virtual-reg: '' }
  - { reg: '$d2', virtual-reg: '' }
  - { reg: '$d3', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $d0, $d1, $d2, $d3

    ; Post-: the GPR-port-FuncUnits model is reverted; the DFA uses
    ; the slot-only itinerary. DR64-only ops in Slot12_ALU are NOT charged
    ; against GPR ports, so all three (ADD32 + ADD64 + SUB64) pack into one
    ; bundle (2R1W GPR + 2 DR64 pairs — within the 4R2W GPR gate enforced by
    ; countGPRPorts).

    ; Full 3-issue: ADD64 + SUB64 (DR slots) + ADD32 (GPR). GPR demand 2R1W;
    ; DR demand independent. Member slot assignment is exact-nondominated.
    ; CHECK-LABEL: name: test5_mixed_gpr_dr64_ports
    ; CHECK: liveins: $r0, $r1, $d0, $d1, $d2, $d3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2 = ADD32{{.*}} $r0, killed $r1, implicit-def dead $sfr
    ; CHECK-NEXT: $d4 = ADD64{{.*}} killed $d0, killed $d1, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY{{.*}}$r2
    ; CHECK-NEXT: $d5 = SUB64{{.*}} killed $d2, killed $d3, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    $d4 = ADD64 $d0, $d1, implicit-def dead $sfr
    $d5 = SUB64 $d2, $d3, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 6: LD32 + ST32 + ADD32 — GPR ports with memory operations
# ============================================================================
#
# LD32 r2, r0, 0 -> reads r0 (1R), writes r2 (1W), uses SLOT0
# ST32 r3, r1, 0 -> reads r3, r1 (2R), writes nothing visible (0W), uses SLOT0
# Wait — both LD32 and ST32 need SLOT0. Can't pack both.
#
# Instead: LD32 + ADD32 (cross-slot). Then ST32 separately.
# LD32 r2, r0, 0 -> 1R(r0), 1W(r2), SLOT0
# ADD32 r3, r4, r5 -> 2R(r4,r5), 1W(r3), SLOT1
# Total: 3R, 2W. Within 4R2W. DFA: SLOT0 + SLOT1 -> bundle.
# ST32 r2, r1, 0 -> 2R(r2,r1), 0W, SLOT0. RAW on r2 (written by LD32).
# Wait — ST32 reads r2, and LD32 writes r2. RAW hazard! Separate bundle.
#
# Let me redesign: use independent registers.
# LD32 r2, r0, 0 -> 1R(r0), 1W(r2), SLOT0
# ADD32 r3, r4, r5 -> 2R(r4,r5), 1W(r3), SLOT1
# Total: 3R, 2W. Within limits. No RAW (all different regs).
# ST32 r6, r7, 0 -> 2R(r6,r7), SLOT0. No RAW with above (different regs).
# But ST32 + LD32 both need SLOT0. And ST32 is a store after load.
# This goes into a new bundle.
#
name:            test6_ld_st_alu_at_limit
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
  - { reg: '$r5', virtual-reg: '' }
  - { reg: '$r6', virtual-reg: '' }
  - { reg: '$r7', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r4, $r5, $r6, $r7

    ; LD32 (SLOT0) + ADD32 (SLOT1) bundle: 3R, 2W.
    ; No RAW hazard: LD32 writes r2, ADD32 reads r4,r5.
    ; ST32 uses SLOT0. No dependency with above (r6,r7 are independent).

    ; CHECK-LABEL: name: test6_ld_st_alu_at_limit
    ; CHECK: liveins: $r0, $r4, $r5, $r6, $r7
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2 = {{LD32|S_LW_WITH_IMM}}{{.*}} $r0, 0, implicit-def dead $sfr
    ; CHECK-NEXT: $r3 = ADD32{{.*}} killed $r4, killed $r5, implicit-def dead $sfr
    ; CHECK-NEXT: {{ST32|S_SW_WITH_IMM}}{{.*}} killed $r6, killed $r7, 0, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY{{.*}}$r2
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = LD32 $r0, 0, implicit-def dead $sfr
    $r3 = ADD32 $r4, $r5, implicit-def dead $sfr
    ST32 $r6, $r7, 0, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
