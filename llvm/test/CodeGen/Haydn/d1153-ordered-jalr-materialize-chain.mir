# D1.153: getJalrAddrMaterializeChain is a reaching-def state machine.
# Nearest ADDI on JALR rs, then that ADDI's exact LUI producer (COPY/MOVE32
# explicit). Reverse-walk LUI then ADDI is not complete: forward
# ADDI -> LUI -> JALR must named-refuse retarget (D1.141 is not this proof).
#
# Layout (d1124/d176): 180 NOP parcels in bb.1 put TBB %bb.2 past
# WIDE_BranchSImm12 (buffer=4); FBB %bb.1 stays near.
#
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-longbranch-normalize \
# RUN:   -haydn-branch-relax-safety-buffer=4 -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s
# REQUIRES: haydn-registered-target

--- |
  define void @swapped_addi_lui_refuse(i32 %c) {
  entry:
    br i1 undef, label %far, label %near
  near:
    ret void
  far:
    ret void
  }
  define void @broken_source_refuse(i32 %c) {
  entry:
    br i1 undef, label %far, label %near
  near:
    ret void
  far:
    ret void
  }
  define void @duplicate_clobber_refuse(i32 %c) {
  entry:
    br i1 undef, label %far, label %near
  near:
    ret void
  far:
    ret void
  }
  define void @copy_mediated_move32(i32 %c) {
  entry:
    br i1 undef, label %far, label %near
  near:
    ret void
  far:
    ret void
  }
  define void @copy_mediated_copy(i32 %c) {
  entry:
    br i1 undef, label %far, label %near
  near:
    ret void
  far:
    ret void
  }
...
---
name:            swapped_addi_lui_refuse
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r6', virtual-reg: '' }
  - { reg: '$r15', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        false
body:             |
  bb.0.entry:
    successors: %bb.2, %bb.1
    liveins: $r1, $r6, $r15
    ; CHECK-LABEL: name: swapped_addi_lui_refuse
    ; CHECK: bb.0.entry
    ; CHECK: $r6 = ADDI32{{.*}}%bb.1
    ; CHECK: $r6 = LUI %bb.1
    ; CHECK: BNEZ{{.*}}%bb.2
    ; CHECK: JALR
    ; CHECK-NOT: LUI %bb.2
    $r6 = ADDI32_W $r6, %bb.1
    $r6 = LUI %bb.1
    BNEZ_W $r1, %bb.2
    $r6 = JALR_W $r6, 0

  bb.1.near:
    liveins: $r15
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
