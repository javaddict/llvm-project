# D1.49 pins: the LongBranchNormalize scratch picker is COMPUTED liveness,
# never stored MBB livein lists; every retained-control operand (explicit +
# implicit, TRI::regsOverlap) is excluded; pristine CSRs are refused
# fail-closed BEFORE any mutation (no AllowUnusedCSR fallback, no spill).
#
# Far template (gr27-d134 law, buffer=4, parcel=12, window edge 2044):
#   bb.0 = BEQZ_W(cond, %bb.2) + B %bb.1 (24B) ; bb.1 = 169 NOPs (2028B)
#   fallthrough ; bb.2 starts at 2052 -> the BEQZ site-0 offset 2052 > 2044
#   is FAR. RETAIN adds one more tail terminator (bb.0 = 36B, trailing B
#   site 24) and 170 NOPs (bb.2 at 2076, off 2052).
#
# Arms:
#   GREEN   : one computed-dead GPR exists ($r6: no use anywhere on either
#             out-edge walk) -> promotion proceeds; scratch is $r6, never
#             the cond $r7.
#   THROUGH : every non-CSR candidate is READ by the bb.2 body but NO
#             stored livein names it; CSRs are unmentioned AND CSI is
#             invalid (no pristine seeding possible) -> both the computed
#             walk (successor reads) and the CSI-independent
#             isPhysRegUsed refusal are required to exhaust. Tail intact.
#   PRISTINE arm — same as THROUGH but CSI valid + empty; the walk seeds
#             all unsaved CSRs live-out of the return block (pristines)
#             and refuses R8-R11 through the LivePhysRegs law itself.
#   RETAIN  : unanalyzable tail (two conds + far trailing B; Arm B). The
#             retained conds read $r4/$r5; every other candidate is read
#             by bb.2; the retired exact-ID Cond Forbid was EMPTY on an
#             unanalyzable tail and the stored-livein probe saw none of
#             these uses. Tail intact (all three terminators survive).
#             On the flat Haydn GPR model (HaydnRegisterInfo.td defines
#             no GPR subregs/aliases) regsOverlap reduces to identity, so
#             this arm pins the operand-COVERAGE half of the alias law
#             (implicit operands and retained controls included); the
#             subreg half is vacuous by construction.
#   USEDCSR : $r8 IS mentioned (bb.0 body, dead after) and computed-dead
#             on both out-edge walks -> a MENTIONED CSR (PEI-saved class)
#             is pickable; pins that the CSR refusal is the pristine law,
#             not a blanket CSR ban. (bb.1 pads 170 NOPs: the ADD32 shifts
#             the BEQZ site to 12, so bb.2 at 2064 keeps the site far.)
#   POISON  : the guarded-tail wrong-code class (ls_reg_scalar CHECK(13),
#             guest_exit=13). bb.0's NEAR successor bb.1 is ALREADY
#             promoted: 169 NOPs then the guarded long form
#             LUI/ADDI/BEQZ_W($r2 near)/JALR_W($r6 fail), and the trailing
#             JALR_W bundle carries the call-saved implicit defs
#             $r1..$r7/$r12/$d0..$d7. $r6 is LIVE-THROUGH bb.0's near
#             chain: bb.1's stored liveins name it, and its ONLY use is
#             bb.3 (reached on bb.1's TAKEN near edge) — the JALR never
#             executes on that path. The UNGUARDED stepBackward walk
#             treats the JALR_W implicit-def $r6 as a kill, so livein(bb.1)
#             drops it and the picker "proves" $r6 dead at bb.0 — every
#             other candidate is read by the far successor bb.2, so $r6 is
#             picked (red-proof: the unguarded build picks $r6 HERE). The
#             guarded walk ignores defs of terminators strictly after
#             bb.1's first terminator: $r6 stays live, bb.0 refuses, the
#             tail survives byte-identically, no LUI.
#
# Every negative arm proves refusal precedes mutation: the far site's
# terminators are byte-identical and no LUI/ADDI32/JALR was inserted.

# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-longbranch-normalize -haydn-branch-relax-safety-buffer=4 -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=GREEN
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-longbranch-normalize -haydn-branch-relax-safety-buffer=4 -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=THROUGH
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-longbranch-normalize -haydn-branch-relax-safety-buffer=4 -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=PRISTINE
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-longbranch-normalize -haydn-branch-relax-safety-buffer=4 -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=RETAIN
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-longbranch-normalize -haydn-branch-relax-safety-buffer=4 -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=USEDCSR
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-longbranch-normalize -haydn-branch-relax-safety-buffer=4 -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=POISON
# REQUIRES: haydn-registered-target

--- |
  define dso_local void @green() {
  entry:
    br i1 undef, label %far, label %near
  near:
    br label %far
  far:
    ret void
  }

  define dso_local void @through() {
  entry:
    br i1 undef, label %far, label %near
  near:
    br label %far
  far:
    ret void
  }

  define dso_local void @pristine() {
  entry:
    br i1 undef, label %far, label %near
  near:
    br label %far
  far:
    ret void
  }

  define dso_local void @retain() {
  entry:
    br i1 undef, label %far, label %near
  near:
    br label %far
  far:
    ret void
  }

  define dso_local void @used_csr() {
  entry:
    br i1 undef, label %far, label %near
  near:
    br label %far
  far:
    ret void
  }

  define dso_local void @poison() {
  entry:
    br i1 undef, label %far, label %near
  near:
    br label %far
  far:
    ret void
  }
...
---
name:            green
alignment:       1
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r7, $r15
    successors: %bb.1, %bb.2
    BEQZ_W $r7, %bb.2, implicit-def dead $sfr
    B %bb.1

  bb.1.near:
    successors: %bb.2
    liveins: $r15
    NOP
