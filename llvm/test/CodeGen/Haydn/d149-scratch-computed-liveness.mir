    $r6 = LUI_E2_E0_ALU0_I12 %bb.4
    $r6 = ADDI32_E2_E0_ALU0_RI20 $r6, %bb.4
    BEQZ_W $r2, %bb.3, implicit-def dead $sfr
    BUNDLE implicit-def $r6, implicit-def $r1, implicit-def $r2, implicit-def $r3, implicit-def $r4, implicit-def $r5, implicit-def $r7, implicit-def $r12, implicit-def $d0, implicit-def $d1, implicit-def $d2, implicit-def $d3, implicit-def $d4, implicit-def $d5, implicit-def $d6, implicit-def $d7, implicit $r6 {
      $r6 = JALR_W $r6, 0, implicit-def $r1, implicit-def $r2, implicit-def $r3, implicit-def $r4, implicit-def $r5, implicit-def $r6, implicit-def $r7, implicit-def $r12, implicit-def $d0, implicit-def $d1, implicit-def $d2, implicit-def $d3, implicit-def $d4, implicit-def $d5, implicit-def $d6, implicit-def $d7
    }

  bb.2.far:
    liveins: $r2, $r3, $r4, $r5, $r7, $r12, $r15
    ST32 $r2, $r2, 0, implicit-def dead $sfr
    ST32 $r3, $r3, 0, implicit-def dead $sfr
    ST32 $r4, $r4, 0, implicit-def dead $sfr
    ST32 $r5, $r5, 0, implicit-def dead $sfr
    ST32 $r7, $r7, 0, implicit-def dead $sfr
    ST32 $r12, $r12, 0, implicit-def dead $sfr
    RET implicit killed $r15

  bb.3:
    liveins: $r6, $r15
    ST32 $r6, $r6, 0, implicit-def dead $sfr
    RET implicit killed $r15

  bb.4:
    liveins: $r15
    RET implicit killed $r15

# POISON-LABEL: name: poison
# $r6 is LIVE-THROUGH bb.0 -> bb.2 (bb.2 reads it; no stored livein names
# it). The already-promoted bb.1 tail's trailing JALR_W carries
# implicit-def $r6, which an UNGUARDED walk treats as a kill — "proving"
# $r6 dead at bb.0 (the ls_reg_scalar guest_exit=13 wrong-code class).
# The guarded walk keeps $r6 live: bb.0 refuses before any mutation; the
# original terminators survive byte-identically and no LUI is inserted.
# POISON-NOT: LUI
# POISON: BEQZ_W $r1, %bb.2
# POISON: B %bb.1
