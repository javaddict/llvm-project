# GREEN-LABEL: name: green
# Computed-dead $r6 (unmentioned CSRs R8-R11 refused, cond $r7 refused,
# nothing else is live on either out-edge walk).
# GREEN-NOT: $r7 = LUI
# GREEN: $r6 = LUI_E2_E0_ALU0_I12 %bb.2
# GREEN: $r6 = ADDI32_E2_E0_ALU0_RI20 $r6, %bb.2
# GREEN: BNEZ_W $r7, %bb.1
# GREEN: JALR_W $r6
...
