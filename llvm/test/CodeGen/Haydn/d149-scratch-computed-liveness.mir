  bb.2.far:
    liveins: $r2, $r3, $r4, $r5, $r6, $r7, $r12, $r15
    ST32 $r2, $r2, 0, implicit-def dead $sfr
    ST32 $r3, $r3, 0, implicit-def dead $sfr
    ST32 $r4, $r4, 0, implicit-def dead $sfr
    ST32 $r5, $r5, 0, implicit-def dead $sfr
    ST32 $r6, $r6, 0, implicit-def dead $sfr
    ST32 $r7, $r7, 0, implicit-def dead $sfr
    ST32 $r12, $r12, 0, implicit-def dead $sfr
    RET implicit killed $r15

# USEDCSR-LABEL: name: used_csr
# $r8 is mentioned (bb.0 body, dead after — no successor reads it) and
# computed-dead on both out-edge walks: a MENTIONED CSR is pickable, so
# the refusal is the pristine law, not a CSR ban. Scratch is $r8.
# USEDCSR-NOT: $r1 = LUI
# USEDCSR: $r8 = LUI_E2_E0_ALU0_I12 %bb.2
# USEDCSR: $r8 = ADDI32_E2_E0_ALU0_RI20 $r8, %bb.2
# USEDCSR: BNEZ_W $r1, %bb.1
# USEDCSR: JALR_W $r8
...

---
name:            poison
alignment:       1
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r12, $r15
    successors: %bb.1, %bb.2
    BEQZ_W $r1, %bb.2, implicit-def dead $sfr
    B %bb.1

  bb.1.near:
    successors: %bb.3, %bb.4
    liveins: $r2, $r6, $r15
    NOP
    NOP
    NOP
    NOP
    NOP
