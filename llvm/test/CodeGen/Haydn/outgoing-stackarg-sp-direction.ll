; RUN: llc -mtriple=haydn-unknown-elf -global-isel-abort=1 -verify-machineinstrs < %s | FileCheck %s

; Role: semantic — outgoing stack-arg SP adjustment decreases SP before the
; call (positive subi32 amount) and restores after (positive addi32 amount).

; Bug: eliminateCallFramePseudoInstr negated ADJCALLSTACKDOWN and then
; emitted SUBI32, so SP grew up instead of down; later 8-byte stores faulted.
; Fix: SUBI32 takes the positive amount directly.
;
; 5 i64 args fill D0-D3; the 5th goes on the stack. Pin positive frame
; adjustments around the call (no negative immediates on subi32/addi32 sp).

; Prologue frame + at least one positive SP decrease for outgoing / temp space.
; Post-call restore: SP increases by a positive amount (not negative addi).

declare i64 @sink_i64(i64, i64, i64, i64, i64)

define i64 @caller_5th_i64_spills(i64 %x) {
; CHECK-LABEL: caller_5th_i64_spills:
; CHECK:       // %bb.0:
; CHECK-NEXT:    { nop; xor32 r0, r0, r0 }
; CHECK-NEXT:    { nop; subi32 sp, sp, 16 }
; CHECK-NEXT:    { nop; st32 lr, sp, 3 }
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    .cfi_offset lr, -4
; CHECK-NEXT:    { nop; addi32 r1, r0, 1 }
; CHECK-NEXT:    { nop; sext32t64 d4, r1 }
; CHECK-NEXT:    { nop; addi32 r1, r0, 2 }
; CHECK-NEXT:    { nop; sext32t64 d1, r1; slli64 d4, d4, 32 }
; CHECK-NEXT:    { nop; addi32 r1, r0, 3 }
; CHECK-NEXT:    { nop; sext32t64 d2, r1; slli64 d1, d1, 32 }
; CHECK-NEXT:    { nop; addi32 r1, r0, 4 }
; CHECK-NEXT:    { nop; sext32t64 d3, r1; slli64 d2, d2, 32 }
; CHECK-NEXT:    { nop; slli64 d3, d3, 32; srli64 d4, d4, 32 }
; CHECK-NEXT:    { nop; srli64 d1, d1, 32; srli64 d2, d2, 32 }
; CHECK-NEXT:    { nop; srli64 d3, d3, 32 }
; CHECK-NEXT:    { nop; subi32 sp, sp, 8 }
; CHECK-NEXT:    { nop; st64 d0, sp, 0 }
; CHECK-NEXT:    { nop; nop }
; CHECK-NEXT:    { nop; or64 d0, d4, d4 }
; CHECK-NEXT:    { nop; jal lr, sink_i64 }
; CHECK-NEXT:    { nop; xor32 r0, r0, r0 }
; CHECK-NEXT:    { nop; addi32 sp, sp, 8 }
; CHECK-NEXT:    { nop; xor32 r0, r0, r0 }
; CHECK-NEXT:    { nop; ld32 lr, sp, 3 }
; CHECK-NEXT:    { nop; addi32 sp, sp, 16 }
; CHECK-NEXT:    .cfi_def_cfa sp, 0
; CHECK-NEXT:    { nop; jalr r0, lr, 0 }
 %r = call i64 @sink_i64(i64 1, i64 2, i64 3, i64 4, i64 %x)
 ret i64 %r
}
