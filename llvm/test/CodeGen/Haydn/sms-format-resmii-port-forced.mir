# RUN: llc -mtriple=haydn-unknown-elf -mattr=-hwloop -run-pass=pipeliner \
# RUN:   -debug-only=pipeliner -verify-machineinstrs %s -o /dev/null 2>&1 \
# RUN:   | FileCheck %s --check-prefix=PORT
# RUN: llc -mtriple=haydn-unknown-elf -mattr=-hwloop -run-pass=pipeliner \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=HANDOFF
# REQUIRES: asserts

# Role: MIR — GR2.1 Kind-A ResMII pin: three independent ADD32 (1W each) now
# pack in ONE pre-RA modulo cycle (IssueWidth cap = E3 entry capacity = 3); the
# GPR 2W port budget no longer binds the pre-RA MII (exact ports are post-RA).

# Kind-A restamp: 3 independent ADD32 fit one issue cycle (3 entries), so
# Return Res MII == 1. Post-RA packing still pays the GPR 2W law (cycle-slip),
# which is the post-RA scheduler's business, never a pre-RA MII input.
#   ZOL form keeps the body to the three ALU ops; schedule acceptance is out
#   of scope for this ResMII pin.
# Companion: sms-format-resmii.mir, sms-format-resmii-move32-port.mir.
# Unit peer: HaydnIssueWidthCycleTest.PacksExactlyIssueWidthThenRejects.
#
# PORT-NOT: SMS-HOOK: reject
# PORT-NOT: SMS-HANDOFF: reject
# PORT-NOT: Unable to analyzeLoop
# PORT: SMS-HANDOFF: coverage ok
# Kind-A: 3 ADD32 pack in one cycle (IssueWidth cap; no port budget pre-RA).
# PORT: Return Res MII:1

--- |
  define void @sms_port_forced_resmii(i32 %n, i32 %a, i32 %b, i32 %c) #0 {
  entry:
    br label %loop
  loop:
    br label %exit
  exit:
    ret void
  }
  attributes #0 = { "target-features"="-hwloop" }
...
---
name:            sms_port_forced_resmii
alignment:       16
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          false
isSSA:           true
noVRegs:         false
registers:
  - { id: 0, class: gpr32 }
  - { id: 1, class: gpr32 }
  - { id: 2, class: gpr32 }
  - { id: 3, class: gpr32 }
  - { id: 4, class: gpr32 }
  - { id: 5, class: gpr32 }
  - { id: 6, class: gpr32 }
  - { id: 7, class: gpr32 }
  - { id: 8, class: gpr32 }
  - { id: 9, class: gpr32 }
  - { id: 10, class: gpr32 }
liveins:
  - { reg: '$r1' }
  - { reg: '$r2' }
  - { reg: '$r3' }
  - { reg: '$r4' }
frameInfo:
  maxAlignment:    1
machineFunctionInfo: {}
body:             |
  bb.1.entry:
    liveins: $r1, $r2, $r3, $r4

    %0:gpr32 = COPY $r1
    %1:gpr32 = COPY $r2
    %2:gpr32 = COPY $r3
    %3:gpr32 = COPY $r4
    %4:gpr32 = LOADI32 1
    LoopStart %0, -1

  bb.2.loop:
    successors: %bb.2(0x7c000000), %bb.3(0x04000000)

    %5:gpr32 = PHI %1, %bb.1, %6, %bb.2
    %7:gpr32 = PHI %2, %bb.1, %8, %bb.2
    %9:gpr32 = PHI %3, %bb.1, %10, %bb.2
    ; Three independent GPR writes — Full slots fit all three; 2W pool does not.
    %6:gpr32 = ADD32 %5, %4
    %8:gpr32 = ADD32 %7, %4
    %10:gpr32 = ADD32 %9, %4
    PseudoLoopEnd %bb.2

  bb.3.exit:
    RET implicit $r15

  ; HANDOFF-LABEL: name: sms_port_forced_resmii
  ; Logical only — no durable pre-RA BUNDLE from SMS expansion.
  ; HANDOFF-NOT: BUNDLE
  ; HANDOFF: ADD32

...
