    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    RET implicit killed $r15

  bb.2.far:
    liveins: $r15
    RET implicit killed $r15

# PRE-LABEL: name:            bundle_invert_keeps_cond_child
# PRE: bb.0.entry
# PRE: BUNDLE
# PRE-NEXT: {{.*}}LUI{{.*}}%bb.2
# PRE-NEXT: }
# PRE: BUNDLE
# PRE-NEXT: {{.*}}ADDI32{{.*}}%bb.2
# PRE-NEXT: }
# PRE: BUNDLE
# PRE-NEXT: $r3 = ADD32
# PRE-NEXT: BNEZ{{.*}} $r7, %bb.1
# PRE-NEXT: }
# PRE-NOT: B %bb.
# PRE: BUNDLE
# PRE-NEXT: {{.*}}JALR
# PRE-NEXT: }
# PRE-NOT: B %bb.
# PRE: bb.1.near
#
# POST-LABEL: name:            bundle_invert_keeps_cond_child
# POST: bb.0.entry
# POST: BUNDLE
# POST: LUI{{.*}}%bb.2
# POST: BUNDLE
# POST: ADDI32{{.*}}%bb.2
# POST: BUNDLE
# POST: $r3 = ADD32
# POST-NEXT: BNEZ{{.*}} $r7, %bb.1
# POST-NOT: BEQZ{{.*}} $r7
# POST-NOT: B %bb.
# POST: BUNDLE
# POST: JALR
# POST-NOT: B %bb.
# POST: bb.1.near
