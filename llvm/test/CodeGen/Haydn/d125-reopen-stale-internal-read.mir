# REQUIRES: haydn-registered-target
# REQUIRES: asserts
# RUN: llc -mtriple=haydn-unknown-elf -mcpu=haydn -x mir \
# RUN:   -start-before=haydn-expand-pseudos \
# RUN:   -stop-after=haydn-late-convergence -o - %s | FileCheck %s
# RUN: llc -mtriple=haydn-unknown-elf -mcpu=haydn -x mir \
# RUN:   -start-before=haydn-expand-pseudos \
# RUN:   -stop-after=haydn-late-convergence -o /dev/null %s \
# RUN:   -debug-only=haydn-post-ra-sched 2>&1 | FileCheck %s --check-prefix=REOPEN

# D1.25 reopen stale IsInternalRead pin. finalizeBundle only ever SETS
# IsInternalRead (a member use that reads an in-parcel LocalDefs register is
# marked internal — MachineInstrBundle.cpp "adds IsInternalRead markers");
# it never clears. Every site that dissolves or re-bakes a committed parcel
# back to bare MIs therefore clears the flag first
# (HaydnBundleMaterialize.cpp pre-pack clear, HaydnPostRASchedStrategy.cpp
# sequentializeMultiMemberRoot / unstamped dissolve, HaydnFixupHwLoops.cpp
# sequentialize) — reopenProvisionalBundles was the one dissolve seat that
# restored BundledPred/BundledSucc but left the operand flag behind.
#
# Why it matters: readsReg() returns false for an internal-read operand, so
# a stale flag on a reopened bare MI hides the read from the ONE shared
# no-forwarding seat haydnHasIntraCycleRAW (HaydnIntraCycleRAW.h) that the
# incremental HR walk (HaydnHazardRecognizer::hasSameBundleRAW) and SMS
# placement use — the same-cycle true RAW below becomes invisible to the
# seat that must reject the coissue.
#
# Shape: two committed singleton parcels. The reader parcel's XOR32 carries
# an internal marker on its $r2 use (the state finalizeBundle leaves on a
# member; commit's own probe refuses true-RAW packs, so a dissolved-then-
# rebased member is the carrier into S2). Product sms2 ON: the first S2
# invocation (bumpPostRASchedInvocation()==2) reopens both roots, and the
# bare logical ADD32/XOR32 pair re-enters scheduling with pre-bundle
# operand semantics: no stale internal read, and the live-def -> reader $r2
# pair stays a same-cycle-RAW pair the seat sees (no coissue; the reader
# lands in a strictly later parcel).

--- |
  define void @f() { ret void }
...
---
name:            f
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r3, $r15
    BUNDLE 1, 0, implicit-def $r2, implicit-def dead $sfr, implicit $r0, implicit $r1 {
      $r2 = ADD32_E3_E0_ALU2_RR $r0, $r1, implicit-def dead $sfr
    }
    BUNDLE 1, 0, implicit-def $r5, implicit-def dead $sfr, implicit $r2, implicit $r3 {
      $r5 = XOR32_E3_E1_ALU1_RR internal $r2, $r3, implicit-def dead $sfr
    }
    $r0 = JALR_E2_E0_ALU0_RI12 $r15, 0

# True-RAW separation pin: the writer's live $r2 def and the reader's $r2
# use are a no-forwarding same-cycle RAW pair, so they never share one
# parcel and the reader is emitted strictly later (schedule order preserved
# as a legal multi-cycle RAW).
# CHECK: $r2 = ADD32
# CHECK-NOT: XOR32
# CHECK: $r5 = XOR32
# THE red/green pin: reopened members re-enter S2 as bare MIs with
# pre-bundle operand semantics — no stale internal read survives on the
# reader's $r2 use. Unpatched reopen left "internal $r2" on the reader
# (finalizeBundle set it; nothing cleared it), and that hidden read is
# exactly what readsReg()-based seats could not see.
# CHECK-NOT: internal $r2
# First S2 invocation reopened a positive number of provisional roots here
# (every parcel is identity-recoverable: DIRECT member->logical).
# REOPEN: HaydnPostRASched {{S2}}: reopened {{[1-9][0-9]*}} provisional BUNDLE root(s) in f
