# RUN: llc -mtriple=haydn-unknown-elf -x mir \
# RUN:   -start-after=livedebugvalues -filetype=obj %s -o %t.o
# RUN: llvm-objdump -d -z --triple=haydn-unknown-elf %t.o | FileCheck %s
# REQUIRES: haydn-registered-target

# Role: FieldSlot suffix-≠-entry premise retired; generated E2 e0 member
# serializes. ADD32_E2_E0_ALU0_RR under E2 entry0 (composite position)
# must serialize as-is.

--- |
  define void @residual_s2_at_e0() { ret void }
...
---
name:            residual_s2_at_e0
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r15
    ; CHECK-LABEL: <residual_s2_at_e0>:
    ; CHECK: add32
    BUNDLE 0, 0, implicit-def $r2, implicit-def dead $sfr, implicit $r0, implicit $r1 {
      $r2 = ADD32_E2_E0_ALU0_RR $r0, $r1, implicit-def dead $sfr
    }
    BUNDLE 0, 0 {
      $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    }
...
