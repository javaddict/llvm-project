# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postmisched -verify-machineinstrs %s -o - | FileCheck %s

# Role: MIR — VLIW Packetizer Hazard Tests.


# REBASELINED : / pipeline reorder (ExpandPseudos/BitSimplify pre-scheduler + materialize at leaveRegion) — bundles regrouped, ops unchanged.
#
# VLIW Packetizer Hazard Tests
#
# Verifies that the packetizer correctly PREVENTS bundling when register
# hazards (RAW, WAW) exist. VLIW bundles execute in parallel — instructions
# with RAW dependencies MUST be in separate bundles because the consumer
# would read the stale pre-bundle value, not the producer's result.
#
# Note: The base class VLIWPacketizerList only creates BUNDLE instructions
# for multi-instruction packets (size > 1). Single-instruction packets have
# no BUNDLE wrapper in MIR. The AsmPrinter handles D-class 64-bit wrapping
# for ALL instructions (bundled and non-bundled) at emission time.
#

--- |
  define i32 @test1_raw_prevents_bundle() { ret i32 0 }
  define void @test2_raw_dr64_prevents_bundle() { ret void }
  define void @test3_independent_can_bundle() { ret void }
...
---
# ============================================================================
# Test 1: RAW-dependent ADD32 chain — no bundling
# ============================================================================
#
# Three ADD32 instructions with RAW register dependencies:
# $r2 = ADD32 $r0, $r1 (def $r2)
# $r3 = ADD32 $r2, $r1 (reads $r2 -- RAW)
# $r4 = ADD32 $r3, $r0 (reads $r3 -- RAW)
#
# No two of these can be in the same packet. Verify no BUNDLE is created.
#
name:            test1_raw_prevents_bundle
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1

    ; No BUNDLE should be created — all three are RAW-dependent.

    ; CHECK-LABEL: name: test1_raw_prevents_bundle
    ; CHECK: liveins: $r0, $r1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2 = ADD32{{.*}} $r0, $r1, implicit-def dead $sfr
    ; CHECK-NEXT: $r3 = ADD32{{.*}} killed $r2, killed $r1, implicit-def dead $sfr
    ; CHECK-NEXT: $r4 = ADD32{{.*}} killed $r3, $r0, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY{{.*}} killed $r4
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    $r3 = ADD32 $r2, $r1, implicit-def dead $sfr
    $r4 = ADD32 $r3, $r0, implicit-def dead $sfr

    $r0 = COPY $r4
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 2: RAW on DR64 prevents bundling
# ============================================================================
#
# ADD64 (Slots 1/2) writes $d0, SUB64 reads $d0 — RAW hazard.
# Must execute sequentially.
#
name:            test2_raw_dr64_prevents_bundle
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$d1', virtual-reg: '' }
  - { reg: '$d2', virtual-reg: '' }
  - { reg: '$d3', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $d0, $d1, $d2, $d3

    ; RAW on DR64: no BUNDLE

    ; CHECK-LABEL: name: test2_raw_dr64_prevents_bundle
    ; CHECK: liveins: $r0, $d0, $d1, $d2, $d3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $d0 = ADD64{{.*}} killed $d2, killed $d3, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY{{.*}} $r0
    ; CHECK-NEXT: $d4 = SUB64{{.*}} killed $d0, killed $d1, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $d0 = ADD64 $d2, $d3, implicit-def dead $sfr
    $d4 = SUB64 $d0, $d1, implicit-def dead $sfr

    $r0 = COPY $r0
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 3: Independent instructions CAN bundle
# ============================================================================
#
# ADD32 and ADD64 that read/write completely different registers.
# No RAW/WAW hazard → should be bundled together.
#
name:            test3_independent_can_bundle
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$d1', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $d0, $d1

    ; No RAW/WAW: ADD32 writes $r2 (GPR), ADD64 writes $d2 (DR64).
    ; These should be bundled together.

    ; CHECK-LABEL: name: test3_independent_can_bundle
    ; CHECK: liveins: $r0, $r1, $d0, $d1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2 = ADD32{{.*}} $r0, killed $r1, implicit-def dead $sfr
    ; CHECK-NEXT: $d2 = ADD64{{.*}} killed $d0, killed $d1, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY{{.*}} killed $r2
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    $d2 = ADD64 $d0, $d1, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
