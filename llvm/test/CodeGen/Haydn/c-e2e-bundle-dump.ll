;===------------------------------------------------------------------===;
; Section 13: FIR filter kernel -- MAC in a loop with loads/stores
;
; Corresponding C:
; int64_t fir_filter(const int64_t *x, const int64_t *h, int n) {
; int64_t acc = 0;
; for (int i = 0; i < n; i++)
; acc = __haydn_mula64_ss_ll(acc, x[i], h[i]);
; return acc;
; }
;
; Note: The MULA64 intrinsic takes 2 DR64 inputs. The accumulation pattern
; below uses mul64 + add64 since the intrinsic mula64_ss_ll maps to a
; binary MULA64_LL instruction with implicit accumulator.
;===------------------------------------------------------------------===;

define i64 @fir_filter(ptr %x, ptr %h, i32 %n) {
; CHECK-LABEL: <fir_filter>:
; CHECK: {{mul64|mula64|mull}}
; CHECK: add64
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %sum = phi i64 [ 0, %entry ], [ %sum.next, %loop ]
  %pa = getelementptr i64, ptr %x, i32 %i
  %pb = getelementptr i64, ptr %h, i32 %i
  %va = load i64, ptr %pa
  %vb = load i64, ptr %pb
  %bc.37 = bitcast i64 %va to <2 x i32>
  %bc.38 = bitcast i64 %vb to <2 x i32>
  %prod = call i64 @llvm.haydn.mul64.ss.ll(<2 x i32> %bc.37, <2 x i32> %bc.38)
  %sum.next = add i64 %sum, %prod
  %i.next = add i32 %i, 1
  %cond = icmp slt i32 %i.next, %n
  br i1 %cond, label %loop, label %exit

exit:
  ret i64 %sum.next
}

;===------------------------------------------------------------------===;
; Section 14: Dot product with saturating accumulation
;
; Corresponding C:
; int64_t dot_product_sat(const int64_t *a, const int64_t *b, int n) {
; int64_t acc = 0;
; for (int i = 0; i < n; i++) {
; int64_t prod = __haydn_mul64_ss_hh(a[i], b[i]);
; acc = __haydn_add64s(acc, prod);
; }
; return acc;
; }
;===------------------------------------------------------------------===;

; add64s already declared in Section 6

define i64 @dot_product_sat(ptr %a, ptr %b, i32 %n) {
; CHECK-LABEL: <dot_product_sat>:
; CHECK: mul64_hh
; CHECK: add64s
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %sum = phi i64 [ 0, %entry ], [ %sum.next, %loop ]
  %pa = getelementptr i64, ptr %a, i32 %i
  %pb = getelementptr i64, ptr %b, i32 %i
  %va = load i64, ptr %pa
  %vb = load i64, ptr %pb
  %bc.39 = bitcast i64 %va to <2 x i32>
  %bc.40 = bitcast i64 %vb to <2 x i32>
  %prod = call i64 @llvm.haydn.mul64.ss.hh(<2 x i32> %bc.39, <2 x i32> %bc.40)
  %sum.next = call i64 @llvm.haydn.add64s(i64 %sum, i64 %prod)
  %i.next = add i32 %i, 1
  %cond = icmp slt i32 %i.next, %n
  br i1 %cond, label %loop, label %exit

exit:
  ret i64 %sum.next
}

;===------------------------------------------------------------------===;
; Section 15: SIMD processing kernel -- x2 dual 32-bit MAC in a loop
;
; Corresponding C:
; int64_t simd_x2_kernel(const int64_t *a, const int64_t *b, int n) {
; int64_t acc = 0;
; for (int i = 0; i < n; i++)
; acc = __haydn_x2mula32(acc, a[i], b[i]);
; return acc;
; }
;===------------------------------------------------------------------===;

define i64 @simd_x2_kernel(ptr %a, ptr %b, i32 %n) {
; CHECK-LABEL: <simd_x2_kernel>:
; CHECK: x2mula32
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %sum = phi i64 [ 0, %entry ], [ %sum.next, %loop ]
  %sum2 = phi i64 [ 0, %entry ], [ %sum2.next, %loop ]
  %pa = getelementptr i64, ptr %a, i32 %i
  %pb = getelementptr i64, ptr %b, i32 %i
  %va = load i64, ptr %pa
  %vb = load i64, ptr %pb
  %bc.41 = bitcast i64 %va to <2 x i32>
  %bc.42 = bitcast i64 %vb to <2 x i32>
  %mac = call { i64, i64 } @llvm.haydn.x2mula32(i64 %sum, i64 %sum2, <2 x i32> %bc.41, <2 x i32> %bc.42)
  %sum.next = extractvalue { i64, i64 } %mac, 0
  %sum2.next = extractvalue { i64, i64 } %mac, 1
  %i.next = add i32 %i, 1
  %cond = icmp slt i32 %i.next, %n
  br i1 %cond, label %loop, label %exit

exit:
  ret i64 %sum.next
}

;===------------------------------------------------------------------===;
; Section 16: Cross-bank operation -- 32-bit result from 64-bit DSP
;
; Corresponding C:
; int dsp_32bit_result(int a, int b, int c) {
; int hi = __haydn_mulssh(a, b);
; int count = __haydn_nsa32(hi);
; int saturated = __haydn_add32s(hi, c);
; return count + saturated;
; }
;===------------------------------------------------------------------===;

define i32 @dsp_32bit_result(i32 %a, i32 %b, i32 %c) {
; CHECK-LABEL: <dsp_32bit_result>:
; CHECK: mulssh
; CHECK: nsa32
; CHECK: add32s
  %hi = call i32 @llvm.haydn.mulssh(i32 %a, i32 %b)
  %count = call i32 @llvm.haydn.nsa32(i32 %hi)
  %saturated = call i32 @llvm.haydn.add32s(i32 %hi, i32 %c)
  %r = add i32 %count, %saturated
  ret i32 %r
}

;===------------------------------------------------------------------===;
; Section 17: Fractional MAC chain -- common DSP filter building block
;
; Corresponding C:
; int64_t frac_mac_chain(int64_t a, int64_t b, int64_t c, int64_t d) {
; int64_t p1 = __haydn_fmul32s_ll(a, b);
; int64_t p2 = __haydn_fmul32s_lh(c, d);
; int64_t acc = __haydn_fmul32s_hh(p1, p2);
; return acc;
; }
;===------------------------------------------------------------------===;

define i64 @frac_mac_chain(i64 %a, i64 %b, i64 %c, i64 %d) {
; CHECK-LABEL: <frac_mac_chain>:
; Objdump may print fmul32s.ll or fmul32s_ll depending on InstPrinter.
; CHECK: fmul32s{{[._]}}ll
; CHECK: fmul32s{{[._]}}lh
; CHECK: fmul32s{{[._]}}hh
  %bc.43 = bitcast i64 %a to <2 x i32>
  %bc.44 = bitcast i64 %b to <2 x i32>
  %p1 = call i64 @llvm.haydn.fmul32s.ll(<2 x i32> %bc.43, <2 x i32> %bc.44)
  %bc.45 = bitcast i64 %c to <2 x i32>
  %bc.46 = bitcast i64 %d to <2 x i32>
  %p2 = call i64 @llvm.haydn.fmul32s.lh(<2 x i32> %bc.45, <2 x i32> %bc.46)
  %bc.47 = bitcast i64 %p1 to <2 x i32>
  %bc.48 = bitcast i64 %p2 to <2 x i32>
  %acc = call i64 @llvm.haydn.fmul32s.hh(<2 x i32> %bc.47, <2 x i32> %bc.48)
  ret i64 %acc
}

;===------------------------------------------------------------------===;
; Section 18: Q31 filter tap -- real DSP filter pattern
;
; Corresponding C:
; int q31_filter_tap(int sample, int coeff, int state) {
; return __haydn_macq31(sample, coeff, state);
; }
;===------------------------------------------------------------------===;

define i32 @q31_filter_tap(i32 %sample, i32 %coeff, i32 %state) {
; CHECK-LABEL: <q31_filter_tap>:
; CHECK: mulssh
  %r = call i32 @llvm.haydn.macq31(i32 %sample, i32 %coeff, i32 %state)
  ret i32 %r
}

;===------------------------------------------------------------------===;
; Section 19: Multiple return paths -- branch + DSP
;
; Corresponding C:
; int64_t branch_dsp(int64_t a, int64_t b, int flag) {
; if (flag)
; return __haydn_mul64_ss_ll(a, b);
; else
; return __haydn_add64s(a, b);
; }
;===------------------------------------------------------------------===;

define i64 @branch_dsp(i64 %a, i64 %b, i32 %flag) {
; CHECK-LABEL: <branch_dsp>:
; CHECK: mul64_ll
; CHECK: add64s
entry:
  %cmp = icmp eq i32 %flag, 0
  br i1 %cmp, label %else, label %then

then:
  %bc.49 = bitcast i64 %a to <2 x i32>
  %bc.50 = bitcast i64 %b to <2 x i32>
  %prod = call i64 @llvm.haydn.mul64.ss.ll(<2 x i32> %bc.49, <2 x i32> %bc.50)
  ret i64 %prod

else:
  %sum = call i64 @llvm.haydn.add64s(i64 %a, i64 %b)
  ret i64 %sum
}

;===------------------------------------------------------------------===;
; Section 20: SIMD quad 16-bit MAC chain
;
; Corresponding C:
; int64_t simd_x4_chain(int64_t a, int64_t b, int64_t c, int64_t d) {
; int64_t acc = __haydn_x4mula16(a, b, c);
; acc = __haydn_x4muls16s(acc, a, d);
; return acc;
; }
;===------------------------------------------------------------------===;

define i64 @simd_x4_chain(i64 %a, i64 %b, i64 %c, i64 %d, i64 %e) {
; CHECK-LABEL: <simd_x4_chain>:
; CHECK: x4mula16
; CHECK: x4muls16s
  %bc.51 = bitcast i64 %b to <4 x i16>
  %bc.52 = bitcast i64 %c to <4 x i16>
  %m1 = call { i64, i64 } @llvm.haydn.x4mula16(i64 %a, i64 %e, <4 x i16> %bc.51, <4 x i16> %bc.52)
  %acc = extractvalue { i64, i64 } %m1, 0
  %acc2 = extractvalue { i64, i64 } %m1, 1
  %bc.53 = bitcast i64 %a to <4 x i16>
  %bc.54 = bitcast i64 %d to <4 x i16>
  %m2 = call { i64, i64 } @llvm.haydn.x4muls16s(i64 %acc, i64 %acc2, <4 x i16> %bc.53, <4 x i16> %bc.54)
  %r = extractvalue { i64, i64 } %m2, 0
  ret i64 %r
}
