    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    B %bb.3

  bb.3.body:
    liveins: $r2
    successors: %bb.1
    B %bb.1

  bb.4.exit:
    liveins: $r2, $r15
    RET implicit $r15

...
# Adjacent rotated backedge: measured FORWARD 0 B — short demote with a
# BNEZ backedge (this arm is the nsichneu #289/#302 regression pin; it
# fatals under a flat sentinel refusal). Latch BNEZ_W $r2 is a Latch-block
# terminator zero-test (erased by the L2 latch-terminator sweep before
# SUBI32+BNEZ_W). It is not a live-in-body read, so Prefer ($r2) remains
# the countdown.
# NEAR-LABEL: name:            rotated_near
# NEAR: $r2 = SUBI32
# NEAR: BNEZ{{.*}} $r2, {{.*}}bb.2
# NEAR-NOT: JALR
#
# Far rotated backedge: measured FORWARD 2052 B — the terminal in-block
# long latch LUI(scr); ADDI32_W(scr); BEQZ_W(countdown, Exit); JALR_W.
# FAR-LABEL: name:            rotated_far
# FAR: $r2 = SUBI32
# FAR: LUI
# FAR: ADDI32
# FAR: BEQZ{{.*}} $r2, {{.*}}bb.4
# FAR: JALR{{.*\$r11, 0}}
# FAR-NOT: BNEZ
#
# Header-then-Latch control (2100 B backward span): LONG, unchanged.
# Body is NOP-only, so Prefer ($r2) remains the countdown.
# CTL-LABEL: name:            header_first
# CTL: LUI
# CTL: ADDI32
# CTL: BEQZ{{.*}} $r2, {{.*}}bb.2
# CTL: JALR{{.*\$r11, 0}}
# CTL-NOT: BNEZ
