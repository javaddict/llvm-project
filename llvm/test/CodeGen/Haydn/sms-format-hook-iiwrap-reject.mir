# RUN: llc -mtriple=haydn-unknown-elf -mattr=-hwloop -run-pass=pipeliner \
# RUN:   -haydn-sms-hook-force-iiwrap-reject -debug-only=pipeliner \
# RUN:   -verify-machineinstrs %s -o /dev/null 2>&1 \
# RUN:   | FileCheck %s --check-prefix=IIWRAP
# REQUIRES: asserts

# Role: MIR — Positive SMS-HOOK II-wrap false-accept fail-closed pin
# (plan §2.5 / §5.2 / §8.4 #8).
#
# MachinePipeliner ResourceManager keeps one independent ResourceCycle per
# modulo phase and only books the issue phase. Multi-cycle FU occupancy that
# spans (Issue+k)%II is invisible to that adapter (issue-time-only false
# acceptance). Product itineraries are InstrStage cycles==1, so the live
# multi-cycle scan has no reject corpus. -haydn-sms-hook-force-iiwrap-reject
# exercises the same analyzeLoopForPipelining fail-closed gate with an
# II-wrap-specific log, without inventing a multi-cycle product FU.
# Default of the flag is OFF — never product policy.
#
# Unit peers:
#   HaydnResourceRestrictionClassesTest.IIWrapPhaseMathAndFalseAcceptPolarity
#   HaydnBundleTest.SMSHookIIWrapIssueTimeOnlyFalseAccept
# Companion generic HOOK force: sms-format-hook-reject.mir
# Companion accept path: sms-format-resmii.mir (SMS-NOT: SMS-HOOK: reject).
#
# IIWRAP: SMS-HOOK: reject — II-wrap issue-time-only false-accept
# IIWRAP: SMS: analyzeLoopForPipelining fail-closed (unsupported SMS-HOOK resource class)
# IIWRAP: Unable to analyzeLoop, can NOT pipeline Loop
# IIWRAP-NOT: Schedule Found? 1

--- |
  define i32 @sms_hook_iiwrap_force_reject(ptr nocapture readonly %p, i32 %n) #0 {
  entry:
    br label %loop
  loop:
    %lsr.iv = phi ptr [ %scevgep, %loop ], [ %p, %entry ]
    %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
    %sum = phi i32 [ 0, %entry ], [ %sum.next, %loop ]
    %val = load i32, ptr %lsr.iv, align 4
    %sum.next = add i32 %sum, %val
    %i.next = add i32 %i, 1
    %scevgep = getelementptr i8, ptr %lsr.iv, i32 4
    %cmp = icmp slt i32 %i.next, %n
    br i1 %cmp, label %loop, label %exit
  exit:
    ret i32 %sum.next
  }
  attributes #0 = { "target-features"="-hwloop" }
...
---
name:            sms_hook_iiwrap_force_reject
alignment:       16
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          false
isSSA:           true
noVRegs:         false
registers:
  - { id: 0, class: gpr32 }
  - { id: 1, class: gpr32 }
  - { id: 2, class: gpr32 }
  - { id: 3, class: gpr32 }
  - { id: 4, class: gpr32 }
  - { id: 5, class: gpr32 }
  - { id: 6, class: gpr32 }
  - { id: 7, class: gpr32 }
  - { id: 8, class: gpr32 }
  - { id: 9, class: gpr32 }
  - { id: 10, class: gpr32 }
  - { id: 11, class: gpr32 }
  - { id: 12, class: gpr32 }
  - { id: 13, class: gpr32 }
liveins:
  - { reg: '$r1' }
  - { reg: '$r2' }
frameInfo:
  maxAlignment:    1
machineFunctionInfo: {}
body:             |
  bb.1.entry:
    liveins: $r1, $r2

    %0:gpr32 = COPY $r1
    %1:gpr32 = COPY $r2
    %7:gpr32 = LOADI32 1
    %12:gpr32 = LOADI32 0

  bb.2.loop:
    successors: %bb.2(0x7c000000), %bb.3(0x04000000)

    %2:gpr32 = PHI %10, %bb.2, %0, %bb.1
    %3:gpr32 = PHI %12, %bb.1, %8, %bb.2
    %4:gpr32 = PHI %12, %bb.1, %6, %bb.2
    %5:gpr32, %10:gpr32 = S_LW_POST_IMM %2, 1 :: (load (s32) from %ir.lsr.iv)
    %6:gpr32 = ADD32 %4, %5
    %8:gpr32 = ADD32 %3, %7
    %13:gpr32 = SLT32 %8, %1
    BNEZ_W %13, %bb.2
    B %bb.3

  bb.3.exit:
    $r1 = COPY %6
    RET implicit $r15, implicit $r1, implicit $r15

...
