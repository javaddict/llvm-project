# RUN: split-file %s %t
# RUN: not llc -mtriple=haydn-unknown-elf -run-pass=haydn-finalize-mi-bundles \
# RUN:   %t/mixed.mir -o - 2>&1 | FileCheck %s --check-prefix=MIXED
# RUN: not llc -mtriple=haydn-unknown-elf -run-pass=haydn-finalize-mi-bundles \
# RUN:   %t/reloc-csr-triple.mir -o - 2>&1 | FileCheck %s --check-prefix=CSR
# REQUIRES: haydn-registered-target

# Mixed generated MemberId + leftover catalog logical must not keep-map a
# subset of children (LOADSTORE0 store member + ST8). Reloc CSRW_W that
# cannot bind under the stamped E2 row must not remain FieldSlot (untyped
# NONE). Both fail closed at Finalize.

# MIXED: mixed MemberId and leftover FieldSlot
# CSR: reloc CSR I8 remained FieldSlot

#--- mixed.mir
--- |
  define void @mixed_memberid_leftover_st8() { ret void }
...
---
name:            mixed_memberid_leftover_st8
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r2, $r3, $r4, $r15
    BUNDLE 0, 0, implicit $r1, implicit $r2, implicit $r3, implicit $r4 {
      S_SW_WITH_IMM_E2_E0_LOADSTORE0_RI6 $r1, $r2, 1
      ST8 $r3, $r4, 0
    }
    RET implicit $r15

#--- reloc-csr-triple.mir
--- |
  @g = external global i32
  define void @reloc_csrw_w_e2_triple() { ret void }
...
---
name:            reloc_csrw_w_e2_triple
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r2, $r3, $r15
    BUNDLE 0, 0, implicit $r1, implicit $r2, implicit $r3, implicit-def $sfr {
      CSRW_W @g, $r1, implicit-def $sfr
      CSRW_W @g, $r2, implicit-def $sfr
      CSRW_W @g, $r3, implicit-def $sfr
    }
    RET implicit $r15
