# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-postlegalizer-combiner -global-isel-abort=1 %s -o - | FileCheck %s

# Role: MIR — s for XOR-zero and double-NOT combiner rules in HaydnPostLegalizerCombiner.

# Tests for XOR-zero and double-NOT combiner rules in HaydnPostLegalizerCombiner.
#
# Combiner rules tested:
# xor_zero: G_XOR x, 0 -> COPY x (identity)
# double_not: G_XOR (G_XOR x, -1), -1 -> COPY x (double complement = identity)

---
# XOR with zero: G_XOR x, 0 -> COPY x
# The combiner replaces G_XOR with COPY, then DCE removes the dead constant
# and folds the copy chain, leaving only G_IMPLICIT_DEF and the final COPY.
name:            xor_zero
legalized:       true
body:             |
  bb.0:
    ; CHECK-LABEL: name: xor_zero
    liveins: $r0
    %0:_(s32) = COPY $r0
    %1:_(s32) = G_CONSTANT i32 0
    ; CHECK-NOT: G_XOR
    ; CHECK: COPY %0
    %2:_(s32) = G_XOR %0, %1
    $r1 = COPY %2
...

---
# XOR with zero (commuted): G_XOR 0, x -> COPY x
name:            xor_zero_commuted
legalized:       true
body:             |
  bb.0:
    ; CHECK-LABEL: name: xor_zero_commuted
    liveins: $r0
    %0:_(s32) = COPY $r0
    %1:_(s32) = G_CONSTANT i32 0
    ; CHECK-NOT: G_XOR
    ; CHECK: COPY %0
    %2:_(s32) = G_XOR %1, %0
    $r1 = COPY %2
...

---
# Double NOT: G_XOR (G_XOR x, -1), -1 -> COPY x
name:            double_not
legalized:       true
body:             |
  bb.0:
    ; CHECK-LABEL: name: double_not
    liveins: $r0
    %0:_(s32) = COPY $r0
    %1:_(s32) = G_CONSTANT i32 -1
    %2:_(s32) = G_XOR %0, %1
    ; CHECK-NOT: G_XOR
    ; CHECK: COPY %0
    %3:_(s32) = G_XOR %2, %1
    $r1 = COPY %3
...

---
# XOR with zero (i64): G_XOR x, 0 -> COPY x
name:            xor_zero_i64
legalized:       true
body:             |
  bb.0:
    ; CHECK-LABEL: name: xor_zero_i64
    liveins: $d0
    %0:_(s64) = COPY $d0
    %1:_(s64) = G_CONSTANT i64 0
    ; CHECK-NOT: G_XOR
    ; CHECK: COPY %0
    %2:_(s64) = G_XOR %0, %1
    $d0 = COPY %2
...

---
# Double NOT (i64): G_XOR (G_XOR x, -1), -1 -> COPY x
name:            double_not_i64
legalized:       true
body:             |
  bb.0:
    ; CHECK-LABEL: name: double_not_i64
    liveins: $d0
    %0:_(s64) = COPY $d0
    %1:_(s64) = G_CONSTANT i64 -1
    %2:_(s64) = G_XOR %0, %1
    ; CHECK-NOT: G_XOR
    ; CHECK: COPY %0
    %3:_(s64) = G_XOR %2, %1
    $d0 = COPY %3
...

---
# Negative test: XOR with non-zero constant should NOT be eliminated.
name:            xor_nonzero
legalized:       true
body:             |
  bb.0:
    ; CHECK-LABEL: name: xor_nonzero
    liveins: $r0
    %0:_(s32) = COPY $r0
    %1:_(s32) = G_CONSTANT i32 42
    ; CHECK: G_XOR
    %2:_(s32) = G_XOR %0, %1
    $r1 = COPY %2
...

---
# Negative test: single NOT should NOT be eliminated.
name:            single_not
legalized:       true
body:             |
  bb.0:
    ; CHECK-LABEL: name: single_not
    liveins: $r0
    %0:_(s32) = COPY $r0
    %1:_(s32) = G_CONSTANT i32 -1
    ; CHECK: G_XOR
    %2:_(s32) = G_XOR %0, %1
    $r1 = COPY %2
...
