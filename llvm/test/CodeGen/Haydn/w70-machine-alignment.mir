# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-machine-alignment -verify-machineinstrs %s -o - | FileCheck %s

# Role: MIR — W70.2 function-entry alignment writer (AIE MachineAlignment
# peer; seat addPostBBSections after the closure Finalize+Verify). Pads the
# committed extent (Kind B size oracle: getInstSizeInBytes on BUNDLE roots)
# with legal generated idle-parcel BUNDLEs at the entry block. The idle row
# is the same committed object LatencyStalls+Finalize produce: E2 row (imm
# 0) + AllEntriesReal (imm 0) wrapping a logical NOP pad child.
#
# aligned_mir body = 4 committed parcels = 48 B; align 256 grid is
# lcm(256,12) = 768 -> 60 idle parcels. already_grid has default Align 4
# (divides 12) -> identity, no pad.

--- |
  define void @aligned_mir() align 256 { ret void }
  define void @already_grid() { ret void }

...
---
name:            aligned_mir
alignment:       4
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
frameInfo:
  maxAlignment:    4
  stackSize:       8
stack:
  - { id: 0, type: spill-slot, offset: -4, size: 4, alignment: 4 }
machineFunctionInfo: {}
body:             |
  bb.0 (%ir-block.0):
    liveins: $r0

    ; CHECK-LABEL: name: aligned_mir
    ; Entry pad: 60 committed idle parcels first (E2 row imm 0 +
    ; AllEntriesReal imm 0 wrapping a logical NOP pad child — the same
    ; committed idle object LatencyStalls+Finalize produce)...
    ; CHECK: BUNDLE 0, 0 {
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: }
    ; CHECK: BUNDLE 0, 0 {
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: }
    ; CHECK: BUNDLE 0, 0 {
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: }
    ; ...then the original 4-parcel body (60 + 4 = 64 parcels = 768 B,
    ; the lcm(256,12) grid).
    ; CHECK: frame-setup BUNDLE 0, 0, implicit-def $r0, implicit $r0 {
    frame-setup BUNDLE 0, 0, implicit-def $r0, implicit $r0 {
      $r0 = frame-setup XOR32_E2_E0_ALU0_RR $r0, $r0
    }
    frame-setup BUNDLE 0, 0, implicit-def $r13, implicit $r13 {
      $r13 = frame-setup SUBI32_E2_E1_ALU1_RI20 $r13, 8
    }
    frame-destroy BUNDLE 0, 0, implicit-def $r13, implicit $r13 {
      $r13 = frame-destroy ADDI32_E2_E0_ALU0_RI20 $r13, 8
    }
    BUNDLE 0, 0, implicit-def $r0, implicit $r15 {
      $r0 = JALR_E2_E0_ALU0_RI12 $r15, 0
    }

...
---
name:            already_grid
alignment:       4
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
frameInfo:
  maxAlignment:    1
machineFunctionInfo: {}
body:             |
  bb.0 (%ir-block.0):
    liveins: $r0

    ; Default Align 4 divides the parcel size: extent already on grid,
    ; identity pass (no idle parcels, same body shape).
    ; CHECK-LABEL: name: already_grid
    ; CHECK-NOT: NOP
    BUNDLE 0, 0, implicit-def $r0, implicit $r15 {
      $r0 = JALR_E2_E0_ALU0_RI12 $r15, 0
    }

...
