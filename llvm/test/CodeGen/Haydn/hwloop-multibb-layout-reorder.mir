# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop -run-pass=haydn-hwloops \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# Role: MIR — multi-BB Role-A expand reorders Latch-before-Header layout.
#
# REGRESSION TEST: MBP may leave the latch before the header. That is
# legal CFG and illegal ZOL (END must follow BEGIN). Formation walks CFG
# only (AIE MLI findLoopControlBlock is not ported) and then places
# Preheader, Header, interiors, Latch in that layout order. Interiors
# keep existing function order so then/else fallthrough is not scrambled.
# Product default stays OFF; this pass runs because the MIR already
# holds LoopStart.

# CHECK-LABEL: name: multibb_layout_reorder
# CHECK: bb.0.entry:
# CHECK: SET_HWLOOP_F2_W 0, %bb.2, %bb.1
# CHECK-NOT: LoopStart
# CHECK: bb.2.header:
# CHECK: bb.3.then:
# CHECK: bb.4.else:
# CHECK: bb.1.latch:
# CHECK: PseudoLoopEnd
# CHECK: bb.5.exit:

--- |
  define dso_local void @multibb_layout_reorder(ptr %p, i32 %c) {
  entry:
    br label %header
  header:
    br i1 undef, label %then, label %else
  then:
    store i32 0, ptr %p
    br label %latch
  else:
    store i32 1, ptr %p
    br label %latch
  latch:
    br i1 undef, label %header, label %exit
  exit:
    ret void
  }
...
---
name:            multibb_layout_reorder
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r2, $r15
    successors: %bb.2
    $r0 = frame-setup XOR32 $r0, $r0
    $r3 = ADDI32_W $r0, 8
    LoopStart $r3, 0
    NOP
    NOP
    NOP
    ; Layout successor is the latch — explicit B so header is a real target.
    B %bb.2

  ; Latch before header: legal CFG, illegal ZOL until placeLoopBlocksForZOL.
  ; Layout successor is the header, so the exit edge is an explicit B.
  bb.1.latch:
    liveins: $r1, $r2, $r3, $r15
    successors: %bb.2, %bb.5
    NOP
    NOP
    NOP
    PseudoLoopEnd %bb.2
    B %bb.5

  bb.2.header:
    liveins: $r1, $r2, $r3, $r15
    successors: %bb.3, %bb.4
    BEQZ_W $r2, %bb.4

  bb.3.then:
    liveins: $r1, $r3, $r15
    successors: %bb.1
    ST32 $r0, $r1, 0
    B %bb.1

  bb.4.else:
    liveins: $r1, $r3, $r15
    successors: %bb.1
    $r4 = ADDI32_W $r0, 1
    ST32 $r4, $r1, 0
    B %bb.1

  bb.5.exit:
    liveins: $r15
    $r0 = JALR_W $r15, 0, implicit $r15
