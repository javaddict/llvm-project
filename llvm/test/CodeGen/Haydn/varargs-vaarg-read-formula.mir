# RUN: llc -mtriple=haydn-unknown-elf -global-isel-abort=1 \
# RUN:     -run-pass=instruction-select -verify-machineinstrs %s -o - \
# RUN:     | FileCheck %s

# Role: MIR — (CB-131 systematic): G_VAARG thin-selects to VAARG_I32.

# REGRESSION TEST (CB-131 systematic): G_VAARG thin-selects to VAARG_I32.
#
# Historical bug: saveVarArgRegisters spills variadic GPRs ASCENDING (R2 at
# base+0 … R7 at base+20). An early selector used the DOWNWARD formula
#   addr = __gr_top - (__gr_offs + TypeSize)
# with __gr_offs initialized to 0, so the first va_arg read base+20 = R7
# (last spilled reg) — reversed argument order for any callee with ≥2 unnamed
# args in a bank.
#
# Fix (AArch64-style, Option 1): upward walk
#   addr = __gr_top + __gr_offs
# with VASTART initializing __gr_offs to the NEGATIVE bank size.
#
# CB-131 systematic placement: ISel is thin (G_VAARG → VAARG_I32/I64 pseudo)
# for leftover G_VAARG injected after legalizer. Product G_VAARG is consumed
# by HaydnLegalizerInfo::legalizeVAArg. This MIR pins the ISel half:
# G_VAARG must become VAARG_I32. Companion IR: gisel/vaarg-legalizer-home.ll.
#
# Why MIR: asserting the post-instruction-select pseudo is the surgical way
# to keep ISel thin. If someone re-inlines a SUB32 downward formula into ISel
# (or drops the pseudo), this fails.

--- |
  define void @vaarg_gpr_read_formula(ptr %ap) {
    %v = va_arg ptr %ap, i32
    ret void
  }
...

---
name: vaarg_gpr_read_formula
legalized: true
regBankSelected: true
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr32regbank }
  - { id: 1, class: gpr32regbank }
body: |
  bb.0:
    liveins: $r1

    %0:gpr32regbank(p0) = COPY $r1
    ; G_VAARG [Dst(0), VaListPtr(1), Align(2)]. Dst is i32 (GPR bank) →
    ; thin-select to VAARG_I32; ExpandPseudos later does top+offs (ADD32).
    %1:gpr32regbank(s32) = G_VAARG %0(p0), 4
    $r1 = COPY %1(s32)
    RET implicit $r15, implicit $r1

# CHECK-LABEL: name: vaarg_gpr_read_formula
# Thin ISel: G_VAARG → VAARG_I32 (not an inlined ADD32/SUB32 sequence).
# CHECK: VAARG_I32
# Downward SUB32 formula must not reappear in ISel.
# CHECK-NOT: = SUB32
...
