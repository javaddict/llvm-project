# RUN: llc -mtriple=haydn-unknown-elf -misched-postra-direction=topdown \
# RUN:   -run-pass=postmisched -verify-machineinstrs %s -o - | \
# RUN:   FileCheck %s --check-prefixes=CHECK,TOP
# RUN: llc -mtriple=haydn-unknown-elf -misched-postra-direction=bottomup \
# RUN:   -run-pass=postmisched -verify-machineinstrs %s -o - | \
# RUN:   FileCheck %s --check-prefixes=CHECK,BOT
# RUN: llc -mtriple=haydn-unknown-elf -misched-postra-direction=bidirectional \
# RUN:   -run-pass=postmisched -verify-machineinstrs %s -o - | \
# RUN:   FileCheck %s --check-prefixes=CHECK,BI

# Role: MIR — SchedBoundary Top/Bot reconstruction + final CurrCycle flush must honour the normal LLVM -misched-postra-direction modes.

# SchedBoundary Top/Bot reconstruction + final CurrCycle flush must honour
# the normal LLVM -misched-postra-direction modes. Zone-local ready cycles
# (TopReadyCycle vs BotReadyCycle) drive commit; bottom-scheduled SUs must not
# be reconstructed from TopReadyCycle. All three directions exact-commit the
# cycles they scheduled without assert or lost members.
#
# AIE peers:
#   computeAndFinalizeBundles(SchedBoundary&) — AIEMachineScheduler.cpp:152-228
#   Top+Bot merge in leaveRegion — AIEMachineScheduler.cpp:1092-1110
#   final CurrCycle flush — :203-216
#
# 1. Independent ALU pair: may BUNDLE (exact multi-MI) or stay sequential;
#    both opcodes survive every direction.
# 2. MAC writeback → rs1 use: mid-stream idle NOP (latency stall) in every
#    direction — CurrCycle / ready-cycle gaps still materialize.

--- |
  define void @independent_alu_pair() { ret void }
  define void @mac_wb_stall_idle() { ret void }
...
---
name:            independent_alu_pair
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r3, $r4

    ; Members survive topdown / bottomup / bidirectional reconstruction.
    ; TOP-LABEL: name: independent_alu_pair
    ; TOP: liveins: $r0, $r3, $r4
    ; TOP-NEXT: {{  $}}
    ; TOP-NEXT: $r2 = ADDI32_E{{[23]}}_E{{[0-2]}}_{{.*}} $r0, 10, implicit-def dead $sfr
    ; TOP-NEXT: $r7 = ADD32_E{{[23]}}_E{{[0-2]}}_{{.*}} killed $r3, killed $r4, implicit-def dead $sfr
    ; TOP-NEXT: $r0 = COPY killed $r2
    ; TOP-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    ;
    ; BOT-LABEL: name: independent_alu_pair
    ; BOT: liveins: $r0, $r3, $r4
    ; BOT-NEXT: {{  $}}
    ; BOT-NEXT: $r2 = ADDI32_E{{[23]}}_E{{[0-2]}}_{{.*}} $r0, 10, implicit-def dead $sfr
    ; BOT-NEXT: $r7 = ADD32_E{{[23]}}_E{{[0-2]}}_{{.*}} killed $r3, killed $r4, implicit-def dead $sfr
    ; BOT-NEXT: $r0 = COPY killed $r2
    ; BOT-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    ;
    ; BI-LABEL: name: independent_alu_pair
    ; BI: liveins: $r0, $r3, $r4
    ; BI-NEXT: {{  $}}
    ; BI-NEXT: $r2 = ADDI32_E{{[23]}}_E{{[0-2]}}_{{.*}} $r0, 10, implicit-def dead $sfr
    ; BI-NEXT: $r0 = COPY killed $r2
    ; BI-NEXT: $r7 = ADD32_E{{[23]}}_E{{[0-2]}}_{{.*}} killed $r3, killed $r4, implicit-def dead $sfr
    ; BI-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADDI32 $r0, 10, implicit-def dead $sfr
    $r7 = ADD32 killed $r3, killed $r4, implicit-def dead $sfr
    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15

...
---
name:            mac_wb_stall_idle
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$d1', virtual-reg: '' }
  - { reg: '$d2', virtual-reg: '' }
  - { reg: '$d3', virtual-reg: '' }
  - { reg: '$d4', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $d0, $d1, $d2, $d3, $d4

    ; Latency gap becomes a rolling idle NOP under every direction.
    ; CHECK-LABEL: name: mac_wb_stall_idle
    ; CHECK: liveins: $d0, $d1, $d2, $d3, $d4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $d0 = F2MULAA32R_HHLL_E{{[23]}}_E{{[0-2]}}_{{.*}} killed $d1, killed $d2, implicit-def dead $sfr
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: $d3 = F2MULAA32R_HHLL_E{{[23]}}_E{{[0-2]}}_{{.*}} killed $d0, killed $d4, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $d0 = F2MULAA32R_HHLL $d0, $d1, $d2, implicit-def dead $sfr
    $d3 = F2MULAA32R_HHLL $d3, $d0, $d4, implicit-def dead $sfr
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
