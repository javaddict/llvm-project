# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postmisched -verify-machineinstrs %s -o - | FileCheck %s

# Role: MIR — (F36): countGPRPorts must count GPR ports correctly.


# REBASELINED : / pipeline reorder (ExpandPseudos/BitSimplify pre-scheduler + materialize at leaveRegion) — bundles regrouped, ops unchanged.
# REBASELINED : / FLEX cutover — ops bundled (MOVE32 S0+S1, ADD32+ADDI32 S0+S1, two ADDI32 S0+S1); dead-def still excluded from bundle (regression intent preserved).
#
# REGRESSION TEST (F36): countGPRPorts must count GPR ports correctly.
#
# Bugs fixed in countGPRPorts (HaydnVLIWPacketizer.cpp):
# 1. Dead defs were excluded by `!MO.isDead`, undercounting writes. A dead
# def still occupies a write port for the cycle (the port is reserved
# before liveness is considered), so dead defs MUST count toward the 2W
# budget. With the old code, two dead-def writes plus a live write would
# be counted as 1W and wrongly packed into a 3-write bundle.
# 2. Read-write operands were counted as EITHER a read OR a write (via
# `else if`), not both. An in-place update like ADD32 r1, r1, r2 reads r1
# AND writes r1 — that's 2 read ports (r1, r2) and 1 write port (r1), not
# "1 read, 0 writes" (the `else if` took the read branch and skipped the
# write). This caused the packetizer to over-pack write-side conflicts.
# 3. Each explicit operand field reserves one port. MOVE32 rd, rs is 1R1W
# (logical dest+src schema W68.0b: descriptor and MI agree — the former
# duplicated second source no longer exists, so the F14 same-reg dedup
# premise is structurally moot for MOVE32). The per-field law itself is
# unchanged: a future opcode that repeats a source field still charges
# each field.
#
# GPR port budget: 4 read ports, 2 write ports (4R2W) shared across all 3 slots
# (CLAUDE.md "Slot architecture" / hard constraint derived from register file).
# DR64 uses a separate register file and does not consume GPR ports.
#
# Tests:
# 1. Two MOVE32 (each 1R/1W) → 2R/2W → well inside 4R2W → MAY bundle.
# Port headroom is no longer the binding constraint for two MOVE32.
# 2. In-place ADD32 (read-write operand) → counts as BOTH a read and a write
# of the same register, so two such ops = 2R+2W (distinct regs) bundling
# is fine; but two ops sharing the read-write reg hit WAW.
# 3. Dead-def writes still count toward 2W: two live writes + one dead write
# must NOT bundle (3 writes > 2W limit).
#
# What breaks if the bugs reappear:
# Test 1: two MOVE32 stay 2R2W (legal, with headroom). A per-field
# undercount would admit GPR-read mixes beyond 4R.
# Test 3: if dead-def counting regresses, three writes bundle illegally.

--- |
  define void @test1_move32_dedup() { ret void }
  define void @test2_inplace_rw_independent() { ret void }
  define void @test3_dead_def_writes_count() { ret void }
...
---
# ============================================================================
# Test 1: MOVE32 per-field — two MOVE32 (rd, rs) each count as 1R/1W.
# ============================================================================
#
# Two independent MOVE32 instructions:
# MOVE32 r2, r0 -> 1 read (r0), 1 write (r2)
# MOVE32 r3, r1 -> 1 read (r1), 1 write (r3)
# Total: 2R, 2W. Inside the 4R2W budget — one legal cycle.
#
name:            test1_move32_dedup
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1

    ; Two MOVE32 (per-field: 2R/2W) -> may bundle (headroom to the 4R cap).

    ; CHECK-LABEL: name: test1_move32_dedup
    ; CHECK: liveins: $r0, $r1
    ; CHECK: $r2 = MOVE32_E{{[23]}}_E{{[0-2]}}_ALU{{[012]}}_R $r0, implicit-def dead $sfr
    ; CHECK: $r3 = MOVE32_E{{[23]}}_E{{[0-2]}}_ALU{{[012]}}_R {{(killed )?}}$r1, implicit-def dead $sfr
    ; CHECK: $r0 = COPY
    ; CHECK: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = MOVE32 $r0, implicit-def dead $sfr
    $r3 = MOVE32 $r1, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 2: Read-write operand counted independently (both ports consumed).
# ============================================================================
#
# ADD32 r2, r2, r0 — r2 is BOTH read and written (in-place accumulator update).
# Reads: r2, r0 (2 reads)
# Writes: r2 (1 write)
# Pre-fix (F36 `else if`): r2 counted as read-only, missing the write.
# That would make this look like 2R/0W, leaving 2W of headroom and allowing
# another writer to bundle (wrong — WAW hazard on r2).
#
# Here we pair it with a non-conflicting writer to show the budget is enforced:
# ADD32 r2, r2, r0 -> 2R (r2,r0), 1W (r2)
# ADDI32 r3, r1, 5 -> 1R (r1), 1W (r3)
# Total: 3R, 2W. Within 4R2W -> should bundle.
#
name:            test2_inplace_rw_independent
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $r2

    ; In-place ADD32 (2R/1W with r2 counted as both) + ADDI32 (1R/1W).
    ; Total 3R/2W -> bundles.

    ; CHECK-LABEL: name: test2_inplace_rw_independent
    ; CHECK: liveins: $r0, $r1, $r2
    ; CHECK: $r2 = ADD32_E{{[23]}}_E{{[0-2]}}_{{.*}} killed $r2, $r0, implicit-def dead $sfr
    ; CHECK: $r3 = ADDI32_E{{[23]}}_E{{[0-2]}}_{{.*}} killed $r1, 5, implicit-def dead $sfr
    ; CHECK: $r0 = COPY
    ; CHECK: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADD32 $r2, $r0, implicit-def dead $sfr
    $r3 = ADDI32 $r1, 5, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 3: Dead defs STILL count toward the 2W write-port budget.
# ============================================================================
#
# Three ADDI32 each writing distinct registers; the third is marked dead.
# ADDI32 r2, r0, 10 -> 1R, 1W (live)
# ADDI32 r3, r0, 20 -> 1R, 1W (live)
# ADDI32 r4, r0, 30 -> 1R, 1W (DEAD def, but still consumes a write port)
# Total: 3 writes. The 2W limit is exceeded regardless of liveness — the third
# must NOT join the bundle.
#
# Pre-fix (F36 `!MO.isDead` filter): dead writes were excluded, so this would
# be miscounted as 2W and the third instruction would be wrongly bundled into
# a 3-write packet that the hardware cannot issue (only 2 GPR write ports).
#
name:            test3_dead_def_writes_count
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0

    ; First two ADDI32: 2R/2W (at write limit). Third ADDI32 (dead def):
    ; would be 3W if bundled -> exceeds 2W limit, must NOT bundle.

    ; CHECK-LABEL: name: test3_dead_def_writes_count
    ; CHECK: liveins: $r0
    ; First two ADDI32 may share a cycle (2W). The dead third is a third
    ; write port and must stay outside that pair.
    ; CHECK: $r2 = ADDI32_E{{[23]}}_E{{[0-2]}}_{{.*}} $r0, 10, implicit-def dead $sfr
    ; CHECK: $r3 = ADDI32_E{{[23]}}_E{{[0-2]}}_{{.*}} $r0, 20, implicit-def dead $sfr
    ; CHECK: dead $r4 = ADDI32_E{{[23]}}_E{{[0-2]}}_{{.*}} $r0, 30, implicit-def dead $sfr
    ; CHECK-NOT: BUNDLE{{.*}}$r4
    ; CHECK: $r0 = COPY
    ; CHECK: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADDI32 $r0, 10, implicit-def dead $sfr
    $r3 = ADDI32 $r0, 20, implicit-def dead $sfr
    dead $r4 = ADDI32 $r0, 30, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
