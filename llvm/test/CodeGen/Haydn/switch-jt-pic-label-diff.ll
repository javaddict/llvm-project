; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    { xor32 r0, r0, r0; nop; nop }
; CHECK-NEXT:    { subi32 sp, sp, 8; nop }
; CHECK-NEXT:    { addi32 r2, r0, 7; nop }
; CHECK-NEXT:    { sltu32 r2, r2, r1; nop; nop }
; CHECK-NEXT:    { bnez r2, .LBB0_10; nop; nop }
; CHECK-NEXT:  // %bb.1: // %entry
; CHECK-NEXT:    { lui r2, .LJTI0_0; slli32 r1, r1, 2; nop }
