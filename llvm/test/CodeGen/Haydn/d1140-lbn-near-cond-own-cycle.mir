# LAST-LABEL: name:            last_anchor_would_fit
# LAST: bb.0.entry
# LAST-NOT: LUI
# LAST-NOT: JALR
# LAST: BEQZ{{.*}} $r2, %bb.3
# LAST: B %bb.2
# LAST-NOT: LUI
# LAST-NOT: JALR
# LAST: bb.1.pad
#
# NEAR-LABEL: name:            cond_cycle_still_near
# NEAR: bb.0.entry
# NEAR: LUI{{.*}}%bb.3{{$}}
# NEAR: ADDI32{{.*}}%bb.3{{$}}
# NEAR-NOT: BEQZ{{.*}} $r2
# NEAR: BNEZ{{.*}} $r2, %bb.2
# NEAR-NOT: B %bb.
# NEAR: JALR
# NEAR-NOT: B %bb.
# NEAR: bb.1.pad
