# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=haydn-hwloops -verify-machineinstrs \
# RUN:   %s -o - | FileCheck %s
# REQUIRES: haydn-registered-target
#
# Wave 4 H — AIE splitLoopEndJump (AIEBaseHardwareLoops.cpp:232-272).
# Latch terminator is PseudoLoopEnd + non-fallthrough B to Exit.
# HardwareLoops must split the exit into a dedicated fallthrough block
# before expand/demote and before scheduler inventory. The END stays on
# the latch; the uncond B moves to the new layout successor.

# CHECK-LABEL: bb.2:
# CHECK: PseudoLoopEnd %bb.1
# CHECK-LABEL: bb.4:
# CHECK: B %bb.3
# CHECK-LABEL: bb.3:
# CHECK: RET

---
name:            d1171_split_loop_end_jump
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r15
    successors: %bb.1
    B %bb.1

  bb.1:
    liveins: $r15
    successors: %bb.2
    NOP
    B %bb.2

  bb.2:
    liveins: $r15
    successors: %bb.1, %bb.3
    PseudoLoopEnd %bb.1
    B %bb.3

  bb.3:
    liveins: $r15
    RET implicit killed $r15
