# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postmisched,postmisched \
# RUN:     -verify-machineinstrs -haydn-postra-interblock \
# RUN:     -misched-postra-direction=bidirectional %s -o - \
# RUN:     | FileCheck %s --check-prefixes=S2,INTER
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postmisched,postmisched \
# RUN:     -verify-machineinstrs \
# RUN:     -misched-postra-direction=bidirectional %s -o - \
# RUN:     | FileCheck %s --check-prefixes=S2,OFF
# REQUIRES: haydn-registered-target
#
# D1.56 llc pin: the Bot successor replay walk counts committed PARCELS, not
# MIs — an opaque INLINEASM head interleaved before the successor's real
# parcels is a non-parcel (never a Format E member: the isBundleSkippable
# membership walls refuse it, spliceSkippablesForCycle refuses any splice
# across it, FinalizeBundle leaves it standalone; it emits through the asm
# path, not a generated row), so it must neither consume a replay cycle nor
# book occupancy. Removing the residual that let the INLINEASM head advance
# the walk's Cycle counter booked demand for a parcel that never exists:
# successor demand landed one cycle LATER (under-constraining the seam) —
# this pin then sees the NOP run shift or shrink, which is the failure
# signature this test rejects.
#
# Shape: identical to interblock-bot-replay-sincos-window.mir (bb.0 writes
# the SIN_COS dest's bank register late; bb.1 leads with SIN_COS, occupancy
# uimm4+2 = 4, so Occupancy-1 = 3 predecessor NOPs under interblock replay)
# with a bare opaque 'nop' INLINEASM placed BEFORE the DSP parcel — the
# sibling of gr27-d139-replay-copy-nonparcel.mir with the opaque boundary
# head in the COPY seat. Any cycle consumption by the INLINEASM itself
# misaligns the demand window (not just trailing layout). The $r3 ADD32
# after the INLINEASM is load-bearing shape, not decoration: INLINEASM is
# an isSchedulingBoundary, so bb.1 splits at it; without a real MI in the
# post-INLINEASM region the SIN_COS region is single-MI and MachineScheduler
# skips it entirely (no S1 depths, no replay, no NOPs anywhere). One real
# parcel after the boundary keeps the region scheduled while the replay
# walk still meets the INLINEASM head before the SIN_COS parcel.
#
# Expectation: identical NOP pattern to the INLINEASM-free successor (INTER
# arm: three NOPs then the parcel; OFF arm expects no NOPs at all). The
# INLINEASM must remain a bare standalone non-member after scheduling — the
# bundled/wrapped INLINEASM rejection is owned by the splice/verify seats
# (postmisched-splice-remaining-set-read.mir), not by this layout pin, so
# no bundle-structure CHECK is asserted here.

# S2-LABEL: name: bot_replay_inlineasm_nonparcel
# S2:       bb.0:
# S2:         $d1 = ADD64{{.*}}
# GR1.7: S2 pred-occupancy NOP replay is gone; dest-window pads sit
# after the DSP in the successor.
# INTER-NOT:  NOP
# OFF-NOT:    NOP
# S2:       bb.1:
# S2:         INLINEASM{{.*}}
# S2:         $r3 = ADD32{{.*}}
# S2:         $d1 = SIN_COS{{.*}} $r0, 2
# S2:         $r0 = JALR{{.*}}

--- |
  define void @bot_replay_inlineasm_nonparcel() { ret void }
...
---
name:            bot_replay_inlineasm_nonparcel
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:           true
isSSA:            false
noVRegs:          true
registers:        []
liveins:
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$r0', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:       []
stack:            []
constants:        []
machineFunctionInfo: {}
body:             |

  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $d0, $r0

    $d2 = ADD64 $d0, $d0
    $d1 = ADD64 $d2, $d0

  bb.1:
    liveins: $r0, $r15

    INLINEASM &"nop", 1 /* sideeffect attdialect */
    $r3 = ADD32 $r0, $r0, implicit-def dead $sfr
    $d1 = SIN_COS $r0, 2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15

...
