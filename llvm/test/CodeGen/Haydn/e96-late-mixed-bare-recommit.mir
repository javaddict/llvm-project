# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-finalize-mi-bundles \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s
# REQUIRES: haydn-registered-target

# Role: leftover bare encode beside an already-bundled root wraps as a
# singleton BUNDLE (AIEFinalizeBundle.cpp:40-59). Construction only:
# wrap+stamp, no late setDesc. The committed ADD32 child stays logical.

--- |
  define void @late_mixed_bare() {
    ret void
  }
...
---
name:            late_mixed_bare
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r15
    ; CHECK-LABEL: name: late_mixed_bare
    ; CHECK: BUNDLE 0, 0
    ; CHECK: $r2 = ADD32_E2_E0_ALU0_RR $r0, $r1
    ; CHECK: BUNDLE 0, 0
    ; CHECK: $r3 = XOR32_E2_E0_ALU0_RR $r0, $r1
    ; CHECK-NOT: ADD32_E2_
    BUNDLE 0, 0, implicit-def $r2, implicit-def dead $sfr, implicit $r0, implicit $r1 {
      $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    }
    $r3 = XOR32 $r0, $r1, implicit-def dead $sfr
    RET implicit $r15
