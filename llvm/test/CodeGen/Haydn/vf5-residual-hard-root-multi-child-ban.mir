#--- printer_loadi32.mir
--- |
  define void @printer_hard_root_loadi32() { ret void }
...
---
name:            printer_hard_root_loadi32
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r15
    ; P-LOADI32: HaydnAsmPrinter: residual cycle-forming pseudo
    ; P-LOADI32: must be exact-committed real MIs before AsmPrinter
    BUNDLE 0, implicit-def $r4, implicit-def $r5, implicit-def dead $sfr, implicit $r0, implicit $r1 {
      $r4 = ADD32 $r0, $r1, implicit-def dead $sfr
      $r5 = LOADI32 42
    }
    RET implicit $r15

