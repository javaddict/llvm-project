# RUN: rm -rf %t && split-file %s %t
# RUN: not llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   %t/verify_loadi32.mir -o - 2>&1 | FileCheck %s --check-prefix=V-LOADI32
# RUN: not llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   %t/verify_load_addr.mir -o - 2>&1 | FileCheck %s --check-prefix=V-LOAD_ADDR
# RUN: not llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   %t/verify_loopdec.mir -o - 2>&1 | FileCheck %s --check-prefix=V-LOOPDEC
# RUN: not llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   %t/verify_loopjnz.mir -o - 2>&1 | FileCheck %s --check-prefix=V-LOOPJNZ
# RUN: not llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   %t/verify_loopstart.mir -o - 2>&1 | FileCheck %s --check-prefix=V-LOOPSTART
# RUN: not llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   %t/verify_setcbr_begin.mir -o - 2>&1 | FileCheck %s --check-prefix=V-SETCBR_B
# RUN: not llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   %t/verify_setcbr_end.mir -o - 2>&1 | FileCheck %s --check-prefix=V-SETCBR_E
# RUN: not llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   %t/verify_set_hwloop.mir -o - 2>&1 | FileCheck %s --check-prefix=V-SET_HWLOOP
# RUN: not llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   %t/verify_set_hwloop_reg.mir -o - 2>&1 | FileCheck %s --check-prefix=V-SET_HWLOOP_REG
# RUN: not llc -mtriple=haydn-unknown-elf -start-after=livedebugvalues \
# RUN:   %t/printer_loadi32.mir -o - 2>&1 | FileCheck %s --check-prefix=P-LOADI32
# RUN: not llc -mtriple=haydn-unknown-elf -start-after=livedebugvalues \
# RUN:   %t/printer_load_addr.mir -o - 2>&1 | FileCheck %s --check-prefix=P-LOAD_ADDR
# RUN: not llc -mtriple=haydn-unknown-elf -start-after=livedebugvalues \
# RUN:   %t/printer_loopdec.mir -o - 2>&1 | FileCheck %s --check-prefix=P-LOOPDEC
# RUN: not llc -mtriple=haydn-unknown-elf -start-after=livedebugvalues \
# RUN:   %t/printer_loopjnz.mir -o - 2>&1 | FileCheck %s --check-prefix=P-LOOPJNZ
# RUN: not llc -mtriple=haydn-unknown-elf -start-after=livedebugvalues \
# RUN:   %t/printer_loopstart.mir -o - 2>&1 | FileCheck %s --check-prefix=P-LOOPSTART
# RUN: not llc -mtriple=haydn-unknown-elf -start-after=livedebugvalues \
# RUN:   %t/printer_setcbr_begin.mir -o - 2>&1 | FileCheck %s --check-prefix=P-SETCBR_B
# RUN: not llc -mtriple=haydn-unknown-elf -start-after=livedebugvalues \
# RUN:   %t/printer_setcbr_end.mir -o - 2>&1 | FileCheck %s --check-prefix=P-SETCBR_E
# RUN: not llc -mtriple=haydn-unknown-elf -start-after=livedebugvalues \
# RUN:   %t/printer_set_hwloop.mir -o - 2>&1 | FileCheck %s --check-prefix=P-SET_HWLOOP
# RUN: not llc -mtriple=haydn-unknown-elf -start-after=livedebugvalues \
# RUN:   %t/printer_set_hwloop_reg.mir -o - 2>&1 | FileCheck %s --check-prefix=P-SET_HWLOOP_REG

# Role: verifier — Late-MC one-to-one residual ban on multi-member hard roots.
#
# Hard-root exact-commit/replay (and post-recommit root operand rebuild) leaves
# FormatID-stamped multi-member BUNDLEs for late layout and AsmPrinter. Every
# residual cycle-forming child co-issued with a real member must fail closed on:
#   * haydn-verify-bundles (late firewall; shared isResidualCycleFormingPseudo)
#   * AsmPrinter (one-to-one serialize ban; no multi-cycle repair)
#
# Matrix covers the full residual set as hard-root children:
# multi-cycle (LOADI32/LOAD_ADDR), CSR setup (SETCBR_*), software-loop demotion
# (LoopDec/LoopJNZ), and hwloop setup residuals (LoopStart/SET_HWLOOP*).
# Bare residual peers: late-mc-residual-printer-matrix.mir / vf5-residual-*.mir.
# No FlexMap.

#--- verify_loadi32.mir
--- |
  define void @verify_hard_root_loadi32() { ret void }
...
---
name:            verify_hard_root_loadi32
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r15
    ; V-LOADI32: residual cycle-forming pseudo child
    ; V-LOADI32: one-to-one ban
    BUNDLE 0, implicit-def $r4, implicit-def $r5, implicit-def dead $sfr, implicit $r0, implicit $r1 {
      $r4 = ADD32 $r0, $r1, implicit-def dead $sfr
      $r5 = LOADI32 42
    }
    RET implicit $r15

#--- verify_load_addr.mir
--- |
  define void @verify_hard_root_load_addr() { ret void }
...
---
name:            verify_hard_root_load_addr
tracksRegLiveness: true
