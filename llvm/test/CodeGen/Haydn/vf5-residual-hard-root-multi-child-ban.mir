    BUNDLE 0, implicit-def $r4, implicit-def $r3, implicit-def dead $sfr, implicit $r0, implicit $r1, implicit $r3 {
      $r4 = ADD32 $r0, $r1, implicit-def dead $sfr
      $r3 = LoopDec $r3
    }
    RET implicit $r15

