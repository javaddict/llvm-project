; Test various integer function patterns compile correctly through the full pipeline

; Simple arithmetic

define i32 @test_arithmetic(i32 %a, i32 %b, i32 %c) {
; CHECK-LABEL: test_arithmetic:
; CHECK:       // %bb.0:
; CHECK-NEXT:    { nop; xor32 r0, r0, r0 }
; CHECK-NEXT:    { nop; subi32 sp, sp, 8 }
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    { nop; add32 r2, r1, r2 }
; CHECK-NEXT:    { nop; mull r2, r2, r3 }
; CHECK-NEXT:    { nop; nop }
; CHECK-NEXT:    { nop; sub32 r1, r2, r1 }
; CHECK-NEXT:    { nop; addi32 sp, sp, 8 }
; CHECK-NEXT:    .cfi_def_cfa sp, 0
; CHECK-NEXT:    { nop; jalr r0, lr, 0 }
  %1 = add i32 %a, %b
  %2 = mul i32 %1, %c
  %3 = sub i32 %2, %a
  ret i32 %3
}

