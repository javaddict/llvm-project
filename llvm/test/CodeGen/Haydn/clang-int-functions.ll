; Test various integer function patterns compile correctly through the full pipeline

; Simple arithmetic

define i32 @test_arithmetic(i32 %a, i32 %b, i32 %c) {
; CHECK-LABEL: test_arithmetic:
; CHECK:       // %bb.0:
; CHECK-NEXT:    { xor32 r0, r0, r0; nop }
; CHECK-NEXT:    { subi32 sp, sp, 8; nop }
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    { add32 r2, r1, r2; nop }
; CHECK-NEXT:    { mull r3, r2, r3; nop }
; CHECK-NEXT:    { sub32 r1, r3, r1; nop }
; CHECK-NEXT:    { xor32 r0, r0, r0; nop }
; CHECK-NEXT:    { addi32_w sp, sp, 8; nop }
; CHECK-NEXT:    { jalr_w r0, lr, 0; nop }
  %1 = add i32 %a, %b
  %2 = mul i32 %1, %c
  %3 = sub i32 %2, %a
  ret i32 %3
}

