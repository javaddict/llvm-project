; Population count (manual loop)
define i32 @test_popcount(i32 %a) {
; CHECK-LABEL: test_popcount:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    { xor32 r0, r0, r0; nop }
; CHECK-NEXT:    { subi32 sp, sp, 8; nop }
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    { nop; nop }
; CHECK-NEXT:    { addi32_w r4, r0, 0; nop }
; CHECK-NEXT:    { addi32_w r3, r0, 1; nop }
; CHECK-NEXT:    { move32 r2, r4; nop }
; CHECK-NEXT:  .LBB14_1: // %loop
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    { and32 r5, r1, r3; srl32 r1, r1, r3 }
; CHECK-NEXT:    { seq32 r6, r1, r4; add32 r2, r2, r5 }
; CHECK-NEXT:    { xori32 r6, r6, 1; nop }
; CHECK-NEXT:    { bnez_w r6, .LBB14_1; nop }
; CHECK-NEXT:  // %bb.2: // %exit
; CHECK-NEXT:    { move32 r1, r2; nop }
; CHECK-NEXT:    { xor32 r0, r0, r0; nop }
; CHECK-NEXT:    { addi32_w sp, sp, 8; nop }
; CHECK-NEXT:    { jalr_w r0, lr, 0; nop }
entry:
  br label %loop
loop:
  %i = phi i32 [0, %entry], [%i.next, %loop]
  %x = phi i32 [%a, %entry], [%x.next, %loop]
  %bit = and i32 %x, 1
  %count = add i32 %i, %bit
  %x.next = lshr i32 %x, 1
  %done = icmp eq i32 %x.next, 0
  %i.next = add i32 %count, 0
  br i1 %done, label %exit, label %loop
exit:
  ret i32 %count
}

; Leading zeros (manual loop)
define i32 @test_clz(i32 %a) {
; CHECK-LABEL: test_clz:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    { xor32 r0, r0, r0; nop }
; CHECK-NEXT:    { subi32 sp, sp, 8; nop }
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    { nop; nop }
; CHECK-NEXT:    { addi32_w r4, r0, 0; nop }
; CHECK-NEXT:    { addi32_w r2, r0, 32; nop }
; CHECK-NEXT:    { addi32_w r3, r0, 1; nop }
; CHECK-NEXT:    { seq32 r4, r2, r4; nop }
; CHECK-NEXT:  .LBB15_1: // %loop
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    { sll32 r1, r1, r3; nop }
; CHECK-NEXT:    { bnez_w r4, .LBB15_1; nop }
; CHECK-NEXT:  // %bb.2: // %exit
; CHECK-NEXT:    { move32 r1, r2; nop }
; CHECK-NEXT:    { xor32 r0, r0, r0; nop }
; CHECK-NEXT:    { addi32_w sp, sp, 8; nop }
; CHECK-NEXT:    { jalr_w r0, lr, 0; nop }
entry:
  br label %loop
loop:
  %i = phi i32 [32, %entry], [%i.next, %loop]
  %x = phi i32 [%a, %entry], [%x.next, %loop]
  %topbit = and i32 %x, -2147483648
  %done = icmp ne i32 %topbit, 0
  %i.next = select i1 %done, i32 %i, i32 %i
  %x.next = shl i32 %x, 1
  %cont = icmp eq i32 %i, 0
  br i1 %cont, label %loop, label %exit
exit:
  ret i32 %i
}

