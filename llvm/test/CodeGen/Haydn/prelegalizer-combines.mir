# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-prelegalizer-combiner -global-isel-abort=1 %s -o - | FileCheck %s
#
# Tests for the Haydn pre-legalizer combiner (haydn_generic_combines + C++
# allowlist). Each test case verifies a specific combine rule operates
# correctly on generic G_* instructions before type/action legalization.
#
# Use liveins (not G_IMPLICIT_DEF) — undef_combines collapses dead undef trees.

---
name: trunc_of_anyext
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0
    ; CHECK-LABEL: name: trunc_of_anyext
    ; G_TRUNC(G_ANYEXT x) -> COPY x when the trunc output type matches
    ; the anyext input type. The G_TRUNC is eliminated.
    %0:_(s32) = COPY $r0
    %1:_(s64) = G_ANYEXT %0
    ; CHECK-NOT: G_TRUNC
    ; CHECK-NOT: G_ANYEXT
    %2:_(s32) = G_TRUNC %1
    $r1 = COPY %2
...

---
name: trunc_of_anyext_wrong_type
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0
    ; Wrong-type trunc(anyext) is not an identity COPY: cast_combines peels
    ; the anyext (trunc(anyext x:s32->s64)->s16 becomes trunc x->s16). Use
    ; G_ZEXT on the result so anyext_trunc_fold cannot re-fold to x.
    ; CHECK-LABEL: name: trunc_of_anyext_wrong_type
    %0:_(s32) = COPY $r0
    %1:_(s64) = G_ANYEXT %0
    %2:_(s16) = G_TRUNC %1
    %3:_(s32) = G_ZEXT %2
    ; CHECK-NOT: G_ANYEXT
    ; CHECK: G_TRUNC
    ; CHECK: G_ZEXT
    $r1 = COPY %3
...

---
name: and_all_ones
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0
    ; CHECK-LABEL: name: and_all_ones
    ; G_AND x, -1 -> COPY x (AND with all-ones is identity)
    %0:_(s32) = COPY $r0
    %1:_(s32) = G_CONSTANT i32 -1
    ; CHECK-NOT: G_AND
    %2:_(s32) = G_AND %0, %1
    $r1 = COPY %2
...

---
name: or_zero
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0
    ; CHECK-LABEL: name: or_zero
    ; G_OR x, 0 -> COPY x (OR with zero is identity)
    %0:_(s32) = COPY $r0
    %1:_(s32) = G_CONSTANT i32 0
    ; CHECK-NOT: G_OR
    %2:_(s32) = G_OR %0, %1
    $r1 = COPY %2
...

---
name: shift_by_zero
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0
    ; CHECK-LABEL: name: shift_by_zero
    ; G_SHL x, 0 -> COPY x (shift by zero is identity)
    %0:_(s32) = COPY $r0
    %1:_(s32) = G_CONSTANT i32 0
    ; CHECK-NOT: G_SHL
    %2:_(s32) = G_SHL %0, %1
    $r1 = COPY %2
...

---
name: lshr_by_zero
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0
    ; CHECK-LABEL: name: lshr_by_zero
    ; G_LSHR x, 0 -> COPY x
    %0:_(s32) = COPY $r0
    %1:_(s32) = G_CONSTANT i32 0
    ; CHECK-NOT: G_LSHR
    %2:_(s32) = G_LSHR %0, %1
    $r1 = COPY %2
...

---
name: ashr_by_zero
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0
    ; CHECK-LABEL: name: ashr_by_zero
    ; G_ASHR x, 0 -> COPY x
    %0:_(s32) = COPY $r0
    %1:_(s32) = G_CONSTANT i32 0
    ; CHECK-NOT: G_ASHR
    %2:_(s32) = G_ASHR %0, %1
    $r1 = COPY %2
...

---
name: constant_fold_add
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: constant_fold_add
    ; G_ADD constant, constant -> new constant
    %0:_(s32) = G_CONSTANT i32 42
    %1:_(s32) = G_CONSTANT i32 100
    ; CHECK-NOT: G_ADD
    ; CHECK: G_CONSTANT i32 142
    %2:_(s32) = G_ADD %0, %1
    $r1 = COPY %2
...

---
name: constant_fold_sub
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: constant_fold_sub
    ; G_SUB constant, constant -> new constant
    %0:_(s32) = G_CONSTANT i32 200
    %1:_(s32) = G_CONSTANT i32 58
    ; CHECK-NOT: G_SUB
    ; CHECK: G_CONSTANT i32 142
    %2:_(s32) = G_SUB %0, %1
    $r1 = COPY %2
...

---
name: constant_fold_mul
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: constant_fold_mul
    ; G_MUL constant, constant -> new constant
    %0:_(s32) = G_CONSTANT i32 6
    %1:_(s32) = G_CONSTANT i32 7
    ; CHECK-NOT: G_MUL
    ; CHECK: G_CONSTANT i32 42
    %2:_(s32) = G_MUL %0, %1
    $r1 = COPY %2
...

---
name: mul_to_shl
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0
    ; CHECK-LABEL: name: mul_to_shl
    ; G_MUL x, power-of-two -> G_SHL x, log2 (trivial_combines / mul_to_shl)
    %0:_(s32) = COPY $r0
    %1:_(s32) = G_CONSTANT i32 8
    ; CHECK-NOT: G_MUL
    ; CHECK: G_SHL
    %2:_(s32) = G_MUL %0, %1
    $r1 = COPY %2
...

---
name: ptr_add_chain
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0
    ; CHECK-LABEL: name: ptr_add_chain
    ; G_PTR_ADD(G_PTR_ADD base, C1), C2 -> G_PTR_ADD base, (C1+C2)
    %0:_(p0) = COPY $r0
    %1:_(s32) = G_CONSTANT i32 10
    %2:_(p0) = G_PTR_ADD %0, %1
    %3:_(s32) = G_CONSTANT i32 20
    ; CHECK-NOT: G_PTR_ADD %2
    ; The combined constant should be 30 (single G_PTR_ADD with base %0)
    ; CHECK: G_CONSTANT i32 30
    ; CHECK: G_PTR_ADD %0
    %4:_(p0) = G_PTR_ADD %2, %3
    $r1 = COPY %4
...

---
name: no_combine_non_constant_add
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1
    ; G_ADD with non-constant operands should NOT be folded.
    ; CHECK-LABEL: name: no_combine_non_constant_add
    %0:_(s32) = COPY $r0
    %1:_(s32) = COPY $r1
    ; CHECK: G_ADD
    %2:_(s32) = G_ADD %0, %1
    $r1 = COPY %2
...
