;Test that global data works
@global_val = global i32 123, align 4

define i32 @use_global() {
; CHECK-LABEL: use_global:
; CHECK:       // #<spill-kpi> @use_global spills=0 spill-bytes=0 reloads=0 reload-bytes=0
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    { xor32 r0, r0, r0; nop; nop }
; CHECK-NEXT:    { subi32 sp, sp, 8; nop }
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    { lui r1, global_val; nop; nop }
; CHECK-NEXT:    { addi32 r1, r1, global_val; nop }
; CHECK-NEXT:    { s_lw_with_imm r1, r1, 0; nop; nop }
; CHECK-NEXT:    { xor32 r0, r0, r0; nop; nop }
; CHECK-NEXT:    { addi32 sp, sp, 8; nop }
; CHECK-NEXT:    { nop; jalr r0, lr, 0; nop }
entry:
  %val = load i32, ptr @global_val, align 4
  ret i32 %val
}

