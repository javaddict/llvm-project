# RUN: llc -mtriple=haydn-unknown-elf -run-pass=machine-cp -mcp-use-is-copy-instr \
# RUN:     -verify-machineinstrs -o - %s | FileCheck %s

# Role: MIR — generic MCP(UseCopyInstr) via isCopyInstrImpl (MOVE32/OR32/OR64).
# Dead non-identity COPY and OR rd,rs,rs copies are removed. Identity COPY
# (overlapping src/dst) is kept — MCP does not erase those (HaydnCopyElim did).
# Non-copy OR (unequal srcs) stays.

--- |
  define void @mcp_use_copy_instr() nounwind { ret void }
...
---
# CHECK-LABEL: name: mcp_use_copy_instr
name:            mcp_use_copy_instr
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$d1', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        false
body:             |
  bb.0:
    liveins: $r1, $r3, $r4, $d0, $d1, $r15

    ; CHECK-NOT: $r5 = COPY $r3
    ; CHECK-NOT: $r6 = OR32 $r3, $r3
    ; CHECK-NOT: $d2 = OR64 $d0, $d0
    ; CHECK: $r1 = COPY $r1
    ; CHECK: $r4 = OR32 $r4, $r4
    ; CHECK: $r2 = OR32 $r3, $r4
    ; CHECK: $d3 = OR64 $d0, $d1
    ; CHECK: RET
    $r5 = COPY $r3
    $r6 = OR32 $r3, $r3, implicit-def dead $sfr
    $d2 = OR64 $d0, $d0, implicit-def dead $sfr
    $r1 = COPY $r1
    $r4 = OR32 $r4, $r4, implicit-def dead $sfr
    $r2 = OR32 $r3, $r4, implicit-def dead $sfr
    $d3 = OR64 $d0, $d1, implicit-def dead $sfr
    RET implicit $r15
