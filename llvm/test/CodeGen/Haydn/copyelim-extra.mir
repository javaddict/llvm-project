# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-copy-elim \
# RUN:     -verify-machineinstrs -debug-only=haydn-copy-elim -o - %s 2>&1 \
# RUN:     | FileCheck %s
# REQUIRES: asserts

# Role: MIR — OR32 identity fold in HaydnCopyElim.

# REGRESSION TEST: OR32 identity fold in HaydnCopyElim.
#
# Fixed (XFAIL hygiene): MIR OR32 arity is (rd, rs1, rs2) so the
# identity form is `$r1 = OR32 $r1, $r1` (two sources). The prior three-source
# form was a test-authoring bug ("Extra explicit operand").
#
# Background:
# The pass historically only folded the OR64 identity pattern
# (OR64 dN, dN, dN -> removed). extended it to also fold
# OR32 rN, rN, rN (the GPR32 analog), since OR32 rd, rs, rs is also a
# valid post-RA copy-like sequence and rd==rs==rs makes it a no-op.
#
# What this test guards:
# An OR32 $r1, $r1 identity in the MIR must be removed by the pass.
# The debug log must print "Eliminating OR32 identity copy:" to prove
# the new code path (not the OR64 path) fired.
# A neighboring non-identity OR32 must remain untouched.

--- |
  define void @or32_identity_fold() nounwind { ret void }
...
---
# CHECK: Eliminating OR32 identity copy:{{.*}}$r1 = OR32 $r1, $r1
# CHECK-LABEL: name: or32_identity_fold
name:            or32_identity_fold
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        false
body:             |
  bb.0:
    liveins: $r1, $r3, $r4, $r15

    ; CHECK-NOT: $r1 = OR32 $r1, $r1
    ; CHECK: $r2 = OR32 $r3, $r4
    ; CHECK: RET
    $r1 = OR32 $r1, $r1, implicit-def dead $sfr
    $r2 = OR32 $r3, $r4, implicit-def dead $sfr
    RET implicit $r15
