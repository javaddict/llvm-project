# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=haydn-hwloops -verify-machineinstrs %s -o - | \
# RUN:   FileCheck %s

# Role: MIR — product selector/CSR/reloc fault matrix on retained-state
# path. Product domain is {0,1}; out-of-domain sel demotes fail-closed (never
# invent extra HWLR seats or free CSR addresses). Legal sel=0/1 keep hardware
# form. Proven COUNT < MinCount is the D1.139 pin
# (d139-hwloop-demote-zero-trip.mir), not a SUBI32+BNEZ wrap.

--- |
  define dso_local void @keep_sel0(ptr %p) {
  entry:
    br label %body
  body:
    store i32 0, ptr %p
    br label %exit
  exit:
    ret void
  }

  define dso_local void @keep_sel1(ptr %p) {
  entry:
    br label %body
  body:
    store i32 0, ptr %p
    br label %exit
  exit:
    ret void
  }

  define dso_local void @demote_sel2(ptr %p) {
  entry:
    br label %body
  body:
    store i32 0, ptr %p
    br label %exit
  exit:
    ret void
  }

  define dso_local void @demote_sel3(ptr %p) {
  entry:
    br label %body
  body:
    store i32 0, ptr %p
    br label %exit
  exit:
    ret void
  }

  define dso_local void @demote_sel_neg(ptr %p) {
  entry:
    br label %body
  body:
    store i32 0, ptr %p
    br label %exit
  exit:
    ret void
  }
...
---
name:            keep_sel0
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r0, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0
    SET_HWLOOP_W 0, %bb.1, %bb.1, 8, implicit-def dead $sfr
    NOP
    NOP
    NOP

  bb.1.body:
    liveins: $r1, $r0
    successors: %bb.2
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.2.exit:
    liveins: $r15
    RET implicit killed $r15

# CHECK-LABEL: name: keep_sel0
# CHECK: SET_HWLOOP_W{{.*}} 0
# CHECK-NOT: SUBI32
# CHECK-NOT: BNEZ_W

---
name:            keep_sel1
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r0, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0
    SET_HWLOOP_W 1, %bb.1, %bb.1, 8, implicit-def dead $sfr
    NOP
    NOP
    NOP

  bb.1.body:
    liveins: $r1, $r0
    successors: %bb.2
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.2.exit:
    liveins: $r15
    RET implicit killed $r15

# CHECK-LABEL: name: keep_sel1
# CHECK: SET_HWLOOP_W{{.*}} 1
# CHECK-NOT: SUBI32
# CHECK-NOT: BNEZ_W

---
name:            demote_sel2
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r0, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0
    ; Out-of-domain selector (product domain is {0,1} only).
    SET_HWLOOP_W 2, %bb.1, %bb.1, 8, implicit-def dead $sfr
    NOP
    NOP
    NOP

  bb.1.body:
    liveins: $r1, $r0
    successors: %bb.2
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.2.exit:
    liveins: $r15
    RET implicit killed $r15

# CHECK-LABEL: name: demote_sel2
# CHECK-NOT: SET_HWLOOP_W
# Soft residual after fail-closed demote. Late exact-commit rewrites
# residual BNEZ_W to the golden Format E BNEZ member.
# CHECK: SUBI32
# CHECK: BNEZ

---
name:            demote_sel3
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r0, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0
    SET_HWLOOP_W 3, %bb.1, %bb.1, 8, implicit-def dead $sfr
    NOP
    NOP
    NOP

  bb.1.body:
    liveins: $r1, $r0
    successors: %bb.2
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.2.exit:
    liveins: $r15
    RET implicit killed $r15

# CHECK-LABEL: name: demote_sel3
# CHECK-NOT: SET_HWLOOP_W
# CHECK: SUBI32
# CHECK: BNEZ

---
name:            demote_sel_neg
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r0, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0
    SET_HWLOOP_W -1, %bb.1, %bb.1, 8, implicit-def dead $sfr
    NOP
    NOP
    NOP

  bb.1.body:
    liveins: $r1, $r0
    successors: %bb.2
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.2.exit:
    liveins: $r15
    RET implicit killed $r15

# CHECK-LABEL: name: demote_sel_neg
# CHECK-NOT: SET_HWLOOP_W
# CHECK: SUBI32
# CHECK: BNEZ
