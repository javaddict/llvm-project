# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=prologepilog,haydn-hwloops -verify-machineinstrs \
# RUN:   %s -o - | FileCheck %s

# Role: MIR — frame-deadline law: the hwloop-demote save home is reserved
# before frame finalization; the post-RA demote never CreateStackObject.
#
# D1.150 / D1.154: when a SET_HWLOOP already present at PEI is
# Fixup-demoted, HaydnFrameLowering CreateStackObject one 4-byte
# demote-save FI per setup (LoopStart included on the product path;
# this file is the SET-at-PEI mechanism pin). Not a PostRA share.
# Formed-ZOL / refused still must not take the reserved slot.
# +4B is often absorbed by StackAlign 8, so do not treat SUBI32 $r13,
# 16 as the dedicated-slot proof — pin the pre-PEI spill-slot count
# instead. CHECK-NOT after COUNT rejects over-reservation.
#
# Bug this pins: the demote used to lazily CreateStackObject AFTER frame
# offsets were final, then later shared PostRAScratchFI by beginSpill
# priority. Reservation is pre-PEI only; disjointness is
# resolveDemoteSaveHome.
#
# What breaks if the bug returns: the demote save ST32/LD32 pair addresses a
# slot the frame layout never accounted for, shares PostRA, or the compiler
# fatals with "dedicated demote-save FI".

--- |
  define dso_local void @demote_savefi_pre_pei(ptr nocapture writeonly %out) {
  entry:
    br label %spacer
  spacer:
    br label %body
  body:
    store i32 0, ptr %out, align 4
    br label %exit
  exit:
    ret void
  }

...
---
name:            demote_savefi_pre_pei
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r2, $r3, $r4, $r5, $r6, $r8, $r9, $r10, $r11, $r12, $r15
    successors: %bb.1

    SET_HWLOOP_W 0, %bb.2, %bb.2, 8, implicit-def dead $sfr
    NOP
    NOP
    NOP

  ; Spacer: 20× NOP = 320 B > uimm6 252 — StartOff overflow, demote-first.
  bb.1.spacer:
    liveins: $r1, $r2, $r3, $r4, $r5, $r6, $r8, $r9, $r10, $r11, $r12
    successors: %bb.2
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP

  bb.2.body:
    liveins: $r1, $r2, $r3, $r4, $r5, $r6, $r8, $r9, $r10, $r11, $r12
    successors: %bb.3

    ST32 renamable $r1, $r13, 0

  bb.3.exit:
    RET implicit $r15

...
# CHECK-NOT: {{.*: demote refused}}
# CHECK-NOT: report_fatal_error
# Demote ran (soft edge installed). Dedicated pre-PEI 4-byte spill homes:
# PostRA + N counters + N saves (SET present at PEI) + scavenger/BR.
# N=1 SET → 4 slots. Do not pin SUBI32 $r13, 16 — StackAlign 8 absorbs
# the extra slot. Product LoopStart census is d1154-*-loopstart-savefi.
# CHECK: stack:
# CHECK-COUNT-4: type: spill-slot
# CHECK-NOT: type: spill-slot
# CHECK: frame-setup SUBI32 $r13
# The demoted countdown loop uses the pre-reserved FI homes.
# CHECK: ST32
# CHECK: BNEZ
