# RUN: rm -rf %t && split-file %s %t
# RUN: llc -mtriple=haydn-unknown-elf -start-after=livedebugvalues \
# RUN:   %t/missing_row.mir -o - | FileCheck %s --check-prefix=COUNT-ROW
# RUN: not llc -mtriple=haydn-unknown-elf -start-after=livedebugvalues \
# RUN:   %t/completion_mismatch.mir -o - 2>&1 | FileCheck %s --check-prefix=COMP-MISMATCH
# REQUIRES: haydn-registered-target

# Role: verifier — E2 vs E3 is a bundle-level fact (stamp or child count).
# A 1-child BUNDLE with no row stamp encodes as E2. Present
# CompletionStateID must still match row + real membership.

#--- missing_row.mir
--- |
  define void @missing_row() { ret void }
...
---
name:            missing_row
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r15
    ; COUNT-ROW: add32
    ; COUNT-ROW: jalr
    BUNDLE implicit-def $r2, implicit-def dead $sfr, implicit $r0, implicit $r1 {
      $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    }
    RET implicit $r15

#--- completion_mismatch.mir
--- |
  define void @completion_mismatch() { ret void }
...
---
name:            completion_mismatch
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r15
    ; COMP-MISMATCH: CompletionStateID does not match
    ; COMP-MISMATCH: refuse filler reselection
    BUNDLE 0, 2, implicit-def $r4, implicit-def $r5, implicit-def dead $sfr, implicit $r0, implicit $r1, implicit $r2, implicit $r3 {
      $r4 = ADD32 $r0, $r1, implicit-def dead $sfr
      $r5 = XOR32 $r2, $r3, implicit-def dead $sfr
    }
    RET implicit $r15
