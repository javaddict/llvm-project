# RUN: llc -mtriple=haydn-unknown-elf -misched-postra-direction=topdown \
# RUN:   -run-pass=postmisched -verify-machineinstrs %s -o - | \
# RUN:   FileCheck %s --check-prefixes=TOP
# RUN: llc -mtriple=haydn-unknown-elf -misched-postra-direction=bottomup \
# RUN:   -run-pass=postmisched -verify-machineinstrs %s -o - | \
# RUN:   FileCheck %s --check-prefixes=BOT
# REQUIRES: haydn-registered-target
#
# Role: MIR — D1.30 fold-note (a): the D1.10 store-stall/dual-load hold is
# DEFINED on the Top zone only (LastSameBaseStoreCycle is keyed by
# Top.getCurrCycle(); noteIssuedStore records Top issues only). Under
# bottomup the hold is inert by construction and the base scheduler's own
# reconstruction owns that arm. This two-arm pin makes the polarity loud:
# topdown keeps the store out of the idle cycle after the same-base store
# (hold shape), bottomup does not apply the Top-keyed hold. A hard assert
# was rejected: postmisched-zone-direction.mir's bottomup/bidirectional
# arms are a supported green debugging surface.

--- |
  define void @store_stall_polarity(ptr %p, ptr %q) { ret void }
...
---
name:            store_stall_polarity
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r1, $r2

    ; TOP-LABEL: name: store_stall_polarity
    ; Top arm: same-base store pair on $r2; the second store must NOT join
    ; the idle cycle right after the first while the nearby $r2 loads are
    ; unscheduled (Top-keyed hold active).
    ; TOP: liveins: $r1, $r2
    ; TOP-NEXT: {{  $}}
    ; TOP-NEXT: BUNDLE 0, 0, implicit-def $r3, implicit-def $r4, implicit $r2 :: (load (s32) from %ir.q + 8), (load (s32) from %ir.q + 12) {
    ; TOP-NEXT: $r3 = S_LW_WITH_IMM_E2_E1_LOAD1_RI6 $r2, 8 :: (load (s32) from %ir.q + 8)
    ; TOP-NEXT: $r4 = S_LW_WITH_IMM_E2_E0_LOADSTORE0_RI6 $r2, 12 :: (load (s32) from %ir.q + 12)
    ; TOP-NEXT: }
    ; TOP-NEXT: S_SW_WITH_IMM_E2_E0_LOADSTORE0_RI6 $r2, $r2, 0 :: (store (s32) into %ir.q)
    ; TOP-NEXT: BUNDLE 1, 0, implicit-def $r0, implicit-def dead $sfr, implicit $r3, implicit killed $r4, implicit killed $r2 :: (store (s32) into %ir.q + 4) {
    ; TOP-NEXT: $r0 = ADD32_E3_E1_ALU1_RR $r3, killed $r4, implicit-def dead $sfr
    ; TOP-NEXT: S_SW_WITH_IMM_E3_E0_LOADSTORE0_RI6 killed $r2, $r2, 4 :: (store (s32) into %ir.q + 4)
    ; TOP-NEXT: }
    ; TOP-NEXT: $r0 = ADD32_E3_E2_ALU2_RR $r0, killed $r3, implicit-def dead $sfr
    ; TOP-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    ;
    ; BOT-LABEL: name: store_stall_polarity
    ; Bot arm: no Top-keyed hold; base reconstruction owns the order. The
    ; two stores land in their cycles by Bot reconstruction, not by the
    ; D1.10 hold (the hold never fires on a non-Top zone).
    ; BOT: liveins: $r1, $r2
    ; BOT-NEXT: {{  $}}
    ; BOT-NEXT: BUNDLE 0, 0, implicit-def $r3, implicit-def $r4, implicit $r2 :: (load (s32) from %ir.q + 8), (load (s32) from %ir.q + 12) {
    ; BOT-NEXT: $r3 = S_LW_WITH_IMM_E2_E1_LOAD1_RI6 $r2, 8 :: (load (s32) from %ir.q + 8)
    ; BOT-NEXT: $r4 = S_LW_WITH_IMM_E2_E0_LOADSTORE0_RI6 $r2, 12 :: (load (s32) from %ir.q + 12)
    ; BOT-NEXT: }
    ; BOT-NEXT: NOP
    ; BOT: $r0 = ADD32_E3_E2_ALU2_RR $r3, killed $r4, implicit-def dead $sfr
    ; BOT: BUNDLE 1, 0, implicit-def $r0, implicit-def dead $sfr, implicit $r0, implicit killed $r3, implicit $r2 :: (store (s32) into %ir.q + 4) {
    ; BOT-NEXT: $r0 = ADD32_E3_E1_ALU1_RR $r0, killed $r3, implicit-def dead $sfr
    ; BOT-NEXT: S_SW_WITH_IMM_E3_E0_LOADSTORE0_RI6 $r2, $r2, 4 :: (store (s32) into %ir.q + 4)
    ; BOT-NEXT: }
    ; BOT-NEXT: S_SW_WITH_IMM_E2_E0_LOADSTORE0_RI6 killed $r2, $r2, 0 :: (store (s32) into %ir.q)
    ; BOT-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    ST32 $r2, $r2, 0 :: (store (s32) into %ir.q)
    ST32 $r2, $r2, 4 :: (store (s32) into %ir.q + 4)
    $r3 = LD32 $r2, 8 :: (load (s32) from %ir.q + 8)
    $r4 = LD32 $r2, 12 :: (load (s32) from %ir.q + 12)
    $r0 = ADD32 $r3, $r4, implicit-def dead $sfr
    $r0 = ADD32 $r0, $r3, implicit-def dead $sfr
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
