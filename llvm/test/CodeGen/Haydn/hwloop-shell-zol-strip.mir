# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop -run-pass=haydn-hwloops \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s
#
# Role A shell strip (unified classifyZOLBody):
# PseudoLoopEnd is MCID::Meta — must match opcode, not isMetaInstruction.
# Shell = PLE + ≤2 stores/copies/imms, no load/compute → strip LoopStart+PLE.
# HiFi never freezes a store-only ZOL while real work lives outside (poly/alog).
#
# CHECK-LABEL: name: shell_store_only
# CHECK-NOT: LoopStart
# CHECK-NOT: PseudoLoopEnd
# CHECK: S_SW_WITH_IMM

--- |
  define dso_local void @shell_store_only(ptr %p) {
  entry:
    br label %body
  body:
    store i32 0, ptr %p, align 4
    br label %exit
  exit:
    ret void
  }
...
---
name:            shell_store_only
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r0, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0
    ; LoopStart: (GPR32 trip, simm6 adj) — body found via successor PLE.
    LoopStart $r1, 0
    NOP
    NOP
    NOP

  bb.1.body:
    successors: %bb.1, %bb.2
    liveins: $r1, $r0, $r15

    ; Store-only shell (soft-zero r0) — no load/compute.
    S_SW_WITH_IMM $r0, $r1, 0
    PseudoLoopEnd %bb.1

  bb.2.exit:
    liveins: $r15
    RET implicit killed $r15
...
