# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop -run-pass=haydn-hwloops \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# Role: MIR — store-only shell expands (not strip). Empty bodies are stripped
# elsewhere; stripping a shell would drop memset/calloc work to a single store.

# CHECK-LABEL: name: shell_store_only
# CHECK: SET_HWLOOP_F2_W
# CHECK-NOT: LoopStart
# CHECK: ST32
# CHECK: PseudoLoopEnd

--- |
  define dso_local void @shell_store_only(ptr %p) {
  entry:
    br label %body
  body:
    store i32 0, ptr %p, align 4
    br label %exit
  exit:
    ret void
  }
...
---
name:            shell_store_only
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r0, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0
    LoopStart $r1, 0
    NOP
    NOP
    NOP

  bb.1.body:
    successors: %bb.1, %bb.2
    liveins: $r1, $r0, $r15

    ST32 $r0, $r1, 0
    PseudoLoopEnd %bb.1

  bb.2.exit:
    liveins: $r15
    RET implicit killed $r15
...
