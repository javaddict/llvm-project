# D1.50 ordered-terminator law pins (proof/coverage slice). The law
# (HaydnLongBranchNormalize describeOrderedTerminatorTail) names every
# control cycle in order, proves the selected uncond unique/trailing with
# its dest the analyzed FBB/TBB, and proves the analyzed cond owns the
# analyzed TBB — BEFORE any mutation. These shapes prove the vocabulary
# executes (verifier enabled), not just that corruption fails closed:
#
#   far_fbb_non_layout_tbb: far FBB whose analyzed TBB is NEAR but NOT
#     the layout successor (a trap block sits between). The kept-polarity
#     arm must retain BEQZ to TBB and replace only the trailing uncond —
#     invert (which would need a proven near dest) must never fire and
#     the trap must never be branched to.
#   one_way_far_tbb: one-way cond to a far TBB with NO trailing uncond.
#     The law names no erasable member; the rewrite appends JALR only,
#     leaving the cond exactly as analyzed.
#   multi_control_far_uncond: unanalyzable two-cond tail whose last cycle
#     is a coissued BUNDLE{ALU,B}. The law names only the trailing uncond
#     member; both conds and the ALU sibling survive, ALU spliced before
#     the first control, JALR last.
#
# Far template (d149/d134 law, buffer=4, parcel=12, window edge 2044):
#   170 NOPs = 2040B. Each logical B/BEQZ/NOP/RET charges one parcel.
#
# Whole-file RUN lines would see the corrupt section's second embedded-IR
# document below (one leading IR doc per .mir file), so every arm runs on
# its split-file section.
# RUN: rm -rf %t && split-file %s %t
# RUN: llc -mtriple=haydn-unknown-elf \
# RUN:   -run-pass=haydn-longbranch-normalize,haydn-finalize-mi-bundles,haydn-verify-bundles \
# RUN:   -haydn-branch-relax-safety-buffer=4 -verify-machineinstrs %t/law.mir -o - \
# RUN:   | FileCheck %s --check-prefix=FBBNL
# RUN: llc -mtriple=haydn-unknown-elf \
# RUN:   -run-pass=haydn-longbranch-normalize,haydn-finalize-mi-bundles,haydn-verify-bundles \
# RUN:   -haydn-branch-relax-safety-buffer=4 -verify-machineinstrs %t/law.mir -o - \
# RUN:   | FileCheck %s --check-prefix=ONEWAY
# RUN: llc -mtriple=haydn-unknown-elf \
# RUN:   -run-pass=haydn-longbranch-normalize,haydn-finalize-mi-bundles,haydn-verify-bundles \
# RUN:   -haydn-branch-relax-safety-buffer=4 -verify-machineinstrs %t/law.mir -o - \
# RUN:   | FileCheck %s --check-prefix=MCLAW
# Corruption probe (split-file so the healthy arms never see the corrupt
# tail): finalize first arms the postcommit stamp, then the normalizer's
# ordered-terminator law refuses the two-uncond-cycle tail with the named
# violation (plain `not`: GenCrashDiag=false exits 1). Pre-stamp the same
# tail defers (nullptr) and Arm A fatals "selected trailing uncond
# missing" — the stamp discriminates the LAW message.
# RUN: not llc -mtriple=haydn-unknown-elf \
# RUN:   -run-pass=haydn-finalize-mi-bundles,haydn-longbranch-normalize \
# RUN:   -haydn-branch-relax-safety-buffer=4 %t/corrupt.mir -o - 2>&1 \
# RUN:   | FileCheck %s --check-prefix=CORRUPT
# REQUIRES: haydn-registered-target

#--- law.mir
--- |
  define dso_local void @far_fbb_non_layout_tbb() {
  entry:
    br i1 undef, label %near, label %far
  trap:
    ret void
  near:
    br label %far
  far:
    ret void
  }

  define dso_local void @one_way_far_tbb() {
  entry:
    br i1 undef, label %far, label %near
  near:
    br label %far
  far:
    ret void
  }

  define dso_local void @multi_control_far_uncond() {
  entry:
    br i1 undef, label %far, label %near
  near:
    br label %far
  far:
    ret void
  }
...
---
name:            far_fbb_non_layout_tbb
alignment:       1
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r7, $r15
    successors: %bb.2, %bb.3
    BEQZ_W $r7, %bb.2, implicit-def dead $sfr
    B %bb.3

  bb.1.trap (inlineasm-br-indirect-target):
    liveins: $r15
    RET implicit killed $r15


  bb.2.near:
    successors: %bb.3
    liveins: $r15
