# RUN: split-file %s %t
# Fatal seats abort; use not --crash so the diagnostic still reaches FileCheck.
# RUN: not --crash llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   %t/e2-two-alu.mir -o - 2>&1 \
# RUN:   | FileCheck %s --check-prefix=E2-NO-MEMBER
# RUN: not --crash llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   %t/dual-store.mir -o - 2>&1 \
# RUN:   | FileCheck %s --check-prefix=DUP-UNIT
# RUN: not --crash llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   %t/residual-logical-missing-completion.mir -o - 2>&1 \
# RUN:   | FileCheck %s --check-prefix=RES-NO-COMP
# RUN: not --crash llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   %t/stub-completion-on-real.mir -o - 2>&1 \
# RUN:   | FileCheck %s --check-prefix=STUB-COMP
# RUN: not llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   %t/expand-owned-post-inc.mir -o - 2>&1 \
# RUN:   | FileCheck %s --check-prefix=EXPAND-OWNED
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   -verify-machineinstrs %t/legal-e2-logical.mir -o - \
# RUN:   | FileCheck %s --check-prefix=OK-LOG
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   -verify-machineinstrs %t/pad-only-idle.mir -o - \
# RUN:   | FileCheck %s --check-prefix=OK-IDLE
# REQUIRES: haydn-registered-target

# Role: MIR — independent inverse records only (opcode-keyed FormatEInverse).
# Residual/logical members must not pass via Haydn::Bundle canAdd / peel /
# findFormatEMember / makeProductPlan / selectCompletionForMembersAndPads.
# Completion is golden-row fill (expectedGoldenRowCompletion) on every
# residual root. Architectural NOP in every slot of a legal format is
# product idle, not residual membership.
#
# AIE peers: AIEBaseInstrInfo.cpp:1595-1614 verifyInstruction fail-closed;
# AIEMCFormats.h:376-379 getAlternateInstsOpcode overlay (opcode-keyed).

# E2-NO-MEMBER: structural inverse: residual/logical inverse record not completed at membership entry (no generated member)
# DUP-UNIT: unit-injective
# RES-NO-COMP: missing CompletionStateID
# STUB-COMP: does not match row and member count
# EXPAND-OWNED: residual expand-owned pseudo child
# OK-LOG-LABEL: name: legal_e2_logical
# OK-LOG: BUNDLE 0, 0
# OK-LOG: ADD32
# OK-LOG: LD32
# OK-IDLE-LABEL: name: pad_only_idle
# OK-IDLE: BUNDLE 0, 0
# OK-IDLE: NOP

#--- e2-two-alu.mir
--- |
  define void @e2_two_alu() { ret void }
...
---
name:            e2_two_alu
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r15
    BUNDLE 0, 0, implicit-def $r4, implicit-def $r5, implicit-def dead $sfr, implicit $r0, implicit $r1, implicit $r2, implicit $r3 {
      $r4 = ADD32 $r0, $r1, implicit-def dead $sfr
      $r5 = XOR32 $r2, $r3, implicit-def dead $sfr
    }
    RET implicit $r15
...
#--- dual-store.mir
--- |
  define void @dual_store() { ret void }
...
---
name:            dual_store
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r15
    BUNDLE 0, 0, implicit-def dead $sfr, implicit $r0, implicit $r1, implicit $r2, implicit $r3 {
      ST32 $r0, $r1, 0, implicit-def dead $sfr
      ST32 $r2, $r3, 0, implicit-def dead $sfr
    }
    RET implicit $r15
...
#--- residual-logical-missing-completion.mir
--- |
  define void @residual_logical_missing_completion() { ret void }
...
---
name:            residual_logical_missing_completion
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r15
    BUNDLE 0, implicit-def $r2, implicit-def dead $sfr, implicit $r0, implicit $r1 {
      $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    }
    RET implicit $r15
...
#--- stub-completion-on-real.mir
--- |
  define void @stub_completion_on_real() { ret void }
...
---
# StubE2Singleton (imm 2) on a real member. Golden-row fill expects
# AllEntriesReal; verify must not accept a stamper-style stub.
name:            stub_completion_on_real
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r15
    BUNDLE 0, 2, implicit-def $r2, implicit-def dead $sfr, implicit $r0, implicit $r1 {
      $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    }
    RET implicit $r15
...
#--- expand-owned-post-inc.mir
--- |
  define void @expand_owned_post_inc() { ret void }
...
---
name:            expand_owned_post_inc
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r15
    BUNDLE 0, 0, implicit-def $r4, implicit $r0 {
      $r4 = LD32_POST_INC $r0, 4, 0
    }
    RET implicit $r15
...
#--- legal-e2-logical.mir
--- |
  define void @legal_e2_logical() { ret void }
...
---
name:            legal_e2_logical
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r15
    BUNDLE 0, 0, implicit-def $r4, implicit-def $r5, implicit-def dead $sfr, implicit $r0, implicit $r1, implicit $r2 {
      $r4 = ADD32 $r0, $r1, implicit-def dead $sfr
      $r5 = LD32 $r2, 0, implicit-def dead $sfr
    }
    RET implicit $r15
...
#--- pad-only-idle.mir
--- |
  define void @pad_only_idle() { ret void }
...
---
name:            pad_only_idle
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r15
    BUNDLE 0, 0 {
      NOP
    }
    RET implicit $r15
...
