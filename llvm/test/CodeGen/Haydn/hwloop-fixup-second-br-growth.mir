# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop -run-pass=haydn-fixup-hwloops \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=CHECK,PRODUCT
# RUN: llc -haydn-enable-hwloop-demote=false -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=haydn-fixup-hwloops -verify-machineinstrs %s -o - | \
# RUN:   FileCheck %s --check-prefixes=CHECK,DEBUGOFF
; Format E96 cutover residual: FileCheck/idle-pad/reloc geometry still open (GE96-01/03).
; XFAIL: *

# Role: MIR — Post-Fixup second-BR growth budget (late-layout-stable-row rule):
# Fixup accepts hardware SET only when residual Off1/Off2 margins cover the
# summed max expansion of still-relaxable short PC-relative branches in the
# SET→BEGIN and SET→END windows. Constant MaxSingleBranchGrowthBytes
# (MaxSingleBranchGrowthParcels × productParcelBytes) lives in
# HaydnHWLoopContracts.h. Second BranchRelaxation must not invalidate a
# Fixup acceptance.
#
# SetupIssueDistance=3 / InterveningCycles=2. Body parcels >= 3.
#
# growth_budget_demote:
#   Following = InterveningCycles (2) after SET → StartOff hard floor OK.
#   Three short unconditional B (simm12) in spacer MBBs before Header:
#   current sizes still fit uimm6, but still-relaxable growth budget is
#   3 × MaxSingleBranchGrowthBytes > BeginMargin → demote-first.
#
# keep_with_one_short_b:
#   Same setup + one short B. Growth ≤ BeginMargin and Off1 holds →
#   hardware SET retained (budget is not always-demote).
#
# keep_with_calls:
#   Same setup gap + three mid-block JAL_W (isCall, long-reach; not still-
#   relaxable short BR subjects). Off1 still holds and growth budget is zero
#   → SET retained (no false demote on non-relaxable control).

--- |
  define dso_local void @growth_budget_demote(ptr nocapture writeonly %out) {
  entry:
    br label %s0
  s0:
    br label %s1
  s1:
    br label %s2
  s2:
    br label %body
  body:
    store i32 0, ptr %out, align 4
    br label %exit
  exit:
    ret void
  }

  define dso_local void @keep_with_one_short_b(ptr nocapture writeonly %out) {
  entry:
    br label %s0
  s0:
    br label %body
  body:
    store i32 0, ptr %out, align 4
    br label %exit
  exit:
    ret void
  }

  define dso_local void @keep_with_calls(ptr nocapture writeonly %out) {
  entry:
    br label %s0
  s0:
    br label %s1
  s1:
    br label %s2
  s2:
    br label %body
  body:
    store i32 0, ptr %out, align 4
    br label %exit
  exit:
    ret void
  }

