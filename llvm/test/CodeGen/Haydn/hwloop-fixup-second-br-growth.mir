# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop -run-pass=haydn-fixup-hwloops \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=CHECK,PRODUCT
# RUN: llc -haydn-enable-hwloop-demote=false -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=haydn-fixup-hwloops -verify-machineinstrs %s -o - | \
# RUN:   FileCheck %s --check-prefixes=CHECK,DEBUGOFF

# Role: MIR — Post-Fixup second-BR growth budget (late-layout-stable-row rule):
# Fixup accepts hardware SET only when residual Off1/Off2 margins cover the
# summed max expansion of still-relaxable short PC-relative branches in the
# SET→BEGIN and SET→END windows. Constant MaxSingleBranchGrowthBytes
# (MaxSingleBranchGrowthParcels × productParcelBytes) lives in
# HaydnHWLoopContracts.h. Second BranchRelaxation must not invalidate a
# Fixup acceptance.
#
# SetupIssueDistance=3 / InterveningCycles=2. Body parcels >= 3.
# Format E productParcelBytes=12 ⇒ MaxSingleBranchGrowthBytes=48.
#
# growth_budget_demote:
#   Following floor OK (InterveningCycles after SET). Extra pad NOPs raise
#   StartOff so hard Off1 still holds, but 3 × MaxSingleBranchGrowthBytes
#   exceeds residual BeginMargin → demote-first.
#
# keep_with_one_short_b:
#   Same setup + one short B. Growth ≤ BeginMargin and Off1 holds →
#   hardware SET retained (budget is not always-demote).
#
# keep_with_calls:
#   Same setup gap + three mid-block JAL_W (isCall, long-reach; not still-
#   relaxable short BR subjects). Off1 still holds and growth budget is zero
#   → SET retained (no false demote on non-relaxable control).
#
# keep_soft_exit_after_ple:
#   Role-A latch keeps PseudoLoopEnd + soft-exit B after END. Post-PLE B is
#   past HWLR_END and must not charge EndGrowth (no false demote).

--- |
  define dso_local void @growth_budget_demote(ptr nocapture writeonly %out) {
  entry:
    br label %s0
  s0:
    br label %s1
  s1:
    br label %s2
  s2:
    br label %body
  body:
    store i32 0, ptr %out, align 4
    br label %exit
  exit:
    ret void
  }

  define dso_local void @keep_with_one_short_b(ptr nocapture writeonly %out) {
  entry:
    br label %s0
  s0:
    br label %body
  body:
    store i32 0, ptr %out, align 4
    br label %exit
  exit:
    ret void
  }

  define dso_local void @keep_with_calls(ptr nocapture writeonly %out) {
  entry:
    br label %s0
  s0:
    br label %s1
  s1:
    br label %s2
  s2:
    br label %body
  body:
    store i32 0, ptr %out, align 4
    br label %exit
  exit:
    ret void
  }

  define dso_local void @keep_soft_exit_after_ple(ptr nocapture writeonly %out) {
  entry:
    br label %body
  body:
    store i32 0, ptr %out, align 4
    br label %exit
  exit:
    ret void
  }

...
---
name:            growth_budget_demote
tracksRegLiveness: true
noVRegs:         true
body:             |
  ; PRODUCT-LABEL: name: growth_budget_demote
  ; PRODUCT-NOT: SET_HWLOOP_W
  ; PRODUCT: ADDI32_W
  ; PRODUCT: SUBI32
  ; PRODUCT: BNEZ_W
  ; PRODUCT: RET
  ;
  ; DEBUGOFF-LABEL: name: growth_budget_demote
  ; DEBUGOFF-NOT: SET_HWLOOP_W
  ; DEBUGOFF-NOT: SUBI32
  ; DEBUGOFF-NOT: BNEZ_W
  ; DEBUGOFF: RET
  bb.0.entry:
    liveins: $r1, $r0, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0
    ; Imm trip; header==latch is %bb.4. Two following NOPs =
    ; InterveningCycles, plus pad so StartOff leaves BeginMargin < 3×48.
    SET_HWLOOP_W 0, %bb.4, %bb.4, 8, implicit-def dead $sfr
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP

  ; Three still-relaxable short B in SET→BEGIN. Current bytes fit uimm6;
  ; max second-BR growth exceeds Off1 margin → demote.
  bb.1.s0:
    liveins: $r1, $r0, $r15
    successors: %bb.2
    B %bb.2

  bb.2.s1:
    liveins: $r1, $r0, $r15
    successors: %bb.3
    B %bb.3

  bb.3.s2:
    liveins: $r1, $r0, $r15
    successors: %bb.4
    B %bb.4

  bb.4.body:
    liveins: $r1, $r0
    successors: %bb.5
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.5.exit:
    liveins: $r15
    RET implicit killed $r15


...
