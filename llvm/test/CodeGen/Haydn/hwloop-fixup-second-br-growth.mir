---
name:            keep_with_calls
tracksRegLiveness: true
noVRegs:         true
body:             |
  ; CHECK-LABEL: name: keep_with_calls
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r1, $r0, $r15
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r0 = frame-setup XOR32 $r0, $r0
  ; CHECK-NEXT:   SET_HWLOOP_W 0, %bb.4, %bb.4, 8
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.s0:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $r1, $r0, $r15
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r15 = JAL_W %bb.5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.s1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $r1, $r0, $r15
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r15 = JAL_W %bb.5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3.s2:
  ; CHECK-NEXT:   successors: %bb.4(0x80000000)
  ; CHECK-NEXT:   liveins: $r1, $r0, $r15
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r15 = JAL_W %bb.5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4.body:
  ; CHECK-NEXT:   successors: %bb.5(0x80000000)
  ; CHECK-NEXT:   liveins: $r1, $r0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   ST32 $r0, $r1, 0
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5.exit:
  ; CHECK-NEXT:   liveins: $r15
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   RET implicit killed $r15
  bb.0.entry:
    liveins: $r1, $r0, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0
    SET_HWLOOP 0, %bb.4, %bb.4, 8
    NOP
    NOP

  ; Mid-block long-reach calls (isCall, not short simm12 BR). Fallthrough
  ; layout — zero still-relaxable growth budget. Off1 holds → keep SET.
  bb.1.s0:
    liveins: $r1, $r0, $r15
    successors: %bb.2
    $r15 = JAL_W %bb.5

  bb.2.s1:
    liveins: $r1, $r0, $r15
    successors: %bb.3
    $r15 = JAL_W %bb.5

  bb.3.s2:
    liveins: $r1, $r0, $r15
    successors: %bb.4
    $r15 = JAL_W %bb.5

  bb.4.body:
    liveins: $r1, $r0
    successors: %bb.5
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.5.exit:
    liveins: $r15
    RET implicit killed $r15

