; CHECK-NEXT:    { nop; slli32 r2, r2, 3 }
; CHECK-NEXT:    { nop; add32 r1, r1, r2 }
; CHECK-NEXT:    { ld32 r1, r1, 0; addi32 r2, r1, 4 }
; CHECK-NEXT:    { nop; nop }
