  @g_h = internal unnamed_addr constant [8 x i32] [i32 126946093, i32 198250683, i32 270712879, i32 378431320, i32 27135404, i32 198383655, i32 415947698, i32 298601465], align 4
  @g_y = internal unnamed_addr global [160 x i32] zeroinitializer, align 4
  @g_golden = internal unnamed_addr constant [160 x i32] [i32 523438, i32 21104896, i32 40747422, i32 70641252, i32 117220279, i32 113272509, i32 163996360, i32 238296885, i32 269743866, i32 239255174, i32 324981195, i32 303705405, i32 251724408, i32 279025599, i32 255898491, i32 176837023, i32 157794834, i32 174775249, i32 160297897, i32 133726532, i32 165339714, i32 167342177, i32 196770218, i32 242168061, i32 287425603, i32 248906713, i32 199665180, i32 279884761, i32 325171836, i32 239667255, i32 259830780, i32 327520163, i32 363098320, i32 325204660, i32 329997293, i32 362508745, i32 349957865, i32 272467057, i32 307490119, i32 288990595, i32 188209464, i32 200770381, i32 220821426, i32 225838764, i32 212026061, i32 177149763, i32 224048803, i32 299025505, i32 198450594, i32 176343861, i32 159132721, i32 197185324, i32 167591401, i32 178759373, i32 138604406, i32 182436224, i32 155463645, i32 206626112, i32 273381014, i32 254143488, i32 203692818, i32 198339221, i32 299274860, i32 340871310, i32 226704166, i32 192445574, i32 302588260, i32 364021802, i32 309688256, i32 242246244, i32 262113129, i32 307838801, i32 307465914, i32 312934218, i32 252530796, i32 223719092, i32 253211172, i32 273790538, i32 245677500, i32 270283321, i32 263339566, i32 229911744, i32 209008812, i32 306370180, i32 310384253, i32 331040492, i32 276610282, i32 226376285, i32 251645923, i32 281700996, i32 236960163, i32 245931453, i32 226722794, i32 192748181, i32 228800950, i32 262502852, i32 197559371, i32 187801693, i32 230051670, i32 184017977, i32 89163444, i32 149049879, i32 192069072, i32 193651083, i32 204890523, i32 210660065, i32 244469187, i32 282079588, i32 315792738, i32 273981453, i32 308577552, i32 358631677, i32 296626432, i32 243993327, i32 283802152, i32 320285551, i32 261319227, i32 275621448, i32 214510843, i32 151828160, i32 222554164, i32 254985778, i32 153649505, i32 170746437, i32 175844379, i32 170362742, i32 193551633, i32 235371218, i32 286164118, i32 276201761,