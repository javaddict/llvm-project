  @.str = private unnamed_addr constant [30 x i8] c"REF   32x32 N=160 M=8 bad=%d\0A\00", align 1
  @.str.1 = private unnamed_addr constant [30 x i8] c"INTR  32x32 N=160 M=8 bad=%d\0A\00", align 1
  
