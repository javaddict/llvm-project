# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop -O2 \
# RUN:   -run-pass=haydn-finalize-mi-bundles,haydn-longbranch-normalize -verify-machineinstrs \
# RUN:   %s -o /dev/null 2> %t.err; echo "verify-done" >> %t.err; cat %t.err \
# RUN:   | FileCheck %s
#
# REGRESSION TEST (reworked 2026-08-22, topics/hwloop PM2 realignment):
# FixupHwLoops must never hoist user code above the SET_HWLOOP count unit.
#
# ORIGINAL BUG (bkfir32x32 ILSS gate, hwloops=1, seeds 1/4/9/10 at M=8):
# tryShortenStartOffset lifted the "SLLI64 $d9,$d11,32" shift-idiom bundle
# above the SET_HWLOOP count unit. That bundle READS $d11 (and $d9), whose
# producers (SEXT32T64 coissued inside the SET cycle below) stay behind
# the splice point => use-before-def. MachineVerifier:
#   *** Bad machine code: Using an undefined physical register ***
#   - instruction: BUNDLE ... implicit killed $d11
#   - instruction: $d11 = SLLI64_E3_E1_ALU1_RI6 killed $d11, 32
# At runtime the stale $d11 fed the MIN64 saturation clamp (INT_MAX read
# as garbage/0) => every bkfir output clamped to 0 (bad=160/N). The interim
# fix (585529f3d790, InterveningDefs/UseBelowHead candidate refusal) was
# shipped first; the peer-verified realignment then DELETED the lift
# mechanism outright (no peer reorders user code for hwloop timing — AIE
# pads via NoOps, AIEMachineScheduler.cpp:843-859 / elongation
# AIEMachineAlignment.cpp:62-101, and never reorders).
#
# Test design: whole-module post-RA MIR of the failing gate main, kept as
# the load-bearing pin across both mechanisms. The same MIR now takes the
# NOP/demote outcome: the slli64 pair STAYS below the SET (no lift exists
# to move it); bodies that would previously have been lifted to satisfy
# Off1 are NOP-padded or demoted instead. The invariant under test is
# unchanged and mechanism-independent: the run is clean under
# -verify-machineinstrs — no "Bad machine code" banner, no undefined
# physical register. If any future fixup rescue reintroduces reordering,
# the verifier aborts exactly as it did pre-fix.
#
# Owner: HaydnFixupHwLoops.cpp fixupOne recoverability ladder
# (peer-aligned NOP-pad → demote; lift deleted per topics/hwloop PM2).

# CHECK: verify-done
# CHECK-NOT: Bad machine code

--- |
  ; ModuleID = 'gmain.ll'
  source_filename = "gmain.c"
  target datalayout = "e-m:e-p:32:32-i64:32-f64:32-v64:32-v128:64-a:0:32-n32-S64"
  target triple = "haydn-unknown-unknown-elf"
  
  @g_x = internal unnamed_addr constant [160 x i32] [i32 8854738, i32 343192604, i32 134459932, i32 226762337, i32 317124385, i32 449325336, i32 126205423, i32 526587666, i32 462185239, i32 175489949, i32 366469545, i32 285324938, i32 115932982, i32 56121385, i32 37873612, i32 171197771, i32 69693948, i32 379700030, i32 312935126, i32 203641811, i32 141169131, i32 403138906, i32 499666249, i32 95173284, i32 179395969, i32 527873791, i32 208619939, i32 294230588, i32 250248000, i32 533831851, i32 469787238, i32 381934365, i32 514177446, i32 523444960, i32 83192336, i32 199863749, i32 368381749, i32 87802396, i32 264248099, i32 93358774, i32 317889131, i32 468060897, i32 177510429, i32 10302062, i32 510599626, i32 123933101, i32 446425984, i32 13905263, i32 206083024, i32 25096962, i32 185501642, i32 70405175, i32 434669311, i32 218977118, i32 79087485, i32 328017736, i32 426424789, i32 501079875, i32 5991703, i32 16490272, i32 535532244, i32 431541039, i32 244458266, i32 210132033, i32 360620154, i32 518214564, i32 393870340, i32 262164265, i32 223156553, i32 78396704, i32 484307543, i32 401027162, i32 341597119, i32 310400037, i32 289368209, i32 28049490, i32 226258526, i32 302443825, i32 508078388, i32 180586387, i32 417234852, i32 147219654, i32 489121470, i32 505337499, i32 231958035, i32 231776098, i32 189742001, i32 11257324, i32 355606569, i32 402098567, i32 237251211, i32 268269060, i32 451302504, i32 151623603, i32 859598, i32 188534629, i32 354865486, i32 43402856, i32 158230520, i32 115409549, i32 131337565, i32 414882340, i32 269239179, i32 330303486, i32 310290195, i32 527802217, i32 257250053, i32 159850550, i32 529917170, i32 386198197, i32 336929000, i32 241914807, i32 322844024, i32 63510666, i32 504274866, i32 442626815, i32 5222183, i32 103959910, i32 301902309, i32 9508496, i32 301764733, i32 255112651, i32 243696127, i32 237510376, i32 10469372, i32 365233719, i32 511595138, i32 395326601, i32 271797282, i32 433912620, i32 187674092, i32 34214910