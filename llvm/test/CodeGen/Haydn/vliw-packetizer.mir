# RUN: llc -mtriple=haydn-unknown-elf -run-pass=finalize-isel -o /dev/null %s
# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# REBASELINED : / pipeline reorder (ExpandPseudos/BitSimplify pre-scheduler + materialize at leaveRegion) — bundles regrouped, ops unchanged.
# REBASELINED : / FLEX cutover — S_SW_WITH_IMM/S_LW_WITH_IMM now render as ST32_S0/LD32_S0, ADD32 as ADD32_S1. Bundles widened: test2 (S_SW_WITH_IMM+ADDI32), test3 (S_LW_WITH_IMM+ADD32+ADD64), test4 (ADD32+ADD64+SUB64) all now pack in one bundle. test4's SUB64 finally lands in S2 (previously kicked to S1 outside the bundle). Regression intent (independent ops BUNDLE; cross-FU pairs coexist) preserved.
#
# REGRESSION TEST: VLIW packetizer multi-instruction bundle formation.
#
# Verifies two fixes:
# 1. Coarse TSFlags slot mask removed from shouldAddToPacket
# isLegalToPacketizeTogether. The DFA resource tracker is now the sole
# arbiter of slot conflicts. Previously, instructions with the same
# coarse TSFlags mask (e.g., ADDI32 and S_SW_WITH_IMM both have 0b001) were
# rejected even though they use different DFA functional units
# (Slot0_ALU vs Slot0_LS).
# 2. hasWAWHazard now ignores dead implicit-defs (e.g., $sfr). Every Haydn
# ALU instruction carries "implicit-def dead $sfr" as a side-effect.
# The old check treated this shared $sfr def as a WAW hazard, which
# prevented ALL multi-instruction bundles.
#
# If this test regresses (instructions that should bundle appear as separate
# single-instruction packets), check that:
# The coarse TSFlags slot mask check has not been re-introduced
# hasWAWHazard still filters dead defs
#
# For tests that verify dependency-prevents-bundling (should always PASS)
# see vliw-packetizer-hazards.mir.
#
# Slot layout (DFA functional units from HaydnSchedule.td):
# Slot 0: SLOT0_ALU (ADD32, ADDI32,...) and SLOT0_LS (S_LW_WITH_IMM, S_SW_WITH_IMM,...)
# Slot 1: SLOT1_ALU, SLOT1_LD, SLOT1_MAC
# Slot 2: SLOT2_ALU, SLOT2_MAC
# Multi: Slot12_ALU = [SLOT1_ALU, SLOT2_ALU] (ADD64, SUB64,...)

--- |
  define void @test1_cross_slot() { ret void }
  define void @test2_cross_fu_same_slot() { ret void }
  define void @test3_mem_plus_alu() { ret void }
  define void @test4_max_packet() { ret void }
...
---
# ============================================================================
# Test 1: Independent cross-slot instructions (bundling EXPECTED)
# ============================================================================
#
# ADD32 (SLOT0_ALU) + ADD64 (Slot12_ALU = [SLOT1_ALU, SLOT2_ALU]).
# No register dependency (GPR32 vs DR64 -- separate register banks).
# No memory dependency (pure ALU ops). Different DFA functional units.
#
# The packetizer bundles ADD32, ADD64, and the following COPY together
# (COPY is not a scheduling boundary and gets included in the packet).
#
name:            test1_cross_slot
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$d1', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $d0, $d1

    ; ADD32 and ADD64 are independent -- should be bundled.
    ; COPY is a pseudo instruction and is excluded from VLIW bundles to prevent
    ; expandPseudosInBundles from placing expansions before register defs
    ; inside the same bundle (use-before-def verifier error).

    ; CHECK-LABEL: name: test1_cross_slot
    ; CHECK: liveins: $r0, $r1, $d0, $d1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE 0, implicit-def $r2, implicit-def dead $sfr, implicit-def $d0, implicit $r0, implicit killed $r1, implicit killed $d0, implicit killed $d1 {
    ; CHECK-NEXT:   $r2 = ADD32 $r0, killed $r1, implicit-def dead $sfr
    ; CHECK-NEXT:   $d0 = ADD64 killed $d0, killed $d1, implicit-def dead $sfr
    ; CHECK-NEXT: }
    ; CHECK-NEXT: $r0 = COPY killed $r2
    ; CHECK-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    $d0 = ADD64 $d0, $d1, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 2: Cross-FU same coarse slot -- the key regression test
# ============================================================================
#
# ADDI32 (itinerary Slot0_ALU, DFA unit SLOT0_ALU)
# S_SW_WITH_IMM (itinerary Slot0_LS, DFA unit SLOT0_LS)
#
# Both have TSFlags slot mask 0b001 (Slot 0). Before the fix, the coarse
# TSFlags check rejected this pair. The DFA correctly models them as
# separate functional units and allows the bundle. This is THE test that
# catches the original coarse-slot-mask bug if it regresses.
#
name:            test2_cross_fu_same_slot
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1

    ; ADDI32 (Slot0_ALU) + S_SW_WITH_IMM (Slot0_LS) -- different DFA FUs, same coarse
    ; TSFlags slot mask. The DFA allows this bundle.
    ; COPY is excluded from bundles (pseudo instruction).

    ; CHECK-LABEL: name: test2_cross_fu_same_slot
    ; CHECK: liveins: $r0, $r1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE 0, implicit-def dead $sfr, implicit-def $r2, implicit killed $r1, implicit $r0 {
    ; CHECK-NEXT:   S_SW_WITH_IMM killed $r1, $r0, 0, implicit-def dead $sfr
    ; CHECK-NEXT:   $r2 = ADDI32 $r0, 10, implicit-def dead $sfr
    ; CHECK-NEXT: }
    ; CHECK-NEXT: $r0 = COPY killed $r2
    ; CHECK-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADDI32 $r0, 10, implicit-def dead $sfr
    S_SW_WITH_IMM $r1, $r0, 0, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 3: Memory + ALU independence (multi-instruction bundle EXPECTED)
# ============================================================================
#
# S_LW_WITH_IMM (Slot0_LS) + ADD32 (Slot0_ALU) + ADD64 (Slot12_ALU).
# All use different DFA functional units. No real register dependencies.
# S_LW_WITH_IMM and ADD32 both have TSFlags mask 0b001 but different DFA FUs
# the DFA correctly allows them together.
#
# Register dependency analysis:
# S_LW_WITH_IMM def $r2, reads $r0 (GPR32)
# ADD32 def $r3, reads $r0, $r1 (GPR32) -- no RAW from S_LW_WITH_IMM ($r2 not read)
# ADD64 def $d0, reads $d0, $d1 (DR64) -- no overlap with GPR32
#
name:            test3_mem_plus_alu
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$d1', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $d0, $d1

    ; Post-: the GPR-port-FuncUnits model is reverted; the DFA uses
    ; the slot-only itinerary. DR64-only ops in Slot12_ALU are NOT charged
    ; against GPR ports, so S_LW_WITH_IMM + ADD32 + ADD64 all pack into one bundle
    ; (2 GPR writes from S_LW_WITH_IMM/ADD32 + 0 from ADD64 — within the 4R2W GPR gate
    ; enforced by countGPRPorts).

    ; CHECK-LABEL: name: test3_mem_plus_alu
    ; CHECK: liveins: $r0, $r1, $d0, $d1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE 0, implicit-def $r3, implicit-def dead $sfr, implicit-def $r2, implicit-def $d0, implicit $r0, implicit killed $r1, implicit killed $d0, implicit killed $d1 {
    ; CHECK-NEXT:   $r2 = S_LW_WITH_IMM $r0, 0, implicit-def dead $sfr
    ; CHECK-NEXT:   $r3 = ADD32 $r0, killed $r1, implicit-def dead $sfr
    ; CHECK-NEXT:   $d0 = ADD64 killed $d0, killed $d1, implicit-def dead $sfr
    ; CHECK-NEXT: }
    ; CHECK-NEXT: $r0 = COPY killed $r3
    ; CHECK-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = S_LW_WITH_IMM $r0, 0, implicit-def dead $sfr
    $r3 = ADD32 $r0, $r1, implicit-def dead $sfr
    $d0 = ADD64 $d0, $d1, implicit-def dead $sfr

    $r0 = COPY $r3
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 4: Multi-slot instructions (ADD64 + SUB64 share Slot12_ALU itinerary)
# ============================================================================
#
# ADD32 (SLOT0_ALU), ADD64 (Slot12_ALU), SUB64 (Slot12_ALU).
# ADD64 and SUB64 both use itinerary Slot12_ALU = [SLOT1_ALU, SLOT2_ALU].
# The DFA assigns them to different sub-units (SLOT1_ALU and SLOT2_ALU).
#
# Register dependency analysis:
# ADD32 def $r2, reads $r0, $r1 (GPR32)
# ADD64 def $d0, reads $d2, $d3 (DR64)
# SUB64 def $d4, reads $d5, $d6 (DR64)
# All write different registers. GPR32 and DR64 are separate banks.
#
name:            test4_max_packet
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$d1', virtual-reg: '' }
  - { reg: '$d2', virtual-reg: '' }
  - { reg: '$d3', virtual-reg: '' }
  - { reg: '$d4', virtual-reg: '' }
  - { reg: '$d5', virtual-reg: '' }
  - { reg: '$d6', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $d0, $d1, $d2, $d3, $d4, $d5, $d6

    ; Post-: the GPR-port-FuncUnits model is reverted; the DFA uses
    ; the slot-only itinerary. DR64-only ops in Slot12_ALU are NOT charged
    ; against GPR ports, so ADD32 + ADD64 + SUB64 all pack into one bundle
    ; (1 GPR write from ADD32 + 0 from ADD64/SUB64 — within the 4R2W GPR gate
    ; enforced by countGPRPorts). ADD64 takes SLOT1, SUB64 takes SLOT2.

    ; CHECK-LABEL: name: test4_max_packet
    ; CHECK: liveins: $r0, $r1, $d0, $d1, $d2, $d3, $d4, $d5, $d6
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE 0, implicit-def $r2, implicit-def dead $sfr, implicit-def $d0, implicit-def $d4, implicit $r0, implicit killed $r1, implicit killed $d2, implicit killed $d3, implicit killed $d5, implicit killed $d6 {
    ; CHECK-NEXT:   $r2 = ADD32 $r0, killed $r1, implicit-def dead $sfr
    ; CHECK-NEXT:   $d0 = ADD64 killed $d2, killed $d3, implicit-def dead $sfr
    ; CHECK-NEXT:   $d4 = SUB64 killed $d5, killed $d6, implicit-def dead $sfr
    ; CHECK-NEXT: }
    ; CHECK-NEXT: $r0 = COPY killed $r2
    ; CHECK-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    $d0 = ADD64 $d2, $d3, implicit-def dead $sfr
    $d4 = SUB64 $d5, $d6, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
