# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postmisched -verify-machineinstrs %s -o - | FileCheck %s

# Role: MIR — multi-instruction BUNDLE formation for independent cross-slot ops.
#
# REGRESSION: independent ops that do not share register hazards must form a
# multi-member BUNDLE under postmisched packing. RAW/WAW negatives live in
# vliw-packetizer-hazards.mir and vliw-packetizer-waw-hazard.mir.
#
# Load-bearing contract: each test function emits a BUNDLE with the expected
# members (cross-slot ALU, LS+ALU, multi-issue). Ordinary ALU/LS descriptors
# do not name SFR; leftover implicit-def $sfr on those MIs is not injected
# here (it is leftover modeling and would trip the one-SFR-writer WAW law).
# Finalize-isel alone with no FileCheck is not coverage — that path never
# exercised packing.
#
# Slot layout (DFA functional units from HaydnSchedule.td):
# Slot 0: SLOT0_ALU (ADD32, ADDI32,...) and SLOT0_LS (LD32, ST32,...)
# Slot 1: SLOT1_ALU, SLOT1_LD, SLOT1_MAC
# Slot 2: SLOT2_ALU, SLOT2_MAC
# Multi: Slot12_ALU = [SLOT1_ALU, SLOT2_ALU] (ADD64, SUB64,...)

--- |
  define void @test1_cross_slot() { ret void }
  define void @test2_cross_fu_same_slot() { ret void }
  define void @test3_mem_plus_alu() { ret void }
  define void @test4_max_packet() { ret void }
...
---
# ============================================================================
# Test 1: Independent cross-slot instructions (bundling EXPECTED)
# ============================================================================
#
# ADD32 (SLOT0_ALU) + ADD64 (Slot12_ALU = [SLOT1_ALU, SLOT2_ALU]).
# No register dependency (GPR32 vs DR64 -- separate register banks).
# No memory dependency (pure ALU ops). Different DFA functional units.
#
# The packetizer bundles ADD32, ADD64, and the following COPY together
# (COPY is not a scheduling boundary and gets included in the packet).
#
name:            test1_cross_slot
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$d1', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $d0, $d1

    ; ADD32 and ADD64 are independent -- should be bundled.
    ; COPY is a pseudo instruction and is excluded from VLIW bundles to prevent
    ; expandPseudosInBundles from placing expansions before register defs
    ; inside the same bundle (use-before-def verifier error).

    ; CHECK-LABEL: name: test1_cross_slot
    ; CHECK: liveins: $r0, $r1, $d0, $d1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE{{.*}} {
    ; CHECK-DAG: $d0 = ADD64{{.*}} killed $d0, killed $d1
    ; CHECK-DAG: $r2 = ADD32{{.*}} $r0, killed $r1
    ; CHECK: }
    ; CHECK-NEXT: $r0 = COPY{{.*}}$r2
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADD32 $r0, $r1
    $d0 = ADD64 $d0, $d1

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 2: Cross-FU same coarse slot -- the key regression test
# ============================================================================
#
# ADDI32 (itinerary Slot0_ALU, DFA unit SLOT0_ALU)
# ST32 (itinerary Slot0_LS, DFA unit SLOT0_LS)
#
# Both have TSFlags slot mask 0b001 (Slot 0). Before the fix, the coarse
# TSFlags check rejected this pair. The DFA correctly models them as
# separate functional units and allows the bundle. This is THE test that
# catches the original coarse-slot-mask bug if it regresses.
#
name:            test2_cross_fu_same_slot
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1

    ; ADDI32 (Slot0_ALU) + ST32 (Slot0_LS) -- different DFA FUs, same coarse
    ; TSFlags slot mask. The DFA allows this bundle.
    ; COPY is excluded from bundles (pseudo instruction).
    ; W3 (store mayLoad=0): leaveRegion emits ADDI32_S1 then ST32_S0; both
    ; still pack (S1 ALU + S0 LS). Order is not the contract — co-issue is.

    ; CHECK-LABEL: name: test2_cross_fu_same_slot
    ; CHECK: liveins: $r0, $r1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE{{.*}} {
    ; CHECK-NEXT: $r2 = ADDI32{{.*}} $r0, 10
    ; CHECK-NEXT: {{ST32|S_SW_WITH_IMM}}{{.*}} killed $r1, $r0, 0
    ; CHECK-NEXT: }
    ; CHECK-NEXT: $r0 = COPY{{.*}}$r2
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADDI32 $r0, 10
    ST32 $r1, $r0, 0

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 3: Memory + ALU independence (multi-instruction bundle EXPECTED)
# ============================================================================
#
# LD32 (Slot0_LS) + ADD32 (Slot0_ALU) + ADD64 (Slot12_ALU).
# All use different DFA functional units. No real register dependencies.
# LD32 and ADD32 both have TSFlags mask 0b001 but different DFA FUs
# the DFA correctly allows them together.
#
# Register dependency analysis:
# LD32 def $r2, reads $r0 (GPR32)
# ADD32 def $r3, reads $r0, $r1 (GPR32) -- no RAW from LD32 ($r2 not read)
# ADD64 def $d0, reads $d0, $d1 (DR64) -- no overlap with GPR32
#
name:            test3_mem_plus_alu
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$d1', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $d0, $d1

    ; Independent LS + ALU32 + ALU64 share one Format E cycle. Member
    ; order is not the contract — the multi-member BUNDLE is.

    ; CHECK-LABEL: name: test3_mem_plus_alu
    ; CHECK: liveins: $r0, $r1, $d0, $d1
    ; CHECK-DAG: $r3 = ADD32{{.*}} $r0, killed $r1
    ; CHECK-DAG: $d0 = ADD64{{.*}} killed $d0, killed $d1
    ; CHECK-DAG: $r2 = {{LD32|S_LW_WITH_IMM}}{{.*}} $r0, 0
    ; CHECK: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = LD32 $r0, 0
    $r3 = ADD32 $r0, $r1
    $d0 = ADD64 $d0, $d1

    $r0 = COPY $r3
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 4: Multi-slot instructions (ADD64 + SUB64 share Slot12_ALU itinerary)
# ============================================================================
#
# ADD32 (SLOT0_ALU), ADD64 (Slot12_ALU), SUB64 (Slot12_ALU).
# ADD64 and SUB64 both use itinerary Slot12_ALU = [SLOT1_ALU, SLOT2_ALU].
# The DFA assigns them to different sub-units (SLOT1_ALU and SLOT2_ALU).
#
# Register dependency analysis:
# ADD32 def $r2, reads $r0, $r1 (GPR32)
# ADD64 def $d0, reads $d2, $d3 (DR64)
# SUB64 def $d4, reads $d5, $d6 (DR64)
# All write different registers. GPR32 and DR64 are separate banks.
#
name:            test4_max_packet
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$d1', virtual-reg: '' }
  - { reg: '$d2', virtual-reg: '' }
  - { reg: '$d3', virtual-reg: '' }
  - { reg: '$d4', virtual-reg: '' }
  - { reg: '$d5', virtual-reg: '' }
  - { reg: '$d6', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $d0, $d1, $d2, $d3, $d4, $d5, $d6

    ; DR64-only Slot12_ALU is not charged against GPR ports, so ADD32 +
    ; ADD64 + SUB64 pack into one bundle (1 GPR write from ADD32). Member
    ; order is not the contract — the three-member BUNDLE is.

    ; CHECK-LABEL: name: test4_max_packet
    ; CHECK: liveins: $r0, $r1, $d0, $d1, $d2, $d3, $d4, $d5, $d6
    ; CHECK-DAG: $d0 = ADD64{{.*}} killed $d2, killed $d3
    ; CHECK-DAG: $d4 = SUB64{{.*}} killed $d5, killed $d6
    ; CHECK-DAG: $r2 = ADD32{{.*}} $r0, killed $r1
    ; CHECK: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADD32 $r0, $r1
    $d0 = ADD64 $d2, $d3
    $d4 = SUB64 $d5, $d6

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
