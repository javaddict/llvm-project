---
# i64 variants: AND with all-ones, OR with zero, ADD with zero
# G_AND x, -1 -> COPY x (i64)
name:            and_all_ones_i64
legalized:       true
body:             |
  bb.0:
    ; CHECK-LABEL: name: and_all_ones_i64
    liveins: $d0
    %0:_(s64) = COPY $d0
    %1:_(s64) = G_CONSTANT i64 -1
    ; CHECK-NOT: G_AND
    ; CHECK: COPY %0
    %2:_(s64) = G_AND %0, %1
    $d0 = COPY %2
...

---
# G_OR x, 0 -> COPY x (i64)
name:            or_zero_i64
legalized:       true
body:             |
  bb.0:
    ; CHECK-LABEL: name: or_zero_i64
    liveins: $d0
    %0:_(s64) = COPY $d0
    %1:_(s64) = G_CONSTANT i64 0
    ; CHECK-NOT: G_OR
    ; CHECK: COPY %0
    %2:_(s64) = G_OR %0, %1
    $d0 = COPY %2
...

---
# G_ADD x, 0 -> COPY x (i64)
name:            add_zero_i64
legalized:       true
body:             |
  bb.0:
    ; CHECK-LABEL: name: add_zero_i64
    liveins: $d0
    %0:_(s64) = COPY $d0
    %1:_(s64) = G_CONSTANT i64 0
    ; CHECK-NOT: G_ADD
    ; CHECK: COPY %0
    %2:_(s64) = G_ADD %0, %1
