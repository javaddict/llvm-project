---
# ASHR by zero: G_ASHR x, 0 -> COPY x
name:            ashr_zero
legalized:       true
body:             |
  bb.0:
    ; CHECK-LABEL: name: ashr_zero
    liveins: $r0
    %0:_(s32) = COPY $r0
    %1:_(s32) = G_CONSTANT i32 0
