name:            add_zero_commuted
legalized:       true
body:             |
  bb.0:
    ; CHECK-LABEL: name: add_zero_commuted
    liveins: $r0
    %0:_(s32) = COPY $r0
    %1:_(s32) = G_CONSTANT i32 0
    ; CHECK-NOT: G_ADD
    ; CHECK: COPY %0
    %2:_(s32) = G_ADD %1, %0
