# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-postlegalizer-combiner -global-isel-abort=1 %s -o - | FileCheck %s
#
# Tests for identity fold combiner rules in HaydnPostLegalizerCombiner.
#
# Combiner rules tested:
# and_all_ones: G_AND x, -1 -> COPY x (AND with all-ones is identity)
# or_zero: G_OR x, 0 -> COPY x (OR with zero is identity)
# add_zero: G_ADD x, 0 -> COPY x (ADD with zero is identity)
# sub_zero: G_SUB x, 0 -> COPY x (SUB with zero RHS is identity)
# shl_zero: G_SHL x, 0 -> COPY x (shift by zero is identity)
# lshr_zero: G_LSHR x, 0 -> COPY x (logical shift right by zero is identity)
# ashr_zero: G_ASHR x, 0 -> COPY x (arithmetic shift right by zero is identity)
# mul_zero: G_MUL x, 0 -> G_CONSTANT 0 (multiply by zero is always zero)

---
# AND with all-ones: G_AND x, -1 -> COPY x
name:            and_all_ones
legalized:       true
body:             |
  bb.0:
    ; CHECK-LABEL: name: and_all_ones
    liveins: $r0
    %0:_(s32) = COPY $r0
    %1:_(s32) = G_CONSTANT i32 -1
    ; CHECK-NOT: G_AND
    ; CHECK: COPY %0
    %2:_(s32) = G_AND %0, %1
    $r1 = COPY %2
...

---
# AND with all-ones (commuted): G_AND -1, x -> COPY x
name:            and_all_ones_commuted
legalized:       true
body:             |
  bb.0:
    ; CHECK-LABEL: name: and_all_ones_commuted
    liveins: $r0
    %0:_(s32) = COPY $r0
    %1:_(s32) = G_CONSTANT i32 -1
    ; CHECK-NOT: G_AND
    ; CHECK: COPY %0
    %2:_(s32) = G_AND %1, %0
    $r1 = COPY %2
...

---
# OR with zero: G_OR x, 0 -> COPY x
name:            or_zero
legalized:       true
body:             |
  bb.0:
    ; CHECK-LABEL: name: or_zero
    liveins: $r0
    %0:_(s32) = COPY $r0
    %1:_(s32) = G_CONSTANT i32 0
    ; CHECK-NOT: G_OR
    ; CHECK: COPY %0
    %2:_(s32) = G_OR %0, %1
    $r1 = COPY %2
...

---
# OR with zero (commuted): G_OR 0, x -> COPY x
name:            or_zero_commuted
legalized:       true
body:             |
  bb.0:
    ; CHECK-LABEL: name: or_zero_commuted
    liveins: $r0
    %0:_(s32) = COPY $r0
    %1:_(s32) = G_CONSTANT i32 0
    ; CHECK-NOT: G_OR
    ; CHECK: COPY %0
    %2:_(s32) = G_OR %1, %0
    $r1 = COPY %2
...

---
