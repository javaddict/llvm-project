...

---
# SUB with zero: G_SUB x, 0 -> COPY x
name:            sub_zero
legalized:       true
body:             |
  bb.0:
    ; CHECK-LABEL: name: sub_zero
    liveins: $r0
    %0:_(s32) = COPY $r0
    %1:_(s32) = G_CONSTANT i32 0
    ; CHECK-NOT: G_SUB
    ; CHECK: COPY %0
    %2:_(s32) = G_SUB %0, %1
