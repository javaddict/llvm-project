name:            mul_zero_commuted
legalized:       true
body:             |
  bb.0:
    ; CHECK-LABEL: name: mul_zero_commuted
    liveins: $r0
    %0:_(s32) = COPY $r0
    %1:_(s32) = G_CONSTANT i32 0
    ; CHECK-NOT: G_MUL
    %2:_(s32) = G_MUL %1, %0
    $r1 = COPY %2
