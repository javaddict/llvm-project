...

---
# Negative test: AND with non-all-ones should NOT be eliminated.
name:            and_non_ones
legalized:       true
body:             |
  bb.0:
    ; CHECK-LABEL: name: and_non_ones
    liveins: $r0
    %0:_(s32) = COPY $r0
    %1:_(s32) = G_CONSTANT i32 -2
    ; CHECK: G_AND
    %2:_(s32) = G_AND %0, %1
    $r1 = COPY %2
...

---
# Negative test: OR with non-zero should NOT be eliminated.
name:            or_nonzero
legalized:       true
body:             |
  bb.0:
    ; CHECK-LABEL: name: or_nonzero
    liveins: $r0
    %0:_(s32) = COPY $r0
    %1:_(s32) = G_CONSTANT i32 42
    ; CHECK: G_OR
    %2:_(s32) = G_OR %0, %1
    $r1 = COPY %2
...

---
# Negative test: SUB x, non-zero should NOT be eliminated as identity.
# TD sub_to_add rewrites G_SUB x, C -> G_ADD x, -C; still not a COPY of x.
name:            sub_nonzero
legalized:       true
body:             |
  bb.0:
    ; CHECK-LABEL: name: sub_nonzero
    liveins: $r0
    %0:_(s32) = COPY $r0
    %1:_(s32) = G_CONSTANT i32 1
    ; CHECK-NOT: $r1 = COPY %0
    ; CHECK: G_ADD
    %2:_(s32) = G_SUB %0, %1
    $r1 = COPY %2
...

---
# Negative test: SHL by non-zero should NOT be eliminated.
name:            shl_nonzero
legalized:       true
body:             |
  bb.0:
    ; CHECK-LABEL: name: shl_nonzero
    liveins: $r0
    %0:_(s32) = COPY $r0
    %1:_(s32) = G_CONSTANT i32 1
    ; CHECK: G_SHL
    %2:_(s32) = G_SHL %0, %1
    $r1 = COPY %2
...

---
# Negative test: MUL by non-zero/non-special constant should NOT be eliminated.
# Use constant 11 which is not 0, -1, pow2, pow2+1, or pow2-1.
name:            mul_nonzero
legalized:       true
body:             |
  bb.0:
    ; CHECK-LABEL: name: mul_nonzero
    liveins: $r0
    %0:_(s32) = COPY $r0
    %1:_(s32) = G_CONSTANT i32 11
    ; CHECK: G_MUL
    %2:_(s32) = G_MUL %0, %1
    $r1 = COPY %2
...
