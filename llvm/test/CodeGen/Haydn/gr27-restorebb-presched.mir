  bb.2.exit:
    liveins: $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8, $r9, $r10, $r11, $r12, $r15
    RET implicit $r15

...

# CHECK: name: all_gpr_live_far_b
# CHECK: bb.0.entry
# The trampoline is created and the long-form parcels are the bare real
# LUI/ADDI32_W/JALR_W triple (S1 commits them next in the product
# pipeline; this probe stops before Finalize so no BUNDLE roots appear).
# CHECK: LUI %bb.2
# CHECK-NEXT: ADDI32_W {{.*}}, %bb.2
# CHECK-NEXT: JALR_W
# CHECK-NOT: B %bb.2
