# RUN: llc -mtriple=haydn-unknown-elf -run-pass=machine-cp -mcp-use-is-copy-instr \
# RUN:     -verify-machineinstrs -o - %s | FileCheck %s

# Role: MIR — durable soft-zero R0: silicon does not hardwire R0=0.
# Generic MCP(UseCopyInstr) must NEVER delete COPY / MOVE32 / OR32 bank-copies
# *into* R0 (reserved). HaydnCopyElim is deleted; do not treat R0 as a
# hardwired sink. Overlapping identity COPY r0,r0 is also kept (MCP skips
# reserved and overlapping src/dst copies).

--- |
  define void @soft_zero_copy_r0() nounwind { ret void }
  define void @soft_zero_move32_r0() nounwind { ret void }
  define void @soft_zero_or32_r0() nounwind { ret void }
  define void @soft_zero_identity_r0() nounwind { ret void }
...
---
# CHECK-LABEL: name: soft_zero_copy_r0
name:            soft_zero_copy_r0
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        false
body:             |
  bb.0:
    liveins: $r1, $r2, $r15

    ; Locally "dead" (R0 redefined before use) — must KEEP (reserved dest).
    ; CHECK: $r0 = COPY $r1
    ; CHECK: $r0 = ADDI32 $r2, 0
    $r0 = COPY $r1
    $r0 = ADDI32 $r2, 0, implicit-def dead $sfr
    RET implicit $r15
...
---
# CHECK-LABEL: name: soft_zero_move32_r0
name:            soft_zero_move32_r0
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        false
body:             |
  bb.0:
    liveins: $r1, $r2, $r15

    ; MOVE32 into R0 is a copy via isCopyInstrImpl — keep (reserved dest).
    ; CHECK: $r0 = MOVE32 $r1
    ; CHECK: $r0 = ADDI32 $r2, 0
    $r0 = MOVE32 $r1
    $r0 = ADDI32 $r2, 0, implicit-def dead $sfr
    RET implicit $r15
...
---
# CHECK-LABEL: name: soft_zero_or32_r0
name:            soft_zero_or32_r0
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        false
body:             |
  bb.0:
    liveins: $r1, $r2, $r15

    ; OR32 bank-copy into R0 — keep (reserved dest).
    ; CHECK: $r0 = OR32 $r1, $r1
    ; CHECK: $r0 = ADDI32 $r2, 0
    $r0 = OR32 $r1, $r1, implicit-def dead $sfr
    $r0 = ADDI32 $r2, 0, implicit-def dead $sfr
    RET implicit $r15
...
---
# CHECK-LABEL: name: soft_zero_identity_r0
name:            soft_zero_identity_r0
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        false
body:             |
  bb.0:
    liveins: $r0, $r1, $r15

    ; MCP keeps overlapping/reserved identity COPY; HaydnCopyElim used to drop it.
    ; CHECK: $r0 = COPY $r0
    ; CHECK: $r1 = ADDI32 $r1, 1
    $r0 = COPY $r0
    $r1 = ADDI32 $r1, 1, implicit-def dead $sfr
    RET implicit $r15
