# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-copy-elim \
# RUN:     -verify-machineinstrs -o - %s | FileCheck %s
#
# W0.3 / durable rule 31 — soft-zero R0:
# Silicon does not hardwire R0=0. HaydnCopyElim must NEVER delete non-identity
# COPY / MOVE32 / OR32 bank-copies *into* R0 as "dead", even when a later def
# of R0 makes local deadness analysis true.
#
# Also: true identity forms (src == dst) remain removable.

--- |
  define void @soft_zero_copy_r0() nounwind { ret void }
  define void @soft_zero_move32_r0() nounwind { ret void }
  define void @soft_zero_or32_r0() nounwind { ret void }
  define void @soft_zero_identity_r0() nounwind { ret void }
...
---
# CHECK-LABEL: name: soft_zero_copy_r0
name:            soft_zero_copy_r0
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        false
body:             |
  bb.0:
    liveins: $r1, $r2, $r15

    ; Locally "dead" (R0 redefined before use) — must KEEP.
    ; CHECK: $r0 = COPY $r1
    ; CHECK: $r0 = ADDI32 $r2, 0
    $r0 = COPY $r1
    $r0 = ADDI32 $r2, 0, implicit-def dead $sfr
    RET implicit $r15
...
---
# CHECK-LABEL: name: soft_zero_move32_r0
name:            soft_zero_move32_r0
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        false
body:             |
  bb.0:
    liveins: $r1, $r2, $r15

    ; MOVE32 into R0 is also a soft-zero write — keep even if dead.
    ; CHECK: $r0 = MOVE32 $r1, $r1
    ; CHECK: $r0 = ADDI32 $r2, 0
    $r0 = MOVE32 $r1, $r1
    $r0 = ADDI32 $r2, 0, implicit-def dead $sfr
    RET implicit $r15
...
---
# CHECK-LABEL: name: soft_zero_or32_r0
name:            soft_zero_or32_r0
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        false
body:             |
  bb.0:
    liveins: $r1, $r2, $r15

    ; OR32 bank-copy into R0 — never eliminate as dead.
    ; CHECK: $r0 = OR32 $r1, $r1
    ; CHECK: $r0 = ADDI32 $r2, 0
    $r0 = OR32 $r1, $r1, implicit-def dead $sfr
    $r0 = ADDI32 $r2, 0, implicit-def dead $sfr
    RET implicit $r15
...
---
# CHECK-LABEL: name: soft_zero_identity_r0
name:            soft_zero_identity_r0
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        false
body:             |
  bb.0:
    liveins: $r0, $r1, $r15

    ; Identity COPY r0,r0 is a pure no-op and may still be removed.
    ; CHECK-NOT: $r0 = COPY $r0
    ; CHECK: $r1 = ADDI32 $r1, 1
    $r0 = COPY $r0
    $r1 = ADDI32 $r1, 1, implicit-def dead $sfr
    RET implicit $r15
