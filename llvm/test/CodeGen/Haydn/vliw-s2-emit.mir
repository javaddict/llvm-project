# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postmisched -verify-machineinstrs %s -o - | FileCheck %s
#
# REGRESSION TEST: Slot 2 opcode emit coverage — Wave 3 encoding migration.
#
# Background : The opcode-budget table in
# ~/haydn-plans/encoding-migration-execution.md section 1.3 lists s2 ALU64 and
# s2 MAC as "0 instructions mapped". This is misleading: the
# getEncOpcodeMap(opcode) switch returns ONE (FU, Opcode) pair per opcode, and
# because Slot 1 and Slot 2 share the same FU datapath types (FU_ALU64 and
# FU_MAC), the emitter's findCompatibleRow matches children by FU type, not
# by slot index. The s1 ALU64/MAC entries therefore already serve s2 placement.
#
# This test guards against a future regression where someone "fixes" the s2
# column by either:
# (a) Adding duplicate case labels (compile error, caught immediately), OR
# (b) Restructuring getEncOpcodeMap to be slot-parametric AND forgetting to
# populate s2 — which would silently break Wave 3 s2 emission.
#
# Test design: Build 3-instruction packets that REQUIRE one instruction to land
# in Slot 2. If s2 emit coverage regresses, the packetizer would either:
# Refuse to bundle (single-instruction packets), OR
# Pick a wrong row (FAIL via verifier).
# The CHECK lines verify a single BUNDLE 0, containing all 3 ops.
#
# Slot architecture (per CLAUDE.md):
# Slot 0: ALU32 + LS (mutually exclusive)
# Slot 1: ALU64 + LD + MAC
# Slot 2: ALU64 + MAC (shares set with Slot 1)
# DFA functional units: SLOT0_ALU, SLOT0_LS, SLOT1_ALU, SLOT1_LD, SLOT1_MAC
# SLOT2_ALU, SLOT2_MAC (M0Rows in HaydnDClassInfo.h).
#
# Instruction reference (lib/Target/Haydn/HaydnInstrInfo.td):
# ADD32 (GPR32 ALU, 3-op: rd, rs1, rs2) — Slot012_ALU
# ADD64 (DR64 ALU, 3-op: rd, rs1, rs2) — Slot12_ALU
# SUB64 (DR64 ALU, 3-op: rd, rs1, rs2) — Slot12_ALU
# X2MUL32 (DR64 SIMD mul, 3-op: rd, rs1, rs2) — Slot1_ALU (DB slot-1-only,)
# X4MUL16 (DR64 SIMD mul, 3-op: rd, rs1, rs2) — Slot1_ALU (DB slot-1-only,)
# F2MULAA32R_HHLL (DR64 dual-product MAC, 3-op: rd, rs1, rs2) — Slot12_ALU
# (DB slots {1,2}: slot-{1+2} MAC family — CAN dual-issue S1+S2)

--- |
  define void @test1_alu32_alu64_s2_alu64() { ret void }
  define void @test2_alu32_alu64_s2_mac() { ret void }
  define void @test3_dual_mac_s1_s2() { ret void }
...
---
# ============================================================================
# Test 1: ALU32 (S0) + ALU64 (S1) + ALU64 (S2)
# ============================================================================
#
# Forces two ALU64 ops into the SAME bundle. The DFA must assign one to SLOT1
# and the other to SLOT2. If s2 ALU64 emit is broken, the second ALU64 would
# be split into a separate packet.
#
# Port math:
# ADD32 r2,r0,r1 -> 2 GPR R, 1 GPR W
# ADD64 d0,d2,d3 -> 0 GPR R, 0 GPR W (DR64 ports)
# SUB64 d4,d5,d6 -> 0 GPR R, 0 GPR W
# Total: 2 GPR reads, 1 GPR write — within 4R2W.
#
name:            test1_alu32_alu64_s2_alu64
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$d2', virtual-reg: '' }
  - { reg: '$d3', virtual-reg: '' }
  - { reg: '$d4', virtual-reg: '' }
  - { reg: '$d5', virtual-reg: '' }
  - { reg: '$d6', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $d0, $d2, $d3, $d4, $d5, $d6

    ; Post-: the GPR-port-FuncUnits model is reverted; the DFA uses
    ; the slot-only itinerary. DR64-only ops in Slot12_ALU are NOT charged
    ; against GPR ports, so ADD32 + ADD64 + SUB64 all pack into one bundle
    ; (1 GPR write from ADD32 — within the 4R2W GPR gate enforced by
    ; countGPRPorts). ADD64 takes SLOT1, SUB64 takes SLOT2 — this is the case
    ; that exercises the Slot 2 ALU64 emit path.

    ; CHECK-LABEL: name: test1_alu32_alu64_s2_alu64
    ; CHECK: liveins: $r0, $r1, $d0, $d2, $d3, $d4, $d5, $d6
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE 1, implicit-def $r2, implicit-def dead $sfr, implicit-def $d0, implicit-def $d4, implicit $r0, implicit killed $r1, implicit killed $d2, implicit killed $d3, implicit killed $d5, implicit killed $d6 {
    ; CHECK-NEXT:   $r2 = ADD32_P32_ALU0 $r0, killed $r1, implicit-def dead $sfr
    ; CHECK-NEXT:   $d0 = ADD64_P31_ALU1 killed $d2, killed $d3, implicit-def dead $sfr
    ; CHECK-NEXT:   $d4 = SUB64_P30_ALU2 killed $d5, killed $d6, implicit-def dead $sfr
    ; CHECK-NEXT: }
    ; CHECK-NEXT: $r0 = COPY killed $r2
    ; CHECK-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    $d0 = ADD64 $d2, $d3, implicit-def dead $sfr
    $d4 = SUB64 $d5, $d6, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 2: ALU32 (S0) + ALU64 (S1) + MAC (S2)
# ============================================================================
#
# Forces one MAC op into Slot 2 (Row 2: s0=ALU, s1=ALU64, s2=MAC).
# If s2 MAC emit is broken, the MAC op would be split into a separate packet.
#
# F2MULAA32R_HHLL is a DR64 dual-product MAC (DB slots {1,2} — slot-{1+2}
# so it CAN legally land in SLOT2). X2MUL32 was used here previously but the
# DB restricts it to slot {1} only, so it cannot exercise SLOT2 MAC
# placement; F2MULAA32R_HHLL is the DB-correct vehicle (see test3 header for
# the full slot-1-only SIMD-MAC rationale).
# Port math:
# ADD32 r2,r0,r1 -> 2 GPR R, 1 GPR W, 0 DR R/W
# ADD64 d0,d2,d3 -> 2 DR R, 1 DR W
# F2MULAA32R_HHLL d4,d5,d6 -> 2 DR R, 1 DR W
# Total: 4 DR R, 2 DR W (within DR 7R/3W), 2 GPR R, 1 GPR W (within 4R2W).
#
name:            test2_alu32_alu64_s2_mac
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$d2', virtual-reg: '' }
  - { reg: '$d3', virtual-reg: '' }
  - { reg: '$d4', virtual-reg: '' }
  - { reg: '$d5', virtual-reg: '' }
  - { reg: '$d6', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $d0, $d2, $d3, $d4, $d5, $d6

    ; Post-: the GPR-port-FuncUnits model is reverted; the DFA uses
    ; the slot-only itinerary. DR64-only ops in Slot12_ALU/MAC are NOT charged
    ; against GPR ports, so ADD32 + ADD64 + F2MULAA32R_HHLL all pack into one
    ; bundle (1 GPR write from ADD32 — within the 4R2W GPR gate enforced by
    ; countGPRPorts). ADD64 takes SLOT1, F2MULAA32R_HHLL (slot-{1+2}) takes
    ; SLOT2 — this is the case that exercises the Slot 2 MAC emit path.

    ; CHECK-LABEL: name: test2_alu32_alu64_s2_mac
    ; CHECK: liveins: $r0, $r1, $d0, $d2, $d3, $d4, $d5, $d6
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE 1, implicit-def $r2, implicit-def dead $sfr, implicit-def $d0, implicit-def $d4, implicit $r0, implicit killed $r1, implicit killed $d2, implicit killed $d3, implicit killed $d4, implicit killed $d5, implicit killed $d6 {
    ; CHECK-NEXT:   $r2 = ADD32_P32_ALU0 $r0, killed $r1, implicit-def dead $sfr
    ; CHECK-NEXT:   $d0 = ADD64_P31_ALU1 killed $d2, killed $d3, implicit-def dead $sfr
    ; CHECK-NEXT:   $d4 = F2MULAA32R_HHLL_P30_MAC0 killed $d4, killed $d5, killed $d6, implicit-def dead $sfr
    ; CHECK-NEXT: }
    ; CHECK-NEXT: $r0 = COPY killed $r2
    ; CHECK-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    $d0 = ADD64 $d2, $d3, implicit-def dead $sfr
    $d4 = F2MULAA32R_HHLL $d4, $d5, $d6, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 3: Dual MAC in S1 + S2
# ============================================================================
#
# Row 6: s0=ALU, s1=MAC, s2=MAC. Two independent MAC ops can dual-issue.
# Per encoding_manual.md section 6 note ²: "Max 1 RRR-type MAC per bundle.
# Dual RRR = 6R/4W > DR 3W. s2 destructive encoding (18b) prevents RRR in s2
# for Mode 0 — RRR-type only in s1."
#
# WHY F2MULAA32R_HHLL (NOT X2MUL32/X4MUL16): the authoritative instruction DB
# (~/haydn-plans/Database/haydn_instruction_db.json) restricts the single-product
# SIMD-MAC family X2MUL32 / X4MUL16 / X2CMUL32 / X4MULA16 / X4SEL16 /... to
# slot {1} ONLY (15 SIMD-MAC instrs). Two slot-1-only ops CANNOT dual-issue:
# both want SLOT1 → conflict, so one always falls out of the bundle. The fix-td
# wave correctly moved these 15 ops to a new Slot1_ALU itinerary in
# HaydnSchedule.td to match the DB. The original -era test body used
# X2MUL32+X4MUL16 to exercise "dual MAC S1+S2", but that pairing was ALWAYS
# impossible per the DB — the old test only passed because both ops were
# (incorrectly) modelled as Slot12_ALU, over-promising slot 2.
#
# To preserve the test's valuable intent (verify two MACs pack S1+S2 in one
# bundle alongside a slot-0 ALU32), this body now uses two F2MULAA32R_HHLL
# ops from the dual-product accumulator MAC family, which the DB marks
# slots {1, 2} — genuinely slot-{1+2}, so one lands in SLOT1 and the other
# in SLOT2.
#
# DB quote (haydn_instruction_db.json, key 'instructions' -> F2MULAA32R_HHLL):
# "syntax": "F2MULAA32R_HHLL rtd, rsd1, rsd2"
# "type": "RR"
# "slots": {"1": {"unit":"MAC",...}, "2": {"unit":"MAC",...}}
# (Contrast X2MUL32: "slots": {"1": {...}} — slot-1-only.)
#
# F2MULAA32R_HHLL is a 3-op DR64 instruction (rd, rs1, rs2) — same MIR shape
# as X2MUL32 — defined in HaydnInstrInfoAuto.td via FmtALU64, which sets
# Itinerary = Slot12_ALU (HaydnInstrFormats.td:328), consistent with the DB.
#
# ADD32 + F2MULAA32R_HHLL + F2MULAA32R_HHLL:
# ADD32 r2,r0,r1 -> 2 GPR R, 1 GPR W, 0 DR R/W
# F2MULAA32R_HHLL d0,d2,d3 -> 2 DR R, 1 DR W
# F2MULAA32R_HHLL d4,d5,d6 -> 2 DR R, 1 DR W
# GPR: 2R, 1W. DR: 4R, 2W. Both within port budgets.
#
name:            test3_dual_mac_s1_s2
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$d2', virtual-reg: '' }
  - { reg: '$d3', virtual-reg: '' }
  - { reg: '$d4', virtual-reg: '' }
  - { reg: '$d5', virtual-reg: '' }
  - { reg: '$d6', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $d0, $d2, $d3, $d4, $d5, $d6

    ; Post-: the GPR-port-FuncUnits model is reverted; the DFA uses
    ; the slot-only itinerary. DR64-only MAC ops in Slot12_ALU/MAC are NOT
    ; charged against GPR ports, so ADD32 + F2MULAA32R_HHLL + F2MULAA32R_HHLL
    ; all pack into one bundle (1 GPR write from ADD32 — within the 4R2W GPR
    ; gate enforced by countGPRPorts). The two slot-{1+2} MAC ops take SLOT1
    ; and SLOT2 — this is the case that exercises dual MAC S1+S2 emit.
    ; (X2MUL32/X4MUL16 are slot-1-only per DB and CANNOT dual-issue — see the
    ; header comment; F2MULAA32R_HHLL is the DB-correct dual-MAC vehicle.)

    ; CHECK-LABEL: name: test3_dual_mac_s1_s2
    ; CHECK: liveins: $r0, $r1, $d0, $d2, $d3, $d4, $d5, $d6
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE 1, implicit-def $d0, implicit-def dead $sfr, implicit-def $r2, implicit-def $d4, implicit killed $d0, implicit killed $d2, implicit killed $d3, implicit $r0, implicit killed $r1, implicit killed $d4, implicit killed $d5, implicit killed $d6 {
    ; CHECK-NEXT:   $d0 = F2MULAA32R_HHLL_P32_MAC1 killed $d0, killed $d2, killed $d3, implicit-def dead $sfr
    ; CHECK-NEXT:   $r2 = ADD32_P31_ALU0 $r0, killed $r1, implicit-def dead $sfr
    ; CHECK-NEXT:   $d4 = F2MULAA32R_HHLL_P30_MAC0 killed $d4, killed $d5, killed $d6, implicit-def dead $sfr
    ; CHECK-NEXT: }
    ; CHECK-NEXT: $r0 = COPY killed $r2
    ; CHECK-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    $d0 = F2MULAA32R_HHLL $d0, $d2, $d3, implicit-def dead $sfr
    $d4 = F2MULAA32R_HHLL $d4, $d5, $d6, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
