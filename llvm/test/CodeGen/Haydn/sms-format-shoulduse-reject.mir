# RUN: llc -mtriple=haydn-unknown-elf -mattr=-hwloop -global-isel-abort=1 \
# RUN:   -O2 -stop-after=pipeliner -haydn-sms-max-stagecount=1 \
# RUN:   -debug-only=pipeliner -verify-machineinstrs \
# RUN:   %S/sms-usad-mutual-war-no-prera-freeze.ll -o /dev/null 2>&1 \
# RUN:   | FileCheck %s --check-prefix=STAGE
# RUN: llc -mtriple=haydn-unknown-elf -mattr=-hwloop -run-pass=pipeliner \
# RUN:   -haydn-sms-force-pressure-reject -debug-only=pipeliner \
# RUN:   -verify-machineinstrs %s -o /dev/null 2>&1 \
# RUN:   | FileCheck %s --check-prefix=PRESSURE
# REQUIRES: asserts

# Role: Positive shouldUseSchedule fail-closed pins (plan §5.2 exit /
# spill-pressure rejection + stage-count gate). Product defaults stay ON:
#   -haydn-sms-max-stagecount=3
#   -haydn-pipeliner-track-regpressure=true
# SMS-HOOK / SMS-RESMII / SMS-HANDOFF already have positive lits; this file
# owns the profitability reject path after a schedule is found (MachinePipeliner
# "Target rejected schedule"), not analyzeLoop fail-closed.
#
# STAGE prefix: matrix_sum IR (same body as sms-f41-containment-product-pin.ll)
# finds organic stages>=2 at -O2. Under -haydn-sms-max-stagecount=1 that
# schedule is a PPS-3 stage reject. The dual-load MAC MIR below is
# format-ResMII-bound (II covers the body, stages=1) so it cannot own this
# pin; PRESSURE still uses it because the force flag is stage-independent.
# PRESSURE prefix: MAC MIR under -haydn-sms-force-pressure-reject (default OFF
# bisect peer of -haydn-sms-hook-force-reject). Product path is canAllocateSMS
# live-in excess; force keeps the pin schedule-shape stable.
#
# Companion accept: sms-format-resmii.mir / sms-format-qor-exit.ll
# Companion HOOK/RESMII reject: sms-format-hook-reject.mir,
#   sms-format-resmii-overestimate-reject.mir
# Never invents durable BUNDLE (HANDOFF metrics-only remains).

# STAGE: Schedule Found? 1 (II={{[1-9][0-9]*}})
# STAGE: SMS-SHOULDUSE: reject stages={{[2-9]|[1-9][0-9]+}} max=1 II={{[1-9][0-9]*}}
# STAGE: PPS-3: reject SMS (stages={{[2-9]|[1-9][0-9]+}} > max=1 II={{[1-9][0-9]*}})
# STAGE: Target rejected schedule
# STAGE-NOT: SMS-HOOK: reject
# STAGE-NOT: SMS-RESMII: reject

# PRESSURE: Schedule Found? 1 (II={{[1-9][0-9]*}})
# PRESSURE: SMS-SHOULDUSE: reject pressure stages={{[1-9][0-9]*}} II={{[1-9][0-9]*}} (forced by -haydn-sms-force-pressure-reject)
# PRESSURE: PPS-3: reject SMS (too much block pressure, stages={{[1-9][0-9]*}} II={{[1-9][0-9]*}})
# PRESSURE: Target rejected schedule
# PRESSURE-NOT: SMS-HOOK: reject
# PRESSURE-NOT: SMS-RESMII: reject

--- |
  define i64 @sms_shoulduse_multistage_mac(ptr nocapture readonly %a,
                                           ptr nocapture readonly %b,
                                           i32 %n) #0 {
  entry:
    br i1 undef, label %loop.preheader, label %exit
  loop.preheader:
    br label %loop
  loop:
    br i1 undef, label %exit, label %loop
  exit:
    ret i64 0
  }
  attributes #0 = { "target-features"="-hwloop" }
...
---
name:            sms_shoulduse_multistage_mac
alignment:       16
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          false
isSSA:           true
noVRegs:         false
registers:
  - { id: 0, class: gpr32 }
  - { id: 1, class: gpr32 }
  - { id: 2, class: gpr32 }
  - { id: 3, class: gpr32 }
  - { id: 5, class: gpr32 }
  - { id: 6, class: gpr32 }
  - { id: 7, class: gpr32 }
  - { id: 8, class: dr64 }
  - { id: 9, class: dr64 }
  - { id: 10, class: dr64 }
  - { id: 13, class: dr64 }
  - { id: 14, class: gpr32 }
  - { id: 15, class: gpr32 }
  - { id: 17, class: gpr32 }
  - { id: 18, class: gpr32 }
  - { id: 20, class: dr64 }
  - { id: 21, class: dr64 }
  - { id: 26, class: gpr32 }
  - { id: 27, class: gpr32 }
  - { id: 28, class: gpr32 }
  - { id: 29, class: gpr32 }
  - { id: 30, class: gpr32 }
  - { id: 31, class: gpr32 }
  - { id: 32, class: gpr32 }
  - { id: 33, class: gpr32 }
  - { id: 34, class: gpr32 }
  - { id: 35, class: gpr32 }
liveins:
  - { reg: '$r1' }
  - { reg: '$r2' }
  - { reg: '$r3' }
frameInfo:
  maxAlignment:    1
machineFunctionInfo: {}
body:             |
  bb.1.entry:
    successors: %bb.2(0x50000000), %bb.4(0x30000000)
    liveins: $r1, $r2, $r3

    %0:gpr32 = COPY $r1
    %1:gpr32 = COPY $r2
    %2:gpr32 = COPY $r3
    %3:gpr32 = LOADI32 0
    %21:dr64 = LOADI64 0
    %34:gpr32 = SLT32 %3, %2
    %35:gpr32 = XORI32 %34, 1
    BNEZ_W %35, %bb.4
    B %bb.2

  bb.2.loop.preheader:
    successors: %bb.3(0x80000000)

    %14:gpr32 = LOADI32 -1

  bb.3.loop:
    successors: %bb.4(0x04000000), %bb.3(0x7c000000)

    %5:gpr32 = PHI %0, %bb.2, %18, %bb.3
    %6:gpr32 = PHI %1, %bb.2, %17, %bb.3
    %7:gpr32 = PHI %2, %bb.2, %15, %bb.3
    %8:dr64 = PHI %13, %bb.3, %21, %bb.2
    %33:gpr32 = ADDI32_W %5, 4
    %31:gpr32 = LD32 %5, 0 :: (load (s32))
    %32:gpr32 = LD32 %33, 0 :: (load (s32))
    %9:dr64 = MOV_GPR_TO_DR64 %31, %32
    %30:gpr32 = ADDI32_W %6, 4
    %28:gpr32 = LD32 %6, 0 :: (load (s32))
    %29:gpr32 = LD32 %30, 0 :: (load (s32))
    %10:dr64 = MOV_GPR_TO_DR64 %28, %29
    %17:gpr32 = ADDI32_W %6, 8
    %13:dr64 = F2MULAA32RS_HHLL %8, %9, %10
    %15:gpr32 = ADD32 %7, %14
    %18:gpr32 = ADDI32 %5, 8
    %26:gpr32 = SEQ32 %15, %3
    %27:gpr32 = XORI32 %26, 1
    BNEZ_W %27, %bb.3
    B %bb.4

  bb.4.exit:
    %20:dr64 = PHI %21, %bb.1, %13, %bb.3
    $d0 = COPY %20
    RET implicit $r15, implicit $d0, implicit $r15

...
