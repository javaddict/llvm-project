# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-postlegalizer-combiner \
# RUN:     -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=COMBINE
# RUN: llc -mtriple=haydn-unknown-elf \
# RUN:     -run-pass=haydn-postlegalizer-combiner,regbankselect,instruction-select \
# RUN:     -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=ISEL

# Role: MIR — G_SEXTLOAD + G_PTR_ADD AGU fuse → G_HAYDN_*INC_LOAD is_sext=1
# → S_LBS/S_LHWS. G_ZEXTLOAD stays is_sext=0 → S_LBU/S_LHWU.

# Wave T3.3: G_SEXTLOAD + G_PTR_ADD AGU fuse → G_HAYDN_*INC_LOAD is_sext=1 →
# S_LBS/S_LHWS (signed byte/half post/pre-inc). G_ZEXTLOAD stays is_sext=0 → S_LBU/S_LHWU.

---
name:            postinc_sextload_i8
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r0
    ; COMBINE-LABEL: name: postinc_sextload_i8
    ; COMBINE: G_HAYDN_POSTINC_LOAD {{.*}}, 1
    ; COMBINE-NOT: G_SEXTLOAD
    ; COMBINE-NOT: G_PTR_ADD
    ; ISEL-LABEL: name: postinc_sextload_i8
    ; ISEL: S_LBS_POST_IMM
    %base:_(p0) = COPY $r0
    %val:_(s32) = G_SEXTLOAD %base(p0) :: (load (s8))
    %c1:_(s32) = G_CONSTANT i32 1
    %new:_(p0) = G_PTR_ADD %base, %c1(s32)
    $r0 = COPY %val
    $r1 = COPY %new
...

---
name:            postinc_sextload_i16
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r0
    ; COMBINE-LABEL: name: postinc_sextload_i16
    ; COMBINE: G_HAYDN_POSTINC_LOAD {{.*}}, 1
    ; COMBINE-NOT: G_SEXTLOAD
    ; ISEL-LABEL: name: postinc_sextload_i16
    ; ISEL: S_LHWS_POST_IMM
    %base:_(p0) = COPY $r0
    %val:_(s32) = G_SEXTLOAD %base(p0) :: (load (s16))
    %c2:_(s32) = G_CONSTANT i32 2
    %new:_(p0) = G_PTR_ADD %base, %c2(s32)
    $r0 = COPY %val
    $r1 = COPY %new
...

---
name:            postinc_zextload_i8
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r0
    ; COMBINE-LABEL: name: postinc_zextload_i8
    ; COMBINE: G_HAYDN_POSTINC_LOAD {{.*}}, 0
    ; COMBINE-NOT: G_ZEXTLOAD
    ; ISEL-LABEL: name: postinc_zextload_i8
    ; ISEL: S_LBU_POST_IMM
    %base:_(p0) = COPY $r0
    %val:_(s32) = G_ZEXTLOAD %base(p0) :: (load (s8))
    %c1:_(s32) = G_CONSTANT i32 1
    %new:_(p0) = G_PTR_ADD %base, %c1(s32)
    $r0 = COPY %val
    $r1 = COPY %new
...

---
name:            preinc_sextload_i8
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r0
    ; COMBINE-LABEL: name: preinc_sextload_i8
    ; COMBINE: G_HAYDN_PREINC_LOAD {{.*}}, 1
    ; COMBINE-NOT: G_SEXTLOAD
    ; ISEL-LABEL: name: preinc_sextload_i8
    ; ISEL: S_LBS_PRE_IMM
    %base:_(p0) = COPY $r0
    %c1:_(s32) = G_CONSTANT i32 1
    %new:_(p0) = G_PTR_ADD %base, %c1(s32)
    %val:_(s32) = G_SEXTLOAD %new(p0) :: (load (s8))
    $r0 = COPY %val
    $r1 = COPY %new
...
