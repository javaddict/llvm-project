    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    RET implicit $r15

  bb.2.tbb:
    liveins: $r15
    RET implicit $r15

  bb.3.fbb:
    liveins: $r15
    RET implicit $r15

