# CHECK-LABEL: name:            stamped_coissued_both_far
# CHECK: bb.0.entry
# CHECK: BUNDLE 1, 0
# CHECK: ADD32{{.*}}E3
# CHECK-NEXT: NOP
# CHECK-NOT: BNEZ
# CHECK: LUI{{.*}}%bb.2
# CHECK: ADDI32{{.*}}%bb.2
# CHECK: XOR32
# CHECK: SEQ32
# CHECK: MOVF32
# CHECK: JALR
# CHECK-NOT: B %bb.
# CHECK-NOT: bb.4
# CHECK: bb.1.pad
#
# CHECK-LABEL: name:            already_long_jalr_no_repromote
# CHECK: bb.0.entry
# CHECK: LUI{{.*}}%bb.2
# CHECK: ADDI32{{.*}}%bb.2
# CHECK: JALR
# CHECK-NOT: XOR32
# CHECK-NOT: SEQ32
# CHECK-NOT: MOVF32
# CHECK-NOT: MOVF
# CHECK-NOT: B %bb.
# CHECK-NOT: bb.3
#
# MC-LABEL: <stamped_coissued_both_far>:
# MC: add32
# MC-DAG: nop
# MC: xor32
# MC: seq32
# MC: movf32
# MC: jalr
# MC-NOT: bnez
