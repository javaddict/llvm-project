# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=prologepilog,haydn-hwloops -verify-machineinstrs \
# RUN:   %s -o - | FileCheck %s
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -debug-only=haydn-hwloops \
# RUN:   -run-pass=prologepilog,haydn-hwloops \
# RUN:   %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=DBG
# REQUIRES: asserts, haydn-registered-target
#
# D1.67(a) — Fixup-forced demote: header ADDI32 Prefer,Prefer,-1 plus a
# body store of Prefer. stripResidualCountdown is not position-blind:
# Prefer's leftover survives when LatchScr/CountReg != Prefer (A-5: Prefer
# is a live IV, not a leftover of the software counter), or demote refuses
# in preflight. CHECK-NOT a shifted SUBI32-only countdown on Prefer.
#
# Hole: stripResidualCountdown erased any ±1 of Prefer and reinstalled
# SUBI32 at latch end, so the body store between those positions saw a
# per-iteration shift. The stack arm stripped Prefer even when Prefer !=
# LatchScr. Do not restamp d164-hwloop-demote-body-read-tripreg.mir
# (body-read without a header leftover), cb162/cb165, or D1.71 overlay.
#
# Shape: SET_HWLOOP_F2_W $r2, spacer forces StartOff overflow (same
# demote-first idiom as d164 / hwloop-fixup-demote-range.mir). Header !=
# Latch so the leftover is outside the reinstall block. Other GPRs stay
# free so pickCounterReg copies the trip; countdown is not Prefer.

# CHECK-LABEL: name: d167_header_residual_shift
# CHECK-NOT: SET_HWLOOP
# Header leftover IV decrement of Prefer survives (CountReg/LatchScr != Prefer):
# CHECK: $r2 = ADDI32 $r2, -1
# Body still reads the original trip:
# CHECK: {{ST32|S_SW}}{{.*}}$r2
# CHECK-NOT: $r2 = SUBI32
# Countdown is another GPR, never Prefer.
# CHECK: $r{{[013-9]|1[0-2]}} = SUBI32
# CHECK: BNEZ
# CHECK-NOT: $r2 = SUBI32

# DBG: demoting hwloop
# DBG: has non-countdown body use
# DBG-NOT: demote latch scratch = Prefer
# DBG-NOT: LatchScr=$r2
# DBG-NOT: residual countdown of $r2 is not latch-equivalent
# DBG: demote trip
# DBG-NOT: demote latch scratch = Prefer
# DBG-NOT: LatchScr=$r2
# DBG-NOT: demote stack-counter
# DBG-NOT: demote skip overlay

--- |
  define dso_local void @d167_header_residual_shift(ptr nocapture writeonly %out, i32 %trip) {
  entry:
    br label %spacer
  spacer:
    br label %header
  header:
    br label %latch
  latch:
    store i32 %trip, ptr %out, align 4
    br label %exit
  exit:
    ret void
  }
...
---
name:            d167_header_residual_shift
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r2, $r15
    successors: %bb.1

    SET_HWLOOP_F2_W 0, %bb.2, %bb.3, $r2, implicit-def dead $sfr
    NOP
    NOP
    NOP

  ; Spacer: 20× NOP = 320 B > uimm6 252 — StartOff overflow, demote-first.
  bb.1.spacer:
    liveins: $r1, $r2
    successors: %bb.2
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP

  ; Header leftover ±1 of Prefer. Demote must not erase this and reinstall
  ; SUBI32 at latch end while the latch still stores Prefer.
  bb.2.header:
    liveins: $r1, $r2
    successors: %bb.3
    $r2 = ADDI32 $r2, -1

  bb.3.latch:
    liveins: $r1, $r2
    successors: %bb.4
    ST32 $r2, $r1, 0
    NOP
    NOP
    NOP

  bb.4.exit:
    liveins: $r15
    RET implicit killed $r15
