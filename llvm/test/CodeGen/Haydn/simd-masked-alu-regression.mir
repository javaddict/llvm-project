---
name:            test_x2mula32_isel
legalized:       true
regBankSelected: false
# CHECK-LABEL: name: test_x2mula32_isel
# CHECK: X2MULA32
# CHECK-NOT: G_INTRINSIC
body:             |
  bb.0.entry:
    liveins: $d0, $d1, $d2, $d3
    %0:_(s64) = COPY $d0
    %1:_(s64) = COPY $d1
    %2:_(s64) = COPY $d2
    %3:_(s64) = COPY $d3
    ; (Path B): x2mula32 is 2-dest accum — args (acc1, acc2, src1, src2)
    ; returns {i64, i64}. G_INTRINSIC has 2 defs + 4 args.
    %4:_(s64), %5:_(s64) = G_INTRINSIC intrinsic(@llvm.haydn.x2mula32), %0(s64), %1(s64), %2(s64), %3(s64)
    $d0 = COPY %4(s64)
    RET implicit $d0, implicit $r0, implicit $r15
...

---
name:            test_x4mula16_isel
