# RUN: llc -mtriple=haydn-unknown-elf -global-isel-abort=1 \
# RUN:   -run-pass=regbankselect,instruction-select -verify-machineinstrs \
# RUN:   %s -o - | FileCheck %s
#
# REGRESSION TEST: SIMD X2/X4 masked ALU instruction selection.
#
# Purpose: Verify that X2/X4 masked ALU intrinsics (X2ADD32S, X2SUB32S
# X4ADD16S, X4SUB16S, X2ADDSUB32S, X2SUBADD32S) are correctly selected
# from G_INTRINSIC to their target instructions. These are the core SIMD
# predicated ALU operations for DSP kernels.
#
# Why MIR-level: The full llc pipeline may eliminate these instructions
# if the SFR side effects are not modeled (known bug #1). Testing at the
# instruction-select level verifies that the selector mapping is correct
# independently of later optimization passes.
#
# Test design: Each MIR function feeds two DR64 operands into a
# G_INTRINSIC and verifies the target instruction appears in the output.

---
name:            test_x2add32s_isel
legalized:       true
regBankSelected: false
# CHECK-LABEL: name: test_x2add32s_isel
# CHECK: X2ADD32S
# CHECK-NOT: G_INTRINSIC
body:             |
  bb.0.entry:
    liveins: $d0, $d1
    %0:_(s64) = COPY $d0
    %1:_(s64) = COPY $d1
    %2:_(s64) = G_INTRINSIC intrinsic(@llvm.haydn.x2add32s), %0(s64), %1(s64)
    $d0 = COPY %2(s64)
    RET implicit $d0, implicit $r0, implicit $r15
...

---
name:            test_x2sub32s_isel
legalized:       true
regBankSelected: false
# CHECK-LABEL: name: test_x2sub32s_isel
# CHECK: X2SUB32S
# CHECK-NOT: G_INTRINSIC
body:             |
  bb.0.entry:
    liveins: $d0, $d1
    %0:_(s64) = COPY $d0
    %1:_(s64) = COPY $d1
    %2:_(s64) = G_INTRINSIC intrinsic(@llvm.haydn.x2sub32s), %0(s64), %1(s64)
    $d0 = COPY %2(s64)
    RET implicit $d0, implicit $r0, implicit $r15
...

