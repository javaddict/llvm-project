# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-latency-stalls \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=WRAP
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-latency-stalls \
# RUN:   -run-pass=haydn-latency-stalls -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s --check-prefix=WRAP
#
# D1.16 pin (b): the loop-end/END MIR position is the true wrap point.
# ZOL latch: bb.1 is its own successor and carries PseudoLoopEnd. The load
# is the LAST real cycle; its data dest r4 and writeback r1 are consumed at
# the next iteration's first cycle (MOVE32 reads r4, the load re-reads r1).
# Required pad P = latency 2 - wrap distance 1 - ... = destWindowWrapPadNeed
# = 1 (remaining 1 at the moment the last cycle retires).
#
# WRAP checks the pad lands AFTER the load and BEFORE PseudoLoopEnd: the
# pad must sit after every def whose window crosses the wrap (a pad before
# the def shifts the def with it and covers nothing — the fir_convol /
# vec_bexp product-kernel defect) and inside the inclusive [BEGIN,END]
# body window (END re-anchors at the last size-bearing body parcel, so
# pads before PseudoLoopEnd execute every iteration; parcels after a
# PseudoLoopEnd-only exit path never cover the wrap). A pad BEFORE the
# load's cycle is pinned absent. Second run arm pins regeneration
# (strip + re-insert identical, never accumulate).
#
# A second function with NO wrap pair (ALU-only tail, latency 1) inserts
# nothing — negative control.

---
name:            zol_wrap_tail_load
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r2
    successors: %bb.1(0x80000000)

    BUNDLE 0, 0, implicit-def $r4, implicit $r1 :: (load (s32)) {
      $r4 = S_LW_WITH_IMM_E2_E1_LOAD1_RI6 $r1, 1 :: (load (s32))
      SET_HWLOOP_F2_E2_E0_ALU0_HWLRIIR 0, %bb.1, %bb.1, killed $r2, implicit-def $sfr
    }

  bb.1:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $r1, $r3, $r4

    ; WRAP-LABEL: bb.1:
    ; Wrap pad inserted AFTER the load (the last def-bearing real cycle) and
    ; BEFORE PseudoLoopEnd — after every crossing def, inside the inclusive
    ; [BEGIN,END] body window.
    ; WRAP: BUNDLE 1, 0, implicit-def $r2, implicit killed $r4 {
    ; WRAP-NEXT: $r2 = MOVE32_E3_E2_ALU2_R killed $r4
    ; WRAP-NEXT: NOP
    ; WRAP-NEXT: }
    ; WRAP-NEXT: $r4, $r1 = S_LW_POST_IMM_E2_E1_LOAD1_RI6
    ; WRAP-NEXT: nomerge NOP
    ; WRONG placement (pad before the def it must cover — the product-kernel
    ; defect) would sit between the consumer and the load — pinned absent:
    ; WRAP-NOT: nomerge NOP
    ; WRAP-NEXT: PseudoLoopEnd %bb.1
    BUNDLE 1, 0, implicit-def $r2, implicit killed $r4 {
      $r2 = MOVE32_E3_E2_ALU2_R killed $r4
      NOP
    }
    $r4, $r1 = S_LW_POST_IMM_E2_E1_LOAD1_RI6 killed $r1, 1 :: (load (s32))
    PseudoLoopEnd %bb.1

  bb.2:
    liveins: $r2, $r3

    $r1 = ADD32_E2_E0_ALU0_RR killed $r2, killed $r3
    RET implicit $r15, implicit $r1
...
---
name:            zol_no_wrap_pair
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r2
    successors: %bb.1(0x80000000)

    BUNDLE 0, 0, implicit-def $sfr, implicit $r2 {
      SET_HWLOOP_F2_E2_E0_ALU0_HWLRIIR 0, %bb.1, %bb.1, killed $r2, implicit-def $sfr
      NOP
    }

  bb.1:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $r1, $r3

    ; ALU-only tail: latency 1 defs never cross the wrap. No wrap pads.
    ; WRAP-LABEL: name: zol_no_wrap_pair
    ; WRAP: BUNDLE 1, 0, implicit-def $r2, implicit $r1, implicit $r3 {
    ; WRAP-NOT: nomerge NOP
    ; WRAP: PseudoLoopEnd %bb.1
    BUNDLE 1, 0, implicit-def $r2, implicit $r1, implicit $r3 {
      $r2 = ADD32_E3_E2_ALU2_RR $r1, $r3
      NOP
    }
    BUNDLE 0, 0, implicit-def $r1 {
      $r1 = ADDI32_E2_E1_ALU1_RI20 $r1, 1
      NOP
    }
    PseudoLoopEnd %bb.1

  bb.2:
    liveins: $r2

    RET implicit $r15, implicit $r2
...
