# RUN: llc -mtriple=haydn-unknown-elf -global-isel-abort=1 -mattr=-hwloop -O2 \
# RUN:   -stop-after=pipeliner -debug-only=pipeliner -verify-machineinstrs %s -o - 2>&1 \
# RUN:   | FileCheck %s

# Role: MIR — GISel update-addr fuse (sole product path) forms post-inc load; SMS can analyze the countable loop.

# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6

#
# GISel update-addr fuse (sole product path) forms post-inc load; SMS can
# analyze the countable loop. FormUpdateAddr (post-ISel MIR fold) is retired.

# CHECK-NOT: Unable to analyzeLoop
# CHECK: Schedule Found?
# Fused post-inc present for SMS.
# CHECK: S_LW_POST_IMM

--- |
  define i32 @stream_postinc(ptr %p, i32 %n) #0 {
  entry:
    br label %loop
  loop:
    %s = phi i32 [ 0, %entry ], [ %s2, %loop ]
    %i = phi i32 [ 0, %entry ], [ %i2, %loop ]
    %bp = phi ptr [ %p, %entry ], [ %bp2, %loop ]
    %ld = load i32, ptr %bp, align 4
    %s2 = add i32 %s, %ld
    %bp2 = getelementptr i8, ptr %bp, i32 4
    %i2 = add i32 %i, 1
    %c = icmp ult i32 %i2, %n
    br i1 %c, label %loop, label %exit
  exit:
    ret i32 %s2
  }

  attributes #0 = { nounwind "target-features"="-hwloop" }
...
