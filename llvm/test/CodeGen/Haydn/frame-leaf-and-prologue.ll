;Non-leaf: function with a call (needs callee-save spills)

declare i32 @extern(i32)

define i32 @non_leaf(i32 %x) {
; Must save/restore callee-saved registers
; CHECK-LABEL: non_leaf:
; CHECK:       // #<spill-kpi> @non_leaf spills=1 spill-bytes=4 reloads=1 reload-bytes=4
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    { xor32 r0, r0, r0; nop; nop }
; CHECK-NEXT:    { subi32 sp, sp, 16; nop }
; CHECK-NEXT:    { nop; nop; s_sw_with_imm lr, sp, 3 }
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    .cfi_offset lr, 12
; CHECK-NEXT:    { nop; jal lr, extern; nop }
; CHECK-NEXT:    { xor32 r0, r0, r0; nop; nop }
; CHECK-NEXT:    { addi32 r1, r1, 1; nop }
; CHECK-NEXT:    { xor32 r0, r0, r0; nop; nop }
; CHECK-NEXT:    { s_lw_with_imm lr, sp, 3; nop; nop }
; CHECK-NEXT:    { addi32 sp, sp, 16; nop }
; CHECK-NEXT:    { nop; jalr r0, lr, 0; nop }
  %v = call i32 @extern(i32 %x)
  %r = add i32 %v, 1
  ret i32 %r
}

;Leaf with alloca (needs stack frame but no callee saves)

define i32 @leaf_with_alloca(i32 %x) {
; Needs stack space for alloca
; (SFR-strip) changed bundle layout (denser packing) — the SP restore may
; be hoisted above the local st32/ld32 (anti-dep); use CHECK-DAG so the frame
; alloc/dealloc and local access are matched regardless of order. Rebaselined.
; CHECK-LABEL: leaf_with_alloca:
; CHECK:       // #<spill-kpi> @leaf_with_alloca spills=0 spill-bytes=0 reloads=0 reload-bytes=0
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    { xor32 r0, r0, r0; nop; nop }
; CHECK-NEXT:    { subi32 sp, sp, 16; nop }
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    { addi32 r2, sp, 12; nop }
; CHECK-NEXT:    { nop; nop; s_sw_with_imm r1, r2, 0 }
; CHECK-NEXT:    { s_lw_with_imm r1, r2, 0; nop; nop }
; CHECK-NEXT:    { nop; nop; nop }
; CHECK-NEXT:    { addi32 r1, r1, 1; nop }
; CHECK-NEXT:    { xor32 r0, r0, r0; nop; nop }
; CHECK-NEXT:    { addi32 sp, sp, 16; nop }
; CHECK-NEXT:    { nop; jalr r0, lr, 0; nop }
  %p = alloca i32
  store i32 %x, ptr %p
  %v = load i32, ptr %p
  %r = add i32 %v, 1
  ret i32 %r
}

