;Leaf with conditional branch (no stack needed)

define i32 @leaf_branch(i32 %a, i32 %b) {
; CHECK-LABEL: leaf_branch:
; CHECK:       // #<spill-kpi> @leaf_branch spills=0 spill-bytes=0 reloads=0 reload-bytes=0
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    { xor32 r0, r0, r0; nop; nop }
; CHECK-NEXT:    { subi32 sp, sp, 8; nop }
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    { addi32 r3, r0, 0; nop }
; CHECK-NEXT:    { slt32 r3, r3, r1; nop; nop }
; CHECK-NEXT:    { xori32 r3, r3, 1; nop }
; CHECK-NEXT:    { bnez r3, .LBB8_2; nop; nop }
; CHECK-NEXT:  // %bb.1: // %pos
; CHECK-NEXT:    { add32 r1, r1, r2; nop; nop }
; CHECK-NEXT:    { beqz r0, .LBB8_3; nop; nop }
; CHECK-NEXT:  .LBB8_2: // %neg
; CHECK-NEXT:    { sub32 r1, r1, r2; nop; nop }
; CHECK-NEXT:  .LBB8_3: // %pos
; CHECK-NEXT:    { xor32 r0, r0, r0; nop; nop }
; CHECK-NEXT:    { addi32 sp, sp, 8; nop }
; CHECK-NEXT:    { nop; jalr r0, lr, 0; nop }
entry:
  %cmp = icmp sgt i32 %a, 0
  br i1 %cmp, label %pos, label %neg

pos:
  %r1 = add i32 %a, %b
  ret i32 %r1

neg:
  %r2 = sub i32 %a, %b
  ret i32 %r2
}
