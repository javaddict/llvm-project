# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-finalize-mi-bundles -verify-machineinstrs %s -o - | FileCheck %s
#
# B1.2 — singleton cycles → BUNDLE + FormatID (AIE FinalizeBundle port).
#
# Port of AIEFinalizeBundle (AIEFinalizeBundle.cpp:22-54 / AIE2TargetMachine.cpp:
# 242-244 after PostMachineScheduler). Bare real MIs become singleton BUNDLEs
# with durable FormatID imm 0 (Bundle128Full). Meta/COPY/already-bundled stay
# correct; multi-MI BUNDLE from pack is left alone (already stamped in B1.1).
# No setDesc / no HaydnMCFlags writers here (BF3 debt).

--- |
  define void @singleton_alu() { ret void }
  define void @already_bundled_multi() { ret void }
  define void @meta_skipped() { ret void }
...
---
name:            singleton_alu
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r3, $r4

    ; CHECK-LABEL: name: singleton_alu
    ; Each real standalone MI → BUNDLE with FormatID imm 0 and one child.
    ; CHECK: BUNDLE 0
    ; CHECK: ADDI32
    ; CHECK: BUNDLE 0
    ; CHECK: ADD32
    ; CHECK: BUNDLE 0
    ; CHECK: JALR
    $r2 = ADDI32 $r0, 10, implicit-def dead $sfr
    $r7 = ADD32 killed $r3, killed $r4, implicit-def dead $sfr
    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15

...
---
name:            already_bundled_multi
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r3, $r4

    ; Pre-formed multi-MI BUNDLE (B1.1 shape) must not be re-wrapped.
    ; CHECK-LABEL: name: already_bundled_multi
    ; CHECK: BUNDLE 0
    ; CHECK: ADDI32
    ; CHECK: ADD32
    ; CHECK: BUNDLE 0
    ; CHECK: JALR
    BUNDLE 0 {
      $r2 = ADDI32 $r0, 10, implicit-def dead $sfr
      $r7 = ADD32 killed $r3, killed $r4, implicit-def dead $sfr
    }
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15

...
---
name:            meta_skipped
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0

    ; Meta (CFI) stays unbundled; real MI wraps.
    ; CHECK-LABEL: name: meta_skipped
    ; CHECK: CFI_INSTRUCTION
    ; CHECK: BUNDLE 0
    ; CHECK: ADDI32
    ; CHECK: BUNDLE 0
    ; CHECK: JALR
    CFI_INSTRUCTION def_cfa $r13, 0
    $r2 = ADDI32 $r0, 1, implicit-def dead $sfr
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15

...
