# RUN: not llc -mtriple=haydn-unknown-elf \
# RUN:   -run-pass=haydn-finalize-mi-bundles,haydn-verify-bundles \
# RUN:   %s -o - 2>&1 | FileCheck %s

# Role: verifier — Late-MC one-to-one: residual cycle-forming LOADI32 (MBB) fails closed at the late firewall.

# Late-MC one-to-one: residual cycle-forming LOADI32 (MBB) fails closed
# at the late firewall. BranchRelaxation must exact-commit LUI+ADDI before layout.

--- |
  define void @residual_loadi32_mbb() { ret void }
...
---
name:            residual_loadi32_mbb
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r15
    successors: %bb.1
    ; CHECK: residual cycle-forming pseudo
    $r1 = LOADI32 %bb.1
    RET implicit $r15
  bb.1:
    RET implicit $r15
