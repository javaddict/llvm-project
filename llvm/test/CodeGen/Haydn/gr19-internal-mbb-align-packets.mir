# RUN: llc -mtriple=haydn-unknown-elf \
# RUN:   -run-pass=haydn-finalize-mi-bundles,haydn-longbranch-normalize \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s
# REQUIRES: haydn-registered-target
#
# GR1.9 / D1.166 / GR1.7: internal MBB alignment becomes complete idle
# packets in the layout predecessor via stamped LBN closer (D1.167
# padInternalMBBAlignment). MF.ensureAlignment(A) raises function alignment
# so W70.2r pre-label fill is an absolute-address grid. The named
# haydn-machine-alignment pass class is deleted (GR2.10).
#
# Peer: AIEMachineAlignment.cpp:370-424 pads the previous region. Overlay:
# no AIE bundle elongation (EncodedBytes is a fixed parcel); no post-label
# function-entry pad (W70.2r pre-label MC fill owns offset 0). AIE seats
# createAIEMachineAlignment in addPreSched2 (AIE2TargetMachine.cpp:254-255)
# because AIE PreEmit is empty (:92); Haydn overlay is this LBN closer.
#
# bb.0 is one NOP parcel (12 B) plus a B parcel (12 B) = 24. bb.1 asks
# align 16; lcm(16,12)=48, so two idle parcels land before B. Entry-only
# align 16 at offset 0 needs no post-label pad but still raises MF
# alignment (already 16 here).
# zol_latch_align16 is the same 24 B predecessor plus a PseudoLoopEnd
# latch (AIE isZOLBody peer): pads still land in the layout predecessor,
# LoopEnd stays the latch terminator.

--- |
  define void @internal_align16() { ret void }
  define void @entry_align16_no_postlabel() { ret void }
  define void @zol_latch_align16() { ret void }
...
---
name:            internal_align16
tracksRegLiveness: true
noVRegs:         true
body:             |
  ; CHECK-LABEL: name: internal_align16
  ; CHECK-NEXT: alignment: 16
  ; CHECK: bb.0:
  ; CHECK: NOP
  ; CHECK: BUNDLE
  ; CHECK: NOP
  ; CHECK: BUNDLE
  ; CHECK: NOP
  ; CHECK: B %bb.1
  ; CHECK: bb.1:
  ; CHECK-NOT: align 16
  ; CHECK: JALR
  bb.0:
    successors: %bb.1
    liveins: $r15
    NOP
    B %bb.1

  bb.1 (align 16):
    liveins: $r15
    RET implicit $r15
...
---
name:            entry_align16_no_postlabel
alignment:       16
tracksRegLiveness: true
noVRegs:         true
body:             |
  ; CHECK-LABEL: name: entry_align16_no_postlabel
  ; CHECK-NEXT: alignment: 16
  ; CHECK: bb.0:
  ; CHECK-NOT: align 16
  ; CHECK: NOP
  ; CHECK: JALR
  bb.0 (align 16):
    liveins: $r15
    NOP
    RET implicit $r15
...
---
name:            zol_latch_align16
tracksRegLiveness: true
noVRegs:         true
body:             |
  ; CHECK-LABEL: name: zol_latch_align16
  ; CHECK-NEXT: alignment: 16
  ; CHECK: bb.0:
  ; CHECK: NOP
  ; CHECK: BUNDLE
  ; CHECK: NOP
  ; CHECK: BUNDLE
  ; CHECK: NOP
  ; CHECK: B %bb.1
  ; CHECK: bb.1:
  ; CHECK-NOT: align 16
  ; CHECK: PseudoLoopEnd %bb.1
  ; CHECK: bb.2:
  ; CHECK: JALR
  bb.0:
    successors: %bb.1
    liveins: $r15
    NOP
    B %bb.1

  bb.1 (align 16):
    successors: %bb.1, %bb.2
    liveins: $r15
    NOP
    PseudoLoopEnd %bb.1

  bb.2:
    liveins: $r15
    RET implicit $r15
...
