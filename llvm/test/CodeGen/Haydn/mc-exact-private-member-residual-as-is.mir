# RUN: llc -mtriple=haydn-unknown-elf -x mir -start-after=livedebugvalues \
# RUN:   -filetype=obj %s -o %t.o && \
# RUN:   llvm-objdump -d -z --triple=haydn-unknown-elf %t.o | FileCheck %s
# REQUIRES: haydn-registered-target

# Role: residual as-is generated MemberId (E2 e0+e1), not FieldSlot suffix.
# ADD32 E2 e0 + ADDI32 E2 e1 both exist in the generated ledger so as-is
# private MemberId cutover applies without DFS re-place. encodeSlotSubInst
# never peels. Dual ALU packs that only cover E2 e0 may still Mode-retry /
# one swap, never encode-slot rebuild.

--- |
  define void @residual_e2_as_is() { ret void }
...
---
name:            residual_e2_as_is
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r15
    ; CHECK-LABEL: <residual_e2_as_is>:
    ; CHECK: {
    ; CHECK-DAG: add32
    ; CHECK-DAG: addi32
    BUNDLE 0, 0, implicit-def $r4, implicit-def $r5, implicit-def dead $sfr, implicit $r0, implicit $r1, implicit $r2 {
      $r4 = ADD32_E2_E0_ALU0_RR $r0, $r1, implicit-def dead $sfr
      $r5 = ADDI32_E2_E1_ALU1_RI20 $r2, 1, implicit-def dead $sfr
    }
    RET implicit $r15
...
