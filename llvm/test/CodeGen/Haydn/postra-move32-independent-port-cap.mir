# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postmisched -verify-machineinstrs %s -o - | FileCheck %s
# REQUIRES: haydn-registered-target
#
# Role: MIR — two MOVE32 (1R1W each after the dest+src schema) plus an
# independent store (2R0W) sit at exactly 4R2W: the packet is admitted
# by the GPR read cap. The port cap alone must admit it; nothing here
# relies on identity dedup. Peer: AIEHazardRecognizer.cpp books
# itinerary resources with no operand-identity dedup.
#
# Companion: countgprports-mir.mir (two MOVE32 still pack);
# postra-move32-per-field-ports.mir (RAW-confounded store of $r2).

--- |
  define void @two_move32_plus_independent_store(ptr %p) { ret void }
...
---
name:            two_move32_plus_independent_store
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
  - { reg: '$r5', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $r4, $r5

    ; Two MOVE32 (1R each) plus an independent store (2R) is exactly 4R2W:
    ; at cap, port-admissible (ceil(4/4)=1). The greedy packer forms a
    ; 2-wide (MOVE32+store) here; the port cap no longer rejects the mix.
    ; CHECK-LABEL: name: two_move32_plus_independent_store
    ; CHECK: BUNDLE
    ; CHECK: MOVE32_E3_E1_ALU1_R
    ; CHECK: S_SW_WITH_IMM_E3_E0_LOADSTORE0_RI6
    ; CHECK: }
    ; CHECK: MOVE32_E3_E2_ALU2_R
    $r2 = MOVE32 $r0, implicit-def dead $sfr
    $r3 = MOVE32 $r1, implicit-def dead $sfr
    ST32 $r4, $r5, 0 :: (store (s32))
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
