# D1.50 complete-tail pins. LongBranchNormalize must prove the analyzed
# near edge for far TBB/FBB (never an arbitrary layout successor) and, on
# an unanalyzable tail, replace only the selected unconditional root/member.
# Generic BranchRelaxation invert+swap uses FBB when present
# (BranchRelaxation.cpp:477-490) and layout-next only if FBB is null
# (520-530). AIE analyzeBranch sets TBB from the cond and FBB from the
# trailing uncond (AIEBaseInstrInfo.cpp:138-235); layout successor only
# deletes a fallthrough uncond (225-230); removeBranch erases at most last
# uncond + preceding cond (237-266). Hexagon range-tests the analyzed
# TBB/FBB terminator (HexagonBranchRelaxation.cpp:153-181);
# removeBranch stops at the first non-branch (HexagonInstrInfo.cpp:605-625).
# RISCV FBB is the trailing uncond (RISCVInstrInfo.cpp:1333-1355);
# removeBranch erases at most two trailing branches (1361-1390).
#
# Far template (d149/d134 law, buffer=4, parcel=12, window edge 2044):
#   170 NOPs = 2040B. Each logical B/BEQZ/NOP/RET charges one parcel.
#
# Arms:
#   far_tbb_non_layout: far TBB, FBB is a non-layout near dest, layout-next
#     is an extra successor (inlineasm-br trap) not FBB. Invert must target
#     FBB (%bb.2), never the trap (%bb.1).
#   far_fbb: far FBB, TBB is the original near cond; only the trailing
#     uncond becomes LUI+ADDI+JALR (polarity stays BEQZ, not inverted BNEZ).
#   multi_control: unanalyzable two-cond tail whose last cycle is a
#     coissued BUNDLE{ALU,B}. Preceding BEQZs and the ALU sibling survive;
#     only the selected uncond member is replaced (Arm B).
#
# RUN: llc -mtriple=haydn-unknown-elf \
# RUN:   -run-pass=haydn-longbranch-normalize,haydn-finalize-mi-bundles,haydn-verify-bundles \
# RUN:   -haydn-branch-relax-safety-buffer=4 -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s --check-prefix=NEAR
# RUN: llc -mtriple=haydn-unknown-elf \
# RUN:   -run-pass=haydn-longbranch-normalize,haydn-finalize-mi-bundles,haydn-verify-bundles \
# RUN:   -haydn-branch-relax-safety-buffer=4 -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s --check-prefix=FBB
# RUN: llc -mtriple=haydn-unknown-elf \
# RUN:   -run-pass=haydn-longbranch-normalize,haydn-finalize-mi-bundles,haydn-verify-bundles \
# RUN:   -haydn-branch-relax-safety-buffer=4 -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s --check-prefix=MULTI
# REQUIRES: haydn-registered-target

--- |
  define dso_local void @far_tbb_non_layout() {
  entry:
    br i1 undef, label %far, label %near
  trap:
    ret void
  near:
    ret void
  far:
    ret void
  }

  define dso_local void @far_fbb() {
  entry:
    br i1 undef, label %near, label %far
  near:
    br label %far
  far:
    ret void
  }

  define dso_local void @multi_control() {
  entry:
    br i1 undef, label %far, label %near
  near:
    br label %far
  far:
    ret void
  }
...
---
name:            far_tbb_non_layout
alignment:       1
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r7, $r15
    successors: %bb.1, %bb.2, %bb.3
    BEQZ_W $r7, %bb.3, implicit-def dead $sfr
    B %bb.2

  bb.1.trap (inlineasm-br-indirect-target):
    liveins: $r15
    RET implicit killed $r15

  bb.2.near:
    successors: %bb.3
    liveins: $r15
    NOP
