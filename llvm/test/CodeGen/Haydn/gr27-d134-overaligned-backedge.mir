  ; Unequal grid arm: lcm(8,12)=24.
  bb.2.spacer (align 8):
    successors: %bb.3
    NOP
    B %bb.3

  bb.3.latch (align 16):
    liveins: $r2
    successors: %bb.2, %bb.4
    NOP
    BNEZ_W $r2, %bb.2, implicit-def dead $sfr
    B %bb.4

  bb.4.exit:
    liveins: $r2, $r15
    RET implicit $r15

# CHECK-LABEL: name:            align16_long
# The joint-grid pad pushes the true backedge past the single-charge
# window: the terminal long latch is emitted (never an under-estimated
# short BNEZ that BR would promote postcommit).
# CHECK: LUI
# CHECK: ADDI32
# CHECK: BEQZ{{.*}} $r2, {{.*}}bb.4
# CHECK: JALR{{.*\$r11, 0}}
# CHECK-NOT: BNEZ
#
# CHECK-LABEL: name:            align8_long
# CHECK: LUI
# CHECK: ADDI32
# CHECK: BEQZ{{.*}} $r2, {{.*}}bb.4
# CHECK: JALR{{.*\$r11, 0}}
# CHECK-NOT: BNEZ
