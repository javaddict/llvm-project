# CB-161 rebaseline (2026-08-21): dropped legacy "implicit-def dead $sfr" operands. Live codegen
# emits none (the every-ALU-writes-SFR modeling is gone), and golden Constraints
# §Registers allows ONE SFR writer per bundle, so a finalize-stamped member pack
# carrying two such operands fails the SFR 1W port law at verify. The bundles were
# illegal under golden all along; the fixtures now mirror real committed MIR.
# RUN: llc -mtriple=haydn-unknown-elf -x mir \
# RUN:   -start-before=haydn-finalize-mi-bundles -filetype=obj %s -o %t.o
# RUN: llvm-objdump -d -z --triple=haydn-unknown-elf %t.o | FileCheck %s
# REQUIRES: haydn-registered-target

# Role: residual full-pack serializes without FieldSlot suffix→entry
# certification (ADD32 + XOR32). Finalize Mode-retries the E2 dual-ALU32
# pack onto E3 (XOR32 is e0-only under E2). Skip-Finalize must not DFS —
# that isolation is e96-skip-finalize-no-keepmap-fill.mir. encodeSlotSubInst
# is serialize-only (generated members / NOP). Bare hand-asm alone may
# free-DFS.

--- |
  define void @residual_e2_fullpack() { ret void }
...
---
name:            residual_e2_fullpack
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r15
    ; CHECK-LABEL: <residual_e2_fullpack>:
    ; CHECK-DAG: add32
    ; CHECK-DAG: ld32
    BUNDLE 0, 0, implicit-def $r4, implicit-def $r5, implicit $r0, implicit $r1, implicit $r2, implicit $r3 {
      $r4 = ADD32_E2_E0_ALU0_RR $r0, $r1
      $r5 = S_LW_WITH_IMM_E2_E1_LOAD1_RI6 $r2, 0
    }
    BUNDLE 0, 0 {
      $r0 = JALR_E2_E0_ALU0_RI12 $r15, 0
    }
...
