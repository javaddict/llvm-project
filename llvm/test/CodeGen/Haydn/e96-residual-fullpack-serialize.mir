# RUN: llc -mtriple=haydn-unknown-elf -x mir \
# RUN:   -start-after=livedebugvalues -filetype=obj %s -o %t.o
# RUN: llvm-objdump -d -z --triple=haydn-unknown-elf %t.o | FileCheck %s
# REQUIRES: haydn-registered-target

# Role: residual full-pack serializes without FieldSlot suffix→entry
# certification (ADD32_S0 + XOR32). Composite entry position + logical
# placeability; dual single-unit packs Mode-retry to E3 (no residual free
# DFS). encodeSlotSubInst is serialize-only (generated members / NOP).
# Residual FieldSlot still bag-sorts in placement when Desc shapes differ.
# Bare hand-asm alone may free-DFS.

--- |
  define void @residual_e2_fullpack() { ret void }
...
---
name:            residual_e2_fullpack
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r15
    ; CHECK-LABEL: <residual_e2_fullpack>:
    ; CHECK-DAG: add32
    ; CHECK-DAG: xor32
    BUNDLE 0, 0, implicit-def $r4, implicit-def $r5, implicit-def dead $sfr, implicit $r0, implicit $r1, implicit $r2, implicit $r3 {
      $r4 = ADD32 $r0, $r1, implicit-def dead $sfr
      $r5 = XOR32 $r2, $r3, implicit-def dead $sfr
    }
    BUNDLE 0 {
      $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    }
...
