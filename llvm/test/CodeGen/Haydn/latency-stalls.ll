entry:
  br label %loop

loop:
  %ptr = phi ptr [ %p, %entry ], [ %next, %loop ]
  %acc = phi i32 [ 0, %entry ], [ %sum, %loop ]
  %i = phi i32 [ 0, %entry ], [ %inc, %loop ]
