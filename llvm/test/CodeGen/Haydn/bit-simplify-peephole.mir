# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-bit-simplify -verify-machineinstrs %s -o - | FileCheck %s
#
# Test for the Haydn bit simplification peephole pass.
# Verifies identity elimination, zero-result simplification, redundant AND+OR
# pair removal, complement synthesis, and XOR constant folding.

--- |
  define void @test_and32_with_r0() { ret void }
  define void @test_or32_with_r0() { ret void }
  define void @test_xor32_with_r0() { ret void }
  define void @test_andi32_zero() { ret void }
  define void @test_ori32_zero() { ret void }
  define void @test_xori32_zero() { ret void }
  define void @test_redundant_and_or_pair() { ret void }
  define void @test_complement_synthesis() { ret void }
  define void @test_xor_constant_fold() { ret void }
  define void @test_and32_self_identity() { ret void }
  define void @test_no_change_valid_ops() { ret void }
...
---
# CHECK-LABEL: name: test_and32_with_r0
name:            test_and32_with_r0
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
body:             |
  bb.0:
    liveins: $r1

    ; AND32 with R0 (zero register) → result is zero → MOVE32 $r2, $r0
    ; CHECK: $r2 = MOVE32 $r0, $r0
    ; CHECK-NOT: AND32
    $r2 = AND32 $r1, $r0, implicit-def dead $sfr

    RET implicit $r0, implicit $r15
...
---
# CHECK-LABEL: name: test_or32_with_r0
name:            test_or32_with_r0
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
body:             |
  bb.0:
    liveins: $r1

    ; OR32 with R0 (zero register) → identity → MOVE32 $r2, $r1
    ; CHECK: $r2 = MOVE32 $r1, $r1
    ; CHECK-NOT: OR32
    $r2 = OR32 $r1, $r0, implicit-def dead $sfr

    RET implicit $r0, implicit $r15
...
---
# CHECK-LABEL: name: test_xor32_with_r0
name:            test_xor32_with_r0
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
body:             |
  bb.0:
    liveins: $r1

    ; XOR32 with R0 (zero register) → identity → MOVE32 $r2, $r1
    ; CHECK: $r2 = MOVE32 $r1, $r1
    ; CHECK-NOT: XOR32
    $r2 = XOR32 $r1, $r0, implicit-def dead $sfr

    RET implicit $r0, implicit $r15
...
---
# CHECK-LABEL: name: test_andi32_zero
name:            test_andi32_zero
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
body:             |
  bb.0:
    liveins: $r1

    ; ANDI32 with 0 → result is zero → MOVE32 $r2, $r0
    ; CHECK: $r2 = MOVE32 $r0, $r0
    ; CHECK-NOT: ANDI32
    $r2 = ANDI32 $r1, 0, implicit-def dead $sfr

    RET implicit $r0, implicit $r15
...
---
# CHECK-LABEL: name: test_ori32_zero
name:            test_ori32_zero
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
body:             |
  bb.0:
    liveins: $r1

    ; ORI32 with 0 → identity → MOVE32 $r2, $r1
    ; CHECK: $r2 = MOVE32 $r1, $r1
    ; CHECK-NOT: ORI32
    $r2 = ORI32 $r1, 0, implicit-def dead $sfr

    RET implicit $r0, implicit $r15
...
---
# CHECK-LABEL: name: test_xori32_zero
name:            test_xori32_zero
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
body:             |
  bb.0:
    liveins: $r1

    ; XORI32 with 0 → identity → MOVE32 $r2, $r1
    ; CHECK: $r2 = MOVE32 $r1, $r1
    ; CHECK-NOT: XORI32
    $r2 = XORI32 $r1, 0, implicit-def dead $sfr

    RET implicit $r0, implicit $r15
...
---
# CHECK-LABEL: name: test_redundant_and_or_pair
name:            test_redundant_and_or_pair
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
body:             |
  bb.0:
    liveins: $r1

    ; P0-2: pair fold deleted — both ANDI and ORI must remain (algebra wrong).
    ; CHECK: ANDI32
    ; CHECK: ORI32
    $r2 = ANDI32 $r1, 255, implicit-def dead $sfr
    $r2 = ORI32 $r2, 15, implicit-def dead $sfr

    RET implicit $r0, implicit $r15
...
---
# CHECK-LABEL: name: test_complement_synthesis
name:            test_complement_synthesis
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
body:             |
  bb.0:
    liveins: $r1

    ; P0-2: complement pair fold deleted — both ops remain.
    ; CHECK: ANDI32
    ; CHECK: ORI32
    $r2 = ANDI32 $r1, 65280, implicit-def dead $sfr
    $r2 = ORI32 $r2, 255, implicit-def dead $sfr

    RET implicit $r0, implicit $r15
...
---
# CHECK-LABEL: name: test_xor_constant_fold
name:            test_xor_constant_fold
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
body:             |
  bb.0:
    liveins: $r1

    ; Post-RA BitSimplify does NOT fold XORI C1 then XORI C2 (AIE/RISCV:
    ; that lives in SSA InstCombine/DAG/GISel). Both XORIs remain.
    ; CHECK: $r2 = XORI32 $r1, 5
    ; CHECK: $r2 = XORI32 $r2, 3
    $r2 = XORI32 $r1, 5, implicit-def dead $sfr
    $r2 = XORI32 $r2, 3, implicit-def dead $sfr

    RET implicit $r0, implicit $r15
...
---
# CHECK-LABEL: name: test_and32_self_identity
name:            test_and32_self_identity
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
body:             |
  bb.0:
    liveins: $r1

    ; AND32 rd, rs, rs → identity copy (r1 & r1 = r1).
    ; Since rd ($r2) != rs ($r1), this becomes MOVE32 $r2, $r1.
    ; CHECK: $r2 = MOVE32 $r1, $r1
    ; CHECK-NOT: AND32
    $r2 = AND32 $r1, $r1, implicit-def dead $sfr

    RET implicit $r0, implicit $r15
...
---
# CHECK-LABEL: name: test_no_change_valid_ops
name:            test_no_change_valid_ops
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
body:             |
  bb.0:
    liveins: $r1, $r2

    ; These operations should NOT be simplified — they are non-trivial.
    ; CHECK: $r3 = AND32 $r1, $r2
    $r3 = AND32 $r1, $r2, implicit-def dead $sfr

    ; CHECK: $r3 = OR32 $r1, $r2
    $r3 = OR32 $r1, $r2, implicit-def dead $sfr

    ; CHECK: $r3 = XOR32 $r1, $r2
    $r3 = XOR32 $r1, $r2, implicit-def dead $sfr

    ; CHECK: $r3 = ANDI32 $r1, 42
    $r3 = ANDI32 $r1, 42, implicit-def dead $sfr

    ; CHECK: $r3 = ORI32 $r1, 100
    $r3 = ORI32 $r1, 100, implicit-def dead $sfr

    ; CHECK: $r3 = XORI32 $r1, 7
    $r3 = XORI32 $r1, 7, implicit-def dead $sfr

    RET implicit $r0, implicit $r15
...
