# RUN: llc -O2 -mtriple=haydn-unknown-elf -disable-verify -debug-pass=Structure \
# RUN:   %s -o /dev/null 2>&1 | FileCheck %s
# REQUIRES: asserts

# Role: ownership — HaydnBitSimplify deleted; combiner owns the patterns.
# Pass the .mir path (not stdin) so llc selects the MIR parser.

# CHECK-NOT: Haydn Bit Simplification
# CHECK: PostRA Machine Instruction Scheduler

--- |
  define i32 @f(i32 %a) {
    %r = and i32 %a, 0
    ret i32 %r
  }
...
