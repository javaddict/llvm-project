# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-expand-pseudos -verify-machineinstrs %s -o - | FileCheck %s

# Role: MIR — LD32_POST_INC / ST32_POST_INC pseudos inside VLIW bundles must be expanded to real instructions, not silently dropped.

# REGRESSION TEST: LD32_POST_INC / ST32_POST_INC pseudos inside VLIW bundles
# must be expanded to real instructions, not silently dropped.
#
# Bug : The load/store optimizer (haydn-ldst-opt) creates LD32_POST_INC
# ST32_POST_INC pseudos after the initial expand-pseudos pass. The VLIW
# packetizer then bundles these pseudos. Without the bundle-aware expansion
# in HaydnExpandPseudos, these pseudos reach the AsmPrinter inside bundles
# and are silently dropped (AsmPrinter skips isPseudo inside bundles)
# producing WRONG CODE — missing loads/stores (the COPY-drop wrong-code).
#
# Fix: leftover *_POST_INC inside a BUNDLE still expands via the one
# expandPostIncPseudo helper (product form is ISel; this MIR injects the
# pseudo). Expansions insert before the BUNDLE; empty bundles are removed.
#
# Residual ExpandPseudos in-bundle seats prefer the same fused post-imm form
# as ExpandPostIncEarly when Offset==0 and the scaled stride fits: LD32 →
# S_LW_POST_IMM, ST32 → ST32_POST. Memory operands transfer onto the real
# memop. Split LD/ST+ADDI remains the fallback for non-zero Offset or out of
# range stride. Safety guarantee unchanged: no residual executable pseudo
# inside a BUNDLE.
#
# If this test regresses (a POST_INC pseudo survives inside a BUNDLE), the
# AsmPrinter will silently drop it and real loads/stores will be missing
# from the output. Do NOT update CHECK lines without understanding root cause.

--- |
  define void @test_ld32.post_inc_in_bundle(ptr %p) {
  entry:
    ret void
  }

  define void @test_st32.post_inc_in_bundle(ptr %p, i32 %val) {
  entry:
    ret void
  }
...
---
name:            test_ld32.post_inc_in_bundle
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0.entry:
    liveins: $r1

    ; The BUNDLE contains LD32_POST_INC — a pseudo that must be expanded.
    ; After expansion: a real load instruction is emitted before the bundle
    ; position (replacing the pseudo), and the empty bundle is removed.
    ;
    ; (DB-named fused post-increment load): when the stride is encodable (here
    ; stride 4 = imm6<<2 with imm6=1, in signed range -32..+31), the pseudo
    ; expands to a SINGLE fused S_LW_POST_IMM (a real, non-pseudo instruction with
    ; encoding 0x48 — NOT dropped by AsmPrinter). The base writeback is tied
    ; into the same instruction. This is the correct fused form; it does NOT
    ; weaken the safety net — the pseudo is still fully expanded out of
    ; the bundle into a real instruction, never silently dropped.
    ; CHECK: $r3, $r1 = S_LW_POST_IMM $r1, 1
    ; CHECK-NOT: LD32_POST_INC
    ; CHECK-NOT: BUNDLE
    BUNDLE implicit-def dead $sfr {
      $r3 = LD32_POST_INC $r1, 4, 0
    }

    RET implicit $r0, implicit $r15
...
---
name:            test_st32.post_inc_in_bundle
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0.entry:
    liveins: $r1, $r3

    ; ST32_POST_INC expands to fused ST32_POST when Offset==0 / stride fits.
    ; CHECK: $r1 = ST32_POST $r3, $r1, 1
    ; CHECK-NOT: ST32_POST_INC
    ; CHECK-NOT: BUNDLE
    BUNDLE implicit-def dead $sfr {
      ST32_POST_INC $r3, $r1, 4, 0
    }

    RET implicit $r0, implicit $r15
...
