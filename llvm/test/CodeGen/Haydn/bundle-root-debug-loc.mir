# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-finalize-mi-bundles \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s
#
# REGRESSION TEST: BUNDLE root DebugLoc from the earliest member (T-MC7).
#
# Bug: HaydnFinalizeBundle skipped already-bundled roots, so multi-MI packs
# from post-RA exact commit kept an empty BUNDLE DebugLoc. AsmPrinter
# iterates top-level MIs only; DwarfDebug::beginInstruction then saw no loc
# and dropped line-table / is_stmt for the whole parcel.
# Fix: after wrap/stamp, copy the earliest member DebugLoc onto any BUNDLE
# root that has none (MachineInstrBundle.cpp:90-101; Hexagon
# packetize-debug-loc.mir). If this regresses, the already-bundled BUNDLE
# below prints without debug-location and -O2 -g line tables go line-0.
#
# Test design: three functions.
#  1. Pre-formed multi-MI BUNDLE with empty root loc + members with loc
#     (the skip-path hole).
#  2. Standalone MI with loc (generic finalizeBundle wrap).
#  3. Pre-formed BUNDLE whose members have no loc (root stays empty).

--- |
  define void @already_bundled_empty_root() { ret void }
  define void @standalone_member_loc() { ret void }
  define void @already_bundled_no_member_loc() { ret void }

  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !9, producer: "llvm", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = distinct !DISubprogram(name: "test", scope: !9, file: !9, line: 1, type: !2, isLocal: false, isDefinition: true, scopeLine: 2, flags: DIFlagPrototyped, isOptimized: true, unit: !0)
  !2 = !DISubroutineType(types: !3)
  !3 = !{null}
  !5 = !DILocation(line: 126, column: 9, scope: !1)
  !6 = !DILocation(line: 321, column: 4, scope: !1)
  !9 = !DIFile(filename: "bundle-root-debug-loc.mir", directory: "/tmp")
  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!7, !8}
  !7 = !{i32 2, !"Dwarf Version", i32 4}
  !8 = !{i32 2, !"Debug Info Version", i32 3}
...
---
name: already_bundled_empty_root
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r3, $r4
    ; CHECK-LABEL: name: already_bundled_empty_root
    ; CHECK: BUNDLE
    ; CHECK-SAME: debug-location !DILocation(line: 126
    ; CHECK-NEXT: ADDI32
    ; CHECK-SAME: debug-location !DILocation(line: 126
    ; CHECK-NEXT: ADD32
    ; CHECK-SAME: debug-location !DILocation(line: 321
    BUNDLE 0 {
      $r2 = ADDI32 $r0, 10, implicit-def dead $sfr, debug-location !5
      $r7 = ADD32 $r3, $r4, implicit-def dead $sfr, debug-location !6
    }
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15

...
---
name: standalone_member_loc
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0
    ; CHECK-LABEL: name: standalone_member_loc
    ; CHECK: BUNDLE
    ; CHECK-SAME: debug-location !DILocation(line: 126
    ; CHECK-NEXT: ADDI32
    ; CHECK-SAME: debug-location !DILocation(line: 126
    $r2 = ADDI32 $r0, 10, implicit-def dead $sfr, debug-location !5
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15

...
---
name: already_bundled_no_member_loc
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r3, $r4
    ; CHECK-LABEL: name: already_bundled_no_member_loc
    ; CHECK: BUNDLE 0
    ; CHECK-NOT: debug-location
    BUNDLE 0 {
      $r2 = ADDI32 $r0, 10, implicit-def dead $sfr
      $r7 = ADD32 $r3, $r4, implicit-def dead $sfr
    }
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
