# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-latency-stalls \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=ONCE
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-latency-stalls \
# RUN:   -run-pass=haydn-latency-stalls -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s --check-prefix=TWICE
#
# D1.16 wrap-pad regeneration / no-double-pad law. The wrap arm inserts the
# residual deficit only: a scheduler-placed idle NOP cycle after the load
# already covers part of the window, and a re-run strips (NoMerge pin) and
# re-inserts exactly the same pad — never accumulating, never duplicating a
# pad the scheduler owns.
#
# bb.1 latch cycles: [MOVE32 reads r4] [LOAD defs r4,r1] [idle NOP].
# The trailing idle NOP retires the latency-2 window before the wrap, so
# the residual wrap deficit is 0 and the pass must insert NOTHING at the
# wrap point (the scheduler's NOP is not NoMerge-stamped and is left
# alone — the net inserts only the residual deficit, never a duplicate).
# bb.2 is a non-latch exit block whose single trailing terminator cycle
# retires the window: zero exit pads, zero wrap pads.

---
name:            wrap_regen
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r2
    successors: %bb.1(0x50000000), %bb.2(0x30000000)

    BUNDLE 0, 0, implicit-def $r4, implicit $r1 :: (load (s32)) {
      $r4 = S_LW_WITH_IMM_E2_E1_LOAD1_RI6 $r1, 1 :: (load (s32))
      NOP
    }
    BNEZ_E2_E0_ALU0_I12 killed $r2, %bb.2
    B %bb.1

  bb.1:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $r1, $r3, $r4

    ; Covered latch: trailing scheduler idle NOP retires the window.
    ; ONCE-LABEL: bb.1:
    ; ONCE: BUNDLE 1, 0, implicit-def $r2, implicit killed $r4 {
    ; ONCE-NEXT: $r2 = MOVE32_E3_E2_ALU2_R killed $r4
    ; ONCE-NEXT: NOP
    ; ONCE-NEXT: }
    ; ONCE-NEXT: $r4, $r1 = S_LW_POST_IMM_E2_E1_LOAD1_RI6 killed $r1, 1 :: (load (s32))
    ; ONCE-NEXT: NOP
    ; ONCE-NEXT: PseudoLoopEnd %bb.1
    ; ONCE-NOT: nomerge NOP
    ; TWICE-LABEL: bb.1:
    ; TWICE-NOT: nomerge NOP
    BUNDLE 1, 0, implicit-def $r2, implicit killed $r4 {
      $r2 = MOVE32_E3_E2_ALU2_R killed $r4
      NOP
    }
    $r4, $r1 = S_LW_POST_IMM_E2_E1_LOAD1_RI6 killed $r1, 1 :: (load (s32))
    NOP
    PseudoLoopEnd %bb.1

  bb.2:
    liveins: $r1, $r15

    ; Not a latch (no self-edge): the load's latency-2 window is retired by
    ; the single trailing terminator cycle on the exit path — zero exit
    ; deficit, zero wrap pads. Pins that the wrap arm adds nothing outside
    ; a latch and the exit arm does not double-pad.
    ; ONCE-LABEL: bb.2:
    ; ONCE: $r4 = S_LW_WITH_IMM_E2_E1_LOAD1_RI6 $r1, 1 :: (load (s32))
    ; ONCE-NEXT: RET implicit $r15
    ; ONCE-NOT: nomerge NOP
    ; TWICE-LABEL: name: wrap_regen_deficit
    $r4 = S_LW_WITH_IMM_E2_E1_LOAD1_RI6 $r1, 1 :: (load (s32))
    RET implicit $r15
...
---
name:            wrap_regen_deficit
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r2
    successors: %bb.1(0x80000000)

    BUNDLE 0, 0, implicit-def $r4, implicit $r1 :: (load (s32)) {
      $r4 = S_LW_WITH_IMM_E2_E1_LOAD1_RI6 $r1, 1 :: (load (s32))
      SET_HWLOOP_F2_E2_E0_ALU0_HWLRIIR 0, %bb.1, %bb.1, killed $r2, implicit-def $sfr
    }

  bb.1:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $r1, $r3, $r4

    ; Deficit ZOL latch: load is the LAST real cycle (no trailing idle NOP),
    ; deficit 1 → exactly one wrap pad AFTER the load and BEFORE
    ; PseudoLoopEnd (after every crossing def, inside the inclusive body
    ; window — a pad before the load shifts the load with it and covers
    ; nothing), identical on the first and the second invocation
    ; (strip + re-insert, never accumulate).
    ; ONCE-LABEL: name: wrap_regen_deficit
    ; ONCE: bb.1:
    ; ONCE: $r2 = MOVE32_E3_E2_ALU2_R killed $r4
    ; ONCE-NEXT: NOP
    ; ONCE-NEXT: }
    ; ONCE-NEXT: $r4, $r1 = S_LW_POST_IMM_E2_E1_LOAD1_RI6 killed $r1, 1 :: (load (s32))
    ; ONCE-NEXT: nomerge NOP
    ; ONCE-NEXT: PseudoLoopEnd %bb.1
    ; ONCE-NOT: nomerge NOP
    ; TWICE: bb.1:
    ; TWICE: $r2 = MOVE32_E3_E2_ALU2_R killed $r4
    ; TWICE-NEXT: NOP
    ; TWICE-NEXT: }
    ; TWICE-NEXT: $r4, $r1 = S_LW_POST_IMM_E2_E1_LOAD1_RI6 killed $r1, 1 :: (load (s32))
    ; TWICE-NEXT: nomerge NOP
    ; TWICE-NEXT: PseudoLoopEnd %bb.1
    ; TWICE-NOT: nomerge NOP
    BUNDLE 1, 0, implicit-def $r2, implicit killed $r4 {
      $r2 = MOVE32_E3_E2_ALU2_R killed $r4
      NOP
    }
    $r4, $r1 = S_LW_POST_IMM_E2_E1_LOAD1_RI6 killed $r1, 1 :: (load (s32))
    PseudoLoopEnd %bb.1

  bb.2:
    liveins: $r2, $r3, $r15
    BUNDLE 0, 0, implicit-def $r9, implicit killed $r2, implicit killed $r3 {
      $r9 = ADD32_E2_E0_ALU0_RR killed $r2, killed $r3
    }
    RET implicit $r15, implicit $r9
...
