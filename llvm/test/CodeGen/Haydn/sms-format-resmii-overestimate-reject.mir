# RUN: llc -mtriple=haydn-unknown-elf -mattr=-hwloop -run-pass=pipeliner \
# RUN:   -debug-only=pipeliner -verify-machineinstrs %s -o /dev/null 2>&1 \
# RUN:   | FileCheck %s --check-prefix=RESMII
# REQUIRES: asserts

# Role: MIR — Positive SMS-RESMII overestimate metrics pin (Option A).
#
# Left-to-right greedy exactTryAddProduct packing can open more cycles than the
# exhaustive ≤3 format set oracle on the order-trap multiset
# [ST32, ST32, ADD32, ADD32, ADD32] (+ IV/addr). Under Option A product law,
# overestimate is metrics-only: StageCount>1 containment is the product gate,
# and inflated greedy ResMII is a conservative II floor (not an analyze reject).
# No shared MachinePipeliner rewrite; no force flag; no force-coissue revival.
#
# Companion accept path (overestimate=0): sms-format-resmii.mir.
# SMS-HOOK positive reject: sms-format-hook-reject.mir.
#
# RESMII: SMS-RESMII: body_ops={{[0-9]+}} greedy={{[0-9]+}} exhaustive={{[0-9]+}} overestimate={{[1-9][0-9]*}}
# RESMII: SMS-RESMII: reject — greedy overestimates exhaustive oracle by {{[1-9][0-9]*}} (metrics-only; StageCount>1 containment is the product gate; format-dependent multi-stage is post-RA only)
# RESMII-NOT: SMS: analyzeLoopForPipelining fail-closed (SMS-RESMII greedy overestimate)

--- |
  define void @sms_resmii_greedy_overestimate(ptr %p, ptr %q, i32 %n) #0 {
  entry:
    br label %loop
  loop:
    br i1 undef, label %loop, label %exit
  exit:
    ret void
  }
  attributes #0 = { "target-features"="-hwloop" }
...
---
name:            sms_resmii_greedy_overestimate
alignment:       16
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          false
isSSA:           true
noVRegs:         false
registers:
  - { id: 0, class: gpr32 }
  - { id: 1, class: gpr32 }
  - { id: 2, class: gpr32 }
  - { id: 3, class: gpr32 }
  - { id: 4, class: gpr32 }
  - { id: 5, class: gpr32 }
  - { id: 6, class: gpr32 }
  - { id: 7, class: gpr32 }
  - { id: 8, class: gpr32 }
  - { id: 9, class: gpr32 }
  - { id: 10, class: gpr32 }
  - { id: 11, class: gpr32 }
  - { id: 12, class: gpr32 }
  - { id: 13, class: gpr32 }
  - { id: 14, class: gpr32 }
  - { id: 15, class: gpr32 }
liveins:
  - { reg: '$r1' }
  - { reg: '$r2' }
  - { reg: '$r3' }
frameInfo:
  maxAlignment:    1
machineFunctionInfo: {}
body:             |
  bb.1.entry:
    liveins: $r1, $r2, $r3

    %0:gpr32 = COPY $r1
    %1:gpr32 = COPY $r2
    %2:gpr32 = COPY $r3
    %3:gpr32 = LOADI32 1
    %4:gpr32 = LOADI32 0
    %5:gpr32 = LOADI32 7

  bb.2.loop:
    successors: %bb.2(0x7c000000), %bb.3(0x04000000)

    %6:gpr32 = PHI %0, %bb.1, %10, %bb.2
    %7:gpr32 = PHI %1, %bb.1, %11, %bb.2
    %8:gpr32 = PHI %4, %bb.1, %12, %bb.2
    %9:gpr32 = PHI %4, %bb.1, %13, %bb.2
    ; Order trap: ST ST ADD ADD ADD — greedy 3 / exact 2 (unit pin peer).
    ST32 %5, %6, 0 :: (store (s32))
    ST32 %5, %7, 0 :: (store (s32))
    %12:gpr32 = ADD32 %8, %5
    %13:gpr32 = ADD32 %9, %5
    %14:gpr32 = ADD32 %12, %13
    %10:gpr32 = ADDI32 %6, 4
    %11:gpr32 = ADDI32 %7, 4
    %15:gpr32 = SLT32 %14, %2
    BNEZ_W %15, %bb.2
    B %bb.3

  bb.3.exit:
    RET implicit $r15

...
