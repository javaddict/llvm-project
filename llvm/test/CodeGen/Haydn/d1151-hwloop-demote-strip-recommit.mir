# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=haydn-hwloops -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s
# REQUIRES: haydn-registered-target
#
# D1.151 — Fixup-only (no haydn-finalize-mi-bundles): stripResidualCountdown
# of a bundled leftover is one root-level erase-and-recommit. Survivors go
# through recommitSurvivingCycleMembers; green cannot be constructive
# Finalize wrapping a stale BUNDLE shell.
#
# side_effect_strip: latch BUNDLE { ST32, ADDI32 Prefer,-1 }. Range spacer
# forces demote; Prefer is the software countdown. After strip the store
# is an exact-committed singleton whose root does not carry implicit-def
# of the stripped countdown dest.
#
# memory_siblings_strip: same geometry with proven-disjoint ST32+LD32
# (same IR object %q, byte 0 vs 4) coissued with the leftover. TII
# same-base oracle, null AA: the pair stays one packet.

--- |
  define dso_local void @side_effect_strip(ptr nocapture writeonly %p, i32 %v, i32 %trip) {
  entry:
    br label %spacer
  spacer:
    br label %header
  header:
    br label %latch
  latch:
    store i32 %v, ptr %p, align 4
    br label %exit
  exit:
    ret void
  }

  define dso_local void @memory_siblings_strip(ptr nocapture %q, i32 %v, i32 %trip) {
  entry:
    br label %spacer
  spacer:
    br label %header
  header:
    br label %latch
  latch:
    store i32 %v, ptr %q, align 4
    br label %exit
  exit:
    ret void
  }

...
---
name:            side_effect_strip
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r2, $r6, $r15
    successors: %bb.1

    SET_HWLOOP_F2_W 0, %bb.2, %bb.3, $r2, implicit-def dead $sfr
    NOP
    NOP
    NOP

  ; Spacer: 20× NOP = 320 B > uimm6 252 — StartOff overflow, demote-first.
  bb.1.spacer:
    liveins: $r1, $r2, $r6
    successors: %bb.2
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP

  bb.2.header:
    liveins: $r1, $r2, $r6
    successors: %bb.3
    NOP

  bb.3.latch:
    liveins: $r1, $r2, $r6
    successors: %bb.4
    BUNDLE implicit-def $r2, implicit $r6, implicit $r1 {
      ST32 $r6, $r1, 0
      $r2 = ADDI32 $r2, -1
    }
    NOP
    NOP
    NOP

  bb.4.exit:
    liveins: $r15
    RET implicit killed $r15

# CHECK-LABEL: name: side_effect_strip
# CHECK-NOT: SET_HWLOOP
# Store sibling is a committed singleton; the stripped countdown dest is
# not a stale BUNDLE implicit-def on that packet.
# CHECK: BUNDLE
# CHECK-NOT: implicit-def $r2
# CHECK: {{ST32|S_SW_WITH_IMM.*}} $r6, $r1, 0
# CHECK-NOT: $r2 = {{ADDI32|ADDI32_W}}
# CHECK: }
# CHECK: $r2 = SUBI32
# CHECK: BNEZ
# CHECK-NOT: $r2 = SUBI32

---
name:            memory_siblings_strip
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r2, $r6, $r15
    successors: %bb.1

    SET_HWLOOP_F2_W 0, %bb.2, %bb.3, $r2, implicit-def dead $sfr
    NOP
    NOP
    NOP

  bb.1.spacer:
    liveins: $r1, $r2, $r6
    successors: %bb.2
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP

  bb.2.header:
    liveins: $r1, $r2, $r6
    successors: %bb.3
    NOP

  bb.3.latch:
    liveins: $r1, $r2, $r6
    successors: %bb.4
    BUNDLE implicit-def $r7, implicit-def $r2, implicit $r6, implicit $r1 {
      ST32 $r6, $r1, 0 :: (store (s32) into %ir.q)
      $r7 = LD32 $r1, 1 :: (load (s32) from %ir.q + 4)
      $r2 = ADDI32 $r2, -1
    }
    NOP
    NOP
    NOP

  bb.4.exit:
    liveins: $r15
    RET implicit killed $r15

# CHECK-LABEL: name: memory_siblings_strip
# CHECK-NOT: SET_HWLOOP
# Proven-disjoint ST+LD stay one packet: no new BUNDLE between the two
# member lines (recommit prints the load child first; discriminator is
# the absence of an intervening BUNDLE root). Leftover countdown is gone.
# CHECK: BUNDLE
# CHECK-NOT: implicit-def $r2
# CHECK: $r7 = {{LD32|S_LW_WITH_IMM.*}} $r1, 1
# CHECK-NOT: BUNDLE
# CHECK: {{ST32|S_SW_WITH_IMM.*}} $r6, $r1, 0
# CHECK-NOT: $r2 = {{ADDI32|ADDI32_W}}
# CHECK: }
# CHECK: $r2 = SUBI32
# CHECK: BNEZ
