# RUN: llc -mtriple=haydn-unknown-elf -run-pass=regbankselect,instruction-select %s -o - | FileCheck %s

# Test that G_* arithmetic operations are selected to ADD32/SUB32/MULL/etc.

---
name:            test_select_add32
legalized:       true
regBankSelected: false
# CHECK-LABEL: name: test_select_add32
# CHECK: ADD32
body:             |
  bb.0.entry:
    liveins: $r0, $r1
    %0:_(s32) = COPY $r0
    %1:_(s32) = COPY $r1
    %2:_(s32) = G_ADD %0, %1
    $r0 = COPY %2(s32)
    RET implicit $r0, implicit $r15
...

---
name:            test_select_addi32
legalized:       true
regBankSelected: false
# CHECK-LABEL: name: test_select_addi32
# Immediate add may stay ADDI32 or become ADD32 of a materialized constant.
# CHECK: {{ADDI32|ADD32}}
body:             |
  bb.0.entry:
    liveins: $r0
    %0:_(s32) = COPY $r0
    %1:_(s32) = G_CONSTANT i32 42
    %2:_(s32) = G_ADD %0, %1
    $r0 = COPY %2(s32)
    RET implicit $r0, implicit $r15
...

