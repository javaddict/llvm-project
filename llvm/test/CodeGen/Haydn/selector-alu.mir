...

---
name:            test_select_mul32
legalized:       true
regBankSelected: false
# CHECK-LABEL: name: test_select_mul32
# G_MUL <s32> → MULL (golden GPR32 MAC GRR low-half product).
# CHECK: MULL
# CHECK-NOT: MUL64_LL
body:             |
  bb.0.entry:
    liveins: $r0, $r1
    %0:_(s32) = COPY $r0
    %1:_(s32) = COPY $r1
    %2:_(s32) = G_MUL %0, %1
    $r0 = COPY %2(s32)
    RET implicit $r0, implicit $r15
...

