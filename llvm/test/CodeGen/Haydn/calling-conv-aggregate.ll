; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=haydn-unknown-elf -global-isel-abort=1 -verify-machineinstrs < %s | FileCheck %s
;
; G-ABI-VEC residual: aggregates pass as Indirect pointers (no byval).
; Clang emits ptr (dead_on_return / sret), never byval(%Big). Backend loads
; fields through the pointer in R1 and stores through the sret pointer.
;
; %Big is 4 x i64 (32 bytes) — too large for R1–R2 / D0 returns.

%Big = type { i64, i64, i64, i64 }

; Indirect arg: pointer in R1, load fields from memory.
define i32 @take_big(ptr %s) nounwind {
; CHECK-LABEL: take_big:
; CHECK:       // #<spill-kpi> @take_big spills=0 spill-bytes=0 reloads=0 reload-bytes=0
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    { xor32 r0, r0, r0; nop; nop }
; CHECK-NEXT:    { subi32 sp, sp, 8; nop }
; CHECK-NEXT:    { s_lw_with_imm r3, r1, 0; addi32 r2, r1, 4 }
; CHECK-NEXT:    { addi32 r1, r1, 8; s_lw_with_imm r2, r2, 0 }
; CHECK-NEXT:    { addi32 r4, r1, 4; s_lw_with_imm r1, r1, 0 }
; CHECK-NEXT:    { s_lw_with_imm r4, r4, 0; subi32 sp, sp, 8 }
; CHECK-NEXT:    { nop; nop; s_sw_with_imm r3, sp, 0 }
; CHECK-NEXT:    { nop; nop; s_sw_with_imm r2, sp, 1 }
; CHECK-NEXT:    { d_ldw_with_imm d0, sp, 0; addi32 sp, sp, 8 }
; CHECK-NEXT:    { subi32 sp, sp, 8; nop }
; CHECK-NEXT:    { nop; nop; s_sw_with_imm r1, sp, 0 }
; CHECK-NEXT:    { nop; nop; s_sw_with_imm r4, sp, 1 }
; CHECK-NEXT:    { d_ldw_with_imm d1, sp, 0; addi32 sp, sp, 8 }
; CHECK-NEXT:    { nop; nop; nop }
; CHECK-NEXT:    { add64 d0, d0, d1; nop; nop }
; CHECK-NEXT:    { move32_dr_l r1, d0; nop; nop }
; CHECK-NEXT:    { xor32 r0, r0, r0; nop; nop }
; CHECK-NEXT:    { addi32 sp, sp, 8; nop }
; CHECK-NEXT:    { nop; jalr r0, lr, 0; nop }
entry:
  %a = getelementptr %Big, ptr %s, i32 0, i32 0
  %v0 = load i64, ptr %a
  %b = getelementptr %Big, ptr %s, i32 0, i32 1
  %v1 = load i64, ptr %b
  %sum = add i64 %v0, %v1
  %trunc = trunc i64 %sum to i32
  ret i32 %trunc
}

; sret return: store into caller-provided pointer (R1).
define void @make_big(ptr sret(%Big) %out, i64 %x) nounwind {
; CHECK-LABEL: make_big:
; CHECK:       // #<spill-kpi> @make_big spills=0 spill-bytes=0 reloads=0 reload-bytes=0
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    { xor32 r0, r0, r0; nop; nop }
; CHECK-NEXT:    { subi32 sp, sp, 8; nop }
; CHECK-NEXT:    { addi32 r2, r1, 4; d_sw_l_with_imm d0, r1, 0 }
; CHECK-NEXT:    { nop; nop; d_sw_h_with_imm d0, r2, 0 }
; CHECK-NEXT:    { xor32 r0, r0, r0; nop; nop }
; CHECK-NEXT:    { addi32 sp, sp, 8; nop }
; CHECK-NEXT:    { nop; jalr r0, lr, 0; nop }
entry:
  %a = getelementptr %Big, ptr %out, i32 0, i32 0
  store i64 %x, ptr %a
  ret void
}

; Call passes the aggregate as a plain pointer (no byval memcpy into CC slots).
define i32 @call_take_big(ptr %p) nounwind {
; CHECK-LABEL: call_take_big:
; CHECK:       // #<spill-kpi> @call_take_big spills=1 spill-bytes=4 reloads=1 reload-bytes=4
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    { xor32 r0, r0, r0; nop; nop }
; CHECK-NEXT:    { subi32 sp, sp, 16; nop }
; CHECK-NEXT:    { nop; nop; s_sw_with_imm lr, sp, 3 }
; CHECK-NEXT:    { nop; jal lr, take_big; nop }
; CHECK-NEXT:    { xor32 r0, r0, r0; nop; nop }
; CHECK-NEXT:    { s_lw_with_imm lr, sp, 3; nop; nop }
; CHECK-NEXT:    { addi32 sp, sp, 16; nop }
; CHECK-NEXT:    { nop; jalr r0, lr, 0; nop }
entry:
  %r = call i32 @take_big(ptr %p)
  ret i32 %r
}

; Multiple field loads through the indirect pointer.
define i64 @sum_big_fields(ptr %s) nounwind {
; CHECK-LABEL: sum_big_fields:
; CHECK:       // #<spill-kpi> @sum_big_fields spills=0 spill-bytes=0 reloads=0 reload-bytes=0
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    { xor32 r0, r0, r0; nop; nop }
; CHECK-NEXT:    { subi32 sp, sp, 8; nop }
; CHECK-NEXT:    { addi32 r2, r1, 8; addi32 r3, r1, 16 }
; CHECK-NEXT:    { addi32 r4, r1, 24; addi32 r5, r1, 4 }
; CHECK-NEXT:    { s_lw_with_imm r1, r1, 0; nop; s_lw_with_imm r5, r5, 0 }
; CHECK-NEXT:    { addi32 r6, r2, 4; s_lw_with_imm r2, r2, 0 }
; CHECK-NEXT:    { addi32 r7, r3, 4; s_lw_with_imm r3, r3, 0 }
; CHECK-NEXT:    { s_lw_with_imm r6, r6, 0; addi32 r12, r4, 4 }
; CHECK-NEXT:    { s_lw_with_imm r7, r7, 0; nop; s_lw_with_imm r4, r4, 0 }
; CHECK-NEXT:    { s_lw_with_imm r12, r12, 0; subi32 sp, sp, 8 }
; CHECK-NEXT:    { nop; nop; s_sw_with_imm r1, sp, 0 }
; CHECK-NEXT:    { nop; nop; s_sw_with_imm r5, sp, 1 }
; CHECK-NEXT:    { d_ldw_with_imm d0, sp, 0; addi32 sp, sp, 8 }
; CHECK-NEXT:    { subi32 sp, sp, 8; nop }
; CHECK-NEXT:    { nop; nop; s_sw_with_imm r2, sp, 0 }
; CHECK-NEXT:    { nop; nop; s_sw_with_imm r6, sp, 1 }
; CHECK-NEXT:    { d_ldw_with_imm d1, sp, 0; addi32 sp, sp, 8 }
; CHECK-NEXT:    { nop; nop; nop }
; CHECK-NEXT:    { subi32 sp, sp, 8; add64 d0, d0, d1 }
; CHECK-NEXT:    { nop; nop; s_sw_with_imm r3, sp, 0 }
; CHECK-NEXT:    { nop; nop; s_sw_with_imm r7, sp, 1 }
; CHECK-NEXT:    { d_ldw_with_imm d2, sp, 0; addi32 sp, sp, 8 }
; CHECK-NEXT:    { subi32 sp, sp, 8; nop }
; CHECK-NEXT:    { nop; nop; s_sw_with_imm r4, sp, 0 }
; CHECK-NEXT:    { nop; nop; s_sw_with_imm r12, sp, 1 }
; CHECK-NEXT:    { d_ldw_with_imm d3, sp, 0; addi32 sp, sp, 8 }
; CHECK-NEXT:    { nop; nop; nop }
; CHECK-NEXT:    { add64 d1, d2, d3; nop; nop }
; CHECK-NEXT:    { add64 d0, d0, d1; nop; nop }
; CHECK-NEXT:    { xor32 r0, r0, r0; nop; nop }
; CHECK-NEXT:    { addi32 sp, sp, 8; nop }
; CHECK-NEXT:    { nop; jalr r0, lr, 0; nop }
entry:
  %p0 = getelementptr %Big, ptr %s, i32 0, i32 0
  %p1 = getelementptr %Big, ptr %s, i32 0, i32 1
  %p2 = getelementptr %Big, ptr %s, i32 0, i32 2
  %p3 = getelementptr %Big, ptr %s, i32 0, i32 3
  %v0 = load i64, ptr %p0
  %v1 = load i64, ptr %p1
  %v2 = load i64, ptr %p2
  %v3 = load i64, ptr %p3
  %s01 = add i64 %v0, %v1
  %s23 = add i64 %v2, %v3
  %r = add i64 %s01, %s23
  ret i64 %r
}
