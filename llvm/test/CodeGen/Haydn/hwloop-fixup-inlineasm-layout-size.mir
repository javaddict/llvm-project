# RUN: rm -rf %t && split-file %s %t
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop -run-pass=haydn-fixup-hwloops \
# RUN:   -verify-machineinstrs %t/ok.mir -o - | FileCheck %s
# RUN: not llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=haydn-fixup-hwloops %t/opaque.mir -o - 2>&1 \
# RUN:   | FileCheck %s --check-prefix=REJECT

# Role: MIR — Exact typed INLINEASM layout size for Fixup Following /
# SET→BEGIN distance. getInstSizeInBytes charges one product parcel per
# unbraced public mnemonic, one parcel per braced Format E packet, and 0
# for empty metadata. Opaque executable text is rejected (not MaxInstLength
# × statement count). No compiler BUNDLE crosses INLINEASM.
#
# Use ';' separators (Haydn MCAsmInfo SeparatorString) so MIR stores real
# multi-instruction text — MIR "\n" escapes are not converted to newlines.
#
# Cases:
#   1. three unbraced nops after SET → Following = InterveningCycles=3;
#      Fixup must NOT insert deficit NOP pads.
#   2. empty INLINEASM after SET      → Following = 0; Fixup inserts 3
#      exact-committed Full NOP pads (deficit-only).
#   3. one-stmt INLINEASM + one ADD32 → Following = 2; Fixup inserts 1
#      deficit pad and keeps both size-bearing ops.
#   4. braced `{ nop; nop; nop }` is one parcel → Following = 1; Fixup
#      inserts 1 deficit pad (InterveningCycles=2; conservative would
#      have charged 3 textual nops and inserted none).
#   5. opaque `.word` is fatal at the size query.
#
# REJECT: Haydn: inline asm is not an exact typed Format E layout

#--- ok.mir
--- |
  define dso_local void @three_stmt_inlineasm_following() {
  entry:
    ret void
  }
  define dso_local void @empty_inlineasm_following() {
  entry:
    ret void
  }
  define dso_local void @one_stmt_inlineasm_plus_add() {
  entry:
    ret void
  }
  define dso_local void @braced_packet_inlineasm_following() {
  entry:
    ret void
  }

...
---
name:            three_stmt_inlineasm_following
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r0, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0, implicit-def dead $sfr
    SET_HWLOOP_W 0, %bb.1, %bb.1, 4, implicit-def dead $sfr
    ; Three textual instructions × Full parcel = InterveningCycles.
    INLINEASM &"nop; nop; nop", 1 /* sideeffect attdialect */

  bb.1:
    liveins: $r1, $r0
    successors: %bb.2
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.2:
    liveins: $r15
    RET implicit killed $r15

...
---
name:            empty_inlineasm_following
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r0, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0, implicit-def dead $sfr
    SET_HWLOOP_W 0, %bb.1, %bb.1, 4, implicit-def dead $sfr
    ; Empty barrier: layout size 0 — does not satisfy Following.
    INLINEASM &"", 1 /* sideeffect attdialect */

  bb.1:
    liveins: $r1, $r0
    successors: %bb.2
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.2:
    liveins: $r15
    RET implicit killed $r15

...
---
name:            one_stmt_inlineasm_plus_add
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r0, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0, implicit-def dead $sfr
    SET_HWLOOP_W 0, %bb.1, %bb.1, 4, implicit-def dead $sfr
    INLINEASM &"nop", 1 /* sideeffect attdialect */
    $r2 = ADD32 $r0, $r1, implicit-def dead $sfr

  bb.1:
    liveins: $r1, $r0, $r2
    successors: %bb.2
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.2:
    liveins: $r15
    RET implicit killed $r15

...
---
name:            braced_packet_inlineasm_following
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r0, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0, implicit-def dead $sfr
    SET_HWLOOP_W 0, %bb.1, %bb.1, 4, implicit-def dead $sfr
    ; One Format E packet, not three textual instructions.
    INLINEASM &"{ nop; nop; nop }", 1 /* sideeffect attdialect */

  bb.1:
    liveins: $r1, $r0
    successors: %bb.2
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.2:
    liveins: $r15
    RET implicit killed $r15

...

#--- opaque.mir
--- |
  define dso_local void @opaque_word_inlineasm() {
  entry:
    ret void
  }
...
---
name:            opaque_word_inlineasm
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r0, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0, implicit-def dead $sfr
    SET_HWLOOP_W 0, %bb.1, %bb.1, 4, implicit-def dead $sfr
    INLINEASM &".word 1", 1 /* sideeffect attdialect */

  bb.1:
    liveins: $r1, $r0
    successors: %bb.2
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.2:
    liveins: $r15
    RET implicit killed $r15

...

# ---------------------------------------------------------------------------
# Case 1: three-stmt INLINEASM fills Following — no deficit pads.
# ---------------------------------------------------------------------------
# CHECK-LABEL: name: three_stmt_inlineasm_following
# CHECK: SET_HWLOOP_W
# CHECK-NEXT: INLINEASM &{{.*}}nop{{.*}}nop{{.*}}nop
# CHECK-NOT: {{BUNDLE|NOP}}
# CHECK: bb.1:

# ---------------------------------------------------------------------------
# Case 2: empty INLINEASM charges 0 — InterveningCycles exact-committed Full NOP pads.
# ---------------------------------------------------------------------------
# CHECK-LABEL: name: empty_inlineasm_following
# CHECK: SET_HWLOOP_W
# CHECK: BUNDLE 0
# CHECK: NOP
# CHECK: BUNDLE 0
# CHECK: NOP
# CHECK: INLINEASM &""
# CHECK: bb.1:

# ---------------------------------------------------------------------------
# Case 3: one-stmt INLINEASM + ADD32 → Following=2 meets InterveningCycles=2;
# no deficit pad. Printer may drop quotes on simple asm text (&nop vs &"nop").
# ---------------------------------------------------------------------------
# CHECK-LABEL: name: one_stmt_inlineasm_plus_add
# CHECK: SET_HWLOOP_W
# CHECK: INLINEASM &{{"?}}nop{{"?}}
# CHECK: $r2 = ADD32
# CHECK: bb.1:

# ---------------------------------------------------------------------------
# Case 4: braced packet is one Following parcel — one deficit pad.
# ---------------------------------------------------------------------------
# CHECK-LABEL: name: braced_packet_inlineasm_following
# CHECK: SET_HWLOOP_W
# CHECK: BUNDLE 0
# CHECK: NOP
# CHECK: INLINEASM &{{.*}}nop{{.*}}nop{{.*}}nop
# CHECK: bb.1:
