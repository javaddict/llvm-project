# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postmisched -verify-machineinstrs %s -o - | FileCheck %s
#
# VLIW STRESS TEST: Maximum packing — 3 independent instructions per bundle.
#
# Tests that the packetizer achieves maximum 3-issue packing when instructions
# are fully independent (no register hazards, no memory deps, no slot conflicts
# no GPR port overflow).
#
# Covers:
# 1. Three ALU32 (Slot012_ALU) — all can go to different slots
# 2. ALU32 + two ALU64 (Slot12_ALU) — mixed GPR32/DR64, all independent
# 3. S_LW_WITH_IMM (Slot0_LS) + ALU32 (Slot012_ALU) + ALU64 (Slot12_ALU) — cross-slot
# 4. LD32_S1 (Slot1_LD) + S_LW_WITH_IMM (Slot0_LS) + ALU32 (Slot012_ALU) — dual-load
# 5. DR64-only: three ALU64 (Slot12_ALU) — all DR64, no GPR port concerns
#

--- |
  define void @test1_three_alu32() { ret void }
  define void @test2_mixed_gpr_dr64() { ret void }
  define void @test3_ld_alu32_alu64() { ret void }
  define void @test4_dual_load_alu() { ret void }
  define void @test5_three_dr64() { ret void }
...
---
# ============================================================================
# Test 1: Three independent ALU32 (Slot012_ALU) in one bundle
# ============================================================================
#
# Three ADD32 instructions that read/write completely disjoint GPR32 registers.
# All use Slot012_ALU itinerary, so the DFA can assign them to SLOT0, SLOT1
# SLOT2 respectively. No RAW/WAW hazards (different registers). GPR port count:
# ADD32 r2, r0, r1 -> 2 reads (r0, r1), 1 write (r2)
# ADD32 r3, r4, r5 -> 2 reads (r4, r5), 1 write (r3)
# ADD32 r6, r7, r8 -> 2 reads (r7, r8), 1 write (r6)
# Total: 6 reads, 3 writes. This EXCEEDS 4R2W — so the 3rd instruction
# should NOT be added to the same packet.
#
# Wait — actually, r0 is hardwired zero and its reads are free. But the code
# counts all reads. Let's use registers that keep reads within 4R and writes
# within 2W. Three ADD32 with 2 reads each = 6 reads. That exceeds 4R.
# So we need at most 2 ALU32 GPR instructions per bundle (2*2=4R, 2*1=2W).
# For 3-instruction packing, use instructions with fewer GPR reads.
#
# Use ADDI32 (1 read, 1 write) for three instructions:
# ADDI32 r2, r0, 10 -> 1 read (r0), 1 write (r2)
# ADDI32 r3, r0, 20 -> 1 read (r0), 1 write (r3)
# ADDI32 r4, r0, 30 -> 1 read (r0), 1 write (r4)
# Total: 3 reads, 3 writes. 3 writes exceeds 2W!
#
# For a 3-issue bundle with GPR32 only, we need:
# At most 2 instructions that write GPR32 (2W limit)
# At most 4 GPR32 reads total
# So 3 independent ALU32 ops that each write GPR can only pack 2 at a time.
#
# To get a 3-issue bundle, mix with DR64 ops (DR64 doesn't count toward GPR
# port limits). See test2 for that pattern.
#
# Here, verify 2 ALU32 + 1 more that would exceed GPR writes -> split bundle.
#
name:            test1_three_alu32
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
  - { reg: '$r5', virtual-reg: '' }
  - { reg: '$r7', virtual-reg: '' }
  - { reg: '$r8', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $r4, $r5, $r7, $r8

    ; Two ADD32 fit in one packet: 4 reads (r0,r1,r4,r5), 2 writes (r2,r3).
    ; The third ADD32 would add 2 more reads + 1 write, exceeding 4R2W.
    ; So: first two bundle, third is separate.

    ; CHECK-LABEL: name: test1_three_alu32
    ; CHECK: liveins: $r0, $r1, $r4, $r5, $r7, $r8
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE 1, implicit-def $r2, implicit-def dead $sfr, implicit-def $r3, implicit $r0, implicit killed $r1, implicit killed $r4, implicit killed $r5 {
    ; CHECK-NEXT:   $r2 = ADD32_P32_ALU0 $r0, killed $r1, implicit-def dead $sfr
    ; CHECK-NEXT:   $r3 = ADD32_P31_ALU1 killed $r4, killed $r5, implicit-def dead $sfr
    ; CHECK-NEXT: }
    ; CHECK-NEXT: $r6 = ADD32_P32_ALU0 killed $r7, killed $r8, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY killed $r2
    ; CHECK-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    $r3 = ADD32 $r4, $r5, implicit-def dead $sfr
    $r6 = ADD32 $r7, $r8, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 2: Mixed GPR32 + DR64 — full 3-issue bundle
# ============================================================================
#
# ADD32 (GPR32, Slot012_ALU) + ADD64 (DR64, Slot12_ALU) + SUB64 (DR64, Slot12_ALU).
# ADD32 writes $r2, reads $r0, $r1 -> 2 GPR reads, 1 GPR write.
# ADD64 writes $d0, reads $d2, $d3 -> 0 GPR reads, 0 GPR writes (DR64 ports).
# SUB64 writes $d4, reads $d5, $d6 -> 0 GPR reads, 0 GPR writes.
# Total: 2 GPR reads, 1 GPR write. Well within 4R2W.
# All independent registers -> no RAW/WAW.
# DFA: ADD32 -> SLOT0, ADD64 -> SLOT1, SUB64 -> SLOT2.
#
name:            test2_mixed_gpr_dr64
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$d2', virtual-reg: '' }
  - { reg: '$d3', virtual-reg: '' }
  - { reg: '$d5', virtual-reg: '' }
  - { reg: '$d6', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $d2, $d3, $d5, $d6

    ; Post-: the GPR-port-FuncUnits model is reverted; the DFA uses
    ; the slot-only itinerary. DR64-only ops in Slot12_ALU are NOT charged
    ; against GPR ports, so all three (ADD32 + ADD64 + SUB64) pack into one
    ; bundle (2R1W GPR from ADD32 + two DR64 pairs — within the 4R2W GPR gate
    ; enforced by countGPRPorts).

    ; CHECK-LABEL: name: test2_mixed_gpr_dr64
    ; CHECK: liveins: $r0, $r1, $d2, $d3, $d5, $d6
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE 1, implicit-def $r2, implicit-def dead $sfr, implicit-def $d0, implicit-def $d4, implicit $r0, implicit killed $r1, implicit killed $d2, implicit killed $d3, implicit killed $d5, implicit killed $d6 {
    ; CHECK-NEXT:   $r2 = ADD32_P32_ALU0 $r0, killed $r1, implicit-def dead $sfr
    ; CHECK-NEXT:   $d0 = ADD64_P31_ALU1 killed $d2, killed $d3, implicit-def dead $sfr
    ; CHECK-NEXT:   $d4 = SUB64_P30_ALU2 killed $d5, killed $d6, implicit-def dead $sfr
    ; CHECK-NEXT: }
    ; CHECK-NEXT: $r0 = COPY killed $r2
    ; CHECK-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    $d0 = ADD64 $d2, $d3, implicit-def dead $sfr
    $d4 = SUB64 $d5, $d6, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 3: S_LW_WITH_IMM (Slot0_LS) + ALU32 (Slot012_ALU) + ALU64 (Slot12_ALU)
# ============================================================================
#
# S_LW_WITH_IMM uses Slot0_LS -> SLOT0.
# ADD32 uses Slot012_ALU -> SLOT1 (since SLOT0 taken).
# ADD64 uses Slot12_ALU -> SLOT2 (since SLOT1 taken).
# No register dependencies (all different registers).
# GPR ports: S_LW_WITH_IMM reads r0, writes r2 (1R, 1W).
# ADD32 reads r4,r5, writes r3 (2R, 1W).
# ADD64 reads d0,d1, writes d2 (0 GPR R, 0 GPR W).
# Total: 3 GPR reads, 2 GPR writes. Within 4R2W.
#
name:            test3_ld_alu32_alu64
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
  - { reg: '$r5', virtual-reg: '' }
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$d1', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r4, $r5, $d0, $d1

    ; Post-: the GPR-port-FuncUnits model is reverted; the DFA uses
    ; the slot-only itinerary. DR64-only ops in Slot12_ALU are NOT charged
    ; against GPR ports, so S_LW_WITH_IMM + ADD32 + ADD64 all pack into one bundle
    ; (2 GPR writes from S_LW_WITH_IMM/ADD32 + 0 from ADD64 — within the 4R2W GPR gate
    ; enforced by countGPRPorts).

    ; CHECK-LABEL: name: test3_ld_alu32_alu64
    ; CHECK: liveins: $r0, $r4, $r5, $d0, $d1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE 1, implicit-def $r2, implicit-def dead $sfr, implicit-def $r3, implicit-def $d2, implicit $r0, implicit killed $r4, implicit killed $r5, implicit killed $d0, implicit killed $d1 {
    ; CHECK-NEXT:   $r2 = S_LW_WITH_IMM_P32_LOAD1 $r0, 0, implicit-def dead $sfr
    ; CHECK-NEXT:   $r3 = ADD32_P31_ALU0 killed $r4, killed $r5, implicit-def dead $sfr
    ; CHECK-NEXT:   $d2 = ADD64_P30_ALU2 killed $d0, killed $d1, implicit-def dead $sfr
    ; CHECK-NEXT: }
    ; CHECK-NEXT: $r0 = COPY killed $r2
    ; CHECK-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = S_LW_WITH_IMM $r0, 0, implicit-def dead $sfr
    $r3 = ADD32 $r4, $r5, implicit-def dead $sfr
    $d2 = ADD64 $d0, $d1, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 4: LD32_S1 (Slot1_LD) + S_LW_WITH_IMM (Slot0_LS) + ALU32 (Slot012_ALU)
# ============================================================================
#
# S_LW_WITH_IMM uses Slot0_LS -> SLOT0 (only slot for Slot0 loads).
# LD32_S1 uses Slot1_LD -> SLOT1 (only slot for Slot1 loads).
# ADD32 uses Slot012_ALU -> SLOT2 (since SLOT0 and SLOT1 taken).
# All different registers, no hazards.
# GPR ports: S_LW_WITH_IMM 1R(r0), 1W(r2). LD32_S1 1R(r4), 1W(r3). ADD32 2R(r5,r6), 1W(r7).
# Total: 4R, 3W. 3 writes exceeds 2W -> CANNOT pack all three.
#
# Expected: S_LW_WITH_IMM + LD32_S1 in one bundle (2R, 2W), ADD32 in separate bundle.
#
name:            test4_dual_load_alu
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
  - { reg: '$r5', virtual-reg: '' }
  - { reg: '$r6', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r4, $r5, $r6

    ; Two logical S_LW_WITH_IMM pack (Slot01_LD); Flex S0/S1 materialize at encode only.
    ; ADD32 separate (2W budget).

    ; CHECK-LABEL: name: test4_dual_load_alu
    ; CHECK: liveins: $r0, $r4, $r5, $r6
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE 1, implicit-def $r2, implicit-def dead $sfr, implicit-def $r3, implicit $r0, implicit killed $r4 {
    ; CHECK-NEXT:   $r2 = S_LW_WITH_IMM_P32_LOAD1 $r0, 0, implicit-def dead $sfr
    ; CHECK-NEXT:   $r3 = S_LW_WITH_IMM_P30_LOADSTORE0 killed $r4, 0, implicit-def dead $sfr
    ; CHECK-NEXT: }
    ; CHECK-NEXT: $r7 = ADD32_P32_ALU0 killed $r5, killed $r6, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY killed $r2
    ; CHECK-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = S_LW_WITH_IMM $r0, 0, implicit-def dead $sfr
    $r3 = S_LW_WITH_IMM $r4, 0, implicit-def dead $sfr
    $r7 = ADD32 $r5, $r6, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 5: Three DR64-only ALU64 operations — full 3-issue bundle
# ============================================================================
#
# ADD64, SUB64, OR64 all use Slot12_ALU (SLOT1, SLOT2). But wait — all three
# need SLOT1 or SLOT2, and there are only 2 slots available (SLOT1 and SLOT2).
# The DFA model: Slot12_ALU maps to [SLOT1, SLOT2]. The DFA automaton assigns
# two of these to SLOT1 and SLOT2. A third Slot12_ALU instruction would have
# no available FU. So max 2 DR64 ALU ops per bundle, even though DR64 has no
# GPR port conflict.
#
# Expected: first two ADD64/SUB64 bundle, third OR64 is separate.
#
name:            test5_three_dr64
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$d1', virtual-reg: '' }
  - { reg: '$d2', virtual-reg: '' }
  - { reg: '$d3', virtual-reg: '' }
  - { reg: '$d4', virtual-reg: '' }
  - { reg: '$d5', virtual-reg: '' }
  - { reg: '$d6', virtual-reg: '' }
  - { reg: '$d8', virtual-reg: '' }
  - { reg: '$d9', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $d0, $d1, $d2, $d3, $d4, $d5, $d6, $d8, $d9

    ; Two DR64 ALU64 ops can bundle (SLOT1 + SLOT2).
    ; Third has no available slot in the DFA.

    ; CHECK-LABEL: name: test5_three_dr64
    ; CHECK: liveins: $r0, $d0, $d1, $d2, $d3, $d4, $d5, $d6, $d8, $d9
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE 1, implicit-def $d10, implicit-def dead $sfr, implicit-def $d11, implicit-def $d12, implicit killed $d0, implicit killed $d1, implicit killed $d2, implicit killed $d3, implicit killed $d4, implicit killed $d5 {
    ; CHECK-NEXT:   $d10 = ADD64_P32_ALU0 killed $d0, killed $d1, implicit-def dead $sfr
    ; CHECK-NEXT:   $d11 = SUB64_P31_ALU1 killed $d2, killed $d3, implicit-def dead $sfr
    ; CHECK-NEXT:   $d12 = OR64_P30_ALU2 killed $d4, killed $d5, implicit-def dead $sfr
    ; CHECK-NEXT: }
    ; CHECK-NEXT: $r0 = COPY $r0
    ; CHECK-NEXT: $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $d10 = ADD64 $d0, $d1, implicit-def dead $sfr
    $d11 = SUB64 $d2, $d3, implicit-def dead $sfr
    $d12 = OR64 $d4, $d5, implicit-def dead $sfr

    $r0 = COPY $r0
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
