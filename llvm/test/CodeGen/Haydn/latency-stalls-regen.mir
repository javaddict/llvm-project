# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-latency-stalls \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-latency-stalls \
# RUN:   -run-pass=haydn-latency-stalls -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s --check-prefix=TWICE
#
# Role: dest-window stalls regenerate rather than accumulate. A second
# in-memory invocation (two -run-pass) strips this pass's prior parcels
# (NoMerge pin) and re-inserts the current need — one stall between a
# Data_Latency=2 load and its user, not two. Inserted stalls charge
# getInstSizeInBytes, carry no MMOs, and have no extra liveness operands.

---
name:            load_then_use
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r15
    ; CHECK-LABEL: name: load_then_use
    ; CHECK: S_LW_WITH_IMM
    ; CHECK-NEXT: nomerge NOP
    ; CHECK-NEXT: ADD32
    ; CHECK-NOT: NOP
    ; TWICE-LABEL: name: load_then_use
    ; TWICE: S_LW_WITH_IMM
    ; TWICE-NEXT: nomerge NOP
    ; TWICE-NEXT: ADD32
    ; TWICE-NOT: NOP
    $r2 = LD32 $r1, 0 :: (load (s32))
    $r3 = ADD32 $r2, $r2, implicit-def dead $sfr
    RET implicit $r15, implicit $r3
...
