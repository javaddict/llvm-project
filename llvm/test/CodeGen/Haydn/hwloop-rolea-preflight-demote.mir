# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop -run-pass=haydn-hwloops \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# Role: MIR — complete retained-state Role-A expand seats (setup pad + body floor).
# Incomplete seats live in hwloop-rolea-preflight-reject.mir (fatal pre-mutation).

--- |
  define dso_local void @expand_geometry(ptr %p) {
  entry:
    br label %body
  body:
    %v = load i32, ptr %p
    store i32 %v, ptr %p
    br label %exit
  exit:
    ret void
  }

  define dso_local void @expand_short_body_pad(ptr %p) {
  entry:
    br label %body
  body:
    store i32 0, ptr %p
    br label %exit
  exit:
    ret void
  }

...
---
name:            expand_geometry
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r15
    successors: %bb.1
    $r0 = frame-setup XOR32 $r0, $r0
    $r2 = ADDI32_W $r0, 8
    LoopStart $r2, 0
  bb.1.body:
    successors: %bb.1, %bb.2
    liveins: $r1, $r15
    $r3 = LD32 $r1, 0
    $r3 = ADD32 $r3, $r3
    ST32 $r3, $r1, 0
    PseudoLoopEnd %bb.1
  bb.2.exit:
    liveins: $r15
    $r0 = JALR_W $r15, 0, implicit $r15

# CHECK-LABEL: name: expand_geometry
# CHECK: SET_HWLOOP_F2_W 1, %bb.1, %bb.1,
# CHECK-NEXT: NOP
# CHECK-NEXT: NOP
# CHECK-NOT: LoopStart
# CHECK: PseudoLoopEnd %bb.1
# CHECK: JALR_W

---
name:            expand_short_body_pad
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r15
    successors: %bb.1
    $r0 = frame-setup XOR32 $r0, $r0
    $r2 = ADDI32_W $r0, 4
    LoopStart $r2, 0
  bb.1.body:
    successors: %bb.1, %bb.2
    liveins: $r1, $r15
    ST32 $r0, $r1, 0
    PseudoLoopEnd %bb.1
  bb.2.exit:
    liveins: $r15
    $r0 = JALR_W $r15, 0, implicit $r15

# CHECK-LABEL: name: expand_short_body_pad
# CHECK: SET_HWLOOP_F2_W 1, %bb.1, %bb.1,
# CHECK-NEXT: NOP
# CHECK-NEXT: NOP
# CHECK-NOT: LoopStart
# CHECK: ST32
# CHECK: NOP
# CHECK: NOP
# CHECK: PseudoLoopEnd %bb.1
# CHECK: JALR_W
