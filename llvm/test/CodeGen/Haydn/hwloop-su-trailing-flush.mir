# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=postmisched -verify-machineinstrs %s -o - | FileCheck %s

# Role: MIR — HWLOOP-SU trailing-cycle flush: SET is a real region SU.

# HWLOOP-SU trailing-cycle flush: SET is a real region SU. ZOLSetupExitLatency
# raises ExitSU artificial latency by SetupIssueDistance (3). leaveRegion
# flushes empty cycles to ExitSU.TopReadyCycle so residual following cycles
# become normal idle NOP bundles (not Fixup-only pads).
#
# Input preheader has SET + independent ALU and *no* following pads. After
# postmisched, the region must still host InterveningCycles (2) size-bearing
# parcels after the SET cycle (coissued SET+ALU counts as the SET cycle).

--- |
  define void @trailing_flush() { ret void }
...
---
name:            trailing_flush
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
body:             |
  ; CHECK-LABEL: name: trailing_flush
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r1, $r2, $r15
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SET_HWLOOP_W_S0 0, %bb.1, %bb.1, 2, implicit-def dead $sfr
  ; CHECK-NEXT:   $r3 = ADD32_E{{[23]}}_E{{[0-2]}}_{{.*}} killed $r1, killed $r2, implicit-def dead $sfr
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $r3, $r15
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r1 = COPY killed $r3
  ; CHECK-NEXT:   NOP_S0
  ; CHECK-NEXT:   NOP_S0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $r1, $r15
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r1 = COPY killed $r1
  ; CHECK-NEXT:   RET implicit $r15, implicit killed $r1
  bb.0:
    liveins: $r1, $r2, $r15
    successors: %bb.1

    ; SET + independent ALU, no formation pads. ExitSU latency forces
    ; InterveningCycles following empty cycles after the SET issue cycle.
    $r3 = ADD32 $r1, $r2, implicit-def dead $sfr
    SET_HWLOOP_W 0, %bb.1, %bb.1, 2, implicit-def dead $sfr

  bb.1:
    liveins: $r3, $r15
    successors: %bb.2
    $r1 = COPY $r3
    NOP
    NOP

  bb.2:
    liveins: $r1, $r15
    $r1 = COPY $r1
    RET implicit killed $r15, implicit $r1

# SET coissues with independent ADD (member setDesc forms OK). Order inside
# the cycle is format-member order — match both as DAG.
# InterveningCycles following idle NOPs from leaveRegion ExitSU/TopCurr
# trailing flush (SetupIssueDistance edge → following empties).
