---
# select (a <u b), b, a -> umax(a, b) [operand swap]
name:            select_ult_umax
legalized:       true
# CHECK-LABEL: name: select_ult_umax
# CHECK: %{{[0-9]+}}:_(s32) = G_UMAX
# CHECK-NOT: G_SELECT
body:             |
  bb.0.entry:
    liveins: $r0, $r1
    %0:_(s32) = COPY $r0
    %1:_(s32) = COPY $r1
