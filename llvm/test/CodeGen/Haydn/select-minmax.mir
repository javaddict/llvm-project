    RET implicit $r0, implicit $r15
...

---
# select (a >u b), b, a -> umin(a, b) [operand swap]
name:            select_ugt_umin
legalized:       true
# CHECK-LABEL: name: select_ugt_umin
# CHECK: %{{[0-9]+}}:_(s32) = G_UMIN
# CHECK-NOT: G_SELECT
body:             |
