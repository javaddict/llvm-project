    %3:_(s32) = G_SELECT %2, %1, %0
    $r0 = COPY %3(s32)
    RET implicit $r0, implicit $r15
...

---
# Negative test: select with different operands (false val %2 != %1) — should NOT combine.
name:            select_no_match
legalized:       true
# CHECK-LABEL: name: select_no_match
# CHECK: G_SELECT
# CHECK-NOT: G_SMAX
body:             |
  bb.0.entry:
    liveins: $r0, $r1, $r2
    %0:_(s32) = COPY $r0
    %1:_(s32) = COPY $r1
    %2:_(s32) = COPY $r2
    %3:_(s1) = G_ICMP intpred(sgt), %0, %1
    %4:_(s32) = G_SELECT %3, %0, %2
    $r0 = COPY %4(s32)
    RET implicit $r0, implicit $r15
...

---
# Negative test: sge predicate — should NOT combine (only sgt/slt/ugt/ult).
name:            select_sge_no_combine
legalized:       true
# CHECK-LABEL: name: select_sge_no_combine
# CHECK: G_SELECT
# CHECK-NOT: G_SMAX
body:             |
  bb.0.entry:
    liveins: $r0, $r1
    %0:_(s32) = COPY $r0
    %1:_(s32) = COPY $r1
    %2:_(s1) = G_ICMP intpred(sge), %0, %1
    %3:_(s32) = G_SELECT %2, %0, %1
    $r0 = COPY %3(s32)
    RET implicit $r0, implicit $r15
...
