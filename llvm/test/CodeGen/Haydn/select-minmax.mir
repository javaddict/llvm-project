    %0:_(s32) = COPY $r0
    %1:_(s32) = COPY $r1
    %2:_(s1) = G_ICMP intpred(slt), %0, %1
    %3:_(s32) = G_SELECT %2, %0, %1
    $r0 = COPY %3(s32)
    RET implicit $r0, implicit $r15
...

---
# select (a < b), b, a -> smax(a, b) [operand swap]
name:            select_slt_smax
legalized:       true
# CHECK-LABEL: name: select_slt_smax
# CHECK: %{{[0-9]+}}:_(s32) = G_SMAX
# CHECK-NOT: G_SELECT
body:             |
  bb.0.entry:
    liveins: $r0, $r1
    %0:_(s32) = COPY $r0
    %1:_(s32) = COPY $r1
    %2:_(s1) = G_ICMP intpred(slt), %0, %1
    %3:_(s32) = G_SELECT %2, %1, %0
    $r0 = COPY %3(s32)
    RET implicit $r0, implicit $r15
...

---
# select (a >u b), a, b -> umax(a, b)
name:            select_ugt_umax
legalized:       true
# CHECK-LABEL: name: select_ugt_umax
# CHECK: %{{[0-9]+}}:_(s32) = G_UMAX
