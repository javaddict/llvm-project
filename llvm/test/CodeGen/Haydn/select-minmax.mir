...

---
# select (a <u b), a, b -> umin(a, b)
name:            select_ult_umin
legalized:       true
# CHECK-LABEL: name: select_ult_umin
# CHECK: %{{[0-9]+}}:_(s32) = G_UMIN
# CHECK-NOT: G_SELECT
body:             |
  bb.0.entry:
    liveins: $r0, $r1
    %0:_(s32) = COPY $r0
    %1:_(s32) = COPY $r1
    %2:_(s1) = G_ICMP intpred(ult), %0, %1
    %3:_(s32) = G_SELECT %2, %0, %1
