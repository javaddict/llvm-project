name:            d164_vaarg22_set_bundle_coissue
tracksRegLiveness: true
noVRegs:         true
body:             |
  ; SET-bundle coissue: r3=sp+off is a member of the SET packet
  ; (glueDefToUse places SET last). skipSetupOrMeta on the BUNDLE header
  ; without instrs() hides the address scratch.
  bb.0.entry:
    liveins: $r1, $r2, $r4, $r5, $r6, $r7, $r8, $r9, $r10, $r11, $r12, $r14, $r15
    successors: %bb.1
    BUNDLE 0, 0, implicit-def $r3, implicit-def dead $sfr, implicit $r13, implicit $r2 {
      $r3 = ADDI32_W $r13, 16
      SET_HWLOOP_F2_W 0, %bb.2, %bb.2, $r2, implicit-def dead $sfr
    }
    $r7 = ADDI32_W $r13, 8
    NOP
    NOP
    NOP

  bb.1.spacer:
    liveins: $r1, $r2, $r3, $r4, $r5, $r6, $r8, $r9, $r10, $r11, $r12, $r14
    successors: %bb.2
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP

  bb.2.body:
    liveins: $r1, $r2, $r3, $r4, $r5, $r6, $r8, $r9, $r10, $r11, $r12, $r14
    successors: %bb.3
    ST32 $r2, $r1, 0
    $r7 = XOR32 $r1, $r2
    ST32 $r7, $r1, 2
    $r4 = XOR32 $r4, $r4
    $r5 = XOR32 $r5, $r5
    $r6 = XOR32 $r6, $r6
    $r8 = XOR32 $r8, $r8
    $r9 = XOR32 $r9, $r9
    $r10 = XOR32 $r10, $r10
    $r11 = XOR32 $r11, $r11
    $r12 = XOR32 $r12, $r12
    $r14 = XOR32 $r14, $r14
    NOP
    NOP
    NOP

  bb.3.exit:
    liveins: $r1, $r3, $r15
    ST32 $r3, $r1, 0
    RET implicit killed $r15

