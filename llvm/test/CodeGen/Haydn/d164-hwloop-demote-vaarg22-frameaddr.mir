  ; into exit). Prefer ($r2) is still READ in the body.
  bb.2.body:
    liveins: $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8, $r9, $r10, $r11, $r12
    successors: %bb.3
    $r14 = MOVE32 $r4
