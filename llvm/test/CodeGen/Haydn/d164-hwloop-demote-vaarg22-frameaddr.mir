name:            d164_vaarg22_o2_main
tracksRegLiveness: true
noVRegs:         true
body:             |
  ; Real O2 @main fill-loop occupancy-miss: SET Prefer=$r3 is a body
  ; read (ST of the trip). Unmentioned FA cluster r4–r12 (SP+off dests
  ; Exit reads) plus tail-imm r14=ADDI r0,22. r3 is PreferHasBodyUse,
  ; not FA (no r3=sp+off). Mention r1 (address) and r2 (pointer) so
  ; pass-2 cannot steal them. Do not mention r4–r12/r14 and do not XOR
  ; r7 (XOR / PEI dest r7 hid the miss as lit-green LatchScr=$r7).
  ; Occupancy fatal, never MOVE32/COPY/SUBI/LD32/S_LW/BNEZ of Prefer /
  ; r3 / r4–r12 / r14, never LatchScr=$r7/Prefer/r3/r14.
  bb.0.entry:
    liveins: $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8, $r9, $r10, $r11, $r12, $r14, $r15
    successors: %bb.1

    SET_HWLOOP_F2_W 0, %bb.2, %bb.2, $r3, implicit-def dead $sfr
    $r4 = ADDI32_W $r13, 20
    $r5 = ADDI32_W $r13, 24
    $r6 = ADDI32_W $r13, 28
    $r7 = ADDI32_W $r13, 32
    $r8 = ADDI32_W $r13, 36
    $r9 = ADDI32_W $r13, 40
    $r10 = ADDI32_W $r13, 44
    $r11 = ADDI32_W $r13, 48
    $r12 = ADDI32_W $r13, 52
    $r14 = ADDI32_W $r0, 22
    NOP
    NOP
    NOP

  bb.1.spacer:
    liveins: $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8, $r9, $r10, $r11, $r12, $r14
    successors: %bb.2
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP

  ; Prefer ($r3) is still READ in the body. Mention r2 so it is not a
  ; pass-2 steal. Do not mention r4–r12 or r14. Latch live-ins keep the
  ; FA cluster live-through so pass-1a cannot take a dead PEI dest.
  bb.2.body:
    liveins: $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8, $r9, $r10, $r11, $r12, $r14
    successors: %bb.3
    ST32 $r3, $r1, 0
    $r2 = XOR32 $r2, $r2
    NOP
    NOP
    NOP

  bb.3.exit:
    liveins: $r1, $r4, $r5, $r6, $r7, $r8, $r9, $r10, $r11, $r12, $r14, $r15
    ST32 $r4, $r1, 1
    ST32 $r5, $r1, 2
    ST32 $r6, $r1, 3
    ST32 $r7, $r1, 4
    ST32 $r8, $r1, 5
    ST32 $r9, $r1, 6
    ST32 $r10, $r1, 7
    ST32 $r11, $r1, 8
    ST32 $r12, $r1, 9
    ST32 $r14, $r1, 10
    RET implicit killed $r15


