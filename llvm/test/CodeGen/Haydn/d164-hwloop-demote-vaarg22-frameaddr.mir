name:            d164_vaarg22_tailimm_r14
tracksRegLiveness: true
noVRegs:         true
body:             |
  ; FA r3=sp+off plus live-into-exit tail-imm r14=ADDI r0,imm after SET.
  ; r4 is mentioned so pass-2 would steal r14 (last in GPR32NoSPNoLR)
  ; after skipping r3. Skip r14 too; occupancy miss fatals rather than
  ; MOVE32/SUBI/LD32/BNEZ r14 or LatchScr=Prefer.
  bb.0.entry:
    liveins: $r1, $r2, $r4, $r5, $r6, $r7, $r8, $r9, $r10, $r11, $r12, $r14, $r15
    successors: %bb.1

    SET_HWLOOP_F2_W 0, %bb.2, %bb.2, $r2, implicit-def dead $sfr
    $r3 = ADDI32_W $r13, 16
    $r14 = ADDI32_W $r0, 2
    NOP
    NOP
    NOP

  bb.1.spacer:
    liveins: $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8, $r9, $r10, $r11, $r12, $r14
    successors: %bb.2
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP

  ; Mention r4 so it is not a pass-2 steal. Do not mention r14: it is
  ; the live-into-exit tail-imm. Prefer ($r2) is still READ in the body.
  bb.2.body:
    liveins: $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8, $r9, $r10, $r11, $r12, $r14
    successors: %bb.3
    ST32 $r2, $r1, 0
    $r4 = XOR32 $r4, $r4
    $r5 = XOR32 $r5, $r5
    $r6 = XOR32 $r6, $r6
    $r7 = XOR32 $r7, $r7
    $r8 = XOR32 $r8, $r8
    $r9 = XOR32 $r9, $r9
    $r10 = XOR32 $r10, $r10
    $r11 = XOR32 $r11, $r11
    $r12 = XOR32 $r12, $r12
    NOP
    NOP
    NOP

  bb.3.exit:
    liveins: $r1, $r3, $r14, $r15
    ST32 $r3, $r1, 0
    ST32 $r14, $r1, 1
    RET implicit killed $r15

