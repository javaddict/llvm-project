# O2MAIN-NOT: $r3 = SUBI32
# O2MAIN-NOT: $r3 = LD32
# O2MAIN-NOT: $r3 = S_LW
# O2MAIN-NOT: BNEZ{{.*}}$r3
# O2MAIN-NOT: $r14 = S_LW
# O2MAIN-NOT: $r14 = SUBI32
# O2MAIN-NOT: $r14 = LD32
# O2MAIN-NOT: BNEZ{{.*}}$r14
# O2MAIN: $r0 = S_LW_WITH_IMM{{.*}}$r13
# O2MAIN: $r0 = SUBI32{{.*}}$r0, 1
# O2MAIN: S_SW_WITH_IMM{{.*}}$r0, $r13
# O2MAIN: BNEZ{{.*}}$r0
# O2MAIN-NOT: $r3 = SUBI32
# O2MAIN-NOT: $r3 = LD32
# O2MAIN-NOT: $r7 = SUBI32
# O2MAIN-NOT: $r{{[2]|[4-9]|1[0-2]}} = SUBI32
# O2MAIN-NOT: $r14 = SUBI32
# O2MAIN-NOT: demote latch scratch = Prefer

# O2MAIN-DBG: demote Prefer {{.*}}$r3{{.*}}has non-countdown body use
# O2MAIN-DBG: demote skip LatchScr {{.*}}$r3{{.*}}non-countdown body use
# O2MAIN-DBG: demote skip LatchScr {{.*}}$r4{{.*}}preheader-tail frame address
# O2MAIN-DBG: demote skip LatchScr {{.*}}$r5{{.*}}preheader-tail frame address
# O2MAIN-DBG: demote skip LatchScr {{.*}}$r6{{.*}}preheader-tail frame address
# O2MAIN-DBG: demote skip LatchScr {{.*}}$r7{{.*}}preheader-tail frame address
# O2MAIN-DBG: demote skip LatchScr {{.*}}$r8{{.*}}preheader-tail frame address
# O2MAIN-DBG: demote skip LatchScr {{.*}}$r9{{.*}}preheader-tail frame address
# O2MAIN-DBG: demote skip LatchScr {{.*}}$r10{{.*}}preheader-tail frame address
# O2MAIN-DBG: demote skip LatchScr {{.*}}$r11{{.*}}preheader-tail frame address
# O2MAIN-DBG: demote skip LatchScr {{.*}}$r12{{.*}}preheader-tail frame address
# O2MAIN-DBG-NOT: live-into-exit tail-imm
# O2MAIN-DBG-NOT: LatchScr=$r7
# O2MAIN-DBG-NOT: LatchScr=$r3
# O2MAIN-DBG-NOT: LatchScr=$r14
# O2MAIN-DBG-NOT: demote latch scratch = Prefer
# O2MAIN-DBG: occupancy miss{{.*}}last-resort LatchScr=R0
# O2MAIN-DBG: demote skip overlay of {{.*}}$r0
# O2MAIN-DBG-NOT: demote overlay save
# O2MAIN-DBG-NOT: demote latch scratch = Prefer
# O2MAIN-DBG-NOT: LatchScr=$r7
# O2MAIN-DBG-NOT: LatchScr=$r3
# O2MAIN-DBG-NOT: LatchScr=$r14
# O2MAIN-DBG-NOT: LLVM ERROR

#--- ok.mir
--- |
  define dso_local void @d164_vaarg22_frameaddr(ptr nocapture %out, i32 %trip) {
  entry:
    br label %spacer
  spacer:
    br label %body
  body:
    store i32 %trip, ptr %out, align 4
    br label %exit
  exit:
    ret void
  }
...
---
name:            d164_vaarg22_frameaddr
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r2, $r4, $r5, $r6, $r7, $r8, $r9, $r10, $r11, $r12, $r14, $r15
    successors: %bb.1

    SET_HWLOOP_F2_W 0, %bb.2, %bb.2, $r2, implicit-def dead $sfr
    ; va-arg-22: r3 = sp+off after SET (SET is not a scheduling boundary).
    ; Unmentioned in the loop; live-through to exit. Pass-2 would steal it
    ; as LatchScr without the frame-address re-pick.
    $r3 = ADDI32_W $r13, 16
    ; PEI-like SP+off dest (bqriir r7): mentioned in the body, dead at
    ; latch. Excluding mentioned FA exhausts pass-1a.
    $r7 = ADDI32_W $r13, 8
    NOP
    NOP
    NOP

  ; Spacer: 20× NOP forces StartOff past uimm6 — demote-first.
  bb.1.spacer:
    liveins: $r1, $r2, $r3, $r4, $r5, $r6, $r8, $r9, $r10, $r11, $r12, $r14
    successors: %bb.2
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP

  ; Every PostRAScratchPriority / pickCounterReg GPR except r3 is
  ; mentioned. r3 stays unmentioned so pickCounterReg cannot copy the
  ; trip into it (tail frame-address + live-after); stack-counter runs.
  ; r4 is mentioned so pass-2 cannot steal it. r7 is a body temp dead at
  ; latch (not a header/exit live-in) — the pass-1a LatchScr.
  bb.2.body:
    liveins: $r1, $r2, $r3, $r4, $r5, $r6, $r8, $r9, $r10, $r11, $r12, $r14
    successors: %bb.3
    ST32 $r2, $r1, 0
    $r7 = XOR32 $r1, $r2
    ST32 $r7, $r1, 2
    $r4 = XOR32 $r4, $r4
    $r5 = XOR32 $r5, $r5
    $r6 = XOR32 $r6, $r6
    $r8 = XOR32 $r8, $r8
    $r9 = XOR32 $r9, $r9
    $r10 = XOR32 $r10, $r10
    $r11 = XOR32 $r11, $r11
    $r12 = XOR32 $r12, $r12
    $r14 = XOR32 $r14, $r14
    NOP
    NOP
    NOP

  ; r3 is the va-arg cursor. r7 is the pass-1a dead temp, not live here.
  bb.3.exit:
    liveins: $r1, $r3, $r15
    ST32 $r3, $r1, 0
    RET implicit killed $r15

