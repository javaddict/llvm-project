name:            d164_vaarg22_pred_livethrough
tracksRegLiveness: true
noVRegs:         true
body:             |
  ; Pred live-through: r3=sp+off is defined in the predecessor, live-in of
  ; the SET block, and never redefined there. A walker that only scans the
  ; post-SET tail misses this and steals LatchScr=$r3.
  bb.0.entry:
    liveins: $r1, $r2, $r4, $r5, $r6, $r7, $r8, $r9, $r10, $r11, $r12, $r14, $r15
    successors: %bb.1
    $r3 = ADDI32_W $r13, 16
    NOP

  bb.1.preheader:
    liveins: $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8, $r9, $r10, $r11, $r12, $r14, $r15
    successors: %bb.2
    SET_HWLOOP_F2_W 0, %bb.3, %bb.3, $r2, implicit-def dead $sfr
    $r7 = ADDI32_W $r13, 8
    NOP
    NOP
    NOP

  bb.2.spacer:
    liveins: $r1, $r2, $r3, $r4, $r5, $r6, $r8, $r9, $r10, $r11, $r12, $r14
    successors: %bb.3
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP

  bb.3.body:
    liveins: $r1, $r2, $r3, $r4, $r5, $r6, $r8, $r9, $r10, $r11, $r12, $r14
    successors: %bb.4
    ST32 $r2, $r1, 0
    $r7 = XOR32 $r1, $r2
    ST32 $r7, $r1, 2
    $r4 = XOR32 $r4, $r4
    $r5 = XOR32 $r5, $r5
    $r6 = XOR32 $r6, $r6
    $r8 = XOR32 $r8, $r8
    $r9 = XOR32 $r9, $r9
    $r10 = XOR32 $r10, $r10
    $r11 = XOR32 $r11, $r11
    $r12 = XOR32 $r12, $r12
    $r14 = XOR32 $r14, $r14
    NOP
    NOP
    NOP

  bb.4.exit:
    liveins: $r1, $r3, $r15
    ST32 $r3, $r1, 0
    RET implicit killed $r15

