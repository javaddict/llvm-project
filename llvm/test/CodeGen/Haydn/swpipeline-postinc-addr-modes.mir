# RUN: llc -mtriple=haydn-unknown-elf -mattr=-hwloop -global-isel-abort=1 \
# RUN:   -run-pass=pipeliner -debug-only=pipeliner -verify-machineinstrs %s -o - 2>&1 \
# RUN:   | FileCheck %s

# Role: MIR — SMS must ACCEPT fused pre/post-inc/dec load+store addressing modes as a single base-updating memory op (TII isPostIncrement / getIncrementValue.

# SMS must ACCEPT fused pre/post-inc/dec load+store addressing modes as a
# single base-updating memory op (TII isPostIncrement / getIncrementValue /
# getBaseAndOffsetPosition / getMemOperandsWithOffsetWidth).
#
# Pre-RA product MIR is normally LD+ADDI; these functions inject the fused
# forms so MachinePipeliner exercises the Haydn hooks. Post-dec = same opcode
# with a negative scaled imm.
#
# Success contract: all 7 fused-addressing kernels are analyzable and get a
# schedule attempt (debug: Schedule Found?). Pipeliner no longer prints
# "********** Start: <fn>" labels — count schedule attempts instead.
#
# If this regresses: HaydnInstrInfo addressing-mode hooks dropped a form, or
# operand layout (base/delta indices) no longer matches the td defs.

# CHECK-NOT: Unable to analyzeLoop
# CHECK-COUNT-7: Schedule Found?

--- |
  define i32 @postinc_load_i32(ptr %p, i32 %n) #0 {
  entry:
    br label %loop
  loop:
    %s = phi i32 [ 0, %entry ], [ %s2, %loop ]
    %i = phi i32 [ 0, %entry ], [ %i2, %loop ]
    %bp = phi ptr [ %p, %entry ], [ %bp2, %loop ]
    %ld = load i32, ptr %bp, align 4
    %s2 = add i32 %s, %ld
    %bp2 = getelementptr i8, ptr %bp, i32 4
    %i2 = add i32 %i, 1
    %c = icmp ult i32 %i2, %n
    br i1 %c, label %loop, label %exit
  exit:
    ret i32 %s2
  }

  define i32 @preinc_load_i32(ptr %p, i32 %n) #0 {
  entry:
    br label %loop
  loop:
    %s = phi i32 [ 0, %entry ], [ %s2, %loop ]
    %i = phi i32 [ 0, %entry ], [ %i2, %loop ]
    %bp = phi ptr [ %p, %entry ], [ %bp2, %loop ]
    %bp2 = getelementptr i8, ptr %bp, i32 4
    %ld = load i32, ptr %bp2, align 4
    %s2 = add i32 %s, %ld
    %i2 = add i32 %i, 1
    %c = icmp ult i32 %i2, %n
    br i1 %c, label %loop, label %exit
  exit:
    ret i32 %s2
  }

  define i32 @postdec_load_i32(ptr %p, i32 %n) #0 {
  entry:
    br label %loop
  loop:
    %s = phi i32 [ 0, %entry ], [ %s2, %loop ]
    %i = phi i32 [ 0, %entry ], [ %i2, %loop ]
    %bp = phi ptr [ %p, %entry ], [ %bp2, %loop ]
    %ld = load i32, ptr %bp, align 4
    %s2 = add i32 %s, %ld
    %bp2 = getelementptr i8, ptr %bp, i32 -4
    %i2 = add i32 %i, 1
    %c = icmp ult i32 %i2, %n
    br i1 %c, label %loop, label %exit
  exit:
    ret i32 %s2
  }

  define i32 @predec_load_i32(ptr %p, i32 %n) #0 {
  entry:
    br label %loop
  loop:
    %s = phi i32 [ 0, %entry ], [ %s2, %loop ]
    %i = phi i32 [ 0, %entry ], [ %i2, %loop ]
    %bp = phi ptr [ %p, %entry ], [ %bp2, %loop ]
    %bp2 = getelementptr i8, ptr %bp, i32 -4
    %ld = load i32, ptr %bp2, align 4
    %s2 = add i32 %s, %ld
    %i2 = add i32 %i, 1
    %c = icmp ult i32 %i2, %n
    br i1 %c, label %loop, label %exit
  exit:
    ret i32 %s2
  }

  define i64 @postinc_load_i64(ptr %p, i32 %n) #0 {
  entry:
    br label %loop
  loop:
    %s = phi i64 [ 0, %entry ], [ %s2, %loop ]
    %i = phi i32 [ 0, %entry ], [ %i2, %loop ]
    %bp = phi ptr [ %p, %entry ], [ %bp2, %loop ]
    %ld = load i64, ptr %bp, align 8
    %s2 = add i64 %s, %ld
    %bp2 = getelementptr i8, ptr %bp, i32 8
    %i2 = add i32 %i, 1
    %c = icmp ult i32 %i2, %n
    br i1 %c, label %loop, label %exit
  exit:
    ret i64 %s2
  }

  define void @postinc_store_i32(ptr %p, i32 %n, i32 %v) #0 {
  entry:
    br label %loop
  loop:
    %i = phi i32 [ 0, %entry ], [ %i2, %loop ]
    %bp = phi ptr [ %p, %entry ], [ %bp2, %loop ]
    store i32 %v, ptr %bp, align 4
    %bp2 = getelementptr i8, ptr %bp, i32 4
    %i2 = add i32 %i, 1
    %c = icmp ult i32 %i2, %n
    br i1 %c, label %loop, label %exit
  exit:
    ret void
  }

  define void @preinc_store_i32(ptr %p, i32 %n, i32 %v) #0 {
  entry:
    br label %loop
  loop:
    %i = phi i32 [ 0, %entry ], [ %i2, %loop ]
    %bp = phi ptr [ %p, %entry ], [ %bp2, %loop ]
    %bp2 = getelementptr i8, ptr %bp, i32 4
    store i32 %v, ptr %bp2, align 4
    %i2 = add i32 %i, 1
    %c = icmp ult i32 %i2, %n
    br i1 %c, label %loop, label %exit
  exit:
    ret void
  }

  attributes #0 = { "target-features"="-hwloop" }
...

---
name:            postinc_load_i32
tracksRegLiveness: true
body:             |
  bb.0.entry:
    liveins: $r1, $r2
    successors: %bb.1

    %p:gpr32 = COPY $r1
    %n:gpr32 = COPY $r2
    %zero:gpr32 = ADDI32 $r0, 0
    %one:gpr32 = ADDI32 $r0, 1
    B %bb.1

  bb.1.loop:
    successors: %bb.1, %bb.2

    %bp:gpr32 = PHI %p, %bb.0, %bp_n, %bb.1
    %s:gpr32 = PHI %zero, %bb.0, %s_n, %bb.1
    %i:gpr32 = PHI %zero, %bb.0, %i_n, %bb.1
    ; fused post-inc: load [bp], bp += 4 (imm6=1, scale<<2)
    %ld:gpr32, %bp_n:gpr32 = S_LW_POST_IMM %bp, 1 :: (load (s32))
    %s_n:gpr32 = ADD32 %s, %ld
    %i_n:gpr32 = ADD32 %i, %one
    %cmp:gpr32 = SLTU32 %i_n, %n
    BNEZ_W %cmp, %bb.1
    B %bb.2

  bb.2.exit:
    $r1 = COPY %s_n
    RET implicit $r15, implicit $r1

---
name:            preinc_load_i32
tracksRegLiveness: true
body:             |
  bb.0.entry:
    liveins: $r1, $r2
    successors: %bb.1

    %p:gpr32 = COPY $r1
    %n:gpr32 = COPY $r2
    %zero:gpr32 = ADDI32 $r0, 0
    %one:gpr32 = ADDI32 $r0, 1
    B %bb.1

  bb.1.loop:
    successors: %bb.1, %bb.2

    %bp:gpr32 = PHI %p, %bb.0, %bp_n, %bb.1
    %s:gpr32 = PHI %zero, %bb.0, %s_n, %bb.1
    %i:gpr32 = PHI %zero, %bb.0, %i_n, %bb.1
    ; fused pre-inc: bp += 4, then load [bp]
    %ld:gpr32, %bp_n:gpr32 = S_LW_PRE_IMM %bp, 1 :: (load (s32))
    %s_n:gpr32 = ADD32 %s, %ld
    %i_n:gpr32 = ADD32 %i, %one
    %cmp:gpr32 = SLTU32 %i_n, %n
    BNEZ_W %cmp, %bb.1
    B %bb.2

  bb.2.exit:
    $r1 = COPY %s_n
    RET implicit $r15, implicit $r1

---
name:            postdec_load_i32
tracksRegLiveness: true
body:             |
  bb.0.entry:
    liveins: $r1, $r2
    successors: %bb.1

    %p:gpr32 = COPY $r1
    %n:gpr32 = COPY $r2
    %zero:gpr32 = ADDI32 $r0, 0
    %one:gpr32 = ADDI32 $r0, 1
    B %bb.1

  bb.1.loop:
    successors: %bb.1, %bb.2

    %bp:gpr32 = PHI %p, %bb.0, %bp_n, %bb.1
    %s:gpr32 = PHI %zero, %bb.0, %s_n, %bb.1
    %i:gpr32 = PHI %zero, %bb.0, %i_n, %bb.1
    ; post-dec: imm6=-1 → bp -= 4
    %ld:gpr32, %bp_n:gpr32 = S_LW_POST_IMM %bp, -1 :: (load (s32))
    %s_n:gpr32 = ADD32 %s, %ld
    %i_n:gpr32 = ADD32 %i, %one
    %cmp:gpr32 = SLTU32 %i_n, %n
    BNEZ_W %cmp, %bb.1
    B %bb.2

  bb.2.exit:
    $r1 = COPY %s_n
    RET implicit $r15, implicit $r1

---
name:            predec_load_i32
tracksRegLiveness: true
body:             |
  bb.0.entry:
    liveins: $r1, $r2
    successors: %bb.1

    %p:gpr32 = COPY $r1
    %n:gpr32 = COPY $r2
    %zero:gpr32 = ADDI32 $r0, 0
    %one:gpr32 = ADDI32 $r0, 1
    B %bb.1

  bb.1.loop:
    successors: %bb.1, %bb.2

    %bp:gpr32 = PHI %p, %bb.0, %bp_n, %bb.1
    %s:gpr32 = PHI %zero, %bb.0, %s_n, %bb.1
    %i:gpr32 = PHI %zero, %bb.0, %i_n, %bb.1
    %ld:gpr32, %bp_n:gpr32 = S_LW_PRE_IMM %bp, -1 :: (load (s32))
    %s_n:gpr32 = ADD32 %s, %ld
    %i_n:gpr32 = ADD32 %i, %one
    %cmp:gpr32 = SLTU32 %i_n, %n
    BNEZ_W %cmp, %bb.1
    B %bb.2

  bb.2.exit:
    $r1 = COPY %s_n
    RET implicit $r15, implicit $r1

---
name:            postinc_load_i64
tracksRegLiveness: true
body:             |
  bb.0.entry:
    liveins: $r1, $r2
    successors: %bb.1

    %p:gpr32 = COPY $r1
    %n:gpr32 = COPY $r2
    %zero:gpr32 = ADDI32 $r0, 0
    %one:gpr32 = ADDI32 $r0, 1
    %z64:dr64 = ZERO_DR
    B %bb.1

  bb.1.loop:
    successors: %bb.1, %bb.2

    %bp:gpr32 = PHI %p, %bb.0, %bp_n, %bb.1
    %s:dr64 = PHI %z64, %bb.0, %s_n, %bb.1
    %i:gpr32 = PHI %zero, %bb.0, %i_n, %bb.1
    %ld:dr64, %bp_n:gpr32 = D_LDW_POST_IMM %bp, 1 :: (load (s64))
    %s_n:dr64 = ADD64 %s, %ld
    %i_n:gpr32 = ADD32 %i, %one
    %cmp:gpr32 = SLTU32 %i_n, %n
    BNEZ_W %cmp, %bb.1
    B %bb.2

  bb.2.exit:
    $d1 = COPY %s_n
    RET implicit $r15, implicit $d1

---
name:            postinc_store_i32
tracksRegLiveness: true
body:             |
  bb.0.entry:
    liveins: $r1, $r2, $r3
    successors: %bb.1

    %p:gpr32 = COPY $r1
    %n:gpr32 = COPY $r2
    %v:gpr32 = COPY $r3
    %zero:gpr32 = ADDI32 $r0, 0
    %one:gpr32 = ADDI32 $r0, 1
    B %bb.1

  bb.1.loop:
    successors: %bb.1, %bb.2

    %bp:gpr32 = PHI %p, %bb.0, %bp_n, %bb.1
    %i:gpr32 = PHI %zero, %bb.0, %i_n, %bb.1
    %bp_n:gpr32 = ST32_POST %v, %bp, 1 :: (store (s32))
    %i_n:gpr32 = ADD32 %i, %one
    %cmp:gpr32 = SLTU32 %i_n, %n
    BNEZ_W %cmp, %bb.1
    B %bb.2

  bb.2.exit:
    RET implicit $r15

---
name:            preinc_store_i32
tracksRegLiveness: true
body:             |
  bb.0.entry:
    liveins: $r1, $r2, $r3
    successors: %bb.1

    %p:gpr32 = COPY $r1
    %n:gpr32 = COPY $r2
    %v:gpr32 = COPY $r3
    %zero:gpr32 = ADDI32 $r0, 0
    %one:gpr32 = ADDI32 $r0, 1
    B %bb.1

  bb.1.loop:
    successors: %bb.1, %bb.2

    %bp:gpr32 = PHI %p, %bb.0, %bp_n, %bb.1
    %i:gpr32 = PHI %zero, %bb.0, %i_n, %bb.1
    %bp_n:gpr32 = S_SW_PRE_IMM %v, %bp, 1 :: (store (s32))
    %i_n:gpr32 = ADD32 %i, %one
    %cmp:gpr32 = SLTU32 %i_n, %n
    BNEZ_W %cmp, %bb.1
    B %bb.2

  bb.2.exit:
    RET implicit $r15

