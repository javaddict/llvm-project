# RUN: not --crash llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   %s -o - 2>&1 | FileCheck %s
# REQUIRES: haydn-registered-target

# Role: MIR — residual generated members with row-only BUNDLE 0 (no
# CompletionStateID) are rejected. Inverse verify requires typed completion
# on every residual root; independently generated inverse records cannot
# certify a row-only stamp.

--- |
  define void @missing_residual_completion() { ret void }
...
---
name:            missing_residual_completion
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r15
    ; CHECK: missing CompletionStateID
    ; CHECK: residual/private members require typed completion
    BUNDLE 0, implicit-def $r2, implicit-def dead $sfr, implicit $r0, implicit $r1 {
      $r2 = ADD32_E2_E0_ALU0_RR $r0, $r1, implicit-def dead $sfr
    }
    RET implicit $r15
