# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s
# REQUIRES: haydn-registered-target

# Role: MIR — residual generated members with row-only BUNDLE 0 (no
# CompletionStateID) are still accepted by verifyCommittedBundle. Missing
# completion remains allowed on residual row-only stamps; hard-root verify
# is the multi-member missing-completion fatal. Typed-completion refuse
# ("missing CompletionStateID" / "residual/private members require typed
# completion") is unlanded — do not invent that diagnostic here.

--- |
  define void @missing_residual_completion() { ret void }
...
---
name:            missing_residual_completion
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r15
    ; CHECK: BUNDLE 0, implicit-def $r2, implicit-def dead $sfr, implicit $r0, implicit $r1 {
    ; CHECK-NEXT: $r2 = ADD32_E2_E0_ALU0_RR $r0, $r1, implicit-def dead $sfr
    ; CHECK-NOT: missing CompletionStateID
    BUNDLE 0, implicit-def $r2, implicit-def dead $sfr, implicit $r0, implicit $r1 {
      $r2 = ADD32_E2_E0_ALU0_RR $r0, $r1, implicit-def dead $sfr
    }
    RET implicit $r15
