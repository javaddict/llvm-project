# RUN: llc -mtriple=haydn-unknown-elf -global-isel-abort=1 \
# RUN:   -run-pass=finalize-isel -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s

# Role: MIR — .4: SLT64_S* members share logical unary shape for AIE setDesc (AIEMachineScheduler.cpp:1126-1132).

# B3.exit.4: SLT64_S* members share logical unary shape for AIE setDesc
# (AIEMachineScheduler.cpp:1126-1132). Golden HW is SFR-only + 2 DR sources;
# compiler model keeps (outs DR64:$rd),(ins DR64:$rsd)+Defs=[SFR] so materialize
# does not hit "Explicit operand marked as def" (B1 R_CMP 0-def shape).
#
# MIR: unary SLT64 with Defs=[SFR] must verify clean.

---
name:            test_slt64_unary_setdesc_shape
tracksRegLiveness: true
registers:
  - { id: 0, class: dr64 }
body:             |
  bb.0.entry:
    %0 = IMPLICIT_DEF
    SLT64 %0, %0, implicit-def $sfr
    RET implicit $r0, implicit $r15
...

# 2026-08-21 pair rework (audit_shapes "Scalar trio"): golden two-source.
# CHECK-LABEL: name: test_slt64_unary_setdesc_shape
# CHECK: SLT64 %{{[0-9]+}}{{(:dr64)?}}, %{{[0-9]+}}{{(:dr64)?}}, implicit-def $sfr
# CHECK-NOT: Explicit operand marked as def
