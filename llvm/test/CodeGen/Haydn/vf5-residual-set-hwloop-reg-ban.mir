# RUN: not llc -mtriple=haydn-unknown-elf \
# RUN:   -run-pass=haydn-finalize-mi-bundles,haydn-verify-bundles \
# RUN:   %s -o - 2>&1 | FileCheck %s

# Role: verifier — Late-MC one-to-one: residual SET_HWLOOP_REG fails closed at the late firewall (must be final SET_HWLOOP_REG_W / wide form before layout).

# Late-MC one-to-one: residual SET_HWLOOP_REG fails closed at the late
# firewall (must be final SET_HWLOOP_REG_W / wide form before layout).
# Shared residual class with AsmPrinter.

--- |
  define void @residual_set_hwloop_reg() { ret void }
...
---
name:            residual_set_hwloop_reg
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r4, $r15
    successors: %bb.1
    ; CHECK: residual cycle-forming pseudo
    SET_HWLOOP_REG 0, %bb.1, %bb.1, $r4, implicit-def dead $sfr
    RET implicit $r15
  bb.1:
    RET implicit $r15
