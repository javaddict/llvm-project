# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop -run-pass=postmisched \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# Role: MIR — SET_HWLOOP trip-reg coissue refuse at leaveMBB.
#
# Snapshot no-forwarding: coissuing a trip-count producer (ADDI remat) with
# SET_HWLOOP samples the pre-cycle trip value. Product law refuses multi-MI
# commit for any same-cycle producer of SET trip/Off GPRs — leaveMBB
# sequentializes in schedule order and clears InternalRead.
#
# Covers residual stamped peels as well as unstamped residual shells.
# Product -haydn-enable-hwloops stays default OFF; this pin is the coissue
# peer-law residual only (no pre-RA multi-member SMS BUNDLE revival).

--- |
  define void @set_trip_addi_no_coissue() { ret void }
  define void @set_trip_stamped_no_coissue() { ret void }
...
---
name:            set_trip_addi_no_coissue
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r5, $r15
    successors: %bb.1

    ; Unstamped multi-member: ADDI defines trip $r6 that SET samples.
    ; leaveMBB must sequentialize (def then use) with InternalRead cleared.
    ; CHECK-LABEL: name: set_trip_addi_no_coissue
    ; CHECK: $r6 = ADDI32{{(_W|_E2_[^ ]+)?}} {{.*}}$r5, -1
    ; CHECK-NEXT: SET_HWLOOP_F2{{(_W|_E2_[^ ]+)?}} 0, %bb.1, %bb.1, {{.*}}$r6
    ; CHECK-NEXT: {{RET|JALR}} implicit $r15
    ; CHECK-NOT: internal
    BUNDLE implicit-def $r6, implicit-def $sfr, implicit $r5 {
      $r6 = ADDI32_W $r5, -1, implicit-def dead $sfr
      SET_HWLOOP_F2_W 0, %bb.1, %bb.1, internal killed $r6, implicit-def $sfr
    }
    RET implicit $r15

  bb.1:
    RET implicit $r15

...
---
name:            set_trip_stamped_no_coissue
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r5, $r15
    successors: %bb.1

    ; Already Format-E stamped multi-member with the same illegal trip coissue.
    ; leaveMBB must re-probe and sequentialize (stamp alone is not authority).
    ; CHECK-LABEL: name: set_trip_stamped_no_coissue
    ; CHECK: $r6 = ADDI32{{(_W|_E2_[^ ]+)?}} {{.*}}$r5, -1
    ; CHECK-NEXT: SET_HWLOOP_F2{{(_W|_E2_[^ ]+)?}} 0, %bb.1, %bb.1, {{.*}}$r6
    ; CHECK-NEXT: {{RET|JALR}} implicit $r15
    ; CHECK-NOT: internal
    BUNDLE 0, 0, implicit-def dead $r6, implicit-def $sfr, implicit $r5 {
      $r6 = ADDI32_W $r5, -1, implicit-def dead $sfr
      SET_HWLOOP_F2_W 0, %bb.1, %bb.1, internal killed $r6, implicit-def $sfr
    }
    RET implicit $r15

  bb.1:
    RET implicit $r15
