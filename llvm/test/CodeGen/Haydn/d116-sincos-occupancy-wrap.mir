# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-finalize-mi-bundles \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s
#
# D1.16 SIN_COS/ARCTAN DestWritePending wrap class. ARCTAN (uimm4+2
# occupancy; imm 4 → window 6, dest-write remaining 5) sits at the ZOL
# latch end; its dest is redefined at the next iteration's first cycle —
# the WRAP pad must cover the conservative window. Cap law: a latch
# needing more than HaydnPostRAMaxInterZonePads parcels in the scheduler
# overlay takes the named-fatal path (never a silent clamp); the
# LatencyStalls net is unbounded by that cap (it inserts what the window
# requires). The golden unit-busy-at-latch question stays OUT of scope
# here (D1.16 open item): this test pins the window arithmetic only.

---
name:            sincos_wrap_latch
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
body:             |
  ; CHECK-LABEL: name: sincos_wrap_latch
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $d0, $r2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BUNDLE 0, 0, implicit-def $sfr, implicit $r2 {
  ; CHECK-NEXT:     SET_HWLOOP_F2_E2_E0_ALU0_HWLRIIR 0, %bb.1, %bb.1, killed $r2, implicit-def $sfr
  ; CHECK-NEXT:     NOP
  ; CHECK-NEXT:   }
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.2(0x04000000)
  ; CHECK-NEXT:   liveins: $d0, $r3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BUNDLE 1, 0, implicit-def $r4, implicit $d0 {
  ; CHECK-NEXT:     $r4 = ARCTAN_E3_E2_ALU2_RI4 $d0, 4
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   BUNDLE 0, 0 {
  ; CHECK-NEXT:     nomerge NOP
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   BUNDLE 0, 0 {
  ; CHECK-NEXT:     nomerge NOP
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   BUNDLE 0, 0 {
  ; CHECK-NEXT:     nomerge NOP
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   BUNDLE 0, 0 {
  ; CHECK-NEXT:     nomerge NOP
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   BUNDLE 0, 0 {
  ; CHECK-NEXT:     nomerge NOP
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   PseudoLoopEnd %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $r4, $r15
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BUNDLE 0, 0, implicit-def $r9, implicit $r4 {
  ; CHECK-NEXT:     $r9 = ADD32_E2_E0_ALU0_RR $r4, $r4
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   BUNDLE 0, 0, implicit-def $r0, implicit $r15 {
  ; CHECK-NEXT:     $r0 = JALR_E2_E0_ALU0_RI12 $r15, 0, implicit $r9
  ; CHECK-NEXT:   }
  bb.0:
    liveins: $d0, $r2
    successors: %bb.1(0x80000000)

    BUNDLE 0, 0, implicit-def $sfr, implicit $r2 {
      SET_HWLOOP_F2_E2_E0_ALU0_HWLRIIR 0, %bb.1, %bb.1, killed $r2, implicit-def $sfr
      NOP
    }

  bb.1:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $d0, $r3

    ; ARCTAN imm 4 → occupancy 6 → dest-write remaining 5 at the latch end.
    ; Exactly 5 wrap pads AFTER the ARCTAN cycle and BEFORE PseudoLoopEnd
    ; (after every crossing def, inside the inclusive body window — pads
    ; before the def shift the def with it and cover nothing), none before
    ; it. Pad count is pinned by the UTC CHECK-NEXT nomerge NOP parcels above.
    $r4 = ARCTAN_E3_E2_ALU2_RI4 $d0, 4
    PseudoLoopEnd %bb.1

  bb.2:
    liveins: $r4, $r15

    BUNDLE 0, 0, implicit-def $r9, implicit $r4 {
      $r9 = ADD32_E2_E0_ALU0_RR $r4, $r4
    }
    RET implicit $r15, implicit $r9
...
