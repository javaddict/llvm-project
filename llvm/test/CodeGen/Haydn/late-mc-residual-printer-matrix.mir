# Role: verifier — Late-MC one-to-one: residual cycle-forming / multi-cycle / loop-control pseudos must fail closed in AsmPrinter (shared law with VerifyBundles via.

# Late-MC one-to-one: residual cycle-forming / multi-cycle / loop-control
# pseudos must fail closed in AsmPrinter (shared law with VerifyBundles via
# isResidualCycleFormingPseudo). start-after livedebugvalues skips the late
# verify firewall so the printer path is hit directly.
# Authority: durable-rules serialize-only; ExpandPseudos / BranchRelaxation /
# FixupHwLoops must exact-commit final reals before layout. No FlexMap.
#

#--- loadi32.mir

--- |
  define void @printer_residual_loadi32() { ret void }
...
---
name:            printer_residual_loadi32
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r15
    successors: %bb.1
    ; LOADI32: HaydnAsmPrinter: residual cycle-forming pseudo
    ; LOADI32: LOADI32 residual
    $r1 = LOADI32 %bb.1
    RET implicit $r15
  bb.1:
    RET implicit $r15

