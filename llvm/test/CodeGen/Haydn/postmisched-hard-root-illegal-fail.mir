# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postmisched \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# Role: product leaveMBB — illegal multi-member hard root is sequentialized
# (Anti-order dissolve), not fail-closed. Four independent ADD32 cannot form
# one product Format E cycle (issue width 3); membership cannot exact-commit,
# so leaveMBB dissolves to bare ADDs instead of aborting the function.
#
# W39 fixture hygiene (2026-08-16): historical noise `implicit-def dead $sfr`
# operands on ALU members were removed (ALU descs carry no implicit SFR def;
# under the unified no-dual-write law they mask the intended packing). W39
# itself is pinned by w39-dead-def-dual-write-waw.mir.

--- |
  define void @illegal_four_member_hard_root() { ret void }
...
---
name:            illegal_four_member_hard_root
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r15

    ; CHECK-LABEL: name: illegal_four_member_hard_root
    ; CHECK-NOT: BUNDLE
    ; CHECK: ADD32
    ; CHECK: ADD32
    ; CHECK: ADD32
    ; CHECK: ADD32
    ; CHECK: RET
    BUNDLE implicit-def $r8, implicit-def $r9, implicit-def $r10, implicit-def $r11, implicit $r0, implicit $r1, implicit $r2, implicit $r3, implicit $r4, implicit $r5, implicit $r6, implicit $r7 {
      $r8 = ADD32 $r0, $r1
      $r9 = ADD32 $r2, $r3
      $r10 = ADD32 $r4, $r5
      $r11 = ADD32 $r6, $r7
    }
    RET implicit $r15
