# RUN: not llc -mtriple=haydn-unknown-elf \
# RUN:   -run-pass=haydn-finalize-mi-bundles,haydn-verify-bundles \
# RUN:   %s -o - 2>&1 | FileCheck %s

# Role: verifier — Late-MC residual LoopDec/LoopJNZ at late firewall is fatal (Fixup demotion must commit SUBI32/BNEZ_W).

# Late-MC residual LoopDec/LoopJNZ at late firewall is fatal
# (Fixup demotion must commit SUBI32/BNEZ_W).

--- |
  define void @residual_loop_control() { ret void }
...
---
name:            residual_loop_control
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r15
    successors: %bb.0, %bb.1
    ; CHECK: residual cycle-forming pseudo
    $r1 = LoopDec $r1
    LoopJNZ $r1, %bb.0
  bb.1:
    RET implicit $r15
