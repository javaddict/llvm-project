# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=haydn-hwloops -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s
# REQUIRES: haydn-registered-target
#
# GR1.4 D1.157 — coissued SET victim becomes the generated same-row NOP
# (HaydnInstrInfo neutralizeSameRowNop / HexagonConstPropagation.cpp:2508-2512
# replaceWithNop). The ST32 sibling keeps the original packet; demote must
# not singleton-split survivors. AIE eraseRootFromBlock (AIEBundle.h:215-221)
# drops the header only — do not port leave-stale-row.

# CHECK-LABEL: name: gr14_demote_same_row_nop
# CHECK: BUNDLE
# CHECK-NOT: SET_HWLOOP
# CHECK: NOP
# CHECK-NOT: BUNDLE
# CHECK: {{ST32|S_SW}}{{.*}}$r6, $r1, 0
# CHECK: }
# CHECK: $r2 = SUBI32
# CHECK: BNEZ{{.*}}$r2

--- |
  define dso_local void @gr14_demote_same_row_nop(ptr nocapture writeonly %p, i32 %v, i32 %trip) {
  entry:
    br label %spacer
  spacer:
    br label %header
  header:
    br label %latch
  latch:
    store i32 %v, ptr %p, align 4
    br label %exit
  exit:
    ret void
  }
...
---
name:            gr14_demote_same_row_nop
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r2, $r6, $r15
    successors: %bb.1
    BUNDLE implicit-def dead $sfr, implicit $r2, implicit $r6, implicit $r1 {
      SET_HWLOOP_F2_W 0, %bb.2, %bb.3, $r2, implicit-def dead $sfr
      ST32 $r6, $r1, 0
    }
    NOP
    NOP
    NOP

  bb.1.spacer:
    liveins: $r1, $r2, $r6
    successors: %bb.2
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP

  bb.2.header:
    liveins: $r1, $r2, $r6
    successors: %bb.3
    NOP

  bb.3.latch:
    liveins: $r1, $r2, $r6
    successors: %bb.4
    NOP
    NOP
    NOP

  bb.4.exit:
    liveins: $r15
    RET implicit killed $r15
