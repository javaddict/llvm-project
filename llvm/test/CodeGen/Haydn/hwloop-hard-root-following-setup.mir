---
name:            coissue_set_then_hard
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
body:             |
  ; CHECK-LABEL: name: coissue_set_then_hard
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r0, $r1, $r2, $r3, $r15
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   frame-setup BUNDLE 0, 0, implicit-def $r0, implicit $r0 {
  ; CHECK-NEXT:     $r0 = frame-setup XOR32_E2_E0_ALU0_RR $r0, $r0
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   BUNDLE 0, 0, implicit-def $r6, implicit $r0, implicit $r1 {
  ; CHECK-NEXT:     SET_HWLOOP_W 0, %bb.1, %bb.1, 4, implicit-def dead $sfr
  ; CHECK-NEXT:     $r6 = ADD32 $r0, $r1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   BUNDLE 0, 0 {
  ; CHECK-NEXT:     NOP
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   BUNDLE 1, 0, implicit-def $r4, implicit-def $r5, implicit $r0, implicit $r1, implicit $r2, implicit $r3 {
  ; CHECK-NEXT:     $r4 = ADD32_E3_E0_ALU2_RR $r0, $r1
  ; CHECK-NEXT:     $r5 = ADD32_E3_E1_ALU1_RR $r2, $r3
  ; CHECK-NEXT:   }
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $r0, $r1, $r4, $r5, $r6, $r15
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BUNDLE 0, 0, implicit $r6, implicit $r1 {
  ; CHECK-NEXT:     S_SW_WITH_IMM_E2_E0_LOADSTORE0_RI6 $r6, $r1, 0
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   BUNDLE 0, 0 {
  ; CHECK-NEXT:     NOP
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   BUNDLE 0, 0 {
  ; CHECK-NEXT:     NOP
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   BUNDLE 0, 0 {
  ; CHECK-NEXT:     NOP
  ; CHECK-NEXT:   }
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $r15
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BUNDLE 0, 0, implicit-def $r0, implicit $r15 {
  ; CHECK-NEXT:     $r0 = JALR_E2_E0_ALU0_RI12 $r15, 0
  ; CHECK-NEXT:   }
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0
    ; Coissued SET cycle (post-exact-commit shape) then hard multi-member cycle.
    BUNDLE 0, implicit-def $r6, implicit $r0, implicit $r1 {
      SET_HWLOOP_W 0, %bb.1, %bb.1, 4, implicit-def dead $sfr
      $r6 = ADD32 $r0, $r1
    }
    BUNDLE 0, implicit-def $r4, implicit-def $r5, implicit $r0, implicit $r1, implicit $r2, implicit $r3 {
      $r4 = ADD32 $r0, $r1
      $r5 = ADD32 $r2, $r3
    }
    ; Following = hard root only (1) → one deficit pad after SET cycle,
    ; before the hard root (never spliced into either multi-member cycle).

  bb.1:
    liveins: $r0, $r1, $r4, $r5, $r6, $r15
    successors: %bb.2
    ST32 $r6, $r1, 0
    NOP
    NOP
    NOP

  bb.2:
    liveins: $r15
    RET implicit killed $r15

# Coissued SET cycle preserved (SET + ADD siblings).
# One top-level exact-commit deficit pad, then hard dual-ADD root.
