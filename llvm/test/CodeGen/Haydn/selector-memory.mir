---
name:            test_select_store32
legalized:       true
regBankSelected: false
body:             |
  bb.0.entry:
    liveins: $r0, $r1
    ; CHECK-LABEL: name: test_select_store32
    ; CHECK: liveins: $r0, $r1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $r1
    ; CHECK-NEXT: S_SW_WITH_IMM [[COPY]], [[COPY1]], 0 :: (store (s32))
    ; CHECK-NEXT: RET implicit $r0, implicit $r15
    %0:_(s32) = COPY $r0
    %1:_(p0) = COPY $r1
    G_STORE %0(s32), %1(p0) :: (store (s32))
    RET implicit $r0, implicit $r15
...

---
name:            test_select_store32_offset
legalized:       true
regBankSelected: false
body:             |
  bb.0.entry:
