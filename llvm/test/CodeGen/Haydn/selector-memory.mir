# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=regbankselect,instruction-select %s -o - | FileCheck %s
#
# Test G_LOAD/G_STORE selection by memory width (ISA-43 bug 2):
# s8 -> S_LBU_WITH_IMM/S_SB_WITH_IMM, s16 -> S_LHWU_WITH_IMM/S_SHW_WITH_IMM, s32 -> S_LW_WITH_IMM/S_SW_WITH_IMM.
# Sign/zero extension is separate (G_SEXT/G_ZEXT lowered by the selector).

---
name:            test_select_load32
legalized:       true
regBankSelected: false
body:             |
  bb.0.entry:
    liveins: $r0
    ; CHECK-LABEL: name: test_select_load32
    ; CHECK: liveins: $r0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r0
    ; CHECK-NEXT: [[S_LW_WITH_IMM:%[0-9]+]]:gpr32 = S_LW_WITH_IMM [[COPY]], 0 :: (load (s32))
    ; CHECK-NEXT: $r0 = COPY [[S_LW_WITH_IMM]]
    ; CHECK-NEXT: RET implicit $r0, implicit $r15
    %0:_(p0) = COPY $r0
    %1:_(s32) = G_LOAD %0(p0) :: (load (s32))
    $r0 = COPY %1(s32)
    RET implicit $r0, implicit $r15
...

---
name:            test_select_load32_offset
legalized:       true
regBankSelected: false
body:             |
  bb.0.entry:
    liveins: $r0
    ; CHECK-LABEL: name: test_select_load32_offset
    ; CHECK: liveins: $r0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r0
    ; CHECK-NEXT: [[S_LW_WITH_IMM:%[0-9]+]]:gpr32 = S_LW_WITH_IMM [[COPY]], 4 :: (load (s32))
    ; CHECK-NEXT: $r0 = COPY [[S_LW_WITH_IMM]]
    ; CHECK-NEXT: RET implicit $r0, implicit $r15
    %0:_(p0) = COPY $r0
    %1:_(s32) = G_CONSTANT i32 16
    %2:_(p0) = G_PTR_ADD %0, %1(s32)
    %3:_(s32) = G_LOAD %2(p0) :: (load (s32))
    $r0 = COPY %3(s32)
    RET implicit $r0, implicit $r15
...

---
name:            test_select_load16
legalized:       true
regBankSelected: false
# ISA-43 bug 2: s16 load selects S_LHWU_WITH_IMM (not S_LW_WITH_IMM)
body:             |
  bb.0.entry:
    liveins: $r0
    ; CHECK-LABEL: name: test_select_load16
    ; CHECK: liveins: $r0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r0
    ; CHECK-NEXT: [[S_LHWU_WITH_IMM:%[0-9]+]]:gpr32 = S_LHWU_WITH_IMM [[COPY]], 0 :: (load (s16))
    ; CHECK-NEXT: [[SLLI32_:%[0-9]+]]:gpr32 = SLLI32 [[S_LHWU_WITH_IMM]], 16
    ; CHECK-NEXT: [[SRAI32_:%[0-9]+]]:gpr32 = SRAI32 [[SLLI32_]], 16
    ; CHECK-NEXT: $r0 = COPY [[SRAI32_]]
    ; CHECK-NEXT: RET implicit $r0, implicit $r15
    %0:_(p0) = COPY $r0
    %1:_(s16) = G_LOAD %0(p0) :: (load (s16))
    %2:_(s32) = G_SEXT %1(s16)
    $r0 = COPY %2(s32)
    RET implicit $r0, implicit $r15
...

