    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r0
    ; CHECK-NEXT: [[S_LHWU_WITH_IMM:%[0-9]+]]:gpr32 = S_LHWU_WITH_IMM [[COPY]], 0 :: (load (s16))
    ; CHECK-NEXT: [[ANDI32_:%[0-9]+]]:gpr32 = ANDI32 [[S_LHWU_WITH_IMM]], 65535
    ; CHECK-NEXT: $r0 = COPY [[ANDI32_]]
    ; CHECK-NEXT: RET implicit $r0, implicit $r15
    %0:_(p0) = COPY $r0
    %1:_(s16) = G_LOAD %0(p0) :: (load (s16))
    %2:_(s32) = G_ZEXT %1(s16)
