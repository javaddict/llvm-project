    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $r1
    ; CHECK-NEXT: S_SW_WITH_IMM [[COPY]], [[COPY1]], 2 :: (store (s32))
    ; CHECK-NEXT: RET implicit $r0, implicit $r15
    %0:_(s32) = COPY $r0
    %1:_(p0) = COPY $r1
    %2:_(s32) = G_CONSTANT i32 8
    %3:_(p0) = G_PTR_ADD %1, %2(s32)
    G_STORE %0(s32), %3(p0) :: (store (s32))
    RET implicit $r0, implicit $r15
...

