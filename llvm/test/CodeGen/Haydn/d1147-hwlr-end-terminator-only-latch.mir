# RUN: llc -mtriple=haydn-unknown-elf -O0 -x mir -start-after=livedebugvalues \
# RUN: -filetype=asm %s -o - | FileCheck %s
# REQUIRES: haydn-registered-target
#
# D1.147: HWLR_END temp must flush on a terminator-only latch. MCInstLower
# creates the temp from SET_HWLOOP's end MBB; emitInstruction used to skip
# terminators via getLastRealInstr and leave the symbol undefined. O0 skips
# FixupHwLoops (no body pads). AIE setPreInstrSymbol unreachables when Prev
# is null (AIEBaseAsmPrinter.cpp:64-70); Haydn overlay flushes the temp at
# the last size-bearing terminator (BUNDLE of B).

--- |
  define void @term_only_latch() { ret void }
...
---
name:            term_only_latch
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.1
    liveins: $r1, $r15
    ; CHECK-LABEL: term_only_latch:
    ; CHECK: set_hwloop_f2 0, .LLhwloop_start0, .LLhwloop_end0
    BUNDLE 0, 0, implicit-def $sfr, implicit $r1 {
      SET_HWLOOP_F2_E2_E0_ALU0_HWLRIIR 0, %bb.1, %bb.1, $r1, implicit-def $sfr
      NOP
    }

  bb.1:
    successors: %bb.2
    liveins: $r15
    ; Inclusive END at the terminator BUNDLE (no non-term real in the latch).
    ; CHECK: .LLhwloop_end0:
    ; CHECK: beqz
    BUNDLE 0, 0 {
      B %bb.2
    }

  bb.2:
    liveins: $r15
    ; CHECK: jalr
    BUNDLE 0, 0, implicit-def $r0, implicit $r15 {
      $r0 = JALR_E2_E0_ALU0_RI12 $r15, 0
    }
...
