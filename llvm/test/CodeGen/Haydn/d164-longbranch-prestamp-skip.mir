---
name:            coissue_alu_two_cond_far_uncond
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
  - { reg: '$r5', virtual-reg: '' }
  - { reg: '$r15', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        false
body:             |
  bb.0.entry:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2, $r4, $r5, $r15
    ; CHECK-LABEL: name: coissue_alu_two_cond_far_uncond
    ; BUNDLE{ADD32,B} + two BEQZ. Coissued ALU must not stop the
    ; analyzed-cond walk; prestamp B; both BEQZs and ADD32 survive.
    ; CHECK: bb.0.entry
    ; CHECK: $r3 = ADD32
    ; CHECK-NOT: B %bb.2
    ; CHECK: LUI
    ; CHECK: ADDI32
    ; CHECK: BEQZ{{.*}} $r4, %bb.1
    ; CHECK: BEQZ{{.*}} $r5, %bb.1
    ; CHECK-NOT: B %bb.2
    ; CHECK: JALR
    ; CHECK-NOT: B %bb.2
    ; CHECK: bb.1.pad
    BEQZ_W $r4, %bb.1, implicit-def dead $sfr
    BEQZ_W $r5, %bb.1, implicit-def dead $sfr
    BUNDLE 0, 0, implicit-def $r3, implicit-def dead $sfr, implicit $r1, implicit $r2 {
      $r3 = ADD32 $r1, $r2, implicit-def dead $sfr
      B %bb.2
    }

  bb.1.pad:
    liveins: $r15
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
