name:            bundled_far_uncond_with_jalr_msp
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r10', virtual-reg: '' }
  - { reg: '$r11', virtual-reg: '' }
  - { reg: '$r15', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        true
body:             |
  bb.0.entry:
    successors: %bb.2
    liveins: $r10, $r11, $r15
    ; CHECK-LABEL: name: bundled_far_uncond_with_jalr_msp
    ; Far uncond is LUI+ADDI+JALR_W. Short B is gone.
    ; CHECK: $r{{[0-9]+}} = LUI
    ; CHECK: ADDI32
    ; CHECK: $r{{[0-9]+}} = JALR_W
    ; CHECK-NOT: B %bb.2
    $r11 = ADDI32_W $r11, 0
    BUNDLE implicit-def $r15, implicit $r10, implicit-def $r1, implicit-def $r2, implicit-def $r3, implicit-def $r4, implicit-def $r5, implicit-def $r6, implicit-def $r7, implicit-def $r12, implicit-def $d0, implicit-def $d1, implicit-def $d2, implicit-def $d3, implicit-def $d4, implicit-def $d5, implicit-def $d6, implicit-def $d7 {
      $r15 = JALR_CALL $r10, 0, implicit-def $r1, implicit-def $r2, implicit-def $r3, implicit-def $r4, implicit-def $r5, implicit-def $r6, implicit-def $r7, implicit-def $r12, implicit-def $d0, implicit-def $d1, implicit-def $d2, implicit-def $d3, implicit-def $d4, implicit-def $d5, implicit-def $d6, implicit-def $d7
      B %bb.2
    }

  bb.1.pad:
