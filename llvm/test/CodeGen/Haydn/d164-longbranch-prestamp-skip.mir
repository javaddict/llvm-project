# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-longbranch-normalize \
# RUN:   -haydn-branch-relax-safety-buffer=4 -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s
# REQUIRES: haydn-registered-target
#
# D1.64 HOLD va-arg-24: LongBranchNormalize must prestamp remaining far
# uncond so LateConvergence BR never calls insertIndirectBranch (GR2.7).
# Skip only the LUI+ADDI+JALR CFG form. A returning JALR_CALL / last-JALR
# without that pair is not already-long (opcode-only skip left a far B
# for BranchRelaxation::fixupUnconditionalBranch).
# Peer: RISCVInstrInfo.cpp insertIndirectBranch AUIPC+JALR; Hexagon
# A2_tfrsi+J2_jumpr; AIE has no insertIndirectBranch.
#
# Far template (d150 law, buffer=4, parcel=12, window edge 2044):
#   180 NOPs = 2160B. Each logical B/BEQZ/NOP/RET charges one parcel.
#
#   already_long_lui_addi_jalr : skip holds; never a second LUI+ADDI+JALR
#     (matmult-int hang class).
#   jalr_msp_then_far_uncond : returning call then far B; prestamp the B.
#   bundled_far_uncond_with_jalr_msp : last cycle lists JALR_CALL first then
#     far B (AnyInBundle isUnconditionalBranch poison); prestamp the B.
#   unanalyzable_far_cond_not_arm_b : two far BEQZ; Arm B must not match
#     a trailing cond via isBranch (MEMORY_FAULT class).
#   coissue_alu_two_cond_far_uncond : BUNDLE{ADD32,B} + two BEQZ.
#     findAnalyzedCondMI must walk past the coissued ALU (AIE terminator
#     count, AIEBaseInstrInfo.cpp:164-192). Prestamp the B; both BEQZs
#     and ADD32 survive (d150 multi_control / tii5
#     coissue_far_uncond_preceding).

--- |
  define void @already_long_lui_addi_jalr() {
  entry:
    br label %far
  pad:
    ret void
  far:
    ret void
  }
  define void @jalr_msp_then_far_uncond(ptr %p) {
  entry:
    call void %p()
    br label %far
  pad:
    ret void
  far:
    ret void
  }
  define void @bundled_far_uncond_with_jalr_msp(ptr %p) {
  entry:
    call void %p()
    br label %far
  pad:
    ret void
  far:
    ret void
  }
  define void @unanalyzable_far_cond_not_arm_b(i32 %a, i32 %b) {
  entry:
    br i1 undef, label %far, label %pad
  pad:
    ret void
  far:
    ret void
  }
  define void @coissue_alu_two_cond_far_uncond() {
  entry:
    br i1 undef, label %far, label %pad
  pad:
    ret void
  far:
    ret void
  }
...
---
name:            already_long_lui_addi_jalr
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r15', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        false
body:             |
  bb.0.entry:
    successors: %bb.2
    liveins: $r15
    ; CHECK-LABEL: name: already_long_lui_addi_jalr
    ; CHECK: bb.0.entry
    ; CHECK: $r6 = LUI
    ; CHECK: $r6 = ADDI32
    ; CHECK: JALR
    ; CHECK-NOT: $r{{[0-9]+}} = LUI
    $r6 = LUI %bb.2
    $r6 = ADDI32_W $r6, %bb.2
    $r6 = JALR_W $r6, 0

  bb.1.pad:
    liveins: $r15
    NOP
    NOP
    NOP
