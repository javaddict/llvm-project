name:            unanalyzable_far_cond_not_arm_b
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r7', virtual-reg: '' }
  - { reg: '$r8', virtual-reg: '' }
  - { reg: '$r11', virtual-reg: '' }
  - { reg: '$r15', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        false
body:             |
  bb.0.entry:
    successors: %bb.1, %bb.2
    liveins: $r7, $r8, $r11, $r15
    ; CHECK-LABEL: name: unanalyzable_far_cond_not_arm_b
    ; Two far conds: unanalyzable. Arm B must not match the trailing
    ; BEQZ via isBranch and JALR it (MEMORY_FAULT class).
    ; CHECK: BEQZ_W $r7
    ; CHECK: BEQZ_W $r8
    ; CHECK-NOT: JALR
    $r11 = ADDI32_W $r11, 0
    BEQZ_W $r7, %bb.2, implicit-def dead $sfr
    BEQZ_W $r8, %bb.2, implicit-def dead $sfr

  bb.1.pad:
    liveins: $r15
    NOP
    NOP
