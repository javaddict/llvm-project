# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-finalize-mi-bundles,haydn-verify-bundles -verify-machineinstrs %s -o - | FileCheck %s
#
# B4.3 late layout firewall — bare MIs after PreEmit growth re-commit as
# ProductFormatID singleton BUNDLEs with empty-cycle tryAdd setDesc.
#
# AIE peers:
#   AIEMachineScheduler.cpp:1121-1139 materializeMultiOpcodeInstrs setDesc
#   AIEHazardRecognizer.cpp:174-214 empty Bundle alt try
#   AIEFinalizeBundle.cpp:40-59 wrap standalone
#   AIEBaseInstrInfo.cpp:1440-1459 verifyInstruction fail-closed
#   AIE2TargetMachine.cpp:88 / AIEBaseTargetMachine.cpp:388 — AIE PreEmit empty
#
# Simulates FixupHwLoops deficit NOP + BR insertBranch bare B/BEQZ + residual
# ALU after pack. No second packer; no MCFlags; product BUNDLE128_FULL only.

--- |
  define void @late_bare_recommit() { ret void }
  define void @idempotent_already_bundled() { ret void }
...
---
# Bare Fixup/BR growth shape: NOP pad, BEQZ, B, ADDI32 — each becomes one
# ProductFormatID cycle; multi-slot logicals setDesc to empty-cycle member.
name:            late_bare_recommit
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r15', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $r15
    successors: %bb.1

    ; CHECK-LABEL: name: late_bare_recommit
    ; Empty-cycle tryAdd promotes each bare logical to one of its format E
    ; members. WHICH member is the packer's choice and not this test's
    ; property — it is ALU0 at position 2 for all three today, and § 5.12's
    ; fix will move it — so the checks pin the _P<form><pos>_<UNIT> SHAPE.
    ; A bare `ADD32` with no suffix is the regression they catch.
    ; CHECK: BUNDLE 0
    ; CHECK: ADD32_P{{[0-9]+}}_{{[A-Z0-9]+}}
    ; CHECK: BUNDLE 0
    ; CHECK: NOP_P{{[0-9]+}}_{{[A-Z0-9]+}}
    ; CHECK: BUNDLE 0
    ; CHECK: BEQZ_P{{[0-9]+}}_{{[A-Z0-9]+}}
    ; CHECK: BUNDLE 0
    ; CHECK: B %bb.1
    $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    NOP
    BEQZ $r2, %bb.1, implicit-def dead $sfr
    B %bb.1

  bb.1:
    liveins: $r15
    ; CHECK: BUNDLE 0
    ; CHECK: RET
    RET implicit killed $r15

...
---
# Already-committed cycles must be idempotent (late Finalize no-op on roots).
name:            idempotent_already_bundled
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r15', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r15

    ; CHECK-LABEL: name: idempotent_already_bundled
    ; CHECK: BUNDLE 0
    ; CHECK: ADDI32
    ; CHECK: BUNDLE 0
    ; CHECK: JALR
    BUNDLE 0 {
      $r2 = ADDI32_P21_ALU1 $r0, 10, implicit-def dead $sfr
    }
    BUNDLE 0 {
      $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    }

...
