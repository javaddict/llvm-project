# RUN: split-file %s %t
# RUN: not llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=haydn-hwloops -verify-machineinstrs \
# RUN:   %t/fixup_keep.mir -o - 2>&1 | FileCheck %s --check-prefix=FORM
# RUN: not llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=haydn-hwloops -verify-machineinstrs \
# RUN:   %t/fixup_no_invent.mir -o - 2>&1 | FileCheck %s --check-prefix=FORM
# RUN: not llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=haydn-hwloops -verify-machineinstrs \
# RUN:   %t/form_reject.mir -o - 2>&1 | FileCheck %s --check-prefix=FORM

# Role: MIR — body-resolution split. Formation is CFG-only
# (AIEBaseHardwareLoops.cpp:301-318 walks MLI findLoopControlBlock;
# Haydn overlay is successor/pred only and never layout order).
# A LoopStart whose preheader successor is a continue trampoline has no
# CFG body proof — haydn-hwloops rejects fail-closed.
# Pre-emit Fixup may walk empty / NOP / B trampolines (Hexagon
# FixupHwLoops.cpp:97-148 converts or leaves LOOP; it does not invent a
# body) and accept the first layout candidate that still proves a latch.
# Bare getNextNode without that proof stays unavailable.

# FIXUP: name: fixup_keep
# FIXUP: LoopStart
# FIXUP: PseudoLoopEnd
# FIXUP-NOT: BNEZ
# NOINVENT-LABEL: name: fixup_no_invent
# NOINVENT-NOT: LoopStart
# NOINVENT-NOT: SET_HWLOOP
# FORM: incomplete Role-A retained state rejected before mutation
# FORM: no body MBB

#--- fixup_keep.mir
--- |
  define dso_local void @fixup_keep(ptr %p) {
  entry:
    br label %tramp
  tramp:
    br label %body
  body:
    store i32 0, ptr %p
    br label %exit
  exit:
    ret void
  }
...
---
name:            fixup_keep
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r0, $r15
    successors: %bb.1
    $r0 = frame-setup XOR32 $r0, $r0
    $r2 = ADDI32_W $r0, 8
    LoopStart $r2, 0
    NOP
    NOP
    NOP

  bb.1.tramp:
    successors: %bb.2
    NOP
    B %bb.2

  bb.2.body:
    liveins: $r1, $r0, $r15
    successors: %bb.2, %bb.3
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP
    PseudoLoopEnd %bb.2

  bb.3.exit:
    liveins: $r15
    RET implicit killed $r15

#--- form_reject.mir
--- |
  define dso_local void @form_reject(ptr %p) {
  entry:
    br label %tramp
  tramp:
    br label %body
  body:
    store i32 0, ptr %p
    br label %exit
  exit:
    ret void
  }
...
---
name:            form_reject
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r0, $r15
    successors: %bb.1
    $r0 = frame-setup XOR32 $r0, $r0
    $r2 = ADDI32_W $r0, 8
    LoopStart $r2, 0
    NOP
    NOP
    NOP

  bb.1.tramp:
    successors: %bb.2
    NOP
    B %bb.2

  bb.2.body:
    liveins: $r1, $r0, $r15
    successors: %bb.2, %bb.3
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP
    PseudoLoopEnd %bb.2

  bb.3.exit:
    liveins: $r15
    RET implicit killed $r15

#--- fixup_no_invent.mir
--- |
  define dso_local void @fixup_no_invent(ptr %p) {
  entry:
    br label %work
  work:
    store i32 0, ptr %p
    br label %exit
  exit:
    ret void
  }
...
---
name:            fixup_no_invent
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r0, $r15
    successors: %bb.1
    $r0 = frame-setup XOR32 $r0, $r0
    $r2 = ADDI32_W $r0, 8
    LoopStart $r2, 0
    NOP
    NOP
    NOP

  bb.1.work:
    liveins: $r1, $r0, $r15
    successors: %bb.2
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.2.exit:
    liveins: $r15
    RET implicit killed $r15
