# RUN: split-file %s %t
# RUN: llc -mtriple=haydn-unknown-elf -x mir -start-after=livedebugvalues \
# RUN:   -filetype=obj %t/lui-3op.mir -o %t/lui-3op.o
# RUN: llvm-objdump -d -z --triple=haydn-unknown-elf %t/lui-3op.o | FileCheck %s --check-prefix=LUI
# RUN: llc -mtriple=haydn-unknown-elf -x mir -start-after=livedebugvalues \
# RUN:   -filetype=obj %t/lui-bundle.mir -o %t/lui-bundle.o
# RUN: llvm-objdump -d -z --triple=haydn-unknown-elf %t/lui-bundle.o | FileCheck %s --check-prefix=LUIB
# RUN: llc -mtriple=haydn-unknown-elf -x mir -start-after=livedebugvalues \
# RUN:   -filetype=obj %t/typed.mir -o %t.typed.o
# RUN: llvm-objdump -d -z --triple=haydn-unknown-elf %t.typed.o | FileCheck %s --check-prefix=TYPED
# REQUIRES: haydn-registered-target
#
# REGRESSION (W68.0b restructure): logical LUI is dest+imm — the vestigial
# first-$rs form is closed at MIR parse (verifier rejects the extra explicit
# operand), so the skip-Finalize bag-sort leak class no longer exists.
# The unbundled and bundled wire-shaped logical LUI below serialize typed
# directly (no fillFormatEMemberInst DFS). Hand-asm LUI is 2-op positional
# (rd, imm) — identical shape. Typed MemberId LUI serializes as-is.
#
# LUI-LABEL: <skip_finalize_lui_vestigial_rs>:
# LUI: lui
# LUI: jalr
# LUI-NOT: <unknown>
# LUIB-LABEL: <skip_finalize_lui_bundle>:
# LUIB: lui
# LUIB: jalr
# LUIB-NOT: <unknown>
# TYPED-LABEL: <skip_finalize_lui_memberid>:
# TYPED: lui
# TYPED-NOT: <unknown>

#--- lui-3op.mir
--- |
  define void @skip_finalize_lui_vestigial_rs() { ret void }
...
---
name:            skip_finalize_lui_vestigial_rs
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r15
    $r1 = LUI 1
    RET implicit $r15

#--- lui-bundle.mir
--- |
  define void @skip_finalize_lui_bundle() { ret void }
...
---
name:            skip_finalize_lui_bundle
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r15
    BUNDLE 0, 0, implicit-def $r1 {
      $r1 = LUI 1
    }
    RET implicit $r15

#--- typed.mir
--- |
  define void @skip_finalize_lui_memberid() { ret void }
...
---
name:            skip_finalize_lui_memberid
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r15
    BUNDLE 0, 0, implicit-def $r1 {
      $r1 = LUI_E2_E0_ALU0_I12 1
    }
    RET implicit $r15
