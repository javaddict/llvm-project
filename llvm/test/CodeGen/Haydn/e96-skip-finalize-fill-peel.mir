# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: split-file %s %t
# RUN: llc -mtriple=haydn-unknown-elf -x mir -start-after=livedebugvalues \
# RUN:   -filetype=obj %t/lui-3op.mir -o %t/lui-3op.o
# RUN: llvm-objdump -d -z --triple=haydn-unknown-elf %t/lui-3op.o | FileCheck %s --check-prefix=LUI
# RUN: not llc -mtriple=haydn-unknown-elf -x mir -start-after=livedebugvalues \
# RUN:   -filetype=obj %t/lui-bundle.mir -o %t/lui-bundle.o 2>&1 \
# RUN:   | FileCheck %s --check-prefix=LUIB
# RUN: llc -mtriple=haydn-unknown-elf -x mir -start-after=livedebugvalues \
# RUN:   -filetype=obj %t/typed.mir -o %t.typed.o
# RUN: llvm-objdump -d -z --triple=haydn-unknown-elf %t.typed.o | FileCheck %s --check-prefix=TYPED
# REQUIRES: haydn-registered-target
#
# Printer serialize-only: skip-Finalize compiler BUNDLE public logicals
# must not bind to generated members at membership entry (no fill /
# DFS / bag-sort). Bundled logical LUI is fatal. Unbundled wire-shaped
# logical LUI still lowers Desc-as-is. Typed MemberId LUI serializes as-is.
# Residual RET is fatal — terminators in these fixtures are JALR_W.
#
# LUI-LABEL: <skip_finalize_lui_vestigial_rs>:
# LUI: lui
# LUI: jalr
# LUI-NOT: <unknown>
# LUIB: compiler BUNDLE child 'LUI' is not a generated Format E member
# TYPED-LABEL: <skip_finalize_lui_memberid>:
# TYPED: lui
# TYPED-NOT: <unknown>

#--- lui-3op.mir
--- |
  define void @skip_finalize_lui_vestigial_rs() { ret void }
...
---
name:            skip_finalize_lui_vestigial_rs
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r15
    $r1 = LUI 1
    $r0 = JALR_W $r15, 0

#--- lui-bundle.mir
--- |
  define void @skip_finalize_lui_bundle() { ret void }
...
---
name:            skip_finalize_lui_bundle
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r15
    BUNDLE 0, 0, implicit-def $r1 {
      $r1 = LUI 1
    }
    $r0 = JALR_W $r15, 0

#--- typed.mir
--- |
  define void @skip_finalize_lui_memberid() { ret void }
...
---
name:            skip_finalize_lui_memberid
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r15
    BUNDLE 0, 0, implicit-def $r1 {
      $r1 = LUI_E2_E0_ALU0_I12 1
    }
    $r0 = JALR_E2_E0_ALU0_RI12 $r15, 0
