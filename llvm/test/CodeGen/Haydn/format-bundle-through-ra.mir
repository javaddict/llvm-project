    %0:gpr32 = COPY $r1
    %1:gpr32 = COPY $r2
    %2:gpr32 = COPY $r3
    %3:gpr32 = COPY $r4
    ; Resource-conflicting neighbor before the hard root: same-FU ADD32,
    ; data-independent of the group (uses only %0/%1). Would be a 4th issue
    ; if co-issued with the three-member BUNDLE.
    %rc_pre:gpr32 = ADD32 %0:gpr32, %1:gpr32, implicit-def dead $sfr
    ; Architectural 3-member logical-opcode hard BUNDLE (Full issue width).
    ; Operands reuse the four liveins so membership is three ADD32 without
    ; inventing extra simultaneous vregs.
    BUNDLE implicit-def %6:gpr32, implicit-def %7:gpr32, implicit-def %8:gpr32, implicit-def dead $sfr, implicit %0, implicit %1, implicit %2, implicit %3 {
      %6:gpr32 = ADD32 %0:gpr32, %2:gpr32, implicit-def dead $sfr
      %7:gpr32 = ADD32 %1:gpr32, %3:gpr32, implicit-def dead $sfr
      %8:gpr32 = ADD32 %0:gpr32, %3:gpr32, implicit-def dead $sfr
    }
    ; Resource-conflicting neighbor after the hard root (independent of group
    ; defs; same ADD32 issue footprint).
    %rc_post:gpr32 = ADD32 %1:gpr32, %2:gpr32, implicit-def dead $sfr
    ; Data-dependent on a bundle member — must stay outside the group.
    %dep:gpr32 = ADDI32 %6:gpr32, 1, implicit-def dead $sfr
    %t0:gpr32 = ADD32 %rc_pre:gpr32, %7:gpr32, implicit-def dead $sfr
    %t1:gpr32 = ADD32 %t0:gpr32, %8:gpr32, implicit-def dead $sfr
    %t2:gpr32 = ADD32 %t1:gpr32, %rc_post:gpr32, implicit-def dead $sfr
    %t3:gpr32 = ADD32 %t2:gpr32, %dep:gpr32, implicit-def dead $sfr
    $r0 = COPY %t3:gpr32
    RET implicit $r0, implicit $r15

  ; Membership: exactly three ADD32 children; RC neighbors stay outside.
  ; Resource-conflicting pre neighbor remains a bare MI before the root.
  ; RC post + data-dependent neighbors stay outside (not inside BUNDLE).
  ; "= ADD32 %" avoids ADDI32 false-match (substring of ADD32).
  ; Phase identity: logical opcodes only through pre-RA schedule.




  ; Physreg rewrite of members; hard root still wraps all three ADD32.

  ; stress-regalloc=4: spill/reload around the hard root only — zero member
  ; loss. Same three ADD32 children; no private slot form through RA.
...
---
# ============================================================================
# Test 4: mixed GPR32/DR64 architectural hard BUNDLE (ADD32 + 2xADD64 Full).
# Membership survives machine-scheduler, isolated register-coalescer,
# pre-greedy, greedy, VirtRegRewriter, and stress spill-around. Mirrors the
# exact rematch product shape (ADD32 rematched to S0 so both ADD64 fit).
# ============================================================================
name:            hard_bundle_mixed_fu
tracksRegLiveness: true
selected:        true
body:             |
  bb.0:
    liveins: $r1, $r2, $d0, $d1, $d2, $d3

