# RUN:   -stop-after=prologepilog -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s --check-prefixes=PEI,FIREWALL
# Optional postmisched exact-commit of dual-load hard roots after PEI.
# RUN: llc -mtriple=haydn-unknown-elf -start-before=machine-scheduler \
# RUN:   -stop-after=postmisched -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s --check-prefix=POST

# Role: MIR — hard BUNDLE membership fence through sched→RA (+ PEI large-frame).
#
# Phase-firewall pin: no durable row/entry/member/completion/issue-cycle
# identity crosses RA. Logical hard BUNDLE roots may keep membership; they
# must not grow private slot forms, Format-E composite names, or stamped
# row/completion immediates until postmisched (POST). Multi-bundle synthetic
# proofs stay inert.
# FIREWALL-NOT: BUNDLE_E96
# FIREWALL-NOT: BundleFormatRowID
# FIREWALL-NOT: CompletionStateID
# FIREWALL-NOT: {{ADD32|ADD64|ADDI32|LD32|ST32}}_S{{[0-2]}}
# FIREWALL-NOT: {{ADD32|ADD64|ADDI32|LD32|ST32}}_E2_
# FIREWALL-NOT: {{ADD32|ADD64|ADDI32|LD32|ST32}}_E3_
# FIREWALL-NOT: BUNDLE{{ *[0-9]+, *[0-9]+}}

# Hard-bundle resource fence: every standard TargetOpcode::BUNDLE root is an
# atomic isSchedulingBoundary. Architectural multi-MI logical-opcode BUNDLEs
# (pre-RA / through RA; no private member setDesc, no FormatID freeze) must:
#
#  1. Keep root/children membership identity under machine-scheduler
#     (neighbors independent of, data-dependent on, or *resource-conflicting*
#     with the group cannot enter or split the BUNDLE — HaydnHazardRecognizer
#     returns NoHazard for isBundle roots without aggregating children, so the
#     isSchedulingBoundary fence is load-bearing over HR NoHazard).
#  2. Survive isolated register-coalescer, greedy, and VirtRegRewriter with
#     zero member loss or unbundle (operand rewrites OK). Core pipeline is
#     machine-scheduler → greedy → VirtRegRewriter plus a dedicated
#     register-coalescer stop-after pin. Dual-load and LD+ADD architectural
#     roots densify the production hard shapes beyond ADD-only rematch.
#  3. Under spill pressure, allow spill/reload *around* the hard root but not
#     unbundle membership.
#  4. Mixed GPR32/DR64 Full rematch shape (ADD32 + 2xADD64) keeps the same
#     three-member hard root through the stages above.
#  5. Compact-subset soft TRI order (-haydn-ra-compact-hints=true) may reorder
#     AllocationOrder preference but cannot unbundle hard membership under
#     greedy / VirtRegRewriter / stress spill (soft preference only).
#  6. Dual-load (2×LD32) and legal LD32+ADD32 architectural hard roots keep
#     membership through the stages above (product dual-load freeze shape).
#  7. Large-frame CSR PEI (stop-after=prologepilog) around a dual-load hard
#     root must not unbundle; CSR save/restore and scavenger spills stay
#     outside the root. Optional stop-after=postmisched exact-commits the
#     dual-load root as private slot members (setDesc) with zero member loss.
#
# SMS clone→cycle logical BUNDLE materialize is product multi-stage always on
# (sms-handoff-bundle-through-ra.mir CONT through postmisched
# exact-commit + dual-run -stats). Compact TRI hints dual-run spill/copy/cycle
# metrics: regalloc-compact-hints.ll (-haydn-ra-compact-hints, default OFF).
# regalloc-hints.ll CSR baseline stays distinct. Full-only product. No hard RC
# demotion. Product flags stay OFF.

--- |
  define void @hard_bundle_membership() { ret void }
  define void @hard_bundle_spill_around() { ret void }
  define void @hard_bundle_resource_conflict() { ret void }
  define void @hard_bundle_mixed_fu() { ret void }
  define void @hard_bundle_dual_ld() { ret void }
  define void @hard_bundle_ld_add() { ret void }
  define i32 @hard_bundle_dual_ld_large_frame(ptr %p, ptr %q) {
  entry:
    %buf = alloca [480 x i8], align 8
    ret i32 undef
  }
...
