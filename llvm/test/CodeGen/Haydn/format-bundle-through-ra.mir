---
# ============================================================================
# Test 7: dual-load hard BUNDLE + large-frame CSR PEI.
# 480-byte stack + enough live GPR pressure to force CSR r8/r9 save/restore
# in the prologue/epilogue. stop-after=prologepilog proves zero member loss
# with CSR stores only around the root; stop-after=postmisched exact-commits
# the dual-load root as LD32_S* members.
# ============================================================================
name:            hard_bundle_dual_ld_large_frame
tracksRegLiveness: true
selected:        true
frameInfo:
  maxAlignment:    8
stack:
  - { id: 0, name: buf, size: 480, alignment: 8 }
body:             |
  bb.0:
    liveins: $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8, $r9, $r10, $r11

