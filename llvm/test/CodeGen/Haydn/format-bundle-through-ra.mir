      %4:gpr32 = ADD32 %0:gpr32, %1:gpr32, implicit-def dead $sfr
      %5:gpr32 = ADD32 %2:gpr32, %3:gpr32, implicit-def dead $sfr
    }
    ; Dependent on bundle member %4 — must stay outside the group.
    %dep:gpr32 = ADDI32 %4:gpr32, 1, implicit-def dead $sfr
    ; Independent of the hard group (uses only %0).
    %ind_post:gpr32 = ADDI32 %0:gpr32, 11, implicit-def dead $sfr
    %sum1:gpr32 = ADD32 %dep:gpr32, %5:gpr32, implicit-def dead $sfr
    %sum2:gpr32 = ADD32 %sum1:gpr32, %ind_pre:gpr32, implicit-def dead $sfr
    %sum3:gpr32 = ADD32 %sum2:gpr32, %ind_post:gpr32, implicit-def dead $sfr
    $r0 = COPY %sum3:gpr32
    RET implicit $r0, implicit $r15

  ; Membership + no neighbor motion into the group (vregs).
  ; Independent neighbor before the hard root stays outside the BUNDLE.
  ; Dependent + independent neighbors after the hard root stay outside.
  ; Phase identity: logical opcodes only through pre-RA schedule.
  ; Isolated register-coalescer: hard root membership holds (operand rewrites
  ; OK; no unbundle / private slot form).

  ; Still hard-bundled after machine-scheduler (pre-greedy).

  ; Assignment may rewrite operands; zero member loss/split.

  ; Physreg rewrite of members; hard root still wraps both ADD32.
