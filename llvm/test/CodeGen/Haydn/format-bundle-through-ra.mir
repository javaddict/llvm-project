# ============================================================================
# Test 2: spill pressure around a hard BUNDLE root.
# stress-regalloc may insert spill/reload around the root; membership holds.
# ============================================================================
name:            hard_bundle_spill_around
tracksRegLiveness: true
selected:        true
body:             |
