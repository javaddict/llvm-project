---
# ============================================================================
# Test 3: hard BUNDLE saturates Full 3-issue + resource-conflicting neighbors.
#
# Plan §5.1 / §8.3: dependent *and* resource-conflicting neighbors must not
# enter or split the hard root. A three-member logical ADD32 BUNDLE fills
# product issue width. Independent ADD32 neighbors share the same ALU/issue
# footprint and would conflict as a 4th co-issue candidate if the HR could
# see children — but the root is NoHazard, so isSchedulingBoundary is the
# fence that keeps them outside membership through sched → greedy → VRW.
# ============================================================================
name:            hard_bundle_resource_conflict
tracksRegLiveness: true
selected:        true
body:             |
  bb.0:
    liveins: $r1, $r2, $r3, $r4

    ; Four liveins + careful reuse so stress-regalloc=4 still completes with
    ; spill/reload around the root (ST/LD + three-member membership CHECKs
    ; below). Not six free temps.
    ; SCHED-LABEL: name: hard_bundle_resource_conflict
    ; SCHED: liveins: $r1, $r2, $r3, $r4
    ; SCHED-NEXT: {{  $}}
    ; SCHED-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r1
    ; SCHED-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $r2
    ; SCHED-NEXT: [[COPY2:%[0-9]+]]:gpr32 = COPY $r3
    ; SCHED-NEXT: [[COPY3:%[0-9]+]]:gpr32 = COPY $r4
    ; SCHED-NEXT: %rc_pre:gpr32 = ADD32 [[COPY]], [[COPY1]], implicit-def dead $sfr
    ; SCHED-NEXT: BUNDLE implicit-def %5, implicit-def %6, implicit-def %7, implicit-def dead $sfr, implicit [[COPY]], implicit [[COPY1]], implicit [[COPY2]], implicit [[COPY3]] {
    ; SCHED-NEXT:   [[ADD32_:%[0-9]+]]:gpr32 = ADD32 [[COPY]], [[COPY2]], implicit-def dead $sfr
    ; SCHED-NEXT:   [[ADD32_1:%[0-9]+]]:gpr32 = ADD32 [[COPY1]], [[COPY3]], implicit-def dead $sfr
    ; SCHED-NEXT:   [[ADD32_2:%[0-9]+]]:gpr32 = ADD32 [[COPY]], [[COPY3]], implicit-def dead $sfr
    ; SCHED-NEXT: }
    ; SCHED-NEXT: %dep:gpr32 = ADDI32 [[ADD32_]], 1, implicit-def dead $sfr
    ; SCHED-NEXT: %rc_post:gpr32 = ADD32 [[COPY1]], [[COPY2]], implicit-def dead $sfr
    ; SCHED-NEXT: %t0:gpr32 = ADD32 %rc_pre, [[ADD32_1]], implicit-def dead $sfr
    ; SCHED-NEXT: %t1:gpr32 = ADD32 %t0, [[ADD32_2]], implicit-def dead $sfr
    ; SCHED-NEXT: %t2:gpr32 = ADD32 %t1, %rc_post, implicit-def dead $sfr
    ; SCHED-NEXT: %t3:gpr32 = ADD32 %t2, %dep, implicit-def dead $sfr
    ; SCHED-NEXT: $r0 = COPY %t3
    ; SCHED-NEXT: RET implicit $r0, implicit $r15
    ;
    ; COALESCER-LABEL: name: hard_bundle_resource_conflict
    ; COALESCER: liveins: $r1, $r2, $r3, $r4
    ; COALESCER-NEXT: {{  $}}
    ; COALESCER-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r1
    ; COALESCER-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $r2
    ; COALESCER-NEXT: [[COPY2:%[0-9]+]]:gpr32 = COPY $r3
    ; COALESCER-NEXT: [[COPY3:%[0-9]+]]:gpr32 = COPY $r4
    ; COALESCER-NEXT: %rc_pre:gpr32 = ADD32 [[COPY]], [[COPY1]], implicit-def dead $sfr
    ; COALESCER-NEXT: BUNDLE implicit-def %5, implicit-def %6, implicit-def %7, implicit-def dead $sfr, implicit [[COPY]], implicit [[COPY1]], implicit [[COPY2]], implicit [[COPY3]] {
    ; COALESCER-NEXT:   [[ADD32_:%[0-9]+]]:gpr32 = ADD32 [[COPY]], [[COPY2]], implicit-def dead $sfr
    ; COALESCER-NEXT:   [[ADD32_1:%[0-9]+]]:gpr32 = ADD32 [[COPY1]], [[COPY3]], implicit-def dead $sfr
    ; COALESCER-NEXT:   [[ADD32_2:%[0-9]+]]:gpr32 = ADD32 [[COPY]], [[COPY3]], implicit-def dead $sfr
