# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop -run-pass=haydn-fixup-hwloops \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# Role: MIR — Fixup must preserve a legal coissued SET cycle.

# Fixup must preserve a legal coissued SET cycle. Input has a BUNDLE
# containing SET_HWLOOP_W + ADD32. Fixup pads Following to
# InterveningCycles=3 *after* the bundle (not by unbundling SET). The ADD32
# co-member must survive as a bundled sibling of SET.
#
# Also covers residual pad when Following is short (only 1 NOP after SET).
# Deficit pads are exact-committed singletons (BUNDLE + FormatID + member
# NOP) so second BR sees committed EncodedBytes.
#
# demote_coissue: REBASELINED 2026-08-22 (topics/hwloop PM2). The spacer
# puts StartOff past the soft margin but inside the hard uimm6 field; the
# former free lift (one NOP above the SET bundle) is deleted, so the SET
# now survives on the hard-limit re-check and the coissued ADD32 stays in
# the bundle. (Push the spacer past 252 B to exercise the actual demote —
# see hwloop-fixup-demote-range.mir demote_uimm6, which owns that arm.)

--- |
  define dso_local void @coissue_set() {
  entry:
    ret void
  }
  define dso_local void @demote_coissue(ptr nocapture writeonly %out) {
  entry:
    br label %spacer
  spacer:
    br label %body
  body:
    store i32 0, ptr %out, align 4
    br label %exit
  exit:
    ret void
  }

...
---
name:            coissue_set
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
body:             |
  ; CHECK-LABEL: name: coissue_set
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r1, $r0, $r2, $r15
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r0 = frame-setup XOR32 $r0, $r0, implicit-def dead $sfr
  ; CHECK-NEXT:   BUNDLE 0, implicit-def $r2, implicit-def dead $sfr, implicit $r0, implicit $r1 {
  ; CHECK-NEXT:     SET_HWLOOP_W 0, %bb.1, %bb.1, 4, implicit-def dead $sfr
  ; CHECK-NEXT:     $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   BUNDLE 0, 0 {
  ; CHECK-NEXT:     NOP{{(_S0)?}}
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $r1, $r0, $r2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   ST32 $r0, $r1, 0
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $r15
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   RET implicit killed $r15
  bb.0:
    liveins: $r1, $r0, $r2, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0, implicit-def dead $sfr
    ; Coissued SET cycle: SET_HWLOOP_W + ADD32 in one BUNDLE (FormatID 0).
    BUNDLE 0, implicit-def $r2, implicit-def dead $sfr, implicit $r0, implicit $r1 {
      SET_HWLOOP_W 0, %bb.1, %bb.1, 4, implicit-def dead $sfr
      $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    }
    ; Only one following parcel — Fixup must insert 2 more NOPs after the
    ; whole BUNDLE (InterveningCycles=3), without destroying coissue.
    NOP

  bb.1:
    liveins: $r1, $r0, $r2
    successors: %bb.2
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.2:
    liveins: $r15
    RET implicit killed $r15

# Coissued SET cycle preserved (never unbundled).
# Following pads: InterveningCycles=2. Input had one bare NOP after SET;
# Fixup exact-commits the deficit (1) as ProductFormatID singleton BUNDLE
# inserted before the existing bare NOP (InsertPt = nextBundleBoundary).

...
---
name:            demote_coissue
tracksRegLiveness: true
noVRegs:         true
body:             |
  ; CHECK-LABEL: name: demote_coissue
  ; REBASELINED 2026-08-22 (topics/hwloop PM2): the former free lift moved
  ; one NOP above the coissued SET bundle to shave StartOff below the soft
  ; margin; with the lift deleted (no peer reorders user code), the NOPs
  ; stay where the input put them and the SET survives on the hard-limit
  ; re-check alone (StartOff 228 B <= 252 B uimm6). The bundle-preserving
  ; contract (coissued SET+ADD cycle never unbundled) is unchanged.
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r1, $r0, $r2, $r15
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r0 = frame-setup XOR32 $r0, $r0, implicit-def dead $sfr
  ; CHECK-NEXT:   BUNDLE 0, implicit-def $r2, implicit-def dead $sfr, implicit $r0, implicit $r1 {
  ; CHECK-NEXT:     SET_HWLOOP_W 0, %bb.2, %bb.2, 8, implicit-def dead $sfr
  ; CHECK-NEXT:     $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.spacer:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $r1, $r0, $r2, $r15
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.body:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $r1, $r0, $r2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   ST32 $r0, $r1, 0
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3.exit:
  ; CHECK-NEXT:   liveins: $r15
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   RET implicit killed $r15
  bb.0.entry:
    liveins: $r1, $r0, $r2, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0, implicit-def dead $sfr
    ; Coissued SET + ADD. Spacer MBB pushes StartOff past the soft margin
    ; (hard field still holds — SET retained, no lift exists to move NOPs).
    BUNDLE 0, implicit-def $r2, implicit-def dead $sfr, implicit $r0, implicit $r1 {
      SET_HWLOOP_W 0, %bb.2, %bb.2, 8, implicit-def dead $sfr
      $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    }
    NOP
    NOP
    NOP

  ; 16×NOP spacer ≈ 256 B after Following → StartOff > 252.
  bb.1.spacer:
    liveins: $r1, $r0, $r2, $r15
    successors: %bb.2
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP

  bb.2.body:
    liveins: $r1, $r0, $r2
    successors: %bb.3
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.3.exit:
    liveins: $r15
    RET implicit killed $r15

# SET member erased; coissued ADD survives as an exact-committed product
# cycle (singleton BUNDLE root with rebuilt consolidated operands), never a
# bare residual real MI or a stale multi-member root that still lists SET uses.
# Final-real soft edge (exact-committed singletons).
