# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop -run-pass=postmisched \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=CHECK,POST
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=postmisched,haydn-fixup-hwloops -verify-machineinstrs %s -o - | \
# RUN:   FileCheck %s --check-prefixes=CHECK,FIX

# Role: MIR — Hard-root / coissued-SET operand recommit through postmisched
# and Fixup.
#
# Transactional exact-commit of a multi-member hard BUNDLE rebuilds the
# consolidated BUNDLE-root operands and kill flags from live children (plan
# recommit pin). Stale root ops (wrong defs, incomplete uses) must not survive.
# Coissued SET+ADD hard roots recommit the same way; Fixup keeps hardware SET
# and Following pads without unbundling or restoring stale root shells.
#
# Cases:
#   stale_hard_root_ops — unstamped dual-ADD hard root with deliberately wrong
#     root operands; postmisched leaveMBB recommit rebuilds defs/uses/kills and
#     stamps FormatID 0.
#   coissue_set_stale_root — coissued SET+ADD hard root with incomplete root;
#     recommit restores $r4 def; Fixup keeps hardware SET (Following already
#     meets InterveningCycles) without unbundling.
#   set_then_hard_stale — bare final SET then stale hard root; postmisched
#     recommit + Fixup Following pads; hard-root root ops stay rebuilt.

--- |
  define void @stale_hard_root_ops() { ret void }
  define void @coissue_set_stale_root() { ret void }
  define void @set_then_hard_stale() { ret void }
...
---
name:            stale_hard_root_ops
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r15

    ; Stale root: invents $r9 def, drops $r4/$r5, incomplete uses.
    ; CHECK-LABEL: name: stale_hard_root_ops
    ; CHECK: liveins: $r0, $r1, $r2, $r3, $r15
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE {{[01]}}, 0, implicit-def $r4, implicit-def dead $sfr, implicit-def $r5, implicit $r0, implicit killed $r1, implicit killed $r2, implicit killed $r3 {
    ; CHECK-NEXT:   $r4 = ADD32_E{{[23]}}_E{{[0-2]}}_{{.*}} $r0, killed $r1, implicit-def dead $sfr
    ; CHECK-NEXT:   $r5 = ADD32_E{{[23]}}_E{{[0-2]}}_{{.*}} killed $r2, killed $r3, implicit-def dead $sfr
    ; CHECK-NEXT: }
    ; CHECK-NEXT: $r6 = XOR32 killed $r4, killed $r5, implicit-def dead $sfr
    ; CHECK-NEXT: RET implicit $r15
    BUNDLE implicit-def $r9, implicit killed $r0 {
      $r4 = ADD32 $r0, $r1, implicit-def dead $sfr
      $r5 = ADD32 $r2, $r3, implicit-def dead $sfr
    }
    $r6 = XOR32 $r4, $r5, implicit-def dead $sfr
    RET implicit $r15


...
---
name:            coissue_set_stale_root
tracksRegLiveness: true
noVRegs:         true
body:             |
  ; POST-LABEL: name: coissue_set_stale_root
  ; POST: bb.0:
  ; POST-NEXT:   successors: %bb.1(0x80000000)
  ; POST-NEXT:   liveins: $r0, $r1, $r15
  ; POST-NEXT: {{  $}}
  ; POST-NEXT:   SET_HWLOOP_W 0, %bb.1, %bb.1, 2, implicit-def dead $sfr
  ; POST-NEXT:   $r4 = ADD32 $r0, killed $r1, implicit-def dead $sfr
  ; POST-NEXT:   NOP_S0
  ; POST-NEXT:   NOP_S0
  ; POST-NEXT:   NOP_S0
  ; POST-NEXT:   RET implicit $r15
  ; POST-NEXT: {{  $}}
  ; POST-NEXT: bb.1:
  ; POST-NEXT:   liveins: $r4, $r15
  ; POST-NEXT: {{  $}}
  ; POST-NEXT:   ST32 killed $r4, $r4, 0
  ; POST-NEXT:   RET implicit $r15
  ;
  ; FIX-LABEL: name: coissue_set_stale_root
  ; FIX: bb.0:
  ; FIX-NEXT:   successors: %bb.1(0x80000000)
  ; FIX-NEXT:   liveins: $r0, $r1, $r15
  ; FIX-NEXT: {{  $}}
  ; FIX-NEXT:   SET_HWLOOP_W 0, %bb.1, %bb.1, 2, implicit-def dead $sfr
  ; FIX-NEXT:   $r4 = ADD32 $r0, killed $r1, implicit-def dead $sfr
  ; FIX-NEXT:   NOP_S0
  ; FIX-NEXT:   NOP_S0
  ; FIX-NEXT:   NOP_S0
  ; FIX-NEXT:   RET implicit $r15
  ; FIX-NEXT: {{  $}}
  ; FIX-NEXT: bb.1:
  ; FIX-NEXT:   liveins: $r4, $r15
  ; FIX-NEXT: {{  $}}
  ; FIX-NEXT:   ST32 killed $r4, $r4, 0
  ; FIX-NEXT:   BUNDLE {{[01]}}, 0 {
  ; FIX-NEXT:     NOP_S0
  ; FIX-NEXT:   }
  ; FIX-NEXT:   RET implicit $r15
  bb.0:
    liveins: $r0, $r1, $r15
    successors: %bb.1

    ; Stale coissued SET+ADD hard root: missing $r4 def on the BUNDLE root.
    BUNDLE implicit-def dead $sfr, implicit killed $r0 {
      SET_HWLOOP_W 0, %bb.1, %bb.1, 2, implicit-def dead $sfr
      $r4 = ADD32 $r0, $r1, implicit-def dead $sfr
    }
    NOP
    NOP
    NOP
    RET implicit $r15

  bb.1:
    liveins: $r4, $r15
    ST32 $r4, $r4, 0
    RET implicit $r15

# Recommit restores $r4 def and keeps SET coissued under FormatID 0.

...
---
name:            set_then_hard_stale
tracksRegLiveness: true
noVRegs:         true
body:             |
  ; POST-LABEL: name: set_then_hard_stale
  ; POST: bb.0:
  ; POST-NEXT:   successors: %bb.1(0x80000000)
  ; POST-NEXT:   liveins: $r0, $r1, $r2, $r3, $r15
  ; POST-NEXT: {{  $}}
  ; POST-NEXT:   SET_HWLOOP_W 0, %bb.1, %bb.1, 3, implicit-def dead $sfr
  ; POST-NEXT:   BUNDLE {{[01]}}, 0, implicit-def $r4, implicit-def dead $sfr, implicit-def $r5, implicit $r0, implicit killed $r1, implicit killed $r2, implicit killed $r3 {
  ; POST-NEXT:     $r4 = ADD32_E{{[23]}}_E{{[0-2]}}_{{.*}} $r0, killed $r1, implicit-def dead $sfr
  ; POST-NEXT:     $r5 = ADD32_E{{[23]}}_E{{[0-2]}}_{{.*}} killed $r2, killed $r3, implicit-def dead $sfr
  ; POST-NEXT:   }
  ; POST-NEXT:   RET implicit $r15
  ; POST-NEXT: {{  $}}
  ; POST-NEXT: bb.1:
  ; POST-NEXT:   liveins: $r4, $r5, $r15
  ; POST-NEXT: {{  $}}
  ; POST-NEXT:   ST32 killed $r4, killed $r5, 0
  ; POST-NEXT:   RET implicit $r15
  ;
  ; FIX-LABEL: name: set_then_hard_stale
  ; FIX: bb.0:
  ; FIX-NEXT:   successors: %bb.1(0x80000000)
  ; FIX-NEXT:   liveins: $r0, $r1, $r2, $r3, $r15
  ; FIX-NEXT: {{  $}}
  ; FIX-NEXT:   SET_HWLOOP_W 0, %bb.1, %bb.1, 3, implicit-def dead $sfr
  ; FIX-NEXT:   BUNDLE {{[01]}}, 0 {
  ; FIX-NEXT:     NOP_S0
  ; FIX-NEXT:   }
  ; FIX-NEXT:   BUNDLE {{[01]}}, 0, implicit-def $r4, implicit-def dead $sfr, implicit-def $r5, implicit $r0, implicit killed $r1, implicit killed $r2, implicit killed $r3 {
  ; FIX-NEXT:     $r4 = ADD32_E{{[23]}}_E{{[0-2]}}_{{.*}} $r0, killed $r1, implicit-def dead $sfr
  ; FIX-NEXT:     $r5 = ADD32_E{{[23]}}_E{{[0-2]}}_{{.*}} killed $r2, killed $r3, implicit-def dead $sfr
  ; FIX-NEXT:   }
  ; FIX-NEXT:   RET implicit $r15
  ; FIX-NEXT: {{  $}}
  ; FIX-NEXT: bb.1:
  ; FIX-NEXT:   liveins: $r4, $r5, $r15
  ; FIX-NEXT: {{  $}}
  ; FIX-NEXT:   ST32 killed $r4, killed $r5, 0
  ; FIX-NEXT:   BUNDLE {{[01]}}, 0 {
  ; FIX-NEXT:     NOP_S0
  ; FIX-NEXT:   }
  ; FIX-NEXT:   RET implicit $r15
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r15
    successors: %bb.1

    SET_HWLOOP_W 0, %bb.1, %bb.1, 3, implicit-def dead $sfr
    ; Stale hard root after SET (Following seed for Fixup deficit pads).
    BUNDLE implicit-def $r9, implicit killed $r0 {
      $r4 = ADD32 $r0, $r1, implicit-def dead $sfr
      $r5 = ADD32 $r2, $r3, implicit-def dead $sfr
    }
    RET implicit $r15

  bb.1:
    liveins: $r4, $r5, $r15
    ST32 $r4, $r5, 0
    RET implicit $r15

# Fixup pads Following (InterveningCycles=2 → one pad when Following=1)
# then keeps rebuilt hard-root operands (not $r9).
