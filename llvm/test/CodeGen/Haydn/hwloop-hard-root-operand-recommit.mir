# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop -run-pass=postmisched \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=CHECK,POST
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=postmisched,haydn-fixup-hwloops -verify-machineinstrs %s -o - | \
# RUN:   FileCheck %s --check-prefixes=CHECK,FIX

# Role: MIR — Hard-root / coissued-SET operand recommit through postmisched
# and Fixup.
#
# Transactional exact-commit of a multi-member hard BUNDLE rebuilds the
# consolidated BUNDLE-root operands and kill flags from live children (plan
# recommit pin). Stale root ops (wrong defs, incomplete uses) must not survive.
# Coissued SET+ADD hard roots recommit the same way; Fixup keeps hardware SET
# and Following pads without unbundling or restoring stale root shells.
#
# Cases:
#   stale_hard_root_ops — unstamped dual-ADD hard root with deliberately wrong
#     root operands; postmisched leaveMBB recommit rebuilds defs/uses/kills and
#     stamps FormatID 0.
#   coissue_set_stale_root — coissued SET+ADD hard root with incomplete root;
#     recommit restores $r4 def; Fixup keeps hardware SET (Following already
#     meets InterveningCycles) without unbundling.
#   set_then_hard_stale — bare final SET then stale hard root; postmisched
#     recommit + Fixup Following pads; hard-root root ops stay rebuilt.
#     REBASELINE 2026-08-23 (W61 tail credit): the Following walk now counts
#     the first size-bearing terminator (RET on the fallthrough path to the
#     loop target), so SET + hard root + RET = 3 parcels = SetupIssueDistance
#     and the old single-NOP pad is correctly gone. Same QoR delta class as
#     hwloop-su-tail-credit.mir.
#
# W39 fixture hygiene (2026-08-16): historical noise `implicit-def dead $sfr`
# operands on ALU members were removed (ALU descs carry no implicit SFR def;
# under the unified no-dual-write law they mask the intended packing). W39
# itself is pinned by w39-dead-def-dual-write-waw.mir.

--- |
  define void @stale_hard_root_ops() { ret void }
  define void @coissue_set_stale_root() { ret void }
  define void @set_then_hard_stale() { ret void }
...
---
name:            stale_hard_root_ops
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r15

    ; Stale root: invents $r9 def, drops $r4/$r5, incomplete uses.
    ; CHECK-LABEL: name: stale_hard_root_ops
    ; CHECK: liveins: $r0, $r1, $r2, $r3, $r15
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE 1, 0, implicit-def $r5, implicit-def $r4, implicit killed $r2, implicit killed $r3, implicit $r0, implicit killed $r1 {
    ; CHECK-NEXT:   $r5 = ADD32_E3_E1_ALU1_RR killed $r2, killed $r3
    ; CHECK-NEXT:   $r4 = ADD32_E3_E0_ALU2_RR $r0, killed $r1
    ; CHECK-NEXT: }
    ; CHECK-NEXT: $r6 = XOR32{{(_E2_[^ ]+)?}} killed $r4, killed $r5
    ; CHECK-NEXT: {{RET|JALR}} implicit $r15
    BUNDLE implicit-def $r9, implicit killed $r0 {
      $r4 = ADD32 $r0, $r1
      $r5 = ADD32 $r2, $r3
    }
    $r6 = XOR32 $r4, $r5
    RET implicit $r15


...
---
name:            coissue_set_stale_root
tracksRegLiveness: true
noVRegs:         true
body:             |
  ; POST-LABEL: name: coissue_set_stale_root
  ; POST: bb.0:
  ; POST-NEXT:   successors: %bb.1(0x80000000)
  ; POST-NEXT:   liveins: $r0, $r1, $r15
  ; POST-NEXT: {{  $}}
  ; POST-NEXT:   BUNDLE 0, 0, implicit-def $r4, implicit-def dead $sfr, implicit $r0, implicit killed $r1 {
  ; POST-NEXT:     $r4 = ADD32{{(_E2_[^ ]+)?}} $r0, killed $r1
  ; POST-NEXT:     SET_HWLOOP_W 0, %bb.1, %bb.1, 2, implicit-def dead $sfr
  ; POST-NEXT:   }
  ; POST-NEXT:   NOP
  ; POST-NEXT:   NOP
  ; POST-NEXT:   NOP
  ; POST-NEXT:   RET implicit $r15
  ; POST-NEXT: {{  $}}
  ; POST-NEXT: bb.1:
  ; POST-NEXT:   liveins: $r4, $r15
  ; POST-NEXT: {{  $}}
  ; POST-NEXT:   {{ST32|S_SW_WITH_IMM[^ ]*}} killed $r4, $r4, 0
  ; POST-NEXT:   RET implicit $r15
  ;
  ; FIX-LABEL: name: coissue_set_stale_root
  ; FIX: bb.0:
  ; FIX-NEXT:   successors: %bb.1(0x80000000)
  ; FIX-NEXT:   liveins: $r0, $r1, $r15
  ; FIX-NEXT: {{  $}}
  ; FIX-NEXT:   BUNDLE 0, 0, implicit-def $r4, implicit-def dead $sfr, implicit $r0, implicit killed $r1 {
  ; FIX-NEXT:     $r4 = ADD32 $r0, killed $r1
  ; FIX-NEXT:     SET_HWLOOP_W 0, %bb.1, %bb.1, 2, implicit-def dead $sfr
  ; FIX-NEXT:   }
  ; FIX-NEXT:   NOP
  ; FIX-NEXT:   NOP
  ; FIX-NEXT:   NOP
  ; FIX-NEXT:   RET implicit $r15
  ; FIX-NEXT: {{  $}}
  ; FIX-NEXT: bb.1:
  ; FIX-NEXT:   liveins: $r4, $r15
  ; FIX-NEXT: {{  $}}
  ; FIX-NEXT:   ST32 killed $r4, $r4, 0
  ; FIX-NEXT:   BUNDLE 0, 0 {
  ; FIX-NEXT:     NOP
  ; FIX-NEXT:   }
  ; FIX-NEXT:   BUNDLE 0, 0 {
  ; FIX-NEXT:     NOP
  ; FIX-NEXT:   }
  ; FIX-NEXT:   RET implicit $r15
  bb.0:
    liveins: $r0, $r1, $r15
    successors: %bb.1

    ; Stale coissued SET+ADD hard root: missing $r4 def on the BUNDLE root.
    BUNDLE implicit killed $r0 {
      SET_HWLOOP_W 0, %bb.1, %bb.1, 2, implicit-def dead $sfr
      $r4 = ADD32 $r0, $r1
    }
    NOP
    NOP
    NOP
    RET implicit $r15

  bb.1:
    liveins: $r4, $r15
    ST32 $r4, $r4, 0
    RET implicit $r15

# Recommit restores $r4 def and keeps SET coissued under FormatID 0.

...
---
name:            set_then_hard_stale
tracksRegLiveness: true
noVRegs:         true
body:             |
  ; POST-LABEL: name: set_then_hard_stale
  ; POST: bb.0:
  ; POST-NEXT:   successors: %bb.1(0x80000000)
  ; POST-NEXT:   liveins: $r0, $r1, $r2, $r3, $r15
  ; POST-NEXT: {{  $}}
  ; POST-NEXT:   SET_HWLOOP_W 0, %bb.1, %bb.1, 3, implicit-def dead $sfr
  ; POST-NEXT:   BUNDLE 1, 0, implicit-def $r5, implicit-def $r4, implicit killed $r2, implicit killed $r3, implicit $r0, implicit killed $r1 {
  ; POST-NEXT:     $r5 = ADD32_E3_E1_ALU1_RR killed $r2, killed $r3
  ; POST-NEXT:     $r4 = ADD32_E3_E0_ALU2_RR $r0, killed $r1
  ; POST-NEXT:   }
  ; POST-NEXT:   RET implicit $r15
  ; POST-NEXT: {{  $}}
  ; POST-NEXT: bb.1:
  ; POST-NEXT:   liveins: $r4, $r5, $r15
  ; POST-NEXT: {{  $}}
  ; POST-NEXT:   ST32 killed $r4, killed $r5, 0
  ; POST-NEXT:   RET implicit $r15
  ;
  ; FIX-LABEL: name: set_then_hard_stale
  ; FIX: bb.0:
  ; FIX-NEXT:   successors: %bb.1(0x80000000)
  ; FIX-NEXT:   liveins: $r0, $r1, $r2, $r3, $r15
  ; FIX-NEXT: {{  $}}
  ; FIX-NEXT:   SET_HWLOOP_W 0, %bb.1, %bb.1, 3, implicit-def dead $sfr
  ; FIX-NEXT:   BUNDLE 1, 0, implicit-def $r5, implicit-def $r4, implicit killed $r2, implicit killed $r3, implicit $r0, implicit killed $r1 {
  ; FIX-NEXT:     $r5 = ADD32_E3_E1_ALU1_RR killed $r2, killed $r3
  ; FIX-NEXT:     $r4 = ADD32_E3_E0_ALU2_RR $r0, killed $r1
  ; FIX-NEXT:   }
  ; FIX-NEXT:   RET implicit $r15
  ; FIX-NEXT: {{  $}}
  ; FIX-NEXT: bb.1:
  ; FIX-NEXT:   liveins: $r4, $r5, $r15
  ; FIX-NEXT: {{  $}}
  ; FIX-NEXT:   ST32 killed $r4, killed $r5, 0
  ; FIX-NEXT:   BUNDLE 0, 0 {
  ; FIX-NEXT:     NOP
  ; FIX-NEXT:   }
  ; FIX-NEXT:   BUNDLE 0, 0 {
  ; FIX-NEXT:     NOP
  ; FIX-NEXT:   }
  ; FIX-NEXT:   RET implicit $r15
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r15
    successors: %bb.1

    SET_HWLOOP_W 0, %bb.1, %bb.1, 3, implicit-def dead $sfr
    ; Stale hard root after SET (Following seed for Fixup deficit pads).
    BUNDLE implicit-def $r9, implicit killed $r0 {
      $r4 = ADD32 $r0, $r1
      $r5 = ADD32 $r2, $r3
    }
    RET implicit $r15

  bb.1:
    liveins: $r4, $r5, $r15
    ST32 $r4, $r5, 0
    RET implicit $r15

# Fixup pads Following (InterveningCycles=2 → one pad when Following=1)
# and pads the body to MinBodyBundles=3 (F45 law: HWLR_END is the last
# size-bearing non-terminator cycle, so a single ST32 body needs 2 NOP
# parcels, not 1) then keeps rebuilt hard-root operands (not $r9).
