    NOP
    RET implicit killed $r15

  bb.2.far:
    liveins: $r15
    RET implicit killed $r15

# PRE-LABEL: name:            two_far_conds
# PRE: bb.0.entry
# PRE: BEQZ{{.*}} $r7, %bb.2
# PRE: BEQZ{{.*}} $r8, %bb.2
# PRE-NOT: LUI
# PRE-NOT: JALR
# PRE: bb.1.near
#
# POST: far cond in unanalyzable/one-way cycle has no range owner
