; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=haydn-unknown-elf -global-isel-abort=1 -verify-machineinstrs < %s | FileCheck %s

; Role: semantic — FrameLowering emits no FP setup when hasFP is false.

; REBASELINED : scheduling changed (//) — bundles regrouped, ops unchanged.


;
; HaydnPEIPeephole is deleted. FrameLowering emits FP setup only when
; hasFP() is true (F10). These CHECKs lock prologue/epilogue shape:
; 1. Soft-zero xor32 r0, r0, r0 in the prologue
; 2. No R14/FP setup when the function does not need a frame pointer

;===----------------------------------------------------------------------===;;
; Test 1: Simple function without FP — prologue should have exactly one
; ZERO_GPR R0 and no FP setup (R14) instructions.
;===----------------------------------------------------------------------===;;

define i32 @test_simple_no_fp(i32 %a, i32 %b) {
; CHECK-LABEL: test_simple_no_fp:
; CHECK:       // %bb.0:
; CHECK-NEXT:    { nop; xor32 r0, r0, r0 }
; CHECK-NEXT:    { nop; subi32 sp, sp, 8 }
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    { nop; add32 r1, r1, r2 }
; CHECK-NEXT:    { nop; xor32 r0, r0, r0 }
; CHECK-NEXT:    { nop; addi32 sp, sp, 8 }
; CHECK-NEXT:    .cfi_def_cfa sp, 0
; CHECK-NEXT:    { nop; jalr r0, lr, 0 }
  %r = add i32 %a, %b
  ret i32 %r
}

;===----------------------------------------------------------------------===;;
; Test 2: Function with a stack slot (local variable) but no FP.
; The prologue allocates stack space but should not set up R14.
;===----------------------------------------------------------------------===;;

define i32 @test_stack_slot_no_fp(i32 %a) {
; CHECK-LABEL: test_stack_slot_no_fp:
; CHECK:       // %bb.0:
; CHECK-NEXT:    { nop; xor32 r0, r0, r0 }
; CHECK-NEXT:    { nop; subi32 sp, sp, 16 }
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    { nop; addi32 r2, sp, 12 }
; CHECK-NEXT:    { nop; st32 r1, r2, 0 }
; CHECK-NEXT:    { nop; nop }
; CHECK-NEXT:    { nop; ld32 r1, r2, 0 }
; CHECK-NEXT:    { nop; xor32 r0, r0, r0 }
; CHECK-NEXT:    { nop; addi32 sp, sp, 16 }
; CHECK-NEXT:    .cfi_def_cfa sp, 0
; CHECK-NEXT:    { nop; jalr r0, lr, 0 }
  %local = alloca i32
  store i32 %a, ptr %local
  %loaded = load i32, ptr %local
  ret i32 %loaded
}

;===----------------------------------------------------------------------===;;
; Test 3: Leaf function (no calls, minimal frame). Soft-zero R0 and a
; small stack adjust; no FP.
;===----------------------------------------------------------------------===;;

define i32 @test_leaf(i32 %x) {
; CHECK-LABEL: test_leaf:
; CHECK:       // %bb.0:
; CHECK-NEXT:    { nop; xor32 r0, r0, r0 }
; CHECK-NEXT:    { nop; subi32 sp, sp, 8 }
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    { nop; addi32 r2, r0, 3 }
; CHECK-NEXT:    { nop; mull r2, r1, r2 }
; CHECK-NEXT:    { nop; nop }
; CHECK-NEXT:    { nop; move32 r1, r2 }
; CHECK-NEXT:    { nop; xor32 r0, r0, r0 }
; CHECK-NEXT:    { nop; addi32 sp, sp, 8 }
; CHECK-NEXT:    .cfi_def_cfa sp, 0
; CHECK-NEXT:    { nop; jalr r0, lr, 0 }
  %r = mul i32 %x, 3
  ret i32 %r
}

;===----------------------------------------------------------------------===;;
; Test 4: Function with a call — forces callee-save spills, larger frame.
; Still no FP unless forced.
;===----------------------------------------------------------------------===;;

declare void @extern_func(i32)

define void @test_with_call(i32 %val) {
; CHECK-LABEL: test_with_call:
; CHECK:       // %bb.0:
; CHECK-NEXT:    { nop; xor32 r0, r0, r0 }
; CHECK-NEXT:    { nop; subi32 sp, sp, 16 }
; CHECK-NEXT:    { nop; st32 lr, sp, 3 }
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    .cfi_offset lr, -4
; CHECK-NEXT:    { nop; jal lr, extern_func }
; CHECK-NEXT:    { nop; xor32 r0, r0, r0 }
; CHECK-NEXT:    { nop; ld32 lr, sp, 3 }
; CHECK-NEXT:    { nop; addi32 sp, sp, 16 }
; CHECK-NEXT:    .cfi_def_cfa sp, 0
; CHECK-NEXT:    { nop; jalr r0, lr, 0 }
  call void @extern_func(i32 %val)
  ret void
}

;===----------------------------------------------------------------------===;;
; Test 5: Multiple basic blocks — FrameLowering prologue still has
; exactly the entry soft-zero, not an FP setup.
;===----------------------------------------------------------------------===;;

define i32 @test_multi_bb(i32 %n) {
; CHECK-LABEL: test_multi_bb:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    { nop; xor32 r0, r0, r0 }
; CHECK-NEXT:    { nop; subi32 sp, sp, 8 }
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    { nop; addi32 r2, r0, 0 }
; CHECK-NEXT:    { nop; slt32 r3, r2, r1 }
; CHECK-NEXT:    { nop; xori32 r3, r3, 1 }
; CHECK-NEXT:    { nop; bnez r3, .LBB4_2 }
; CHECK-NEXT:  // %bb.1: // %pos
; CHECK-NEXT:    { nop; addi32 r1, r1, 10 }
; CHECK-NEXT:    { nop; beqz_w r0, .LBB4_3 }
; CHECK-NEXT:  .LBB4_2: // %neg
; CHECK-NEXT:    { nop; sub32 r1, r2, r1 }
; CHECK-NEXT:  .LBB4_3: // %pos
; CHECK-NEXT:    { nop; xor32 r0, r0, r0 }
; CHECK-NEXT:    { nop; addi32 sp, sp, 8 }
; CHECK-NEXT:    .cfi_def_cfa sp, 0
; CHECK-NEXT:    { nop; jalr r0, lr, 0 }
entry:
  %cmp = icmp sgt i32 %n, 0
  br i1 %cmp, label %pos, label %neg

pos:
  %p = add i32 %n, 10
  ret i32 %p

neg:
  %q = sub i32 0, %n
  ret i32 %q
}

;===----------------------------------------------------------------------===;;
; Test 6: Frame-pointer forced via attribute — FP setup should NOT be
; eliminated when the user explicitly requests a frame pointer.
; (We cannot easily force hasFP=true from IR alone, but this test
; documents the intent and ensures no mis-optimization when FP
; is present.)
;===----------------------------------------------------------------------===;;

define i32 @test_many_args(i32 %a, i32 %b, i32 %c, i32 %d, i32 %e,
; CHECK-LABEL: test_many_args:
; CHECK:       // %bb.0:
; CHECK-NEXT:    { nop; xor32 r0, r0, r0 }
; CHECK-NEXT:    { nop; subi32 sp, sp, 8 }
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    { nop; addi32 r12, sp, 8 }
; CHECK-NEXT:    { nop; ld32 r12, r12, 0 }
; CHECK-NEXT:    { nop; add32 r1, r1, r2 }
; CHECK-NEXT:    { add32 r3, r5, r6; add32 r2, r3, r4 }
; CHECK-NEXT:    { add32 r1, r1, r2; add32 r4, r7, r12 }
; CHECK-NEXT:    { nop; add32 r2, r3, r4 }
; CHECK-NEXT:    { nop; add32 r1, r1, r2 }
; CHECK-NEXT:    { nop; xor32 r0, r0, r0 }
; CHECK-NEXT:    { nop; addi32 sp, sp, 8 }
; CHECK-NEXT:    .cfi_def_cfa sp, 0
; CHECK-NEXT:    { nop; jalr r0, lr, 0 }
                           i32 %f, i32 %g, i32 %h) {
  %s1 = add i32 %a, %b
  %s2 = add i32 %c, %d
  %s3 = add i32 %e, %f
  %s4 = add i32 %g, %h
  %t1 = add i32 %s1, %s2
  %t2 = add i32 %s3, %s4
  %r = add i32 %t1, %t2
  ret i32 %r
}
