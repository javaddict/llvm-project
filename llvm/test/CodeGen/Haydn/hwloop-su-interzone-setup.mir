# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -misched-postra-direction=topdown \
# RUN:   -run-pass=postmisched -verify-machineinstrs %s -o - | \
# RUN:   FileCheck %s --check-prefixes=CHECK,TOP
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -misched-postra-direction=bottomup \
# RUN:   -run-pass=postmisched -verify-machineinstrs %s -o - | \
# RUN:   FileCheck %s --check-prefixes=CHECK,BOT
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -misched-postra-direction=bidirectional \
# RUN:   -run-pass=postmisched -verify-machineinstrs %s -o - | \
# RUN:   FileCheck %s --check-prefixes=CHECK,BI
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -misched-postra-direction=topdown \
# RUN:   -run-pass=postmisched,haydn-fixup-hwloops -verify-machineinstrs %s -o - | \
# RUN:   FileCheck %s --check-prefixes=CHECK,FIX
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -misched-postra-direction=bottomup \
# RUN:   -run-pass=postmisched,haydn-fixup-hwloops -verify-machineinstrs %s -o - | \
# RUN:   FileCheck %s --check-prefixes=CHECK,FIXBOT

# Role: MIR — HWLOOP-SU setup distance under dual-zone leaveRegion conflicts.
#
# ZOLSetupExitLatency raises the forward ExitSU Artificial edge by
# SetupIssueDistance (4) so top-down ExitSU.TopReadyCycle drives
# handleRegionConflicts ExitReady pads, and the reverse Preds edge by
# distance-1 so bot-up/bidirectional BotCurr still covers InterveningCycles
# following after SET. Inter-zone scoreboard pads only lengthen Top.
#
# Multi-MI preheader (independent ALU + SET, no formation pads) so the list
# scheduler actually runs (single-MI regions are skipped — Fixup residual
# owns those).
#
# Every direction must keep SET and yield at least InterveningCycles (2)
# size-bearing parcels after the SET cycle (NOP and/or real work). Fixup
# residual must not demote SET when leaveRegion already padded.

--- |
  define void @interzone_setup() { ret void }
...
---
name:            interzone_setup
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r2, $r15
    successors: %bb.1

    ; Independent ALU + SET, no formation pads. Forces postmisched +
    ; handleRegionConflicts (ExitReady / inter-zone) or bot-up reverse edge
    ; to materialize Following >= InterveningCycles after SET.
    $r3 = ADD32 $r1, $r2, implicit-def dead $sfr
    SET_HWLOOP_W 0, %bb.1, %bb.1, 2, implicit-def dead $sfr

  bb.1:
    liveins: $r3, $r15
    successors: %bb.2
    $r1 = COPY $r3
    NOP
    NOP
    NOP

  bb.2:
    liveins: $r1, $r15
    $r1 = COPY $r1
    RET implicit killed $r15, implicit $r1

# CHECK-LABEL: name: interzone_setup
#
# Top-down: one-SFR-writer law keeps SET+ADD sequential (both def dead $sfr);
# InterveningCycles trailing idle NOPs still come from ExitReady
# (handleRegionConflicts ExitReady arm; SetupIssueDistance edge).
# TOP: SET_HWLOOP
# TOP: ADD32
# TOP: NOP
# TOP: bb.1
# TOP: RET
#
# Bot-up / bidirectional: reverse edge forces region length >= SetupIssueDistance.
# SET is earliest; following is ADD + NOP (InterveningCycles size-bearing).
# BOT: SET_HWLOOP
# BOT: ADD32
# BOT: NOP
# BOT: bb.1
# BOT: RET
#
# BI: SET_HWLOOP
# BI: ADD32
# BI: NOP
# BI: bb.1
# BI: RET
#
# Fixup residual after leaveRegion pads: SET kept, no software demote.
# FIX: SET_HWLOOP
# FIX: NOP
# FIX: NOP
# FIX: RET
# FIX-NOT: SUBI32
# FIX-NOT: BNEZ
# FIXBOT: SET_HWLOOP
# FIXBOT: RET
# FIXBOT-NOT: SUBI32
# FIXBOT-NOT: BNEZ
