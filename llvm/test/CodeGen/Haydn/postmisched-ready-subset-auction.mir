# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postmisched -verify-machineinstrs %s -o - | FileCheck %s

# Role: MIR — Post-RA bounded ready-subset cycle auction: densest exact-legal fill of the open issue cycle (≤3 members) under product matching.

# Post-RA bounded ready-subset cycle auction: densest exact-legal fill of the
# open issue cycle (≤3 members) under product matching. Exact no-split commit
# still owns BUNDLE roots (NumScheduledCyclesSplit == 0). Selected format-member
# opcodes (_S*) are the post-setDesc identity — pin their order, not only
# logical CHECK-DAG membership.
#
# 1. Independent ALU ops: auction densest legal multi-MI under ready state
#    (selected members ordered by format SlotMap / S2→S1→S0 materialize).
# 2. ADD32 + 2×ADD64 rematch triple packs one BUNDLE with selected members
#    ADD64, ADD64, ADD32_S0 (exact rematch, not first-fit starvation).
# 3. Dual ST32 still serializes (auction densest legal size is 1 per cycle).

--- |
  define void @auction_three_alu() { ret void }
  define void @auction_add32_2xadd64() { ret void }
  define void @auction_dual_store_serial() { ret void }
...
---
name:            auction_three_alu
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
  - { reg: '$r5', virtual-reg: '' }
  - { reg: '$r6', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r3, $r4, $r5, $r6

    ; Independent ALU ops — pin selected format-member order inside the first
    ; multi-MI cycle (post-setDesc). Residual ALU may follow as a singleton.
    ; CHECK-LABEL: name: auction_three_alu
    ; CHECK: liveins: $r0, $r3, $r4, $r5, $r6
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2 = ADDI32{{.*}} $r0, 10, implicit-def dead $sfr
    ; CHECK-NEXT: $r7 = ADD32{{.*}} killed $r3, killed $r4, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY{{.*}}$r2
    ; CHECK-NEXT: $r8 = XOR32{{.*}} killed $r5, killed $r6, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADDI32 $r0, 10, implicit-def dead $sfr
    $r7 = ADD32 killed $r3, killed $r4, implicit-def dead $sfr
    $r8 = XOR32 killed $r5, killed $r6, implicit-def dead $sfr
    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15

...
---
name:            auction_add32_2xadd64
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$d1', virtual-reg: '' }
  - { reg: '$d2', virtual-reg: '' }
  - { reg: '$d3', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r1, $r2, $d0, $d1, $d2, $d3

    ; Three-ready rematch product: ADD32 + 2×ADD64 in one Format E.
    ; Preferred first-fit freezes ADD32 high then loses the second ADD64;
    ; exact matching rematches ADD32 onto S0 so all three co-issue. Selected
    ; members (applyFormatOrdering S2→S1→S0): ADD64, ADD64, ADD32_S0.
    ; CHECK-LABEL: name: auction_add32_2xadd64
    ; CHECK: liveins: $r1, $r2, $d0, $d1, $d2, $d3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r3 = ADD32{{.*}} killed $r1, killed $r2, implicit-def dead $sfr
    ; CHECK-NEXT: $d4 = ADD64{{.*}} killed $d0, killed $d1, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY{{.*}}$r3
    ; CHECK-NEXT: $d5 = ADD64{{.*}} killed $d2, killed $d3, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit killed $d4, implicit killed $d5, implicit $r15
    $r3 = ADD32 $r1, $r2, implicit-def dead $sfr
    $d4 = ADD64 $d0, $d1, implicit-def dead $sfr
    $d5 = ADD64 $d2, $d3, implicit-def dead $sfr
    $r0 = COPY $r3
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $d4, implicit $d5, implicit $r15

...
---
name:            auction_dual_store_serial
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r1, $r2, $r3, $r4

    ; Dual S0-only stores: auction densest legal size is 1 — never one BUNDLE.
    ; CHECK-LABEL: name: auction_dual_store_serial
    ; CHECK: liveins: $r1, $r2, $r3, $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: {{ST32|S_SW_WITH_IMM}}{{.*}} killed $r2, killed $r1, 0
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: {{ST32|S_SW_WITH_IMM}}{{.*}} killed $r4, killed $r3, 4
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    ST32 $r2, $r1, 0
    ST32 $r4, $r3, 4
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15

...
