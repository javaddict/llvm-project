...

---
name:            test_shl_s64
legalized:       false
# CHECK-LABEL: name: test_shl_s64
# CHECK: %{{[0-9]+}}:_(s64) = G_SHL
body:             |
  bb.0.entry:
    liveins: $d0, $r0
    %0:_(s64) = COPY $d0
    %1:_(s32) = COPY $r0
    %2:_(s64) = G_SHL %0, %1
    $d0 = COPY %2(s64)
    RET implicit $d0, implicit $r0, implicit $r15
...

---
name:            test_lshr_s64
legalized:       false
# CHECK-LABEL: name: test_lshr_s64
# CHECK: %{{[0-9]+}}:_(s64) = G_LSHR
body:             |
  bb.0.entry:
    liveins: $d0, $r0
    %0:_(s64) = COPY $d0
    %1:_(s32) = COPY $r0
    %2:_(s64) = G_LSHR %0, %1
    $d0 = COPY %2(s64)
    RET implicit $d0, implicit $r0, implicit $r15
...

---
name:            test_ashr_s64
legalized:       false
# CHECK-LABEL: name: test_ashr_s64
# CHECK: %{{[0-9]+}}:_(s64) = G_ASHR
body:             |
  bb.0.entry:
    liveins: $d0, $r0
    %0:_(s64) = COPY $d0
    %1:_(s32) = COPY $r0
    %2:_(s64) = G_ASHR %0, %1
    $d0 = COPY %2(s64)
    RET implicit $d0, implicit $r0, implicit $r15
...

---
name:            test_icmp_s64
legalized:       false
# CHECK-LABEL: name: test_icmp_s64
# CHECK: %{{[0-9]+}}:_(s1) = G_ICMP intpred(sgt)
# CHECK: G_SELECT
body:             |
  bb.0.entry:
    liveins: $d0, $d1
    %0:_(s64) = COPY $d0
    %1:_(s64) = COPY $d1
    %2:_(s1) = G_ICMP intpred(sgt), %0, %1
    %3:_(s64) = G_SELECT %2, %0, %1
    $d0 = COPY %3
    RET implicit $d0, implicit $r0, implicit $r15
...

---
name:            test_merge_unmerge_s64
legalized:       false
# CHECK-LABEL: name: test_merge_unmerge_s64
# CHECK: COPY $r0
# CHECK: COPY $r1
# NOTE: G_MERGE_VALUES + G_UNMERGE_VALUES are eliminated by the legalizer
# as they cancel out (merge then immediately unmerge = identity).
body:             |
  bb.0.entry:
    liveins: $r0, $r1
    %0:_(s32) = COPY $r0
    %1:_(s32) = COPY $r1
    %2:_(s64) = G_MERGE_VALUES %0(s32), %1(s32)
    %3:_(s32), %4:_(s32) = G_UNMERGE_VALUES %2(s64)
    $r0 = COPY %3(s32)
    $r1 = COPY %4(s32)
    RET implicit $r0, implicit $r1, implicit $r15
...

---
name:            test_sext_s32_to_s64
legalized:       false
# CHECK-LABEL: name: test_sext_s32_to_s64
# CHECK: G_SEXT
body:             |
  bb.0.entry:
    liveins: $r0
    %0:_(s32) = COPY $r0
    %1:_(s64) = G_SEXT %0(s32)
    $d0 = COPY %1(s64)
    RET implicit $d0, implicit $r0, implicit $r15
...

---
name:            test_zext_s32_to_s64
legalized:       false
# CHECK-LABEL: name: test_zext_s32_to_s64
# CHECK: G_ZEXT
body:             |
  bb.0.entry:
    liveins: $r0
    %0:_(s32) = COPY $r0
    %1:_(s64) = G_ZEXT %0(s32)
    $d0 = COPY %1(s64)
    RET implicit $d0, implicit $r0, implicit $r15
...

---
name:            test_trunc_s64_to_s32
legalized:       false
# CHECK-LABEL: name: test_trunc_s64_to_s32
# CHECK: G_TRUNC
body:             |
  bb.0.entry:
    liveins: $d0
    %0:_(s64) = COPY $d0
    %1:_(s32) = G_TRUNC %0(s64)
    $r0 = COPY %1(s32)
    RET implicit $r0, implicit $r15
...

---
name:            test_load_s64
legalized:       false
# CHECK-LABEL: name: test_load_s64
# CHECK: G_LOAD
body:             |
  bb.0.entry:
    liveins: $r0
    %0:_(p0) = COPY $r0
    %1:_(s64) = G_LOAD %0(p0) :: (load (s64))
    $d0 = COPY %1(s64)
    RET implicit $d0, implicit $r0, implicit $r15
...

---
name:            test_store_s64
legalized:       false
# CHECK-LABEL: name: test_store_s64
# CHECK: G_STORE
body:             |
  bb.0.entry:
    liveins: $d0, $r0
    %0:_(s64) = COPY $d0
    %1:_(p0) = COPY $r0
    G_STORE %0(s64), %1(p0) :: (store (s64))
    RET implicit $d0, implicit $r0, implicit $r15
...
