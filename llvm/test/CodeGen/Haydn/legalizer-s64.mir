# RUN: llc -mtriple=haydn-unknown-elf -run-pass=legalizer %s -o - | FileCheck %s

# Role: MIR — that 64-bit integer operations are legalized via DR64 instructions s64 add/sub should remain legal (handled by DR64).

# Test that 64-bit integer operations are legalized via DR64 instructions
# s64 add/sub should remain legal (handled by DR64)
# s64 mul is custom-lowered to a native schoolbook of G_HAYDN_MUL64_WIDENU
# partials (true 64x64) -- no LIBCALL_MUL64 / __muldi3. Selection to
# MUL64_ULUL is instruction-select, not this pass.
# s64 bitwise/shift/cmp operations are legal, selector handles DR64 mapping

---
name:            test_add_s64
legalized:       false
# CHECK-LABEL: name: test_add_s64
# CHECK: %{{[0-9]+}}:_(s64) = G_ADD
body:             |
  bb.0.entry:
    liveins: $d0, $d1
    %0:_(s64) = COPY $d0
    %1:_(s64) = COPY $d1
    %2:_(s64) = G_ADD %0, %1
    $d0 = COPY %2(s64)
    RET implicit $d0, implicit $r0, implicit $r15
...

---
name:            test_sub_s64
legalized:       false
# CHECK-LABEL: name: test_sub_s64
# CHECK: %{{[0-9]+}}:_(s64) = G_SUB
body:             |
  bb.0.entry:
    liveins: $d0, $d1
    %0:_(s64) = COPY $d0
    %1:_(s64) = COPY $d1
    %2:_(s64) = G_SUB %0, %1
    $d0 = COPY %2(s64)
    RET implicit $d0, implicit $r0, implicit $r15
...

---
name:            test_mul_s64
legalized:       false
# CHECK-LABEL: name: test_mul_s64
# True 64x64 mul lowers to the native schoolbook sequence: unmerge both
# operands, zero-extend the four halves, three G_HAYDN_MUL64_WIDENU partials
# (LL/LH/HL), add the cross partials, shift left 32, add the low partial.
# No LIBCALL_MUL64 / __muldi3. MUL64_ULUL is selected later.
# CHECK-NOT: LIBCALL_MUL64
# CHECK-NOT: MUL64_LL
# CHECK-NOT: MUL64_ULUL
# CHECK: G_UNMERGE_VALUES
# CHECK: G_UNMERGE_VALUES
# CHECK: G_ZEXT
# CHECK: G_HAYDN_MUL64_WIDENU
# CHECK: G_HAYDN_MUL64_WIDENU
# CHECK: G_HAYDN_MUL64_WIDENU
# CHECK: G_SHL
body:             |
  bb.0.entry:
    liveins: $d0, $d1
    %0:_(s64) = COPY $d0
    %1:_(s64) = COPY $d1
    %2:_(s64) = G_MUL %0, %1
    $d0 = COPY %2(s64)
    RET implicit $d0, implicit $r0, implicit $r15
...

---
name:            test_and_s64
legalized:       false
# CHECK-LABEL: name: test_and_s64
# CHECK: %{{[0-9]+}}:_(s64) = G_AND
body:             |
  bb.0.entry:
    liveins: $d0, $d1
    %0:_(s64) = COPY $d0
    %1:_(s64) = COPY $d1
    %2:_(s64) = G_AND %0, %1
    $d0 = COPY %2(s64)
    RET implicit $d0, implicit $r0, implicit $r15
...

---
name:            test_or_s64
legalized:       false
# CHECK-LABEL: name: test_or_s64
# CHECK: %{{[0-9]+}}:_(s64) = G_OR
body:             |
  bb.0.entry:
    liveins: $d0, $d1
    %0:_(s64) = COPY $d0
    %1:_(s64) = COPY $d1
    %2:_(s64) = G_OR %0, %1
    $d0 = COPY %2(s64)
    RET implicit $d0, implicit $r0, implicit $r15
...

---
name:            test_xor_s64
legalized:       false
# CHECK-LABEL: name: test_xor_s64
# CHECK: %{{[0-9]+}}:_(s64) = G_XOR
body:             |
  bb.0.entry:
    liveins: $d0, $d1
    %0:_(s64) = COPY $d0
    %1:_(s64) = COPY $d1
    %2:_(s64) = G_XOR %0, %1
    $d0 = COPY %2(s64)
