#--- non_successor_body.mir
# Layout-order next MBB carries PLE but is NOT a CFG successor of the
# preheader. Successor-only resolution must not invent that body.
--- |
  define dso_local void @non_successor_body(ptr %p) {
  entry:
    br label %exit
  body:
    store i32 0, ptr %p
    br label %exit
  exit:
    ret void
  }
...
---
name:            non_successor_body
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r15
    successors: %bb.2
    $r0 = frame-setup XOR32 $r0, $r0
    $r2 = ADDI32_W $r0, 8
    LoopStart $r2, 0
    NOP
    NOP
    NOP
    B %bb.2
  bb.1.body:
    successors: %bb.1, %bb.2
    liveins: $r1, $r15
    ST32 $r0, $r1, 0
    PseudoLoopEnd %bb.1
  bb.2.exit:
    liveins: $r15
    $r0 = JALR_W $r15, 0, implicit $r15

#--- incomplete_operands.mir
--- |
  define dso_local void @incomplete_operands(ptr %p) {
  entry:
    br label %body
  body:
    store i32 0, ptr %p
    br label %exit
  exit:
    ret void
  }
...
---
name:            incomplete_operands
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r15
    successors: %bb.1
    $r0 = frame-setup XOR32 $r0, $r0
    $r2 = ADDI32_W $r0, 8
    ; Deliberately incomplete retained seat: adj not an immediate.
    LoopStart $r2, %bb.1
    NOP
    NOP
    NOP
  bb.1.body:
    successors: %bb.1, %bb.2
    liveins: $r1, $r15
    ST32 $r0, $r1, 0
    PseudoLoopEnd %bb.1
  bb.2.exit:
    liveins: $r15
    $r0 = JALR_W $r15, 0, implicit $r15
