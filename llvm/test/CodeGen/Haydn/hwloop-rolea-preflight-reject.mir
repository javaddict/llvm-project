#--- non_successor_body.mir
# Layout-order next MBB carries PLE but is NOT a CFG successor of the
# preheader. Successor-only resolution must not invent that body.
--- |
  define dso_local void @non_successor_body(ptr %p) {
  entry:
    br label %exit
  body:
    store i32 0, ptr %p
    br label %exit
  exit:
    ret void
  }
...
---
name:            non_successor_body
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r15
    successors: %bb.2
    $r0 = frame-setup XOR32 $r0, $r0
    $r2 = ADDI32_W $r0, 8
    LoopStart $r2, 0
    NOP
    NOP
    NOP
    B %bb.2
  bb.1.body:
    successors: %bb.1, %bb.2
    liveins: $r1, $r15
    ST32 $r0, $r1, 0
    PseudoLoopEnd %bb.1
  bb.2.exit:
    liveins: $r15
    $r0 = JALR_W $r15, 0, implicit $r15

#--- incomplete_operands.mir
--- |
  define dso_local void @incomplete_operands(ptr %p) {
  entry:
    br label %body
  body:
    store i32 0, ptr %p
    br label %exit
  exit:
    ret void
  }
...
---
name:            incomplete_operands
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r15
    successors: %bb.1
    $r0 = frame-setup XOR32 $r0, $r0
    $r2 = ADDI32_W $r0, 8
    ; Deliberately incomplete retained seat: adj not an immediate.
    LoopStart $r2, %bb.1
    NOP
    NOP
    NOP
  bb.1.body:
    successors: %bb.1, %bb.2
    liveins: $r1, $r15
    ST32 $r0, $r1, 0
    PseudoLoopEnd %bb.1
  bb.2.exit:
    liveins: $r15
    $r0 = JALR_W $r15, 0, implicit $r15

#--- cond_early_exit.mir
--- |
  define dso_local void @cond_early_exit(ptr %p, i32 %c) {
  entry:
    br label %body
  body:
    store i32 0, ptr %p
    br i1 undef, label %exit, label %body
  exit:
    ret void
  }
...
---
name:            cond_early_exit
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r2, $r15
    successors: %bb.1
    $r0 = frame-setup XOR32 $r0, $r0
    $r3 = ADDI32_W $r0, 8
    LoopStart $r3, 0
    NOP
    NOP
    NOP
  bb.1.body:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2, $r15
    ST32 $r0, $r1, 0
    BNEZ_W $r2, %bb.2
    PseudoLoopEnd %bb.1
  bb.2.exit:
    liveins: $r15
    $r0 = JALR_W $r15, 0, implicit $r15

#--- multibb_early_exit.mir
--- |
  define dso_local void @multibb_early_exit(ptr %p, i32 %c) {
  entry:
    br label %header
  header:
    br i1 undef, label %then, label %else
  then:
    store i32 0, ptr %p
    br label %exit
  else:
    store i32 1, ptr %p
    br label %latch
  latch:
    br i1 undef, label %header, label %exit
  exit:
    ret void
  }
...
---
name:            multibb_early_exit
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r2, $r15
    successors: %bb.1
    $r0 = frame-setup XOR32 $r0, $r0
    $r3 = ADDI32_W $r0, 8
    LoopStart $r3, 0
    NOP
    NOP
    NOP
  bb.1.header:
    liveins: $r1, $r2, $r3, $r15
    successors: %bb.2, %bb.3
    BEQZ_W $r2, %bb.3
  bb.2.then:
    liveins: $r1, $r3, $r15
    successors: %bb.5
    ST32 $r0, $r1, 0
    B %bb.5
  bb.3.else:
    liveins: $r1, $r3, $r15
    successors: %bb.4
    $r4 = ADDI32_W $r0, 1
    ST32 $r4, $r1, 0
    B %bb.4
  bb.4.latch:
    liveins: $r1, $r2, $r3, $r15
    successors: %bb.1, %bb.5
    NOP
    NOP
    NOP
    PseudoLoopEnd %bb.1
  bb.5.exit:
    liveins: $r15
    $r0 = JALR_W $r15, 0, implicit $r15

#--- hwlr_csr.mir
--- |
  define dso_local void @hwlr_csr(ptr %p, i32 %v) {
  entry:
    br label %body
  body:
    store i32 %v, ptr %p
    br label %exit
  exit:
    ret void
  }
...
---
name:            hwlr_csr
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r2, $r15
    successors: %bb.1
    $r0 = frame-setup XOR32 $r0, $r0
    $r3 = ADDI32_W $r0, 8
    LoopStart $r3, 0
    NOP
    NOP
    NOP
  bb.1.body:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2, $r15
    ST32 $r2, $r1, 0
    CSRW_W 32, $r2, implicit-def $sfr
    PseudoLoopEnd %bb.1
  bb.2.exit:
    liveins: $r15
    $r0 = JALR_W $r15, 0, implicit $r15
