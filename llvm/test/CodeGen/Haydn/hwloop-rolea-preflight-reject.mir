# RUN: rm -rf %t && split-file %s %t
#
# 2026-08-22 hwloop product-default flip split: preflight failures with a
# body-resolvable shape (Header+PLE parsed) now DEMOTE to the software loop
# (Hexagon keep-legal shape) instead of fatal — fatal is reserved for
# unresolvable retained state, where demoteHardwareLoopToSoftware cannot
# parse the body either and erase-only would leave a dangling PseudoLoopEnd
# (silent infinite loop). Arms reclassified live at the flip commit.
#

# FATAL arms — unresolvable retained state / malformed LoopStart:
# RUN: not llc -mtriple=haydn-unknown-elf -mattr=+hwloop -run-pass=haydn-hwloops \
# RUN:   %t/trip_r0.mir -o - 2>&1 | FileCheck %s --check-prefix=TRIP
# RUN: not llc -mtriple=haydn-unknown-elf -mattr=+hwloop -run-pass=haydn-hwloops \
# RUN:   %t/nested_setup.mir -o - 2>&1 | FileCheck %s --check-prefix=NEST
# RUN: not llc -mtriple=haydn-unknown-elf -mattr=+hwloop -run-pass=haydn-hwloops \
# RUN:   %t/missing_self_edge.mir -o - 2>&1 | FileCheck %s --check-prefix=SELF
# RUN: not llc -mtriple=haydn-unknown-elf -mattr=+hwloop -run-pass=haydn-hwloops \
# RUN:   %t/missing_ple.mir -o - 2>&1 | FileCheck %s --check-prefix=NOPLE
# RUN: not llc -mtriple=haydn-unknown-elf -mattr=+hwloop -run-pass=haydn-hwloops \
# RUN:   %t/non_successor_body.mir -o - 2>&1 | FileCheck %s --check-prefix=NSUCC
# RUN: not llc -mtriple=haydn-unknown-elf -mattr=+hwloop -run-pass=haydn-hwloops \
# RUN:   %t/incomplete_operands.mir -o - 2>&1 | FileCheck %s --check-prefix=OPS

# DEMOTE arms — body-resolvable shape: software loop restored, no ZOL residue.
# prologepilog precedes haydn-hwloops (product pipeline order: PEI runs in
# addMachineLateOptimization territory, hwloops in addPreSched2) so the demote
# stack-counter sink has its PEI-created PostRAScratchFI. That matters for
# body_with_call: the counter must live across the body call, so
# isSoundDemoteCounter refuses every call-regmask-clobbered caller-saved GPR
# and every ABI-CSR this prologue does not save (post-PEI, unsaved = never
# repaired) — the trip goes to the stack-counter FI (ST32 in preheader;
# LD32/SUBI32/ST32/BNEZ in latch, all after the last call).
# REGRESSION (2026-08-22): before the counter-ownership law the demoter
# picked the call-clobbered trip reg itself; -verify-machineinstrs reported
# "Using an undefined physical register" on the BUNDLE implicit use because
# a regmask clobber is invisible to an explicit-def-only walk — silent wrong
# trip at runtime. The verify flags below are load-bearing.
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=prologepilog,haydn-hwloops -verify-machineinstrs \
# RUN:   %t/body_with_call.mir -o - 2>&1 | FileCheck %s --check-prefix=DM-CALL
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=prologepilog,haydn-hwloops -verify-machineinstrs \
# RUN:   %t/multi_exit.mir -o - 2>&1 | FileCheck %s --check-prefix=DM-MEXIT
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=prologepilog,haydn-hwloops -verify-machineinstrs \
# RUN:   %t/multi_ple.mir -o - 2>&1 | FileCheck %s --check-prefix=DM-MPLE
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=prologepilog,haydn-hwloops -verify-machineinstrs \
# RUN:   %t/cond_early_exit.mir -o - 2>&1 | FileCheck %s --check-prefix=DM-CEXIT
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=prologepilog,haydn-hwloops -verify-machineinstrs \
# RUN:   %t/multibb_early_exit.mir -o - 2>&1 | FileCheck %s --check-prefix=DM-MBEXIT
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=prologepilog,haydn-hwloops -verify-machineinstrs \
# RUN:   %t/hwlr_csr.mir -o - 2>&1 | FileCheck %s --check-prefix=DM-HWLR

# Role: MIR — incomplete Role-A retained seats.
# FATAL class (unresolvable/malformed): trip reg / nested setup / missing
# self-edge / missing PLE / non-successor layout invent (successor-only body)
# / incomplete LoopStart operands — the retained seat never becomes a
# half-expanded SET.
# DEMOTE class (body-resolvable): call / multi-exit / multi-PLE / pre-PLE
# conditional early-exit (golden Constraints: branches must not leave an
# active hwloop before HWLR_END) / multi-BB Header successor that never
# reaches Latch / unpublished HWLR CSR write (SET-only program) — not
# ZOL-able, demote to software loop.

# TRIP: incomplete Role-A retained state rejected before mutation
# TRIP: trip reg not a physical GPR
# NEST: incomplete Role-A retained state rejected before mutation
# SELF: incomplete Role-A retained state rejected before mutation
# NOPLE: no body MBB
# NSUCC: no body MBB
# OPS: incomplete Role-A retained state

# DM-CALL: SUBI32{{.*}}, 1
# DM-CALL: BNEZ{{.*}} %bb.1
# DM-CALL-NOT: SET_HWLOOP
# DM-CALL-NOT: LoopStart
# DM-CALL-NOT: PseudoLoopEnd
# DM-MEXIT: SUBI32{{.*}}, 1
# DM-MEXIT: BNEZ{{.*}} %bb.1
# DM-MEXIT-NOT: SET_HWLOOP
# DM-MEXIT-NOT: PseudoLoopEnd
# DM-MPLE: SUBI32{{.*}}, 1
# DM-MPLE: BNEZ{{.*}} %bb.1
# DM-MPLE-NOT: SET_HWLOOP
# DM-MPLE-NOT: PseudoLoopEnd
# DM-CEXIT: SUBI32{{.*}}, 1
# DM-CEXIT: BNEZ{{.*}} %bb.1
# DM-CEXIT-NOT: SET_HWLOOP
# DM-CEXIT-NOT: PseudoLoopEnd
# DM-MBEXIT: SUBI32{{.*}}, 1
# DM-MBEXIT: BNEZ{{.*}}
# DM-MBEXIT-NOT: SET_HWLOOP
# DM-MBEXIT-NOT: PseudoLoopEnd
# DM-HWLR: SUBI32{{.*}}, 1
# DM-HWLR: BNEZ{{.*}} %bb.1
# DM-HWLR-NOT: SET_HWLOOP
# DM-HWLR-NOT: PseudoLoopEnd
# DM-HWLR-NOT: CSRW

#--- trip_r0.mir
--- |
  define dso_local void @trip_r0(ptr %p) {
  entry:
    br label %body
  body:
    store i32 0, ptr %p
    br label %exit
  exit:
    ret void
  }
...
---
name:            trip_r0
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r15
    successors: %bb.1
    $r0 = frame-setup XOR32 $r0, $r0
    LoopStart $r0, 0
    NOP
    NOP
    NOP
  bb.1.body:
    successors: %bb.1, %bb.2
    liveins: $r1, $r0, $r15
    ST32 $r0, $r1, 0
    PseudoLoopEnd %bb.1
  bb.2.exit:
    liveins: $r15
    $r0 = JALR_W $r15, 0, implicit $r15

#--- body_with_call.mir
--- |
  define dso_local void @body_with_call(ptr %p) {
  entry:
    br label %body
  body:
    call void @ext(ptr %p)
    br label %exit
  exit:
    ret void
  }
  declare void @ext(ptr)
...
---
name:            body_with_call
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r15
    successors: %bb.1
    $r0 = frame-setup XOR32 $r0, $r0
    $r2 = ADDI32_W $r0, 8
    LoopStart $r2, 0
    NOP
    NOP
    NOP
  bb.1.body:
    successors: %bb.1, %bb.2
    liveins: $r1, $r15
    $r15 = JAL_W @ext, csr_haydn, implicit-def $r1, implicit $r1, implicit-def $r15
    PseudoLoopEnd %bb.1
  bb.2.exit:
    liveins: $r15
    $r0 = JALR_W $r15, 0, implicit $r15

#--- multi_exit.mir
--- |
  define dso_local void @multi_exit(ptr %p, i32 %c) {
  entry:
    br label %body
  body:
    store i32 0, ptr %p
    br i1 undef, label %exit, label %alt
  exit:
    ret void
  alt:
    ret void
  }
...
---
name:            multi_exit
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r2, $r15
    successors: %bb.1
    $r0 = frame-setup XOR32 $r0, $r0
    $r3 = ADDI32_W $r0, 8
    LoopStart $r3, 0
    NOP
    NOP
    NOP
  bb.1.body:
    successors: %bb.1, %bb.2, %bb.3
    liveins: $r1, $r2, $r15
    ST32 $r0, $r1, 0
    BNEZ_W $r2, %bb.3
    PseudoLoopEnd %bb.1
  bb.2.exit:
    liveins: $r15
    $r0 = JALR_W $r15, 0, implicit $r15
  bb.3.alt:
    liveins: $r15
    $r0 = JALR_W $r15, 0, implicit $r15

