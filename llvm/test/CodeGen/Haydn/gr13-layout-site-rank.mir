    NOP
    NOP
    NOP
    RET implicit killed $r15

  bb.2.far:
    liveins: $r15
    RET implicit killed $r15

---
name:            near_short
alignment:       1
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r15
    successors: %bb.1
    B %bb.1

  bb.1.exit:
    liveins: $r15
    RET implicit killed $r15

# CHECK-LABEL: name:            far_uncond
# CHECK: bb.0.entry
# CHECK: LUI{{.*}}%bb.2{{$}}
# CHECK: ADDI32{{.*}}%bb.2{{$}}
# CHECK-NOT: B %bb.
# CHECK: JALR
# CHECK-NOT: B %bb.
# CHECK: bb.1.pad
# CHECK: bb.2.far
# CHECK-NOT: bb.3
#
# CHECK-LABEL: name:            near_short
# CHECK: bb.0.entry
# CHECK: B %bb.1
# CHECK-NOT: JALR
# CHECK-NOT: bb.2
