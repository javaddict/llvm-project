# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postrapseudos \
# RUN:     -verify-machineinstrs %s -o - | FileCheck %s
# REQUIRES: haydn-registered-target
#
# Role: MIR — LOADI32 MatInt seeds Cur=R0. A dirty R0 at the expand
# point must be restored locally (XOR32 r0,r0,r0) before the seed is
# read. Same cleanliness rule as withDR64PackBase.

--- |
  define i32 @loadi32_dirty_r0() { ret i32 0 }
...
---
name:            loadi32_dirty_r0
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r15
    $r0 = ADDI32_W $r1, 1
    $r2 = LOADI32 42
    RET implicit $r15
...
# CHECK-LABEL: name: loadi32_dirty_r0
# CHECK: $r0 = ADDI32_W $r1, 1
# CHECK-NEXT: $r0 = XOR32 $r0, $r0
# CHECK: ADDI32
# CHECK-NOT: LOADI32
