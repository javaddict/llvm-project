# already_long_far: exactly one LUI / one ADDI / one JALR after the full
# post-stamp pair (never a second stacked long form); near cond retained
# to %bb.1; no CFG growth.
# CHECK-LABEL: name:            already_long_far
# CHECK: bb.0.entry
# CHECK: LUI{{.*}}%bb.2{{$}}
# CHECK: ADDI32{{.*}}%bb.2{{$}}
# CHECK: BEQZ{{.*}} $r7, %bb.1,
# CHECK: JALR
# CHECK-NOT: LUI
# CHECK-NOT: JALR
# CHECK: bb.1.near
# CHECK-NOT: bb.4
#
# near_edge_retained: in-range retained near cond is still skipped.
# CHECK-LABEL: name:            near_edge_retained
# CHECK: bb.0.entry
# CHECK: LUI{{.*}}%bb.3{{$}}
# CHECK: ADDI32{{.*}}%bb.3{{$}}
# CHECK: BEQZ{{.*}} $r7, %bb.2,
# CHECK: JALR
# CHECK-NOT: LUI
# CHECK-NOT: JALR
# CHECK: bb.1.pad
# CHECK-NOT: bb.4
#
# reoverflowed_near_cond: far retained cond + near JALR dest → invert+
# retarget. Pair dest becomes %bb.2; cond inverts to %bb.1.
# CHECK-LABEL: name:            reoverflowed_near_cond
# CHECK: bb.0.entry
# CHECK: LUI{{.*}}%bb.2{{$}}
# CHECK: ADDI32{{.*}}%bb.2{{$}}
# CHECK: BNEZ{{.*}} $r7, %bb.1,
# CHECK: JALR
# CHECK-NOT: LUI
# CHECK-NOT: JALR
# CHECK: bb.1.near
# CHECK-NOT: bb.3
