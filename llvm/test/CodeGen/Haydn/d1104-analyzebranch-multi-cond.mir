# D1.104: analyzeBranch must treat a bundle with cond-count>1 as
# unanalyzable. Taking the first cond child dropped the second edge
# (one-way TBB + fallthrough). Arm A then rewrote the first dest; Arm B
# does not match a trailing cond (MEMORY_FAULT class). Both conds survive,
# no LUI/JALR.
#
# Layout (d164/d1124): 180 NOP parcels in bb.1 (~2160B) put %bb.2 past
# WIDE_BranchSImm12 (buffer=4). If the first child were analyzed one-way,
# LBN would promote it.
#
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-longbranch-normalize \
# RUN:   -haydn-branch-relax-safety-buffer=4 -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s
# REQUIRES: haydn-registered-target

--- |
  define void @two_cond_bundle(i32 %a, i32 %b) {
  entry:
    br i1 undef, label %far, label %near
  near:
    ret void
  far:
    ret void
  }
...
---
name:            two_cond_bundle
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r4', virtual-reg: '' }
  - { reg: '$r5', virtual-reg: '' }
  - { reg: '$r15', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        false
body:             |
  bb.0.entry:
    successors: %bb.1, %bb.2
    liveins: $r4, $r5, $r15
    ; CHECK-LABEL: name:            two_cond_bundle
    ; CHECK: bb.0.entry
    ; CHECK: BEQZ{{.*}} $r4, %bb.2
    ; CHECK: BNEZ{{.*}} $r5, %bb.1
    ; CHECK-NOT: LUI
    ; CHECK-NOT: JALR
    ; CHECK: bb.1.near
    BUNDLE 0 {
      BEQZ_W $r4, %bb.2, implicit-def dead $sfr
      BNEZ_W $r5, %bb.1, implicit-def dead $sfr
    }

  bb.1.near:
    liveins: $r15
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
