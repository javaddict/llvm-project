; RUN: llc -mtriple=haydn-unknown-elf -global-isel-abort=1 < %s | FileCheck %s

; Role: semantic — Branch relaxation for out-of-range conditional branches.

; REGRESSION TEST: Branch relaxation for out-of-range conditional branches.
;
; Haydn conditional branches (BEQ, BNE, BGE, etc.) use a 16-bit signed offset
; (simm16), giving a +-32KB range. When the branch target is beyond this range
; the generic BranchRelaxation pass must relax the branch by emitting an
; inverted condition + indirect jump sequence.
;
; Test design: A conditional branch targets a label that is >32KB away
; achieved by placing many volatile stores in between. The BranchRelaxation
; pass converts the conditional branch to an inverted condition + JALR.

@arr = global [3000 x i32] zeroinitializer

define void @test_cond_far(i32 %a, i32 %b) {
; CHECK-LABEL: test_cond_far:
entry:
  %cmp = icmp eq i32 %a, %b
  br i1 %cmp, label %far, label %pad

pad:
