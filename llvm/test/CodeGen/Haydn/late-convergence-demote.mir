# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop -run-pass=haydn-late-convergence \
# RUN:   -verify-machineinstrs %s -o - 2>&1 | FileCheck %s

# Role: MIR — W68.3R convergence driver executes the contract loop on a
# function whose single HWLoop is range-illegal (spacer MBB between
# preheader and header: StartOff > uimm6 hard field). The driver's
# FixupHwLoops step demotes inside iteration 0; the census sees the setup
# count drop (monotone law: setups only decrease); BranchRelaxation then
# closes ranges LAST in the same iteration; iteration 1 confirms the
# fixed point. Driver-level pins (beyond the Fixup-only sibling
# hwloop-fixup-demote-range.mir):
#   * the loop reaches a fixed point (no bound exhaustion diagnostic);
#   * the demote result (SUBI32 + BNEZ_W soft edge, no SET residual)
#     survives the in-loop S2 reschedule unchanged in kind;
#   * the source debug location on the branch site survives promotion.

--- |
  define dso_local void @conv_demote(ptr nocapture writeonly %out) {
  entry:
    br label %spacer
  spacer:
    br label %body
  body:
    store i32 0, ptr %out, align 4
    br label %exit
  exit:
    ret void
  }

  define dso_local i32 @conv_branch_dl(ptr nocapture readonly %a, i32 %n) {
  entry:
    %c = icmp sgt i32 %n, 0
    br i1 %c, label %body, label %exit
  body:
    %v = load i32, ptr %a, align 4
    br label %exit
  exit:
    %r = phi i32 [ 0, %entry ], [ %v, %body ]
    ret i32 %r
  }

  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !9, producer: "llvm", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = distinct !DISubprogram(name: "conv_branch_dl", scope: !9, file: !9, line: 1, type: !2, isLocal: false, isDefinition: true, scopeLine: 2, flags: DIFlagPrototyped, isOptimized: true, unit: !0)
  !2 = !DISubroutineType(types: !3)
  !3 = !{null}
  !5 = !DILocation(line: 3, column: 5, scope: !1)
  !9 = !DIFile(filename: "late-convergence-demote.mir", directory: "/tmp")
  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!7, !8}
  !7 = !{i32 2, !"Dwarf Version", i32 4}
  !8 = !{i32 2, !"Debug Info Version", i32 3}
...
---
name:            conv_demote
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r0, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0
    SET_HWLOOP_W 0, %bb.2, %bb.2, 8, implicit-def dead $sfr
    NOP
    NOP
    NOP

  bb.1.spacer:
    successors: %bb.2
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP

  bb.2.body:
    liveins: $r1, $r0
    successors: %bb.3
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.3.exit:
    liveins: $r15
    RET implicit killed $r15

...
---
name:            conv_branch_dl
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r2, $r15
    successors: %bb.1, %bb.3

    renamable $r3 = nsw ADDI32_W $r0, 0, implicit-def $sfr
    renamable $r4 = SLT32 killed renamable $r3, renamable $r2, implicit-def $sfr
    BNEZ_W internal renamable $r4, %bb.3, implicit $sfr, debug-location !5

  bb.1.body:
    liveins: $r1
    successors: %bb.3

    renamable $r5 = LD32 renamable $r1, 0, implicit-def $sfr

  bb.3.exit:
    liveins: $r15
    RET implicit killed $r15

...
# The driver ran (both functions) without the bound-exhaustion diagnostic:
# CHECK-NOT: bounded repair loop exhausted
# CHECK-NOT: non-monotone mutation
#
# conv_demote: setup erased, soft countable edge installed inside the loop;
# successors and probabilities updated by the demote (preservation gate).
# CHECK-LABEL: name: conv_demote
# CHECK-NOT: SET_HWLOOP
# CHECK: successors: %bb.2(0x40000000), %bb.3(0x40000000)
# CHECK: SUBI32{{[^ ]*}}_ALU1_RI20
# CHECK: BNEZ{{[^ ]*}} $r7, %bb.2
#
# conv_branch_dl: the branch site survives the loop WITH its debug
# location on the branch line itself (a promoted long form inherits the
# original branch DL; a retained short form keeps it).
# CHECK-LABEL: name: conv_branch_dl
# CHECK: BNEZ{{[^ ]*}} internal $r4, %bb.{{[0-9]+}}, implicit $sfr, debug-location !DILocation(line: 3
