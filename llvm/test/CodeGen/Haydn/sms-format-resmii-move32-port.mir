# RUN: llc -mtriple=haydn-unknown-elf -mattr=-hwloop -run-pass=pipeliner \
# RUN:   -debug-only=pipeliner -verify-machineinstrs %s -o /dev/null 2>&1 \
# RUN:   | FileCheck %s --check-prefix=PORT
# RUN: llc -mtriple=haydn-unknown-elf -mattr=-hwloop -run-pass=pipeliner \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=HANDOFF
# REQUIRES: asserts

# Role: MIR — MOVE32-class SMS port / placement pin: MOVE32 is tablegen'd (outs rd), (ins rs) — dest+src schema (W68.0b).

# MOVE32-class SMS port / placement pin:
#   MOVE32 is tablegen'd (outs rd), (ins rs) — the W68.0b dest+src
#   schema; copyPhysReg emits MOVE32 rd, rs. The MI and the descriptor
#   agree at 1R1W, so the former repeated-source differential
#   (mi_repeated_src vs desc_shape) is structurally moot. SMS-PORT
#   metrics log the agreement; SMS-HOOK does not reject (not an
#   operand-dependent format predicate).
#
#   Body: three independent MOVE32 (format greedy=exhaustive=1). Write pool
#   2W forces DFA ResMII ≥ 2 under the MI path (same as port-forced ADD32).
#   GR2.1: ResMII is Kind-A (entry count); MOVE32 1R1W no longer binds it.
#
# Companion: sms-format-resmii-port-forced.mir (ADD32 3×1W),
# sms-format-resmii.mir (accept). Unit peer: HaydnBundleTest
# SMS_Move32Class* ResourceCycle packing differential.
#
# PORT-NOT: SMS-HOOK: reject
# PORT-NOT: SMS-HANDOFF: reject
# PORT-NOT: Unable to analyzeLoop
# PORT: SMS-HANDOFF: coverage ok
# PORT: SMS-PORT: move32-class ops=3 desc_shape=1R1W mi_repeated_src=1R1W desc_overcounts_mi=0
# Kind-A: entry-count ResMII only; ports never bind pre-RA.
# PORT: Return Res MII:{{[1-9][0-9]*}}

--- |
  define void @sms_move32_port_diff(i32 %n, i32 %a, i32 %b, i32 %c) #0 {
  entry:
    br label %loop
  loop:
    br label %exit
  exit:
    ret void
  }
  attributes #0 = { "target-features"="-hwloop" }
...
---
name:            sms_move32_port_diff
alignment:       16
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          false
isSSA:           true
noVRegs:         false
registers:
  - { id: 0, class: gpr32 }
  - { id: 1, class: gpr32 }
  - { id: 2, class: gpr32 }
  - { id: 3, class: gpr32 }
  - { id: 4, class: gpr32 }
  - { id: 5, class: gpr32 }
  - { id: 6, class: gpr32 }
  - { id: 7, class: gpr32 }
  - { id: 8, class: gpr32 }
  - { id: 9, class: gpr32 }
  - { id: 10, class: gpr32 }
liveins:
  - { reg: '$r1' }
  - { reg: '$r2' }
  - { reg: '$r3' }
  - { reg: '$r4' }
frameInfo:
  maxAlignment:    1
machineFunctionInfo: {}
body:             |
  bb.1.entry:
    liveins: $r1, $r2, $r3, $r4

    %0:gpr32 = COPY $r1
    %1:gpr32 = COPY $r2
    %2:gpr32 = COPY $r3
    %3:gpr32 = COPY $r4
    %4:gpr32 = LOADI32 1
    LoopStart %0, -1

  bb.2.loop:
    successors: %bb.2(0x7c000000), %bb.3(0x04000000)

    %5:gpr32 = PHI %1, %bb.1, %6, %bb.2
    %7:gpr32 = PHI %2, %bb.1, %8, %bb.2
    %9:gpr32 = PHI %3, %bb.1, %10, %bb.2
    ; Three independent MOVE32 (copyPhysReg shape: dest+src, 1R1W).
    ; MI and descriptor agree.
    %6:gpr32 = MOVE32 %5
    %8:gpr32 = MOVE32 %7
    %10:gpr32 = MOVE32 %9
    PseudoLoopEnd %bb.2

  bb.3.exit:
    RET implicit $r15

  ; HANDOFF-LABEL: name: sms_move32_port_diff
  ; Logical only — no durable pre-RA BUNDLE from SMS expansion.
  ; HANDOFF-NOT: BUNDLE
  ; HANDOFF: MOVE32

...
