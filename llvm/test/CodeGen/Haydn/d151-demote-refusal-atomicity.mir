# RUN: not llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=haydn-fixup-hwloops -verify-machineinstrs \
# RUN:   %s -o - 2>&1 | FileCheck %s --check-prefix=FATAL
# RUN: not llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -debug-only=haydn-hwloops -run-pass=haydn-fixup-hwloops \
# RUN:   %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=DBG
# REQUIRES: haydn-registered-target
#
# D1.51 refusal-atomicity pin at the product fixup seat: the HOISTED
# long-latch scratch law — the decision that sat AFTER countdown-strip,
# SET erase, the latch terminator sweep, and the successor rewrite. The
# whole-body NOP run (16680 B) overflows the Off2 window, so Fixup takes
# the product demote-first path; the demoted backedge overflows simm12
# (LongLatch); every LongCands register except the countdown $r2 is
# read (never defined) in the body — live-in of the latch's out-edges —
# so the computed-dead JALR scratch probe refuses.
#
# Atomicity: the refusal now precedes every MIR/CFG mutation. The debug
# arm proves no exact-commit emission happens between the demote decision
# and the refusal; the byte/CFG snapshot-identity proof lives in
# HaydnHWLoopDemoteTest (printMIR before/after a refused demote is
# identical).

# FATAL: cannot demote to software loop
# FATAL: refusing erase-only once-through
#
# DBG: demoting hwloop header=%bb.1 latch=%bb.1 exit=%bb.2
# DBG-NOT: exact-commit
# DBG: demote refused

--- |
  define dso_local i32 @d151_long_scratch_refuse() {
  entry:
    br label %body
  body:
    br label %exit
  exit:
    ret i32 0
  }
...
---
name:            d151_long_scratch_refuse
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r2, $r3, $r4, $r7, $r8, $r9, $r10, $r11, $r12, $r15
    successors: %bb.1

    SET_HWLOOP_F2_W 0, %bb.1, %bb.1, $r2, implicit-def dead $sfr

  ; Read-only uses: each candidate stays live-in of the single-block
  ; loop body (the latch's own out-edge set) without being defined.
  bb.1.body:
    liveins: $r1, $r2, $r3, $r4, $r7, $r8, $r9, $r10, $r11, $r12
    successors: %bb.2
    ST32 $r1, $r2, 0
    ST32 $r3, $r2, 0
    ST32 $r4, $r2, 0
    ST32 $r7, $r2, 0
    ST32 $r8, $r2, 0
    ST32 $r9, $r2, 0
    ST32 $r10, $r2, 0
    ST32 $r11, $r2, 0
    ST32 $r12, $r2, 0
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
