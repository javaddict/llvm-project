# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -misched-postra-direction=topdown \
# RUN:   -run-pass=postmisched -verify-machineinstrs %s -o - | \
# RUN:   FileCheck %s --check-prefixes=CHECK,TOP
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -misched-postra-direction=topdown \
# RUN:   -run-pass=postmisched,haydn-fixup-hwloops -verify-machineinstrs %s -o - | \
# RUN:   FileCheck %s --check-prefixes=CHECK,FIX

# Role: MIR — HWLOOP-SU with a hard multi-member BUNDLE as region boundary.
#
# Every TargetOpcode::BUNDLE root is an isSchedulingBoundary fence. A durable
# FormatID-stamped multi-member root (exact-commit / multipass hard-cycle shape)
# therefore splits post-RA regions: SET stays a real DAG SU in the region
# before the fence; ZOLSetupExitLatency raises ExitSU by SetupIssueDistance;
# leaveRegion materializes Following empties inside that region. The hard root
# itself is not a region SU and must survive postmisched with membership fixed.
#
# Product formation still emits bare final SET forms (no hard root). This MIR
# pins the activation interaction once a stamped hard cycle sits after SET in
# the same MBB (same shape leaveMBB will keep after hard-root exact-commit).

--- |
  define void @set_before_hard_boundary() { ret void }
...
---
name:            set_before_hard_boundary
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r15
    successors: %bb.1

    ; Multi-MI region so list scheduler runs (single-MI regions skip).
    $r6 = ADD32 $r0, $r1, implicit-def dead $sfr
    SET_HWLOOP_W 0, %bb.1, %bb.1, 2, implicit-def dead $sfr
    ; Hard multi-member fence (FormatID 0). Splits postmisched regions.
    BUNDLE 0, implicit-def $r4, implicit-def $r5, implicit-def dead $sfr, implicit $r0, implicit $r1, implicit $r2, implicit $r3 {
      $r4 = ADD32 $r0, $r1, implicit-def dead $sfr
      $r5 = ADD32 $r2, $r3, implicit-def dead $sfr
    }

  bb.1:
    liveins: $r4, $r5, $r6, $r15
    successors: %bb.2
    $r1 = COPY $r6
    NOP
    NOP
    NOP

  bb.2:
    liveins: $r1, $r15
    $r1 = COPY $r1
    RET implicit killed $r15, implicit $r1

# CHECK-LABEL: name: set_before_hard_boundary
#
# Top-down: one-SFR-writer law keeps SET and the independent ADD sequential
# (both def dead $sfr). ExitSU setup edge still yields InterveningCycles
# size-bearing work before the hard fence. Hard root keeps both ADD children
# and FormatID 0 (input multi-member fence; not re-packed here).
# TOP: SET_HWLOOP
# TOP: ADD32
# TOP: BUNDLE 0
# TOP: ADD32
# TOP: ADD32
# TOP: }
# TOP: bb.1
# TOP: RET
#
# Fixup residual: keep hardware SET (no demote); hard root still dual-member.
# FIX: SET_HWLOOP
# FIX: BUNDLE 0
# FIX: ADD32
# FIX: ADD32
# FIX: }
# FIX: RET
# FIX-NOT: SUBI32
# FIX-NOT: BNEZ
