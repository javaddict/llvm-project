#--- tail-bad.mir
--- |
  define void @tail_bad() { ret void }
...
---
name:            tail_bad
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.2
    liveins: $r7, $r15
    BUNDLE 0, 0, implicit-def $r7 {
      $r7 = LUI_E2_E0_ALU0_I12 %bb.1
    }
    BUNDLE 0, 0, implicit-def $r7, implicit $r7 {
      $r7 = ADDI32_E2_E0_ALU0_RI20 $r7, %bb.2
    }
    BUNDLE 0, 0, implicit-def $r7, implicit $r7 {
      $r7 = JALR_E2_E0_ALU0_RI12 $r7, 0
    }

  bb.1:
    liveins: $r15
    BUNDLE 0, 0, implicit-def $r0, implicit $r15 {
      $r0 = JALR_E2_E0_ALU0_RI12 $r15, 0
    }

  bb.2:
    liveins: $r15
    BUNDLE 0, 0, implicit-def $r0, implicit $r15 {
      $r0 = JALR_E2_E0_ALU0_RI12 $r15, 0
    }
...

#--- tail-ok.mir
--- |
  define void @tail_ok() { ret void }
...
---
name:            tail_ok
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.1
    liveins: $r7, $r15
    BUNDLE 0, 0, implicit-def $r7 {
      $r7 = LUI_E2_E0_ALU0_I12 %bb.1
    }
    BUNDLE 0, 0, implicit-def $r7, implicit $r7 {
      $r7 = ADDI32_E2_E0_ALU0_RI20 $r7, %bb.1
    }
    BUNDLE 0, 0, implicit-def $r7, implicit $r7 {
      $r7 = JALR_E2_E0_ALU0_RI12 $r7, 0
    }

  bb.1:
    liveins: $r15
    BUNDLE 0, 0, implicit-def $r0, implicit $r15 {
      $r0 = JALR_E2_E0_ALU0_RI12 $r15, 0
    }
...

#--- dup-control.mir
--- |
  define void @dup_control() { ret void }
...
---
name:            dup_control
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.1
    liveins: $r0, $r1, $r15
    BUNDLE 0, 0, implicit $r0, implicit $r1 {
