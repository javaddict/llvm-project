#--- beqz-ok.mir
--- |
  define void @beqz_ok() { ret void }
...
---
name:            beqz_ok
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.1
    liveins: $r0, $r15
    BUNDLE 0, 0, implicit $r0 {
      BEQZ_E2_E0_ALU0_I12 $r0, %bb.1, implicit-def dead $sfr
    }

  bb.1:
    liveins: $r15
    BUNDLE 0, 0, implicit-def $r0, implicit $r15 {
      $r0 = JALR_E2_E0_ALU0_RI12 $r15, 0
    }
...

#--- set-oor.mir
--- |
  define void @set_oor() { ret void }
...
---
name:            set_oor
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.1
    liveins: $r2, $r15
    BUNDLE 0, 0, implicit-def $sfr, implicit $r2 {
      SET_HWLOOP_F2_E2_E0_ALU0_HWLRIIR 0, %bb.1, %bb.1, killed $r2, implicit-def $sfr
      NOP
    }
    BUNDLE 0, 0 {
      NOP
    }
    BUNDLE 0, 0 {
      NOP
    }
    BUNDLE 0, 0 {
      NOP
    }
    BUNDLE 0, 0 {
      NOP
    }
    BUNDLE 0, 0 {
      NOP
    }
    BUNDLE 0, 0 {
      NOP
    }
    BUNDLE 0, 0 {
      NOP
    }
    BUNDLE 0, 0 {
      NOP
    }
    BUNDLE 0, 0 {
      NOP
    }
    BUNDLE 0, 0 {
      NOP
    }
    BUNDLE 0, 0 {
      NOP
    }
    BUNDLE 0, 0 {
      NOP
    }
    BUNDLE 0, 0 {
      NOP
    }
    BUNDLE 0, 0 {
      NOP
    }
    BUNDLE 0, 0 {
      NOP
    }
    BUNDLE 0, 0 {
      NOP
    }
    BUNDLE 0, 0 {
      NOP
    }
    BUNDLE 0, 0 {
      NOP
    }
    BUNDLE 0, 0 {
      NOP
    }
    BUNDLE 0, 0 {
      NOP
    }
    BUNDLE 0, 0 {
      NOP
    }

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $r15
    BUNDLE 0, 0 {
      NOP
    }
    PseudoLoopEnd %bb.1

  bb.2:
    liveins: $r15
    BUNDLE 0, 0, implicit-def $r0, implicit $r15 {
      $r0 = JALR_E2_E0_ALU0_RI12 $r15, 0
    }
...

#--- set-ok.mir
--- |
  define void @set_ok() { ret void }
...
---
name:            set_ok
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.1
    liveins: $r2, $r15
    BUNDLE 0, 0, implicit-def $sfr, implicit $r2 {
      SET_HWLOOP_F2_E2_E0_ALU0_HWLRIIR 0, %bb.1, %bb.1, killed $r2, implicit-def $sfr
      NOP
    }
    BUNDLE 0, 0 {
      NOP
    }
    BUNDLE 0, 0 {
      NOP
    }

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $r15
    BUNDLE 0, 0 {
      NOP
    }
    PseudoLoopEnd %bb.1

  bb.2:
    liveins: $r15
    BUNDLE 0, 0, implicit-def $r0, implicit $r15 {
      $r0 = JALR_E2_E0_ALU0_RI12 $r15, 0
    }
...

#--- align-meta.mir
--- |
  define void @align_meta() { ret void }
...
---
name:            align_meta
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.1
    liveins: $r15
    BUNDLE 0, 0 {
      NOP
    }

  bb.1 (align 16):
    liveins: $r15
    BUNDLE 0, 0, implicit-def $r0, implicit $r15 {
      $r0 = JALR_E2_E0_ALU0_RI12 $r15, 0
    }
...

