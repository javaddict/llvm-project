target datalayout = "e-m:e-p:32:32-i64:32-f64:32-v64:32-v128:64-a:0:32-n32-S64"
target triple = "haydn-unknown-elf"

; Minimal IIR-DF1 inner shape: load two GPRs, sext both to i64, multiply, store.
; Forces the selector to emit SEXT_GPR32_TO_DR64 for both sign-extends, and the
; packetizer to pack them into bundles alongside the load and the MAC.
define i32 @sext_in_bundle_test(ptr readonly %a, ptr readonly %b) #0 {
entry:
; ASM-LABEL: <sext_in_bundle_test>:
 %av = load i32, ptr %a, align 4
 %bv = load i32, ptr %b, align 4
 %aext = sext i32 %av to i64
 %bext = sext i32 %bv to i64
 %mul = mul i64 %aext, %bext
 ; Extract the high 32 bits (the IIR accumulator extract step) so the 64-bit
 ; product is not dead-code eliminated.
 %shl = shl i64 %mul, 1
 %hi = lshr i64 %shl, 33
 %trunc = trunc i64 %hi to i32
 ret i32 %trunc
; ASM: sext32t64
}

attributes #0 = { nounwind "target-features"="+hwloop" }
