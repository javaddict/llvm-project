; Tests for alloca and dynamic stack allocation.

; Dynamic stack allocation changes SP at runtime (SUB32 SP, SP, size).
; When a function has variable-sized allocas, FP (R14) is required so
; that local variables can still be accessed at known offsets.

; Stack alignment: 8 bytes. SP adjustments are always multiples of 8.
; Frame contract: VLA + FP, then Role-A hwloop body (layout may reorder peels).

; Multi-size alloca: frame slots + dual DR store (pack order may vary).


declare void @use_ptr(ptr)
declare i32 @use_i32(i32)

;Fixed-size alloca (compile-time known size)

define i32 @fixed_alloca(i32 %x) {
; Single alloca, frame allocated at compile time
; CHECK-LABEL: fixed_alloca:
; CHECK:       // %bb.0:
; CHECK-NEXT:    { xor32 r0, r0, r0; subi32 sp, sp, 16 }
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    { nop; addi32 r2, sp, 12 }
; CHECK-NEXT:    { nop; st32 r1, r2, 0 }
; CHECK-NEXT:    { nop; nop }
; CHECK-NEXT:    { nop; ld32 r1, r2, 0 }
; CHECK-NEXT:    { nop; addi32 sp, sp, 16 }
; CHECK-NEXT:    .cfi_def_cfa sp, 0
; CHECK-NEXT:    { nop; jalr r0, lr, 0 }
  %p = alloca i32
  store i32 %x, ptr %p
  %v = load i32, ptr %p
  ret i32 %v
}

;Variable-length array (VLA) - requires dynamic stack allocation
;
; DWARF CFA (T-ABI1): prologue sets FP = SP + StackSize (= incoming SP).
; CFA must then be `.cfi_def_cfa fp, 0`. `.cfi_def_cfa_register fp` keeps
; the prior offset StackSize, so CFA = FP+StackSize = incoming_SP+StackSize
; — wrong by the whole frame. `.cfi_offset` stays incoming-SP-relative.

define i32 @vla_basic(i32 %n) {
; Dynamic stack allocation with SUB32
; The store-then-load of constant 42 survives as an explicit ld32 in the
; post-schedule output (the fold no longer fires after the Flex cutover).
; CHECK-LABEL: vla_basic:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    { xor32 r0, r0, r0; subi32 sp, sp, 16 }
; CHECK-NEXT:    { nop; st32 fp, sp, 3 } // 4-byte Folded Spill
; CHECK-NEXT:    // 4-byte Spill
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    { nop; addi32 fp, sp, 16 }
; CHECK-NEXT:    .cfi_def_cfa fp, 0
; CHECK-NEXT:    .cfi_offset fp, -4
; CHECK-NEXT:    { slli32 r1, r1, 2; addi32 r2, r0, -8 }
; CHECK-NEXT:    { nop; addi32 r1, r1, 7 }
; CHECK-NEXT:    { nop; and32 r1, r1, r2 }
; CHECK-NEXT:    { nop; addi32 r1, r1, 7 }
; CHECK-NEXT:    { nop; and32 r1, r1, r2 }
; CHECK-NEXT:    { sub32 r1, sp, r1; addi32 r3, r0, 42 }
; CHECK-NEXT:    { nop; and32 r2, r1, r2 }
; CHECK-NEXT:    { nop; st32 r3, r2, 0; move32 sp, r2 }
; CHECK-NEXT:    { nop; nop }
; CHECK-NEXT:    { nop; xor32 r0, r0, r0; ld32 r1, r2, 0 }
; CHECK-NEXT:    { nop; addi32 sp, fp, -16 }
; CHECK-NEXT:    { nop; ld32 fp, sp, 3 }
; CHECK-NEXT:    { nop; addi32 sp, sp, 16 }
; CHECK-NEXT:    .cfi_def_cfa sp, 0
; CHECK-NEXT:    { nop; jalr r0, lr, 0 }
entry:
  %vla = alloca i32, i32 %n
  %p = getelementptr i32, ptr %vla, i32 0
  store i32 42, ptr %p
  %v = load i32, ptr %p
  ret i32 %v
}

;Dynamic alloca with call

define ptr @dynamic_alloca_with_call(i32 %size) {
