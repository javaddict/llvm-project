define i64 @test_fir_chain_hh_hl(i64 %acc0, i64 %a, i64 %b) {
; CHECK-LABEL: test_fir_chain_hh_hl:
; CHECK:       // %bb.0:
; CHECK-NEXT:    { nop; xor32 r0, r0, r0 }
; CHECK-NEXT:    { nop; subi32 sp, sp, 8 }
