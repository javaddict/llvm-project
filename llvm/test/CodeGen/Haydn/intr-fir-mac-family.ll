; FMULA32S_HH.
; Unblocks: bkfir16x16, firdec32x32 (dual-output 32x16 FIR MAC step).
;===------------------------------------------------------------------===;

define i64 @test_mulaa32s_fir_hh(i64 %acc, i64 %a, i64 %b) {
; CHECK-LABEL: test_mulaa32s_fir_hh:
