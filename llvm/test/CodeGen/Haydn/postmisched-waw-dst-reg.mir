# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postmisched -verify-machineinstrs %s -o - | FileCheck %s

# Role: MIR — same-bundle destination-register WAW must be rejected on the LIVE post-RA scoreboard path.


# REBASELINED : / pipeline reorder (ExpandPseudos/BitSimplify pre-scheduler + materialize at leaveRegion) — bundles regrouped, ops unchanged.
# REBASELINED : / FLEX cutover — test3 control (different-dest ADD32 pair) now bundles (S0+S1); test1/test2 WAW pairs stay un-bundled (regression intent preserved).
#
# REGRESSION TEST : same-bundle destination-register WAW must be rejected
# on the LIVE post-RA scoreboard path.
#
# Background: added HaydnVLIWPacketizer::hasWAWHazard (modifiesRegister
# alias-aware, no dead-def skip, SFR excluded) to forbid two instructions in
# one VLIW bundle from writing the same register (per register file) — spec
# VLIW_Engine_Compiler_Constraints.md §Constraints. then RETIRED the
# Phase-1 packetizer and made HaydnHazardRecognizer + materializeBundles the
# sole bundle authority. The gate lived inside the retired file and was
# deleted with it; nothing restored the explicit check on the new live path.
# (The older vliw-packetizer-waw-hazard.mir only kept passing because the
# scheduler DAG's output-dep edges happen to serialize the same-physreg defs
# in its cases — an indirect side-effect, not the explicit gate.)
#
# re-adds the gate in HaydnHazardRecognizer::getHazardType (a scheduler
# time gate so consumers keep correct latencies — NOT a materializeBundles
# un-bundle, which would create RAW violations). This test locks the contract:
# two instrs writing the SAME GPR dest -> NOT bundled (forced sequential)
# two instrs writing the SAME DR64 dest -> NOT bundled
# two instrs writing DIFFERENT dests -> bundled (control; guard must not
# over-reject, matching 's lesson)
#
# What breaks if regresses (gate removed AND the DAG stops serializing):
# test1/test2's pair lands in ONE BUNDLE 0, -> the CHECK (two standalone instrs
# no BUNDLE) fails. The base VLIWPacketizerList only emits a BUNDLE MI for
# multi-instruction packets; a forced-sequential pair shows up as two
# un-bundled instrs.
#
# note: is a RAW (consumer scheduled ahead of its ldu8 load), NOT a
# WAW — this test does NOT cover. See OPEN-COMPILER-BUGS.md.

--- |
  define void @test1_waw_same_gpr_dest_no_bundle() { ret void }
  define void @test2_waw_same_dr64_dest_no_bundle() { ret void }
  define void @test3_diff_dest_can_bundle() { ret void }
...
---
# ============================================================================
# Test 1: two ADD32 to the SAME GPR dest $r2. No RAW ($r0,$r1 vs $r3,$r4), no
# memory alias, ports fit (2R2W), slots free. Only the WAW on $r2 forbids the
# bundle -> MUST be two standalone instrs (no BUNDLE).
# ============================================================================
name:            test1_waw_same_gpr_dest_no_bundle
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $r3, $r4

    ; CHECK-LABEL: name: test1_waw_same_gpr_dest_no_bundle
    ; CHECK: liveins: $r0, $r1, $r3, $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2 = ADD32{{.*}} $r0, killed $r1, implicit-def dead $sfr
    ; CHECK-NEXT: $r2 = ADD32{{.*}} killed $r3, killed $r4, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY{{.*}} killed $r2
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    $r2 = ADD32 $r3, $r4, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 2: two DR64 ALU ops to the SAME dest $d2. DR64 has its own 7R3W file;
# the WAW is on $d2 (a DR64 register), so the guard (regsOverlap, reg-file
# independent) must still catch it -> NOT bundled.
# ============================================================================
name:            test2_waw_same_dr64_dest_no_bundle
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$d1', virtual-reg: '' }
  - { reg: '$d3', virtual-reg: '' }
  - { reg: '$d4', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $d0, $d1, $d3, $d4

    ; CHECK-LABEL: name: test2_waw_same_dr64_dest_no_bundle
    ; CHECK: liveins: $d0, $d1, $d3, $d4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $d2 = ADD64{{.*}} killed $d0, killed $d1, implicit-def dead $sfr
    ; CHECK-NEXT: $d2 = ADD64{{.*}} killed $d3, killed $d4, implicit-def dead $sfr
    ; CHECK-NEXT: $d0 = COPY{{.*}} killed $d2
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $d2 = ADD64 $d0, $d1, implicit-def dead $sfr
    $d2 = ADD64 $d3, $d4, implicit-def dead $sfr

    $d0 = COPY $d2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 3 (CONTROL): two ADD32 to DIFFERENT dests. No RAW, no WAW, ports fit
# slots free -> SHOULD bundle. Guards against the fix over-rejecting.
# ============================================================================
name:            test3_diff_dest_can_bundle
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $r3, $r4

    ; CHECK-LABEL: name: test3_diff_dest_can_bundle
    ; CHECK: liveins: $r0, $r1, $r3, $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2 = ADD32{{.*}} $r0, killed $r1, implicit-def dead $sfr
    ; CHECK-NEXT: $r7 = ADD32{{.*}} killed $r3, killed $r4, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY{{.*}} killed $r2
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    $r7 = ADD32 $r3, $r4, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
