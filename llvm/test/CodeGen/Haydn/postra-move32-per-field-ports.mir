# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postmisched -verify-machineinstrs %s -o - | FileCheck %s
# REQUIRES: haydn-registered-target
#
# Role: MIR — MOVE32 rd,rs is 1R1W (logical dest+src; descriptor and MI
# agree). Two MOVE32 sit at 2R2W. A store reading a just-written MOVE32
# destination (no-forwarding RAW) must not join its cycle regardless of
# the remaining read budget (4R - 2R = 2R covers the store's reads).
#
# Companion: countgprports-mir.mir (two MOVE32 still pack).

--- |
  define void @two_move32_plus_store(ptr %p) { ret void }
...
---
name:            two_move32_plus_store
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $r4

    ; CHECK-LABEL: name: two_move32_plus_store
    ; MOVE32 is 1R1W. The store reads $r2, so it cannot share a cycle
    ; with the first MOVE32 (no-forwarding RAW), even though the read
    ; budget (2R of 4R left) would cover it.
    ; CHECK: MOVE32
    ; CHECK: MOVE32
    ; CHECK: S_SW_WITH_IMM
    ; CHECK-NOT: BUNDLE{{.*}}MOVE32{{.*}}MOVE32{{.*}}S_SW_WITH_IMM
    $r2 = MOVE32 $r0, implicit-def dead $sfr
    $r3 = MOVE32 $r1, implicit-def dead $sfr
    ST32 $r2, $r4, 0 :: (store (s32))
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
