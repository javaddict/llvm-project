# RUN: split-file %s %t
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=haydn-finalize-mi-bundles,haydn-longbranch-normalize \
# RUN:   -verify-machineinstrs \
# RUN:   %t/keep.mir -o - | FileCheck %s --check-prefix=KEEP
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -debug-only=haydn-fixup-hwloops \
# RUN:   -run-pass=haydn-finalize-mi-bundles,haydn-longbranch-normalize \
# RUN:   %t/keep.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=KEEP-DBG
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=haydn-hwloops -verify-machineinstrs \
# RUN:   %t/demote.mir -o - | FileCheck %s --check-prefix=DEMOTE
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -debug-only=haydn-hwloops \
# RUN:   -run-pass=haydn-hwloops \
# RUN:   %t/demote.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=DEMOTE-DBG
# REQUIRES: asserts, haydn-registered-target
#
# GR1.4 H: closer consults LayoutSite canFitPatch/Dest/Dest2/Rank.
# Near Off1/Off2 stays FitPatch (hardware SET kept). Formation
# haydn-hwloops demotes unstamped out-of-range (SUBI32+BNEZ). Isolated
# -run-pass=haydn-fixup-hwloops is not a pass; stamped closer refuses
# CFG demote (d1171-hwloop-postcommit-demote-refuse). NeutralizedNop
# only on live-body L1 erase. AIE empty PreEmit
# (AIE2TargetMachine.cpp:92); Hexagon Fixup is opcode+getSize
# (HexagonFixupHwLoops.cpp:98-157). Haydn overlay is Root/Member +
# RelocFieldInfo + monotone rank.

# KEEP-LABEL: name: gr13_hwloop_fitpatch_keep
# KEEP: SET_HWLOOP
# KEEP-NOT: SUBI32
# KEEP-NOT: BNEZ

# KEEP-DBG: canFitPatch
# KEEP-DBG: site rank FitPatch Off1/Off2
# KEEP-DBG-NOT: site rank NeutralizedNop
# KEEP-DBG-NOT: LLVM ERROR

# DEMOTE-LABEL: name: gr13_hwloop_neutralized_demote
# DEMOTE-NOT: SET_HWLOOP
# DEMOTE: SUBI32
# DEMOTE: BNEZ

# DEMOTE-DBG: demoting hwloop
# DEMOTE-DBG-NOT: LLVM ERROR

//--- keep.mir
--- |
  define dso_local void @gr13_hwloop_fitpatch_keep(ptr nocapture writeonly %out) {
  entry:
    br label %body
  body:
    store i32 0, ptr %out, align 4
    br label %exit
  exit:
    ret void
  }
...
---
name:            gr13_hwloop_fitpatch_keep
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r0, $r15
    successors: %bb.1
    $r0 = frame-setup XOR32 $r0, $r0, implicit-def dead $sfr
    SET_HWLOOP_W 0, %bb.1, %bb.1, 8, implicit-def dead $sfr
    NOP
    NOP
    NOP

  bb.1.body:
    liveins: $r1, $r0
    successors: %bb.2
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.2.exit:
    liveins: $r15
    RET implicit killed $r15

//--- demote.mir
--- |
  define dso_local void @gr13_hwloop_neutralized_demote(ptr nocapture writeonly %out) {
  entry:
    br label %body
  body:
    store i32 0, ptr %out, align 4
    br label %exit
  exit:
    ret void
  }
...
---
name:            gr13_hwloop_neutralized_demote
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r0, $r15
    successors: %bb.1
    $r0 = frame-setup XOR32 $r0, $r0, implicit-def dead $sfr
    ; 21 NOPs after SET: SET-parcel-base Off1 encodes 264 B > uimm6 252.
    SET_HWLOOP_W 0, %bb.1, %bb.1, 8, implicit-def dead $sfr
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP

  bb.1.body:
    liveins: $r1, $r0
    successors: %bb.2
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.2.exit:
    liveins: $r15
    RET implicit killed $r15
