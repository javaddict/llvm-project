# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postmisched -verify-machineinstrs %s -o - | FileCheck %s

# Role: MIR — VLIW STRESS TEST: Hazard detection — RAW, WAW, memory deps, slot conflicts.


# REBASELINED : / pipeline reorder (ExpandPseudos/BitSimplify pre-scheduler + materialize at leaveRegion) — bundles regrouped, ops unchanged.
# REBASELINED : dual-sched pre-RA — trailing NOP before JALR (delay-slot fill order).
# REBASELINED : / FLEX cutover — LD32/ST32 now render as LD32_S0/ST32_S0; the slot-1-promoted load renders as LD32_S1. All hazard intents preserved: RAW/WAW chains stay sequential (tests 1/2/3), store-store alias stays separate (test4), LD32+ST32 same-addr stays separate (test7), ST32 slot conflict stays separate (test6), two LD32 still bundle via slot-1 promotion (test5).
#
# NOTE: updated for VLIW slot-1 load promotion — independent loads now pack as ld32+ld32.
#
# VLIW STRESS TEST: Hazard detection — RAW, WAW, memory deps, slot conflicts.
#
# Verifies that the packetizer correctly PREVENTS bundling when:
# 1. RAW hazard exists (GPR32)
# 2. RAW hazard exists (DR64)
# 3. WAW hazard exists (both write same register)
# 4. Two stores to potentially-aliasing addresses
# 5. Two independent LD32 pack as LD32 + LD32_S1 (slot-1 promotion,)
# 6. Two ST32 cannot share SLOT0 (slot conflict)
# 7. LD32 + ST32 from same address (memory dependency)
#

--- |
  define void @test1_raw_gpr32_chain() { ret void }
  define void @test2_raw_dr64_chain() { ret void }
  define void @test3_waw_gpr32() { ret void }
  define void @test4_store_store_alias() { ret void }
  define void @test5_two_ld32_slot_conflict() { ret void }
  define void @test6_two_st32_slot_conflict() { ret void }
  define void @test7_ld_st_same_addr() { ret void }
...
---
# ============================================================================
# Test 1: Long RAW chain on GPR32 — every instruction depends on the previous
# ============================================================================
#
# Four ADD32 instructions forming a dependency chain:
# r2 = ADD32 r0, r1
# r3 = ADD32 r2, r0 (reads r2 from prev)
# r4 = ADD32 r3, r0 (reads r3 from prev)
# r5 = ADD32 r4, r0 (reads r4 from prev)
# No two can be in the same bundle. All must be separate.
#
name:            test1_raw_gpr32_chain
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1

    ; All four are RAW-dependent. No BUNDLE should be created.

    ; CHECK-LABEL: name: test1_raw_gpr32_chain
    ; CHECK: liveins: $r0, $r1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2 = ADD32{{.*}} $r0, killed $r1, implicit-def dead $sfr
    ; CHECK-NEXT: $r3 = ADD32{{.*}} killed $r2, $r0, implicit-def dead $sfr
    ; CHECK-NEXT: $r4 = ADD32{{.*}} killed $r3, $r0, implicit-def dead $sfr
    ; CHECK-NEXT: $r5 = ADD32{{.*}} killed $r4, $r0, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY{{.*}}$r5
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    $r3 = ADD32 $r2, $r0, implicit-def dead $sfr
    $r4 = ADD32 $r3, $r0, implicit-def dead $sfr
    $r5 = ADD32 $r4, $r0, implicit-def dead $sfr

    $r0 = COPY $r5
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 2: Long RAW chain on DR64 — every instruction depends on the previous
# ============================================================================
#
# ADD64 -> SUB64 -> OR64 chain on DR64 registers. Same as test1 but DR64 bank.
#
name:            test2_raw_dr64_chain
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$d1', virtual-reg: '' }
  - { reg: '$d2', virtual-reg: '' }
  - { reg: '$d3', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $d0, $d1, $d2, $d3

    ; All three are RAW-dependent on DR64. No BUNDLE.

    ; CHECK-LABEL: name: test2_raw_dr64_chain
    ; CHECK: liveins: $r0, $d0, $d1, $d2, $d3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $d4 = ADD64{{.*}} killed $d0, killed $d1, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY{{.*}} $r0
    ; CHECK-NEXT: $d5 = SUB64{{.*}} killed $d4, killed $d2, implicit-def dead $sfr
    ; CHECK-NEXT: $d6 = OR64{{.*}} killed $d5, killed $d3, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $d4 = ADD64 $d0, $d1, implicit-def dead $sfr
    $d5 = SUB64 $d4, $d2, implicit-def dead $sfr
    $d6 = OR64 $d5, $d3, implicit-def dead $sfr

    $r0 = COPY $r0
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 3: WAW hazard — two instructions write the same GPR32 register
# ============================================================================
#
# Two ADD32 both write $r2. Even though they read different registers, the
# WAW hazard means they cannot execute in parallel (the architectural result
# of $r2 would be undefined).
#
name:            test3_waw_gpr32
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $r3, $r4

    ; Both write $r2 — WAW hazard prevents bundling.

    ; CHECK-LABEL: name: test3_waw_gpr32
    ; CHECK: liveins: $r0, $r1, $r3, $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2 = ADD32{{.*}} $r0, killed $r1, implicit-def dead $sfr
    ; CHECK-NEXT: $r2 = ADD32{{.*}} killed $r3, killed $r4, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY{{.*}}$r2
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    $r2 = ADD32 $r3, $r4, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 4: Two stores to the same address — memory dependency prevents bundle
# ============================================================================
#
# ST32 to [r0+0] then ST32 to [r0+0]. Store-Store alias -> memory dep.
# They must be in separate bundles.
#
name:            test4_store_store_alias
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $r2

    ; Both ST32 store to same address [r0+0]. Memory dependency.
    ; Additionally, both need SLOT0 (Slot0_LS) — slot conflict too.

    ; CHECK-LABEL: name: test4_store_store_alias
    ; CHECK: liveins: $r0, $r1, $r2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: {{ST32|S_SW_WITH_IMM}}{{.*}} killed $r1, $r0, 0, implicit-def dead $sfr
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: {{ST32|S_SW_WITH_IMM}}{{.*}} killed $r2, $r0, 0, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY{{.*}} $r0
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    ST32 $r1, $r0, 0, implicit-def dead $sfr
    ST32 $r2, $r0, 0, implicit-def dead $sfr

    $r0 = COPY $r0
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 5: Two LD32 from different addresses — slot conflict (both need SLOT0)
# ============================================================================
#
# LD32 uses Slot0_LS which maps to SLOT0 only. Even though Load-Load has no
# memory dependency (parallel reads), the DFA prevents both from reserving
# SLOT0 simultaneously. Must be separate bundles.
#
name:            test5_two_ld32_slot_conflict
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1

    ; Two independent logical LD32 pack into one bundle (Slot01_LD / placement).
    ; Flex S0/S1 windows materialize only at encode.

    ; CHECK-LABEL: name: test5_two_ld32_slot_conflict
    ; CHECK: liveins: $r0, $r1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2 = {{LD32|S_LW_WITH_IMM}}{{.*}} $r0, 0, implicit-def dead $sfr
    ; CHECK-NEXT: $r3 = {{LD32|S_LW_WITH_IMM}}{{.*}} killed $r1, 0, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY{{.*}}$r2
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r2 = LD32 $r0, 0, implicit-def dead $sfr
    $r3 = LD32 $r1, 0, implicit-def dead $sfr

    $r0 = COPY $r2
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 6: Two ST32 to different addresses — slot conflict (both need SLOT0)
# ============================================================================
#
# ST32 uses Slot0_LS -> SLOT0 only. Both need SLOT0. Even if addresses don't
# alias, the DFA prevents the bundle.
#
name:            test6_two_st32_slot_conflict
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r3

    ; Both ST32 need SLOT0. DFA slot conflict prevents bundling.

    ; CHECK-LABEL: name: test6_two_st32_slot_conflict
    ; CHECK: liveins: $r0, $r1, $r2, $r3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: {{ST32|S_SW_WITH_IMM}}{{.*}} killed $r2, $r0, 0, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY{{.*}} $r0
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: {{ST32|S_SW_WITH_IMM}}{{.*}} killed $r3, killed $r1, 0, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    ST32 $r2, $r0, 0, implicit-def dead $sfr
    ST32 $r3, $r1, 0, implicit-def dead $sfr

    $r0 = COPY $r0
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
---
# ============================================================================
# Test 7: LD32 + ST32 from same address — memory dependency prevents bundle
# ============================================================================
#
# LD32 reads [r0+0], then ST32 writes [r0+0]. Load-Store alias.
# Additionally, both need SLOT0. Both reasons prevent bundling.
#
name:            test7_ld_st_same_addr
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r0, $r2

    ; LD32 then ST32 to same address [r0+0]. Memory dependency + slot conflict.

    ; CHECK-LABEL: name: test7_ld_st_same_addr
    ; CHECK: liveins: $r0, $r2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r1 = {{LD32|S_LW_WITH_IMM}}{{.*}} $r0, 0, implicit-def dead $sfr
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: {{ST32|S_SW_WITH_IMM}}{{.*}} killed $r2, $r0, 0, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = COPY{{.*}}$r1
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit $r15
    $r1 = LD32 $r0, 0, implicit-def dead $sfr
    ST32 $r2, $r0, 0, implicit-def dead $sfr

    $r0 = COPY $r1
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
