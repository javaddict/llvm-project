# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postmisched \
# RUN:     -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=OFF
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postmisched \
# RUN:     -verify-machineinstrs -haydn-postra-interblock \
# RUN:     -haydn-postra-region-end-edges %s -o - \
# RUN:     | FileCheck %s --check-prefix=ON
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postmisched,postmisched \
# RUN:     -verify-machineinstrs -haydn-postra-interblock \
# RUN:     -haydn-postra-region-end-edges %s -o - \
# RUN:     | FileCheck %s --check-prefix=S2
#
# W68.2R conservative inter-block pin. Stage-0 next-block pack (the old
# "pull independent Succ ADDI into Pred and co-issue") was deleted with
# HC#0 walker/AIE InterBlockScheduling. Haydn's -haydn-postra-interblock
# flag (default off) is a target-owned DDG / effective-latency cut only:
# extra edges suppress reductions and are safe; it must NOT move an
# independent successor ADDI into the predecessor.
#
# Fixture: acyclic fallthrough Pred -> Succ. Pred has a lone ADDI32; Succ
# has an independent ADDI32 (different regs) plus a return.
#   * default-off: packing-identical S1 — each ADDI stays in its BB.
#   * flag on: still no cross-BB pack (verify-clean).
#   * two postmisched invocations (S1 then S2): whole-function reschedule
#     still does not hoist Succ's ADDI into Pred.

--- |
  define void @fallthrough_pack() { ret void }
...
---
name:            fallthrough_pack
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  ; OFF-LABEL: name: fallthrough_pack
  ; OFF: bb.0:
  ; OFF: $r1 = ADDI32 $r0, 1
  ; OFF-NOT: $r7 = ADDI32
  ; OFF: bb.1:
  ; OFF: $r7 = ADDI32
  ; OFF-NOT: BUNDLE
  ; OFF-NOT: NOP
  ; OFF: $r0 = COPY
  ; OFF-NEXT: $r0 = JALR

  ; ON-LABEL: name: fallthrough_pack
  ; ON: bb.0:
  ; ON: $r1 = ADDI32 $r0, 1
  ; ON-NOT: $r7 = ADDI32
  ; ON: bb.1:
  ; ON: $r7 = ADDI32
  ; ON-NOT: BUNDLE
  ; ON: JALR

  ; S2-LABEL: name: fallthrough_pack
  ; S2: bb.0:
  ; S2: $r1 = ADDI32 $r0, 1
  ; S2-NOT: $r7 = ADDI32
  ; S2: bb.1:
  ; S2: $r7 = ADDI32
  ; S2: JALR

  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $r0, $r3

    $r1 = ADDI32 $r0, 1, implicit-def dead $sfr

  bb.1:
    liveins: $r0, $r1, $r3, $r15

    $r7 = ADDI32 $r3, 2, implicit-def dead $sfr
    $r0 = COPY killed $r7
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15

...
