; RUN: llc -mtriple=haydn-unknown-elf -global-isel-abort=1 -O2 \
; RUN:     -haydn-branch-relax-safety-buffer=200 \
; RUN:     -verify-machineinstrs < %s 2>&1 | FileCheck %s
;
; D1.33 one-buffer pin: a NON-DEFAULT -haydn-branch-relax-safety-buffer
; value must move EVERY far-deciding seat together — the TII
; isBranchOffsetInRange window test, the hwloop-demote LongLatch decision
; (which consumes TII.getBranchRelaxSafetyBuffer(), never a compile-time
; constant), and the pre-S1 normalization far-test. Before the fix, the
; demote read the compile-time BranchRelaxSafetyBufferBytes while BR read
; the cl::opt: a raised buffer could make BR measure far where the demote
; measured near (or vice versa), splitting the two seats into disagreeing
; promotions and driving the postcommit CFG wall on legal code.
;
; This loop's body (~18KB) overflows the Off2 uimm12x4 window (forcing
; the demote) AND the demoted BNEZ backedge overflows simm12 under the
; RAISED buffer in BOTH seats' view: the demote installs the long-latch
; template and the compile finishes green (no postcommit CFG-creation
; refusal, no trampoline).

@g = global [4096 x i32] zeroinitializer

define i32 @buffer_agree_loop(i32 %n) {
; CHECK-LABEL: buffer_agree_loop:
entry:
  br label %loop
loop:
