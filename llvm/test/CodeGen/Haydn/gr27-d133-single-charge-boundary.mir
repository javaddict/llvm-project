# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=haydn-fixup-hwloops -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s --check-prefix=DEF
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=haydn-fixup-hwloops -haydn-branch-relax-safety-buffer=0 \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=BUF0
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=haydn-fixup-hwloops -haydn-branch-relax-safety-buffer=100 \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=BUF100
# REQUIRES: haydn-registered-target
#
# D1.33 class 2 pin: single-charge boundary of the demote LongLatch
# decision. TII.isBranchOffsetInRange (HaydnInstrInfo.cpp) is the ONLY
# seat that inflates a displacement by getBranchRelaxSafetyBuffer(); the
# demote seat (HaydnHardwareLoops.cpp) passes the RAW signed backedge
# displacement. Before the fix the demote pre-added the SAME buffer, so
# the legal short-latch window was BackedgeBytes <= 2048 - 2*buffer
# instead of <= 2048 - buffer: at the default buffer (48 B = 4 parcels)
# the double charge stole the (1952, 2000] band — valid near-boundary
# short latches were forced long and then had to find a computed-dead
# JALR scratch (a fail-closed compile error on legal code).
#
# Parcel arithmetic: each NOP is one product parcel (12 B); the demote
# measures the Header<-Latch span BEFORE installing the countdown, so
# BackedgeBytes = NOPs * 12 exactly (verified against the pass debug
# "backedge NB" print during construction):
#   t162 = 1944 B   t163 = 1956 B   t166 = 1992 B   t167 = 2004 B
# Short-latch legality after this fix: BackedgeBytes + buffer <= 2048
# (single charge, applied once inside the TII oracle).
#
# Demote trigger: OUT-OF-DOMAIN selector (Sel=2; product domain is {0,1})
# flows through the same shared demoteHardwareLoopToSoftware long-latch
# path as an Off2-overflow demote, but lets the body be arbitrarily
# small. An Off2-overflow trigger necessarily spans > 16380 B
# (uimm12x4) and can never sit inside the 48 B boundary band, so it
# cannot pin this boundary. Do not replace Sel=2 with a legal selector
# without re-deriving every arm from the arithmetic.
#
# Arms (check prefixes Default / Buf0 / Buf100):
#   Default run — t166 (1992 B) stays SHORT (was the stolen band);
#   t167 (2004 B) goes LONG with the terminal LUI+ADDI32_W+BEQZ_W+
#   JALR_W form and no BNEZ backedge (oracle not weakened); t162/t163
#   stay SHORT (1944/1956 B <= 2000 B single charge).
#   Buf0 run — the SAME 2004 B t167 body stays SHORT (buffer=0 moves
#   the demote boundary to 2048 through the one accessor; proves the
#   flag reaches the demote seat transitively via the oracle).
#   Buf100 run — t163 (1956 B) goes LONG (boundary 1948) while t162
#   (1944 B) stays SHORT, pinning both sides of the raised boundary.

--- |
  define dso_local i32 @t162() {
  entry:
    br label %body
  body:
    br label %exit
  exit:
    ret i32 0
  }

  define dso_local i32 @t163() {
  entry:
    br label %body
  body:
    br label %exit
  exit:
    ret i32 0
  }

  define dso_local i32 @t166() {
  entry:
    br label %body
  body:
    br label %exit
  exit:
    ret i32 0
  }

  define dso_local i32 @t167() {
  entry:
    br label %body
  body:
    br label %exit
  exit:
    ret i32 0
  }
...
---
name:            t162
alignment:       1
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r2, $r15
    successors: %bb.1
    SET_HWLOOP_F2_W 2, %bb.1, %bb.1, $r2, implicit-def dead $sfr

  bb.1.body:
    liveins: $r2
    successors: %bb.2

  bb.2.exit:
    liveins: $r2, $r15
    RET implicit $r15

