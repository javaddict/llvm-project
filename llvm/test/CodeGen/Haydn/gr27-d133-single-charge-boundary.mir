# ----- default buffer (48 B): single charge boundary at 2000 B -----
# DEF-LABEL: name: t162
# 1944 B: short at default AND at buffer=100 (<= 1948).
# DEF: SUBI32
# DEF: BNEZ{{.*}} $r2, {{.*}}bb.1
# DEF-NOT: JALR
# BUF100-LABEL: name: t162
# BUF100: SUBI32
# BUF100: BNEZ{{.*}} $r2, {{.*}}bb.1
# BUF100-NOT: JALR
#
# DEF-LABEL: name: t163
# 1956 B: short at default (<= 2000), LONG at buffer=100 (> 1948).
# DEF: SUBI32
# DEF: BNEZ{{.*}} $r2, {{.*}}bb.1
# DEF-NOT: JALR
# BUF100-LABEL: name: t163
# BUF100: LUI
# BUF100: ADDI32
# Terminal exit test reads the COUNTDOWN ($r2), never the scratch.
# BUF100: BEQZ{{.*}} $r2, {{.*}}bb.2
# BUF100: JALR{{.*\$r11, 0}}
# No short backedge survives a long latch.
# BUF100-NOT: BNEZ
#
# DEF-LABEL: name: t166
# 1992 B: THE STOLEN BAND (1952, 2000] at the default buffer. Single
# charge keeps the short BNEZ; the old double charge (1992 + 2*48 >
# 2048) forced the long form here.
# DEF: SUBI32
# DEF: BNEZ{{.*}} $r2, {{.*}}bb.1
# DEF-NOT: JALR
#
# DEF-LABEL: name: t167
# 2004 B: past the single-charge boundary even at the raw 2048 window
# before growth — long at default. Pins that the oracle was NOT
# weakened: the terminal in-block template in the corrected order
# LUI(scr) ; ADDI32_W(scr) ; BEQZ_W(countdown, Exit) ; JALR_W(scr).
# DEF: LUI
# DEF: ADDI32
# DEF: BEQZ{{.*}} $r2, {{.*}}bb.2
# DEF: JALR{{.*\$r11, 0}}
# DEF-NOT: BNEZ
#
# ----- buffer=0: the SAME 2004 B body stays short (boundary 2048) -----
# The flag moves the demote boundary THROUGH the one accessor; if any
# far-deciding seat captured the buffer separately this arm would
# disagree with the BUF100 arm above.
# BUF0-LABEL: name: t167
# BUF0: SUBI32
# BUF0: BNEZ{{.*}} $r2, {{.*}}bb.1
# BUF0-NOT: JALR
