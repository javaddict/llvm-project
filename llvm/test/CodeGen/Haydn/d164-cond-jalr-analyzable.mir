---
name:            jalr_msp_then_cond_long_jalr
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r10', virtual-reg: '' }
  - { reg: '$r15', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        true
body:             |
  bb.0.entry:
    successors: %bb.2, %bb.1
    liveins: $r1, $r10, $r15
    ; CHECK-LABEL: name: jalr_msp_then_cond_long_jalr
    ; CHECK: bb.0.entry
    ; va-arg-24 @verify bb.22: returning JALR_CALL then LUI/ADDI %bb +
    ; cond + CFG JALR. Dest recovery must keep the pair two-way.
    ; CHECK: JALR_CALL
    ; CHECK: {{BNEZ|BEQZ}}
    ; CHECK: JALR
    ; RELAX-LABEL: name: jalr_msp_then_cond_long_jalr
    ; RELAX: JALR_CALL
    ; RELAX: JALR
    $r15 = JALR_CALL $r10, 0, implicit-def $r1, implicit-def $r2, implicit-def $r3, implicit-def $r4, implicit-def $r5, implicit-def $r6, implicit-def $r7, implicit-def $r12, implicit-def $d0, implicit-def $d1, implicit-def $d2, implicit-def $d3, implicit-def $d4, implicit-def $d5, implicit-def $d6, implicit-def $d7
    BUNDLE implicit-def $r7 {
      $r7 = LUI_E2_E0_ALU0_I12 %bb.1
    }
    BUNDLE implicit-def $r7, implicit $r7 {
      $r7 = ADDI32_E2_E0_ALU0_RI20 $r7, %bb.1
    }
    BUNDLE implicit $r1 {
      BNEZ_E2_E0_ALU0_I12 $r1, %bb.2
    }
    BUNDLE implicit-def $r7, implicit-def $r1, implicit-def $r2, implicit-def $r3, implicit-def $r4, implicit-def $r5, implicit-def $r6, implicit-def $r12, implicit-def $d0, implicit-def $d1, implicit-def $d2, implicit-def $d3, implicit-def $d4, implicit-def $d5, implicit-def $d6, implicit-def $d7, implicit $r7 {
      $r7 = JALR_E2_E0_ALU0_RI12 $r7, 0, implicit-def $r1, implicit-def $r2, implicit-def $r3, implicit-def $r4, implicit-def $r5, implicit-def $r6, implicit-def $r7, implicit-def $r12, implicit-def $d0, implicit-def $d1, implicit-def $d2, implicit-def $d3, implicit-def $d4, implicit-def $d5, implicit-def $d6, implicit-def $d7
    }

  bb.1.near:
    liveins: $r15
    RET implicit $r15

  bb.2.far:
    liveins: $r15
    RET implicit $r15

...
