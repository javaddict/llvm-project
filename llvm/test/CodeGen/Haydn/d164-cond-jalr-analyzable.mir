    successors: %bb.2, %bb.1
    liveins: $r1, $r15
    ; CHECK-LABEL: name: bundled_cond_with_jalr_dest
    ; Coissued cond + CFG JALR. unwrap prefers the cond; JALR dest must
    ; be recovered from preceding LUI/ADDI (bundle-member dest scan) so
    ; the pair stays two-way — not one-way cond + layout fall-through.
    ; CHECK: successors: %bb.2{{.*}}%bb.1
