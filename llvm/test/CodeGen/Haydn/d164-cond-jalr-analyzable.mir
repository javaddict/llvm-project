---
name:            destless_jalr_bundled_ret
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r15
    ; CHECK-LABEL: name: destless_jalr_bundled_ret
    ; Dest-less bundled RET JALR is unanalyzable, never fall-through.
    ; CHECK: $r0 = JALR_W $r15, 0
    BUNDLE implicit-def $r0, implicit $r15 {
      $r0 = JALR_W $r15, 0
    }

...
---
name:            destless_jalr_computed_after_cond
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2, $r15
    ; CHECK-LABEL: name: destless_jalr_computed_after_cond
    ; Cond then dest-less computed JALR: keep both successors; do not
    ; analyze as cond+fall-through (JALR is a barrier).
    ; CHECK: successors: %bb.1{{.*}}%bb.2
    ; CHECK: $r0 = JALR_W $r1, 0
    BNEZ_W $r2, %bb.2
    $r0 = JALR_W $r1, 0
  bb.1:
    liveins: $r15
    RET implicit $r15
  bb.2:
    liveins: $r15
    RET implicit $r15

...
---
name:            destless_bundled_jalr_with_cond
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2, $r15
    ; CHECK-LABEL: name: destless_bundled_jalr_with_cond
    ; Unwrap may return the cond; dest-less sibling JALR must stay
    ; unanalyzable (not cond+fall-through).
    ; CHECK: successors: %bb.1{{.*}}%bb.2
    ; CHECK: $r0 = JALR_W $r1, 0
    BUNDLE implicit $r2, implicit-def $r0, implicit $r1 {
      BNEZ_W $r2, %bb.2
      $r0 = JALR_W $r1, 0
    }
  bb.1:
    liveins: $r15
    RET implicit $r15
  bb.2:
    liveins: $r15
    RET implicit $r15

...
---
name:            cond_after_jalr_call
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r8', virtual-reg: '' }
  - { reg: '$r10', virtual-reg: '' }
  - { reg: '$r15', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        true
body:             |
  bb.0.entry:
    successors: %bb.2, %bb.1
    liveins: $r8, $r10, $r15
    ; CHECK-LABEL: name: cond_after_jalr_call
    ; CHECK: bb.0.entry
    ; va-arg-24 @verify shape: returning JALR_CALL then a far cond.
    ; Must compile (no analyzable assert). Cond survives invert-swap.
    ; CHECK: JALR_CALL
    ; CHECK: {{BNEZ|BEQZ}}
    $r15 = JALR_CALL $r10, 0, implicit-def $r1, implicit-def $r2, implicit-def $r3, implicit-def $r4, implicit-def $r5, implicit-def $r6, implicit-def $r7, implicit-def $r12, implicit-def $d0, implicit-def $d1, implicit-def $d2, implicit-def $d3, implicit-def $d4, implicit-def $d5, implicit-def $d6, implicit-def $d7
    BNEZ_E2_E0_ALU0_I12 $r8, %bb.2

  bb.1.near:
    liveins: $r15
    NOP
    NOP
