    liveins: $r8, $r15
    ; CHECK-LABEL: name: jalr_msp_lui_then_cond
    ; LUI/ADDI of JALR_CALL rs is not a CFG dest. %bb.3 is not a successor;
    ; recovering it as FBB fails MachineVerifier. Cond stays one-way
    ; (fall-through + TBB).
    ; CHECK: successors: %bb.2{{.*}}%bb.1
