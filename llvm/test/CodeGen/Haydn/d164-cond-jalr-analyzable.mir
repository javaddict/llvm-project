name:            bundled_cond_uncond_with_jalr_msp
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.2, %bb.3
    liveins: $r8, $r10, $r15
    ; CHECK-LABEL: name: bundled_cond_uncond_with_jalr_msp
    ; Cond + short B + returning JALR_CALL in one cycle. JALR_CALL is not a CFG
    ; jump; sibling B stays FBB.
    ; CHECK: successors: %bb.2{{.*}}%bb.3
    ; CHECK: {{BNEZ|BEQZ}}
    ; CHECK: B %bb.3
    ; CHECK: JALR_CALL
    BUNDLE implicit $r8, implicit-def $r15, implicit $r10, implicit-def $r1, implicit-def $r2, implicit-def $r3, implicit-def $r4, implicit-def $r5, implicit-def $r6, implicit-def $r7, implicit-def $r12, implicit-def $d0, implicit-def $d1, implicit-def $d2, implicit-def $d3, implicit-def $d4, implicit-def $d5, implicit-def $d6, implicit-def $d7 {
      BNEZ_W $r8, %bb.2
      B %bb.3
      $r15 = JALR_CALL $r10, 0, implicit-def $r1, implicit-def $r2, implicit-def $r3, implicit-def $r4, implicit-def $r5, implicit-def $r6, implicit-def $r7, implicit-def $r12, implicit-def $d0, implicit-def $d1, implicit-def $d2, implicit-def $d3, implicit-def $d4, implicit-def $d5, implicit-def $d6, implicit-def $d7
    }
  bb.1.skip:
    liveins: $r15
    RET implicit $r15
  bb.2.taken:
    liveins: $r15
    RET implicit $r15
  bb.3.other:
    liveins: $r15
    RET implicit $r15

