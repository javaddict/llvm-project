# RUN: llc -mtriple=haydn-unknown-elf -run-pass=branch-relaxation \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=haydn-unknown-elf \
# RUN:   -run-pass=haydn-longbranch-normalize,branch-relaxation \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=RELAX
# REQUIRES: haydn-registered-target
#
# D1.64 HOLD va-arg-24: LateConvergence BR must not insertIndirectBranch
# (postcommit CFG wall). Overlays:
#   1) LUI/ADDI %bb dest recovery so cond+long-form JALR stays two-way.
#   2) JALR_CALL (returning fnptr call) is not a CFG jump — dest-less dest
#      recovery must not abort the walk (va-arg-24.c -O3 @verify: printf
#      JALR_CALL then a far cond in the same MBB).
#   3) Normalize already-long skip is LUI+ADDI+JALR only. A returning
#      JALR_CALL is not that form; skipping the whole MBB left a far short
#      uncond for LateConvergence BR::fixupUnconditionalBranch.
#   4) Coissued short uncond B beside a cond (and beside JALR_CALL) stays
#      the FBB. unwrap prefers the cond; hiding the sibling reports one-way
#      cond + layout fall-through (va-arg-22 MEMORY_FAULT). Same for a
#      coissued short uncond B, and for a sibling CFG JALR whose
#      dest is recovered from preceding LUI/ADDI (bundle members).
#   5) Far TBB on bundled dest recovery (cond_then_jalr_bundled,
#      bundled_cond_with_jalr_dest) forces BranchRelaxation analyze —
#      dest-scan miss is an analyzable-assert.
# JAL_W is not an analyzable uncond terminator. Dest-less CFG
# JALR/RET/computed-goto stay unanalyzable (never analyzable fall-through
# — JALR is a barrier). getBranchDestBlock returns null on dest-less
# JALR/RET/JALR_W/JAL-without-MBB, never UNREACHABLE.
#
# Layout: cond TBB is %bb.2, JALR FBB is layout-next %bb.1. 180 NOP parcels
# in %bb.1 make entry→bb.2 miss WIDE_BranchSImm12 (byte PC+imm, ~2048B)
# while FBB stays near so invert-swap does not create CFG. Bare generated
# members match the MI opcode BR prints (not a BUNDLE root: GR2.7
# isBranchOffsetInRange(BUNDLE) is always in-range). Singleton BUNDLE
# roots (cond_then_jalr_bundled) are the Fixup/Finalize shape: dest
# recovery must continue past JALR so the cond successor stays explained.
# Peer: Hexagon analyzeBranch instr_iterator (HexagonInstrInfo.cpp:435-508);
# RISC-V / AIE leave dest-less indirect unanalyzable
# (RISCVInstrInfo.cpp:1325-1327, AIEBaseInstrInfo.cpp:186-188).

--- |
  define void @cond_then_jalr_e2(i32 %c) {
  entry:
    br i1 undef, label %far, label %near
  far:
    ret void
  near:
    ret void
  }
  define void @destless_jalr_ret() {
    ret void
  }
  define void @destless_jalr_after_csrw() {
    ret void
  }
  define void @destless_jalr_computed(ptr %p) {
    indirectbr ptr %p, [label %a, label %b]
  a:
    ret void
  b:
    ret void
  }
  define void @destless_jalr_after_unrelated_lui() {
    ret void
  }
  define void @cond_then_jalr_bundled(i32 %c) {
  entry:
    br i1 undef, label %far, label %near
  far:
    ret void
  near:
    ret void
  }
  define void @destless_jalr_bundled_ret() {
    ret void
  }
  define void @destless_jalr_computed_after_cond(ptr %p, i32 %c) {
    br i1 undef, label %b, label %indirect
  indirect:
    indirectbr ptr %p, [label %a, label %b]
  a:
    ret void
  b:
    ret void
  }
  define void @destless_bundled_jalr_with_cond(ptr %p, i32 %c) {
    br i1 undef, label %b, label %indirect
  indirect:
    indirectbr ptr %p, [label %a, label %b]
  a:
    ret void
  b:
    ret void
  }
  define void @cond_after_jalr_call(i32 %c, ptr %p) {
  entry:
    br i1 undef, label %far, label %near
  far:
    ret void
  near:
    ret void
  }
  define void @bundled_cond_with_jalr_call(i32 %c, ptr %p) {
    br i1 undef, label %b, label %a
  a:
    ret void
  b:
    ret void
  }
  define void @jalr_msp_then_far_uncond(ptr %p) {
  entry:
    call void %p()
    br label %far
  pad:
    ret void
  far:
    ret void
  }
  define void @bundled_far_uncond_with_jalr_msp(ptr %p) {
  entry:
    call void %p()
    br label %far
  pad:
    ret void
  far:
    ret void
  }
  define void @bundled_jalr_msp_then_cond(i32 %c, ptr %p) {
    br i1 undef, label %b, label %a
  a:
    ret void
  b:
    ret void
  }
  define void @bundled_jalr_msp_then_uncond_b(ptr %p) {
    call void %p()
    br label %dst
  dst:
    ret void
  }
  define void @jalr_msp_lui_then_cond(i32 %c) {
    br i1 undef, label %far, label %near
  far:
    ret void
  near:
    ret void
  }
  define void @destless_ret() {
    ret void
  }
  define void @destless_jalr_w_msp(ptr %p) {
    ret void
  }
  define void @jal_w_not_analyzable_uncond() {
    ret void
  }
  define void @jalr_msp_then_cond_long_jalr(i32 %c, ptr %p) {
  entry:
    br i1 undef, label %far, label %near
  far:
    ret void
  near:
    ret void
  }
  define void @cond_then_jalr_unrelated_add(i32 %c) {
  entry:
    br i1 undef, label %far, label %near
  far:
    ret void
  near:
    ret void
  }
  define void @bundled_cond_with_uncond_b(i32 %c) {
  entry:
    br i1 undef, label %taken, label %other
  skip:
    ret void
  taken:
    ret void
  other:
    ret void
  }
  define void @bundled_uncond_b_then_cond(i32 %c) {
  entry:
    br i1 undef, label %taken, label %other
  skip:
    ret void
  taken:
    ret void
  other:
    ret void
  }
  define void @bundled_cond_uncond_with_jalr_msp(i32 %c, ptr %p) {
  entry:
    br i1 undef, label %taken, label %other
  skip:
    ret void
  taken:
    ret void
  other:
    ret void
  }
  define void @bundled_cond_with_jalr_dest(i32 %c) {
  entry:
    br i1 undef, label %far, label %near
  far:
    ret void
  near:
    ret void
  }
  define void @bundled_cond_with_beqz_w_msp(i32 %c) {
  entry:
    br i1 undef, label %taken, label %other
  skip:
    ret void
  taken:
    ret void
  other:
    ret void
  }
  define void @bundled_beqz_w_msp_then_cond(i32 %c) {
  entry:
    br i1 undef, label %taken, label %other
  skip:
    ret void
  taken:
    ret void
  other:
    ret void
  }
...
---
name:            cond_then_jalr_e2
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r15', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        false
body:             |
  bb.0.entry:
    successors: %bb.2, %bb.1
    liveins: $r1, $r15
    ; CHECK-LABEL: name: cond_then_jalr_e2
    ; CHECK: bb.0.entry
    ; Must compile (no analyzable assert). Invert-swap keeps a cond;
    ; the far dest may become JALR.
    ; CHECK: {{BNEZ|BEQZ}}
    $r7 = LUI_E2_E0_ALU0_I12 %bb.1
    $r7 = ADDI32_E2_E0_ALU0_RI20 $r7, %bb.1
    BNEZ_E2_E0_ALU0_I12 $r1, %bb.2
    $r7 = JALR_E2_E0_ALU0_RI12 $r7, 0

  bb.1.near:
    liveins: $r15
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
