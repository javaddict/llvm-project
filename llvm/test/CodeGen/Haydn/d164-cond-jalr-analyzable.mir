---
name:            destless_jalr_ret
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r15
    ; CHECK-LABEL: name: destless_jalr_ret
    ; Dest-less RET JALR is unanalyzable, never fall-through.
    ; CHECK: $r0 = JALR_W $r15, 0
    $r0 = JALR_W $r15, 0

...
---
name:            destless_jalr_after_csrw
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r15
    ; CHECK-LABEL: name: destless_jalr_after_csrw
    ; SETCBR class: CSRW then RET JALR. CSRW is not a barrier; dest-less
    ; JALR must not continue the walk into analyzable fall-through.
    ; CHECK: CSRW_W 44, $r1
    ; CHECK: $r0 = JALR_W $r15, 0
    CSRW_W 44, $r1, implicit-def $sfr, implicit-def $cbr0
    $r0 = JALR_W $r15, 0

...
---
name:            destless_jalr_computed
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r15
    ; CHECK-LABEL: name: destless_jalr_computed
    ; Computed-goto: keep both successors; do not invent a fall-through.
    ; CHECK: successors: %bb.1{{.*}}%bb.2
    ; CHECK: $r0 = JALR_W $r1, 0
    $r0 = JALR_W $r1, 0
  bb.1:
    liveins: $r15
    RET implicit $r15
  bb.2:
    liveins: $r15
    RET implicit $r15

...
---
name:            destless_jalr_after_unrelated_lui
alignment:       1
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.1
    liveins: $r15
    ; CHECK-LABEL: name: destless_jalr_after_unrelated_lui
    ; Unrelated LUI/ADDI %bb.1 must not become the RET JALR dest (rs is
    ; $r15, not $r7). CHECK the jump stays on LR.
    ; CHECK: $r7 = LUI
    ; CHECK: $r0 = JALR_W $r15, 0
    $r7 = LUI %bb.1
    $r7 = ADDI32_W $r7, %bb.1
    $r0 = JALR_W $r15, 0
  bb.1:
    liveins: $r15
    RET implicit $r15

...
---
name:            cond_then_jalr_bundled
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r15', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
  hasCalls:        false
body:             |
  bb.0.entry:
    successors: %bb.2, %bb.1
    liveins: $r1, $r15
    ; CHECK-LABEL: name: cond_then_jalr_bundled
    ; CHECK: bb.0.entry
    ; Singleton BUNDLE roots (Fixup/Finalize shape). Dest recovery must
    ; continue past the JALR so the cond successor stays explained.
    ; CHECK: {{BNEZ|BEQZ}}
    ; CHECK: JALR
    BUNDLE implicit-def $r7 {
      $r7 = LUI %bb.1
    }
    BUNDLE implicit-def $r7, implicit $r7 {
      $r7 = ADDI32_W $r7, %bb.1
    }
    BUNDLE implicit $r1 {
      BNEZ_W $r1, %bb.2
    }
    BUNDLE implicit-def $r7, implicit $r7 {
      $r7 = JALR_W $r7, 0
    }

  bb.1.near:
    liveins: $r15
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
