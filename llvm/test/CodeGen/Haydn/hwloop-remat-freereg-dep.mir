# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop -run-pass=haydn-hwloops \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# Role: MIR — Post-RA remat of LoopStart src+adj must: 1) Never ADDI in-place into src (AIE preserves src; outer N stays live).

# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6

#
# Post-RA remat of LoopStart src+adj must:
#  1) Never ADDI in-place into src (AIE preserves src; outer N stays live)
#  2) Pick a free GPR via LivePhysRegs (or spill — never silent clobber)
#  3) Glue remat def → SET so Dest cannot be redefined before the use
#
# CHECK-LABEL: name: remat_free_reg_glued
# Remat into free GPR (not src $r1); dest feeds real-wide SET. Bundle glue is optional.
# CHECK: $r{{[0-9]+}} = ADDI32_W $r1, -1
# CHECK-NOT: $r1 = ADDI32_W $r1, -1
# CHECK: SET_HWLOOP_F2_W 0, %bb.1, %bb.1, {{((internal )?killed )?\$r[0-9]+}}

--- |
  define dso_local void @remat_free_reg_glued(i32 %n, ptr %p) {
  entry:
    br label %body
  body:
    store i32 0, ptr %p
    br label %exit
  exit:
    ret void
  }
...
---
name:            remat_free_reg_glued
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r2, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0
    ; N in $r1 live across expand — remat must not clobber it.
    LoopStart $r1, -1
    NOP
    NOP
    NOP

  bb.1.body:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2, $r15

    $r3 = LD32 $r2, 0
    $r3 = ADD32 $r3, $r3
    ST32 $r3, $r2, 0
    $r2 = ADDI32 $r2, 4
    PseudoLoopEnd %bb.1

  bb.2.exit:
    liveins: $r1, $r15
    $r1 = ADD32 $r1, $r1
    $r0 = JALR_W $r15, 0, implicit $r15
