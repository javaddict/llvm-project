# RUN: not --crash llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   -verify-machineinstrs %s -o - 2>&1 | FileCheck %s
# REQUIRES: haydn-registered-target
#
# REGRESSION TEST (rebased 2026-08-21): pad NOP consumes an encode-dag
# entry position; it is never compacted away for capacity.
#
# Original bug (pre-rebase law): collectBundleMemberOpcodes counted
# isPadNopOpcode children, so E2 + 2 reals + NOP fataled as "membership
# exceeds stamped row"; the fix made verify skip pads entirely.
#
# Superseding law (HaydnBundleVerify.cpp, LeadingPadDoesNotReplanResidualLogical
# unit): committed child order IS the encode-dag entry order, pad holes
# included. Compacting a pad would re-plan a later residual/logical onto an
# earlier entry (structural acceptance). Capacity therefore counts the
# encode-dag sequence: E2 (2 entries) + 2 reals + 1 pad = 3 > 2 and must
# fatal. A full E2 row carries no pad; a pad only completes an under-filled
# row up to its stamped entry count.
#
# Test design: stamped E2 BUNDLE with two Format E members and a mid NOP.
# If verify compacts the pad for capacity, the hidden third entry is
# accepted and this test fails. Positive no-pad paths are covered by
# w28-pad-nop-census-unified.mir and the HaydnBundleVerifyTest units.

# CHECK: BUNDLE membership exceeds stamped row entry count

--- |
  define void @e2_two_reals_plus_pad() { ret void }
...
---
name:            e2_two_reals_plus_pad
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r15
    BUNDLE 0, 0, implicit-def $r4, implicit-def $r5, implicit-def dead $sfr, implicit $r0, implicit $r1, implicit $r2 {
      $r4 = ADD32_E2_E0_ALU0_RR $r0, $r1, implicit-def dead $sfr
      NOP
      $r5 = ADDI32_E2_E1_ALU1_RI20 $r2, 1, implicit-def dead $sfr
    }
    RET implicit $r15
...
