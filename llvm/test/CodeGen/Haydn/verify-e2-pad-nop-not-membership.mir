# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s
# REQUIRES: haydn-registered-target
#
# REGRESSION TEST: pad NOP is CompletionState, not a membership entry.
#
# Bug: collectBundleMemberOpcodes counted isPadNopOpcode children.
# E2 (2 entries) + 2 reals + NOP_S0 was "membership exceeds stamped row".
# Finalize already skips pads. One counter law: verify skips them too.
#
# Test design: stamped E2 BUNDLE with two Format E members and NOP_S0.
# If pads count as members, verify fatals. CHECK keeps the two reals.

--- |
  define void @e2_two_reals_plus_pad() { ret void }
...
---
name:            e2_two_reals_plus_pad
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r15
    ; CHECK-LABEL: name: e2_two_reals_plus_pad
    ; CHECK: BUNDLE 0, 0
    ; CHECK: ADD32_E2_E0_ALU0_RR
    ; CHECK: ADDI32_E2_E1_ALU1_RI20
    BUNDLE 0, 0, implicit-def $r4, implicit-def $r5, implicit-def dead $sfr, implicit $r0, implicit $r1, implicit $r2 {
      $r4 = ADD32_E2_E0_ALU0_RR $r0, $r1, implicit-def dead $sfr
      NOP_S0
      $r5 = ADDI32_E2_E1_ALU1_RI20 $r2, 1, implicit-def dead $sfr
    }
    RET implicit $r15
...
