# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postmisched -verify-machineinstrs %s -o - | FileCheck %s

# Role: MIR — post-RA MultiSlot_Pseudo pack through leaveRegion
# (AltDesc → setDesc → reconstruct/splice → exact multi-MI BUNDLE).
#
# ADD32_MSP is isPseudo=1 but alts-bearing: HR books issue/placement, pack
# reconstruction keeps it as a cycle member, and leaveRegion setDesc bakes
# preferred format-members before exact multi-MI commit. Residual logical
# ADD32_MSP must not survive. True meta (IMPLICIT_DEF/KILL) stays pack-
# skippable and is spliced out of multi-MI spans — never hazard-exempt MSP.
#
# 1. Three independent ADD32_MSP: densest legal under GPR 4R2W is a two-
#    member BUNDLE (ADD32_S2, ADD32_S1) plus a singleton ADD32_S*; zero
#    residual ADD32_MSP.
# 2. ADD32_MSP + 2×ADD64 rematch: one Format E with selected members
#    ADD64, ADD64, ADD32_S0 (MSP setDesc onto S0).
# 3. Meta pack-skip control: IMPLICIT_DEF/KILL between MSPs do not enter
#    the multi-MI BUNDLE; MSP still setDesc and co-issue under the same
#    4R2W densest fill.

--- |
  define void @pack_three_msp() { ret void }
  define void @pack_msp_2xadd64() { ret void }
  define void @pack_msp_meta_skip() { ret void }
...
---
name:            pack_three_msp
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
  - { reg: '$r5', virtual-reg: '' }
  - { reg: '$r7', virtual-reg: '' }
  - { reg: '$r8', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r1, $r2, $r4, $r5, $r7, $r8

    ; Three independent MultiSlot_Pseudo ADD32_MSP. Post-RA densest legal
    ; fill under GPR 4R2W is two members; preferred field order S2→S1.
    ; leaveRegion setDesc bakes members; no residual logical ADD32_MSP.
    ; CHECK-LABEL: name: pack_three_msp
    ; CHECK: liveins: $r1, $r2, $r4, $r5, $r7, $r8
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r0 = ADD32{{.*}} killed $r1, killed $r2, implicit-def dead $sfr
    ; CHECK-NEXT: $r3 = ADD32{{.*}} killed $r4, killed $r5, implicit-def dead $sfr
    ; CHECK-NEXT: $r6 = ADD32{{.*}} killed $r7, killed $r8, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit killed $r3, implicit killed $r6, implicit $r15
    $r0 = ADD32_MSP $r1, $r2, implicit-def dead $sfr
    $r3 = ADD32_MSP $r4, $r5, implicit-def dead $sfr
    $r6 = ADD32_MSP $r7, $r8, implicit-def dead $sfr
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r3, implicit $r6, implicit $r15

...
---
name:            pack_msp_2xadd64
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
  - { reg: '$d0', virtual-reg: '' }
  - { reg: '$d1', virtual-reg: '' }
  - { reg: '$d2', virtual-reg: '' }
  - { reg: '$d3', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r1, $r2, $d0, $d1, $d2, $d3

    ; Three-ready rematch: MultiSlot_Pseudo ADD32_MSP + 2×ADD64 in one
    ; Format E. Selected members (applyFormatOrdering S2→S1→S0):
    ; ADD64, ADD64, ADD32_S0 — MSP setDesc onto S0. Zero residual
    ; ADD32_MSP.
    ; CHECK-LABEL: name: pack_msp_2xadd64
    ; CHECK: liveins: $r1, $r2, $d0, $d1, $d2, $d3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r3 = ADD32{{.*}} killed $r1, killed $r2, implicit-def dead $sfr
    ; CHECK-NEXT: $d4 = ADD64{{.*}} killed $d0, killed $d1, implicit-def dead $sfr
    ; CHECK-NEXT: $d5 = ADD64{{.*}} killed $d2, killed $d3, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit killed $r3, implicit killed $d4, implicit killed $d5, implicit $r15
    $r3 = ADD32_MSP $r1, $r2, implicit-def dead $sfr
    $d4 = ADD64 $d0, $d1, implicit-def dead $sfr
    $d5 = ADD64 $d2, $d3, implicit-def dead $sfr
    $r0 = JALR $r15, 0, implicit $r15, implicit $r3, implicit $d4, implicit $d5, implicit $r15

...
---
name:            pack_msp_meta_skip
alignment:       1
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
registers:       []
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
  - { reg: '$r5', virtual-reg: '' }
  - { reg: '$r7', virtual-reg: '' }
  - { reg: '$r8', virtual-reg: '' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 4294967295
fixedStack:      []
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r1, $r2, $r4, $r5, $r7, $r8

    ; IMPLICIT_DEF / KILL are pack-skippable meta (not MultiSlot_Pseudo).
    ; They must not block MSP co-issue or appear inside the multi-MI BUNDLE
    ; as issue members; MSP still setDesc; residual ADD32_MSP is zero.
    ; CHECK-LABEL: name: pack_msp_meta_skip
    ; CHECK: liveins: $r1, $r2, $r4, $r5, $r7, $r8
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r0 = ADD32{{.*}} killed $r1, killed $r2, implicit-def dead $sfr
    ; CHECK-NEXT: $r12 = IMPLICIT_DEF
    ; CHECK-NEXT: KILL killed $r12
    ; CHECK-NEXT: $r3 = ADD32{{.*}} killed $r4, killed $r5, implicit-def dead $sfr
    ; CHECK-NEXT: $r6 = ADD32{{.*}} killed $r7, killed $r8, implicit-def dead $sfr
    ; CHECK-NEXT: $r0 = JALR{{.*}} $r15, 0, implicit $r15, implicit $r0, implicit killed $r3, implicit killed $r6, implicit $r15
    $r0 = ADD32_MSP $r1, $r2, implicit-def dead $sfr
    $r12 = IMPLICIT_DEF
    $r3 = ADD32_MSP $r4, $r5, implicit-def dead $sfr
    KILL killed $r12
    $r6 = ADD32_MSP $r7, $r8, implicit-def dead $sfr
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r3, implicit $r6, implicit $r15

...
