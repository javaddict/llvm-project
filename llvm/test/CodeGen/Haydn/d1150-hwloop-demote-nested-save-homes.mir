# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop \
# RUN:   -run-pass=prologepilog,haydn-hwloops -verify-machineinstrs \
# RUN:   %s -o - | FileCheck %s
# REQUIRES: asserts, haydn-registered-target
#
# D1.150 — nested overlapping PreheaderSave pairs bind distinct save homes.
# Inner-first: two SET_HWLOOP_F2_W, each LatchScr==Prefer, trip live-out.
# Exact ST/LD FixedStack pair per latch. Spill census = PostRA + 2 counters
# + 2 saves + scavenger. Do not share one function-wide save FI.

# Nested demote still stores save/counter slots and a software countdown.
# (UTC CHECK block in the MIR body pins the shape.)

# Inner-first take+bind, then outer. Distinct FIs vs PostRA and vs each
# latch's counter. Inner take+bind must not reuse the outer SaveFI
# (CHECK-NOT between the two take+bind lines: same-FI reuse fails).
# SAVE-DBG: demote save home disjoint SaveFI#[[IN:[0-9]+]] PostRAScratchFI#[[POSTRA:[0-9]+]] {{.*}}stack-counter FI#[[INCTR:[0-9]+]]
# SAVE-DBG: demote save home take+bind SaveFI#[[IN]] latch %bb.4
# SAVE-DBG-NOT: take+bind SaveFI#[[IN]]
# SAVE-DBG: demote save home disjoint SaveFI#[[OUT:[0-9]+]] PostRAScratchFI#[[POSTRA]] {{.*}}stack-counter FI#[[OUTCTR:[0-9]+]]
# SAVE-DBG: demote save home take+bind SaveFI#[[OUT]] latch %bb.5
# SAVE-DBG-NOT: SaveFI#[[EQ:[0-9]+]] PostRAScratchFI#[[EQ]]
# SAVE-DBG-NOT: SaveFI#[[EQ2:[0-9]+]] {{.*}}stack-counter FI#[[EQ2]]
# SAVE-DBG-NOT: occupancy miss
# SAVE-DBG-NOT: LLVM ERROR

--- |
  define dso_local void @d1150_nested_save_homes(ptr nocapture writeonly %out, i32 %outer, i32 %inner) {
  entry:
    br label %outer_spacer
  outer_spacer:
    br label %inner_pre
  inner_pre:
    br label %inner_spacer
  inner_spacer:
    br label %inner_body
  inner_body:
    store i32 0, ptr %out, align 4
    br label %outer_body
  outer_body:
    store i32 %inner, ptr %out, align 4
    br label %exit
  exit:
    store i32 %outer, ptr %out, align 4
    br label %ret
  ret:
    ret void
  }
...
