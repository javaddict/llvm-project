# RUN: split-file %s %t
# REQUIRES: haydn-registered-target
#
# D1.13 freeze-seat binding. Freeze identity is a property of the
# addPreEmitPass2 REGISTRATION (createHaydnVerifyBundlesPass(true)); the
# default-constructed -run-pass=haydn-verify-bundles instance is
# invariant-only by construction, so the same freeze-violating fixture
# must pass the default instance silently and fire the exact freeze wall
# under -haydn-freeze-verify on that same single instance. Freeze-only
# law families pinned: dest-window seam walk (verifyMBBDestWindowSeams),
# freeze residual logical child, and freeze residual bare encode
# (all-bare non-optnone fixture). Wall strings match
# bundle-corruption-matrix.mir / d17-freeze-seam-latency.mir verbatim;
# nothing here redefines a law.
#
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   %t/seam-then-use.mir -o - | FileCheck %s --check-prefix=SEAM-SILENT
# RUN: not --crash llc -mtriple=haydn-unknown-elf -haydn-freeze-verify \
# RUN:   -run-pass=haydn-verify-bundles %t/seam-then-use.mir -o - 2>&1 \
# RUN:   | FileCheck %s --check-prefix=SEAM-FIRE
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   %t/residual-logical.mir -o - | FileCheck %s --check-prefix=LOG-SILENT
# RUN: not --crash llc -mtriple=haydn-unknown-elf -haydn-freeze-verify \
# RUN:   -run-pass=haydn-verify-bundles %t/residual-logical.mir -o - 2>&1 \
# RUN:   | FileCheck %s --check-prefix=LOG-FIRE
# RUN: llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   %t/bare-encode.mir -o - | FileCheck %s --check-prefix=BARE-SILENT
# RUN: not llc -mtriple=haydn-unknown-elf -haydn-freeze-verify \
# RUN:   -run-pass=haydn-verify-bundles %t/bare-encode.mir -o - 2>&1 \
# RUN:   | FileCheck %s --check-prefix=BARE-FIRE
#
# SEAM-SILENT: S_LW_WITH_IMM_E2_E0_LOADSTORE0_RI6
# SEAM-FIRE: dest-window seam
# LOG-SILENT: ADD32
# LOG-FIRE: freeze residual logical child
# BARE-SILENT: ADD32_E2_E0_ALU0_RR
# BARE-FIRE: freeze residual bare encode

#--- seam-then-use.mir
--- |
  define void @seat_binding_seam() { ret void }
...
---
name:            seat_binding_seam
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1
    BUNDLE 0, 0, implicit-def $r2, implicit $r1 {
      $r2 = S_LW_WITH_IMM_E2_E0_LOADSTORE0_RI6 $r1, 0
    }
    BUNDLE 0, 0, implicit-def $r3, implicit $r2 {
      $r3 = ADD32_E2_E0_ALU0_RR $r2, $r2
    }
...
#--- residual-logical.mir
--- |
  define void @seat_binding_residual_logical() { ret void }
...
---
name:            seat_binding_residual_logical
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1
    BUNDLE 0, 0, implicit-def $r2, implicit $r0, implicit $r1 {
      $r2 = ADD32 $r0, $r1
    }
...
#--- bare-encode.mir
--- |
  define void @seat_binding_bare_encode() { ret void }
...
---
name:            seat_binding_bare_encode
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1
    $r2 = ADD32_E2_E0_ALU0_RR $r0, $r1
...
