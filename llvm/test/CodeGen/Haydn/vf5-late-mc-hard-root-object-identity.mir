# CB-161 rebaseline (2026-08-21): dropped legacy "implicit-def dead $sfr" operands. Live codegen
# emits none (the every-ALU-writes-SFR modeling is gone), and golden Constraints
# §Registers allows ONE SFR writer per bundle, so a finalize-stamped member pack
# carrying two such operands fails the SFR 1W port law at verify. The bundles were
# illegal under golden all along; the fixtures now mirror real committed MIR.
# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=haydn-unknown-elf \
# RUN:   -run-pass=haydn-finalize-mi-bundles,haydn-verify-bundles \
# RUN:   -verify-machineinstrs %s -o %t.mir
# RUN: FileCheck %s --check-prefix=MIR --input-file=%t.mir
# RUN: llc -mtriple=haydn-unknown-elf -start-after=livedebugvalues \
# RUN:   -filetype=obj %t.mir -o %t.o
# RUN: llvm-objdump -d -z --triple=haydn-unknown-elf %t.o | FileCheck %s --check-prefix=OBJ
# REQUIRES: haydn-registered-target

# Role: object — Late-MC one-to-one for Format E multi-member hard roots
# that exact-commit/replay leaves for AsmPrinter.
#
# Activated hard roots (post-RA exact-commit of pre-existing multi-member
# BUNDLE groups, or late multipass re-entry of FormatID-stamped multi-MI
# cycles) must serialize as one verified Format E 12-byte parcel per root:
#   * Durable BundleFormatRowID + CompletionStateID on the BUNDLE root
#     (E96TwoEntry/AllEntriesReal for 2 reals; E96ThreeEntry/AllEntriesReal
#     for 3 reals). A lone imm-0 (E2) stamp with three members is illegal —
#     it used to pass MIR membership and drop one child at object encode.
#   * Member Desc-as-is through Bundle.canAdd (no FlexMap / dual path)
#   * Exact 12 B Format E parcel identity (bytes + disasm mnemonics)
#   * No residual cycle-forming children, no multi-cycle printer repair
#   * No silent reshape of co-issued membership
#   * Consolidated root operands / kill flags (post-recommit rebuild) do not
#     change encode identity — printer is serialize-only
#
# Pass order: late FinalizeBundle + VerifyBundles residual/firewall →
# start-after livedebugvalues AsmPrinter serialize-only → objdump.
# Negative residual peers: late-mc-residual-printer-matrix.mir and
# vf5-residual-hard-root-multi-child-ban.mir.

--- |
  define void @hard_root_two_member_alu() { ret void }
  define void @hard_root_three_member_mixed_fu() { ret void }
  define void @hard_root_killed_consolidated_operands() { ret void }
  define void @hard_root_xor32_beqz_e2_rematch() { ret void }
  define void @pad_only_missing_row() { ret void }
...
---
# Two-member Format E hard root (logical ADD32+XOR32). Finalize
# rebinds onto E3 (E2 leading-entry cannot cover both) and cutovers to
# MemberId. Encode scatters by committed EntryIdx.
name:            hard_root_two_member_alu
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r15
    BUNDLE 0, 0, implicit-def $r4, implicit-def $r5, implicit $r0, implicit $r1, implicit $r2, implicit $r3 {
      $r4 = ADD32 $r0, $r1
      $r5 = XOR32 $r2, $r3
    }
    RET implicit $r15

# MIR-LABEL: name: hard_root_two_member_alu
# MIR: BUNDLE 1, 0
# MIR: ADD32{{.*}}
# MIR: XOR32{{.*}}
# MIR: BUNDLE 0
# MIR: RET
# MIR-NOT: LOADI32
# MIR-NOT: LOAD_ADDR
# MIR-NOT: SETCBR
# MIR-NOT: LoopDec
# MIR-NOT: LoopJNZ

# OBJ-LABEL: <hard_root_two_member_alu>:
# Format E 12 B: two reals co-issued (entry order may place NOP underfill).
# OBJ: {{.*}}{{xor32.*r5.*r2.*r3.*add32.*r4.*r0.*r1|add32.*r4.*r0.*r1.*xor32.*r5.*r2.*r3}}
# OBJ: jalr
# OBJ-NOT: <unknown>
# OBJ-NOT: setcbr
# OBJ-NOT: loopdec

...
---
# Three-member mixed-FU Format E hard root (ADD32 + two ADD64). Root must
# stamp E96ThreeEntry + AllEntriesReal so MC serializes all three members
# in one 12-byte parcel (no 2-real+nop drop).
name:            hard_root_three_member_mixed_fu
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $d0, $d1, $d2, $d3, $r15
    BUNDLE 1, 0, implicit-def $r4, implicit-def $d4, implicit-def $d5, implicit $r0, implicit $r1, implicit $d0, implicit $d1, implicit $d2, implicit $d3 {
      $r4 = ADD32 $r0, $r1
      $d4 = ADD64 $d0, $d1
      $d5 = ADD64 $d2, $d3
    }
    RET implicit $r15

# MIR-LABEL: name: hard_root_three_member_mixed_fu
# MIR: BUNDLE 1, 0
# MIR: ADD32_E3_E0_ALU2_RR
# MIR: ADD64_E3_E1_ALU1_RR
# MIR: ADD64_E3_E2_ALU0_RR
# MIR: BUNDLE 0
# MIR: RET
# MIR-NOT: LOADI32
# MIR-NOT: LoopDec

# OBJ-LABEL: <hard_root_three_member_mixed_fu>:
# Format E 12 B: all three reals in one parcel (entry order from joint place).
# OBJ: add64{{.*}}d5, d2, d3; add64{{.*}}d4, d0, d1; add32{{.*}}r4, r0, r1
# OBJ: jalr
# OBJ-NOT: <unknown>

...
---
# Hard-root after operand recommit: consolidated BUNDLE-root implicits with
# killed uses on members. Serialize-only MC must ignore kill/internal-read
# markers for encode identity (same Format E parcel as bare two-member ALU).
name:            hard_root_killed_consolidated_operands
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r15
    BUNDLE 0, 0, implicit-def $r4, implicit-def $r5, implicit killed $r0, implicit killed $r1, implicit killed $r2, implicit killed $r3 {
      $r4 = ADD32 killed $r0, killed $r1
      $r5 = XOR32 killed $r2, killed $r3
    }
    RET implicit $r15

# MIR-LABEL: name: hard_root_killed_consolidated_operands
# MIR: BUNDLE 1, 0
# MIR: killed $r0
# MIR: killed $r1
# MIR: killed $r2
# MIR: killed $r3
# MIR: ADD32_E3_E0_ALU2_RR killed $r0, killed $r1
# MIR: XOR32_E3_E1_ALU1_RR killed $r2, killed $r3
# MIR: RET
# MIR-NOT: LOADI32
# MIR-NOT: LoopDec
# MIR-NOT: SETCBR

# OBJ-LABEL: <hard_root_killed_consolidated_operands>:
# Same Desc-as-is Format E parcel as hard_root_two_member_alu (kills are MIR-only).
# OBJ: {{.*}}{{xor32.*r5.*r2.*r3.*add32.*r4.*r0.*r1|add32.*r4.*r0.*r1.*xor32.*r5.*r2.*r3}}
# OBJ: jalr
# OBJ-NOT: <unknown>
# OBJ-NOT: setcbr
# OBJ-NOT: loopdec

...
---
# XOR32 and BEQZ are e0-only under E2. A dual E2 stamp with XOR32/BEQZ
# at membership entry 1 is an illegal inverse. Finalize rematches onto
# E3 members and stamps the E3 row.
name:            hard_root_xor32_beqz_e2_rematch
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r15
    successors: %bb.1
    BUNDLE 0, 0, implicit-def $r3, implicit $r0, implicit $r1, implicit $r2 {
      $r3 = XOR32 $r0, $r1
      BEQZ $r2, %bb.1
    }
    RET implicit $r15

  bb.1:
    liveins: $r15
    RET implicit $r15

# MIR-LABEL: name: hard_root_xor32_beqz_e2_rematch
# MIR: BUNDLE 1, 0
# MIR: XOR32_E3_
# MIR: BEQZ_E3_
# MIR: RET

# OBJ-LABEL: <hard_root_xor32_beqz_e2_rematch>:
# OBJ: xor32
# OBJ: beqz
# OBJ: jalr
# OBJ-NOT: <unknown>

...
---
# Pad-only idle with no row imm must stamp a product row. Printer
# !Row→E2 is fatal; full-bundle NOP idle is legal constructively.
name:            pad_only_missing_row
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r15
    BUNDLE {
      NOP
    }
    RET implicit $r15

# MIR-LABEL: name: pad_only_missing_row
# MIR: BUNDLE 0, 0 {
# MIR-NEXT: NOP
# MIR: RET
