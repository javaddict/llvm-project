; Format E96 cutover residual: FileCheck/idle-pad/reloc geometry still open (GE96-01/03).
; XFAIL: *

# Role: object — Late-MC one-to-one for FormatID-stamped multi-member hard
# roots that exact-commit/replay leaves for AsmPrinter.
#
# Activated hard roots (post-RA exact-commit of pre-existing multi-member
# BUNDLE groups, or late multipass re-entry of FormatID-stamped multi-MI
# cycles) must serialize as one verified Full parcel per root:
#   * Member Desc-as-is through Bundle.canAdd (no FlexMap / MCFlags / dual path)
#   * Exact 16 B Full parcel identity (bytes + disasm mnemonics)
#   * No residual cycle-forming children, no multi-cycle printer repair
#   * No silent reshape of co-issued membership
#   * Consolidated root operands / kill flags (post-recommit rebuild) do not
#     change encode identity — printer is serialize-only
#
# Pass order: late FinalizeBundle + VerifyBundles residual/firewall →
# start-after livedebugvalues AsmPrinter serialize-only → objdump.
# Negative residual peers: late-mc-residual-printer-matrix.mir and
# vf5-residual-hard-root-multi-child-ban.mir.

--- |
  define void @hard_root_two_member_alu() { ret void }
  define void @hard_root_three_member_mixed_fu() { ret void }
  define void @hard_root_killed_consolidated_operands() { ret void }
...
---
# Two-member Full hard root (post-setDesc members + FormatID imm 0).
# Matches the multi-MI exact-commit shape used by late multipass stable-row.
name:            hard_root_two_member_alu
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r15
    BUNDLE 0, implicit-def $r4, implicit-def $r5, implicit-def dead $sfr, implicit $r0, implicit $r1, implicit $r2, implicit $r3 {
      $r4 = ADD32_S2 $r0, $r1, implicit-def dead $sfr
      $r5 = XOR32_S1 $r2, $r3, implicit-def dead $sfr
    }
    RET implicit $r15

# MIR-LABEL: name: hard_root_two_member_alu
# MIR: BUNDLE 0
# MIR: ADD32_S2
# MIR: XOR32_S1
# MIR: BUNDLE 0
# MIR: RET
# MIR-NOT: LOADI32
# MIR-NOT: LOAD_ADDR
# MIR-NOT: SETCBR
# MIR-NOT: LoopDec
# MIR-NOT: LoopJNZ

# OBJ-LABEL: <hard_root_two_member_alu>:
# Exact Full 16 B parcel: S0=NOP, S1=XOR32, S2=ADD32 (member Desc-as-is).
# OBJ: 00 00 00 00 00 00 32 05 00 c0 03 10 04 00 40 01{{.*}}xor32{{.*}}r5{{.*}}r2{{.*}}r3{{.*}}add32{{.*}}r4{{.*}}r0{{.*}}r1
# OBJ: jalr_w
# OBJ-NOT: <unknown>
# OBJ-NOT: setcbr
# OBJ-NOT: loopdec

...
---
# Three-member mixed-FU Full hard root (rematch membership after exact commit:
# ADD32 on S0 + two ADD64 on S1/S2). Proves multi-member hard roots survive
# to object without printer re-split or membership loss.
name:            hard_root_three_member_mixed_fu
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $d0, $d1, $d2, $d3, $r15
    BUNDLE 0, implicit-def $r4, implicit-def $d4, implicit-def $d5, implicit-def dead $sfr, implicit $r0, implicit $r1, implicit $d0, implicit $d1, implicit $d2, implicit $d3 {
      $r4 = ADD32_S0 $r0, $r1, implicit-def dead $sfr
      $d4 = ADD64_S1 $d0, $d1, implicit-def dead $sfr
      $d5 = ADD64_S2 $d2, $d3, implicit-def dead $sfr
    }
    RET implicit $r15

# MIR-LABEL: name: hard_root_three_member_mixed_fu
# MIR: BUNDLE 0
# MIR: ADD32_S0
# MIR: ADD64_S1
# MIR: ADD64_S2
# MIR: BUNDLE 0
# MIR: RET
# MIR-NOT: LOADI32
# MIR-NOT: LoopDec

# OBJ-LABEL: <hard_root_three_member_mixed_fu>:
# Exact Full 16 B: S0=ADD32, S1=ADD64, S2=ADD64 — one verified issue cycle.
# OBJ: 10 04 00 00 40 01 10 04 00 20 40 32 05 00 20 40{{.*}}add32{{.*}}r4{{.*}}r0{{.*}}r1{{.*}}add64{{.*}}d4{{.*}}d0{{.*}}d1{{.*}}add64{{.*}}d5{{.*}}d2{{.*}}d3
# OBJ: jalr_w
# OBJ-NOT: <unknown>

...
---
# Hard-root after operand recommit: consolidated BUNDLE-root implicits with
# killed uses on members. Serialize-only MC must ignore kill/internal-read
# markers for encode identity (same Full parcel as bare two-member ALU).
name:            hard_root_killed_consolidated_operands
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r15
    BUNDLE 0, implicit-def $r4, implicit-def $r5, implicit-def dead $sfr, implicit killed $r0, implicit killed $r1, implicit killed $r2, implicit killed $r3 {
      $r4 = ADD32_S2 killed $r0, killed $r1, implicit-def dead $sfr
      $r5 = XOR32_S1 killed $r2, killed $r3, implicit-def dead $sfr
    }
    RET implicit $r15

# MIR-LABEL: name: hard_root_killed_consolidated_operands
# MIR: BUNDLE 0
# MIR: killed $r0
# MIR: killed $r1
# MIR: killed $r2
# MIR: killed $r3
# MIR: ADD32_S2 killed $r0, killed $r1
# MIR: XOR32_S1 killed $r2, killed $r3
# MIR: RET
# MIR-NOT: LOADI32
# MIR-NOT: LoopDec
# MIR-NOT: SETCBR

# OBJ-LABEL: <hard_root_killed_consolidated_operands>:
# Same Desc-as-is Full parcel as hard_root_two_member_alu (kills are MIR-only).
# OBJ: 00 00 00 00 00 00 32 05 00 c0 03 10 04 00 40 01{{.*}}xor32{{.*}}r5{{.*}}r2{{.*}}r3{{.*}}add32{{.*}}r4{{.*}}r0{{.*}}r1
# OBJ: jalr_w
# OBJ-NOT: <unknown>
# OBJ-NOT: setcbr
# OBJ-NOT: loopdec
