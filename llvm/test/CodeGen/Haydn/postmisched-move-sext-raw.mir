# RUN: llc -mtriple=haydn-unknown-elf -run-pass=postmisched %s -o - | FileCheck %s
#
# Role: MIR — product no-forwarding law: MOVE32_DR_L then SEXT of the same
# GPR must never share a multi-MI product cycle (true RAW).
#
# Soft-float half extract densifies to
#   { move32_dr_l r2, dX; sext32t64 dY, r2 }
# under pure format packing. Haydn reads all sources simultaneously in a
# cycle — no intra-bundle forwarding — so that pack miscompiles (lldb proof
# on __muldf3 1.5*2.5). Product multi-MI commit must leave them sequential.
#
# CHECK-LABEL: name: move_sext_raw_no_bundle
# CHECK: $r1 = MOVE32_DR_L
# CHECK-NEXT: $d1 = SEXT32T64
# CHECK-NOT: BUNDLE
---
name:            move_sext_raw_no_bundle
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $d0

    $r1 = MOVE32_DR_L $d0, implicit-def dead $sfr
    $d1 = SEXT_GPR32_TO_DR64 $r1, implicit-def dead $sfr
    $d0 = COPY $d1
    $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
...
