    ; HWLOOP-NOT: SET_HWLOOP{{$}}
    SET_HWLOOP 0, %bb.1, %bb.2, 16
    RET implicit $r15
  bb.1:
    RET implicit $r15
  bb.2:
    RET implicit $r15

