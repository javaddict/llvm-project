# Role: verifier — ExpandPseudos residual matrix. Relocated surfaces
# (PseudoCALL / LIBCALL_* / VASTART / VACOPY / VAARG_* / ADJCALLSTACK) fail
# closed here; product owners are CallLowering / legalizer / PEI. Product
# HardwareLoops emits SET_HWLOOP_F2_W at the creator; leftover generic
# SET_HWLOOP{,_REG} setDesc here is MIR last-chance only. Leftover
# SET_HWLOOP / SETCBR / LOOPCTL / LOAD_ADDR as BUNDLE children are fatal
# (in-bundle expand is leftover *_POST_INC only). Top-level leftover
# LOADI32/LOADI64 after ExpandPostRA is fatal before pack. Representation
# expands RET/BR_JT→JALR_W r0 and PseudoCALLIndirect→JALR_MSP here
# (pre-S1). Top-level B stays the CFG uncond shell through BranchRelaxation;
# leftover bundled B/RET/BR_JT/PseudoCALLIndirect is fatal.

#--- load_addr_fi.mir
--- |
  define void @residual_load_addr_fi() { ret void }
...
---
name:            residual_load_addr_fi
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r15
    ; RESIDUAL: LOAD_ADDR operand kind is not expandable
    ; RESIDUAL: LOAD_ADDR
    $r1 = LOAD_ADDR %stack.0
    RET implicit $r15
stack:
  - { id: 0, name: '', type: default, offset: 0, size: 4, alignment: 4 }

#--- setcbr_ok.mir
--- |
  define void @expand_setcbr_clears() { ret void }
...
---
name:            expand_setcbr_clears
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r15
    ; SETCBR: CSRW_W
    ; SETCBR-NOT: SETCBR
    SETCBR_BEGIN 0, $r1
    RET implicit $r15

#--- setcbr_end_ok.mir
--- |
  define void @expand_setcbr_end() { ret void }
...
---
name:            expand_setcbr_end
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r15
    ; SETCBRE: CSRW_W
    ; SETCBRE-NOT: SETCBR
    SETCBR_END 1, $r1
    RET implicit $r15

#--- load_addr_imm.mir
--- |
  define void @expand_load_addr_imm() { ret void }
...
---
name:            expand_load_addr_imm
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r15
    ; ADDR-NOT: LOAD_ADDR
    ; ADDR: ADDI32
    $r1 = LOAD_ADDR 42
    RET implicit $r15

#--- set_hwloop_ok.mir
--- |
  define void @expand_set_hwloop() { ret void }
...
---
name:            expand_set_hwloop
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r15
    successors: %bb.1, %bb.2
    ; HWLOOP: SET_HWLOOP_W
    ; HWLOOP-NOT: SET_HWLOOP{{$}}
    SET_HWLOOP 0, %bb.1, %bb.2, 16, implicit-def dead $sfr
    RET implicit $r15
  bb.1:
    RET implicit $r15
  bb.2:
    RET implicit $r15

#--- set_hwloop_reg_ok.mir
--- |
  define void @expand_set_hwloop_reg() { ret void }
...
---
name:            expand_set_hwloop_reg
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r4, $r15
    successors: %bb.1, %bb.2
    ; HWLOOPR: SET_HWLOOP_F2_W
    ; HWLOOPR-NOT: SET_HWLOOP_REG
    SET_HWLOOP_REG 0, %bb.1, %bb.2, $r4, implicit-def dead $sfr
    RET implicit $r15
  bb.1:
    RET implicit $r15
  bb.2:
    RET implicit $r15

#--- post_inc_ok.mir
--- |
  define void @expand_post_inc() { ret void }
...
---
name:            expand_post_inc
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r2, $r15
    ; POSTINC: S_LW_POST_IMM
    ; POSTINC-NOT: LD32_POST_INC
    $r1 = LD32_POST_INC $r2, 4, 0
    RET implicit $r15, implicit $r1, implicit $r2

#--- st_post_inc_ok.mir
--- |
  define void @expand_st_post_inc() { ret void }
...
---
name:            expand_st_post_inc
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r2, $r15
    ; STPOST: = ST32_POST 
    ; STPOST-NOT: ST32_POST_INC
    ST32_POST_INC $r1, $r2, 4, 0
    RET implicit $r15, implicit $r2

#--- pseudo_call_ok.mir
--- |
  declare void @callee()
  define void @expand_pseudo_call() { ret void }
...
---
name:            expand_pseudo_call
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r15
    ; CALL: residual expand-owned semantic pseudo
    $r15 = PseudoCALL @callee, csr_haydn
    RET implicit $r15

#--- vacopy_ok.mir
--- |
  define void @expand_vacopy() { ret void }
...
---
name:            expand_vacopy
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r2, $r15
    ; VACOPY: residual expand-owned semantic pseudo
    VACOPY $r1, $r2
    RET implicit $r15

#--- vaend_ok.mir
--- |
  define void @expand_vaend() { ret void }
...
---
name:            expand_vaend
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $r15
    ; VAEND-NOT: VAEND
    ; VAEND: JALR_W
    VAEND $r1
    RET implicit $r15

#--- post_inc_mmo.mir
--- |
  define i32 @expand_post_inc_mmo(ptr %p) {
    %v = load i32, ptr %p, align 4
    ret i32 %v
  }
...
---
name:            expand_post_inc_mmo
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r2, $r15
    ; MMO: S_LW_POST_IMM{{.*}}load
    ; MMO-NOT: LD32_POST_INC
    $r1 = LD32_POST_INC $r2, 4, 0 :: (load (s32) from %ir.p)
    RET implicit $r15, implicit $r1, implicit $r2

#--- ld64_post_inc_ok.mir
--- |
  define i64 @expand_ld64_post_inc(ptr %p) {
    %v = load i64, ptr %p, align 8
    ret i64 %v
  }
...
---
name:            expand_ld64_post_inc
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r2, $r15
    ; LD64POST: D_LDW_POST_IMM{{.*}}load
    ; LD64POST-NOT: LD64_POST_INC
    $d0 = LD64_POST_INC $r2, 8, 0 :: (load (s64) from %ir.p)
    RET implicit $r15, implicit $d0, implicit $r2

#--- st64_post_inc_ok.mir
--- |
  define void @expand_st64_post_inc(ptr %p, i64 %v) {
    store i64 %v, ptr %p, align 8
    ret void
  }
...
---
name:            expand_st64_post_inc
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $d0, $r2, $r15
    ; ST64POST: = ST64_POST {{.*}}store
    ; ST64POST-NOT: ST64_POST_INC
    ST64_POST_INC $d0, $r2, 8, 0 :: (store (s64) into %ir.p)
    RET implicit $r15, implicit $r2

#--- libcall_sdiv_ok.mir
--- |
  define i32 @expand_libcall_sdiv(i32 %a, i32 %b) {
    %r = sdiv i32 %a, %b
    ret i32 %r
  }
...
---
name:            expand_libcall_sdiv
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r3, $r4, $r15
    ; LIBCALL: residual expand-owned semantic pseudo
    $r1 = LIBCALL_SDIV $r3, $r4, implicit-def $r2, implicit-def $r3, implicit-def $r4, implicit-def $r5, implicit-def $r6, implicit-def $r7, implicit-def $r12, implicit-def $d0, implicit-def $d1, implicit-def $d2, implicit-def $d3, implicit-def $d4, implicit-def $d5, implicit-def $d6, implicit-def $d7, implicit-def $r15
    RET implicit $r15, implicit $r1

#--- libcall_mul64_ok.mir
--- |
  define i64 @expand_libcall_mul64(i64 %a, i64 %b) {
    %r = mul i64 %a, %b
    ret i64 %r
  }
...
---
name:            expand_libcall_mul64
tracksRegLiveness: true
