# REQUIRES: haydn-registered-target

# Role: object — Hardware-loop demotion closes only at object identity, not MIR shape alone.

# Hardware-loop demotion closes only at object identity, not MIR shape alone.
#
# Fixed late-pass order (product PreEmit):
#   BranchRelaxation -> FixupHwLoops -> BranchRelaxation ->
#   late FinalizeBundle -> VerifyBundles
# then AsmPrinter serialize-only to ELF (start-after livedebugvalues skips
# re-running the late multipass on already-final MIR).
#
# Contracts sealed here:
#   * demote_range: out-of-range Off1 demotes to final-real SUBI32 + BNEZ_W
#     exact-committed Full singletons; object has subi32/bnez_w, no set_hwloop
#   * demote_coissue: coissued SET+ADD — SET member erase only; ADD survives
#     as a non-empty product cycle at MIR and object; soft edge is final-real
#   * keep_shorten: same-preheader oversize shortens; hardware SET_HWLOOP_W
#     retained through object (discriminator — not always-demote). Laid out
#     last so OBJ-KEEP-NOT cannot see demote soft-edge mnemonics.
#   * No residual LoopDec / LoopJNZ / LoopStart at late firewall or printer
#
# Peer MIR-only locks: hwloop-fixup-demote-range.mir,
# hwloop-fixup-bundle-preserving.mir, postmisched-late-layout-stable-row.mir.
# MC serialize peer: MC/Haydn/vf5-one-to-one-csrw-demotion-roundtrip.s.
# Authority: topics/hwloop demote-first; contracts/pipeline Fixup ownership.

--- |
  define dso_local void @demote_range(ptr nocapture writeonly %out) {
  entry:
    br label %spacer
  spacer:
    br label %body
  body:
    store i32 0, ptr %out, align 4
    br label %exit
  exit:
    ret void
  }

  define dso_local void @demote_coissue(ptr nocapture writeonly %out) {
  entry:
    br label %spacer
  spacer:
    br label %body
  body:
    store i32 0, ptr %out, align 4
    br label %exit
  exit:
    ret void
  }

  define dso_local void @keep_shorten(ptr nocapture writeonly %out) {
  entry:
    br label %body
  body:
    store i32 0, ptr %out, align 4
    br label %exit
  exit:
    ret void
  }

...
---
# Out-of-range Off1 via cross-MBB spacer: product demote-first to soft edge.
name:            demote_range
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r0, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0, implicit-def dead $sfr
    ; Immediate trip 8; header==latch is %bb.2. Three following NOPs =
    ; InterveningCycles (SetupIssueDistance=4). Final wide form so
    ; late Finalize/Verify accept before Fixup demotes.
    SET_HWLOOP_W 0, %bb.2, %bb.2, 8, implicit-def dead $sfr
    NOP
    NOP
    NOP

  ; Spacer: 20× NOP = 320 B > uimm6 252 — StartOff overflow that shorten
  ; cannot pull across MBB boundaries → demote-first.
  bb.1.spacer:
    successors: %bb.2
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP

  bb.2.body:
    liveins: $r1, $r0
    successors: %bb.3
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.3.exit:
    liveins: $r15
    RET implicit killed $r15

# DEMOTE-LABEL: name: demote_range
# DEMOTE-NOT: SET_HWLOOP
# DEMOTE-NOT: LoopDec
# DEMOTE-NOT: LoopJNZ
# DEMOTE-NOT: LoopStart
# Trip materialize + exact-committed Format E singleton soft edge.
# DEMOTE: ADDI32_E2_E0_ALU0_RI20
# DEMOTE: SUBI32
# DEMOTE: BNEZ_E2
# DEMOTE: bb.3.exit
# DEMOTE: {{RET|JALR}}

# OBJ-DEMOTE-LABEL: <demote_range>:
# Final-real software countdown encodes and decodes (not <unknown>).
# OBJ-DEMOTE: addi32
# OBJ-DEMOTE: subi32
# OBJ-DEMOTE: bnez

...
---
# Coissued SET+ADD: demote erases SET member only; ADD + soft edge remain.
name:            demote_coissue
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r0, $r2, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0, implicit-def dead $sfr
    BUNDLE 0, implicit-def $r2, implicit-def dead $sfr, implicit $r0, implicit $r1 {
      SET_HWLOOP_W 0, %bb.2, %bb.2, 8, implicit-def dead $sfr
      $r2 = ADD32 $r0, $r1, implicit-def dead $sfr
    }
    NOP
    NOP
    NOP

  ; Format E 12 B parcels: 22×NOP spacer + 3 following ≈ 300 B > uimm6 252
  ; (legacy 16 B fixtures used 16×NOP; re-sized so hard Off1 still demotes).
  bb.1.spacer:
    liveins: $r1, $r0, $r2, $r15
    successors: %bb.2
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP

  bb.2.body:
    liveins: $r1, $r0, $r2
    successors: %bb.3
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.3.exit:
    liveins: $r15
    RET implicit killed $r15

# COISSUE-LABEL: name: demote_coissue
# SET member erased; coissued ADD survives (never whole-root drop).
# COISSUE-NOT: SET_HWLOOP
# COISSUE: ADD32
# COISSUE: SUBI32
# COISSUE: BNEZ_E2
# COISSUE-NOT: LoopDec
# COISSUE-NOT: LoopJNZ
# COISSUE: bb.3.exit

# OBJ-COISSUE-LABEL: <demote_coissue>:
# Bundle-preserving demote is object-observable: ALU + soft edge.
# OBJ-COISSUE: add32
# OBJ-COISSUE: subi32
# OBJ-COISSUE: bnez

...
---
# Same-preheader oversize shortens; hardware SET retained (not always-demote).
# Placed last so OBJ-KEEP-NOT cannot match demote soft-edge mnemonics.
name:            keep_shorten
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r0, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0, implicit-def dead $sfr
    SET_HWLOOP_W 0, %bb.1, %bb.1, 8, implicit-def dead $sfr
    ; 20 NOPs after SET (320 B) — over uimm6; shorten pulls them before SET
    ; leaving Following >= InterveningCycles (3).
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP

  bb.1.body:
    liveins: $r1, $r0
    successors: %bb.2
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.2.exit:
    liveins: $r15
    RET implicit killed $r15

# KEEP-LABEL: name: keep_shorten
# KEEP: SET_HWLOOP_E2
# KEEP-NOT: LoopDec
# KEEP-NOT: LoopJNZ
# KEEP-NOT: SUBI32
# KEEP-NOT: BNEZ_W
# KEEP: bb.1.body

# OBJ-KEEP-LABEL: <keep_shorten>:
# Hardware form survives to object (discriminator vs demote cases).
# OBJ-KEEP: set_hwloop
# OBJ-KEEP-NOT: subi32
# OBJ-KEEP-NOT: bnez
