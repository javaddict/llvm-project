# RUN: split-file %s %t
# Fatal seats abort; use not --crash so the diagnostic still reaches FileCheck.
# RUN: not --crash llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   %t/missing-formatid.mir -o - 2>&1 \
# RUN:   | FileCheck %s --check-prefix=NO-IMM
# RUN: not --crash llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   %t/unknown-formatid.mir -o - 2>&1 \
# RUN:   | FileCheck %s --check-prefix=BAD-ID
# RUN: not --crash llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   %t/e2-three-members.mir -o - 2>&1 \
# RUN:   | FileCheck %s --check-prefix=E2-OVER
# RUN: not --crash llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   %t/wrong-completion.mir -o - 2>&1 \
# RUN:   | FileCheck %s --check-prefix=BAD-COMP
# RUN: not --crash llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   %t/over-issue.mir -o - 2>&1 \
# RUN:   | FileCheck %s --check-prefix=OVER-ISSUE
# RUN: not --crash llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   %t/e2-private-e3-member.mir -o - 2>&1 \
# RUN:   | FileCheck %s --check-prefix=E2-PRIV-E3
# P7 INDEPENDENCE SEAT: hand-stamped E2 row over two ALU32 logicals. Each is
# e0-only under E2 in the generated member table, so the independent inverse
# must reject. The OLD verifier accepted this exact shape by consulting the
# forward canAdd oracle (residual FieldSlots S0|S1 covered it) — a
# forward-solver defect validating itself. If this seat passes again,
# P7 independence was lost. Companion unit test: E2TwoAlu32FailClosedIndependence.
# RUN: not --crash llc -mtriple=haydn-unknown-elf -run-pass=haydn-verify-bundles \
# RUN:   %t/e2-two-alu-no-member.mir -o - 2>&1 \
# RUN:   | FileCheck %s --check-prefix=P7-NO-MEMBER
# MC encode refuse uses report_fatal_error(/*GenCrashDiag=*/false) → exit 1,
# not abort; plain `not` (no --crash) still surfaces the diagnostic for FileCheck.
# RUN: not llc -mtriple=haydn-unknown-elf -x mir \
# RUN:   -start-after=livedebugvalues -filetype=obj \
# RUN:   %t/private-wrong-entry-encode.mir -o /dev/null 2>&1 \
# RUN:   | FileCheck %s --check-prefix=PRIV-REPLACE
# Residual cycle-forming LOADI32 seat is already load-bearing in
# vf5-residual-cycle-pseudo-ban.mir (not --crash path under finalize+verify).

# Role: verifier — inverse corruption matrix scaffolding for committed BUNDLE
# roots. Each injected defect must fail closed at haydn-verify-bundles without
# planner repair.
#
# Seat inventory: Inputs/CORRUPTION-MATRIX.txt
# Companion MC entry-count reject: MC/Haydn/bundle-canadd-reject.s
# Residual phase: vf5-residual-cycle-pseudo-ban.mir / residual-crossbank-*.mir
# Independent inverse positive accepts: e96-bundle-inverse-verify.mir

# NO-IMM: BUNDLE root missing or unknown BundleFormatRowID imm
# BAD-ID: BUNDLE root missing or unknown BundleFormatRowID imm
# E2-OVER: BUNDLE membership exceeds stamped row entry count (E2 holds 2
# BAD-COMP: BUNDLE root CompletionStateID does not match row and member count
# OVER-ISSUE: memberCount > ISSUE_SLOT_COUNT (3)
# E2-PRIV-E3: structural inverse: E3 member under E96TwoEntry row
# P7-NO-MEMBER: structural inverse: committed logical has no generated member
# PRIV-REPLACE: committed Format E private member cannot enter standalone DFS
# (duplicate EntryIdx scatter miss — typed members never DFS)

#--- missing-formatid.mir
--- |
  define void @corrupt_missing_formatid() { ret void }
...
---
name:            corrupt_missing_formatid
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r15
    BUNDLE {
      $r2 = ADDI32 $r0, 10, implicit-def dead $sfr
    }
    BUNDLE 0 {
      $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    }
...
#--- unknown-formatid.mir
--- |
  define void @corrupt_unknown_formatid() { ret void }
...
---
name:            corrupt_unknown_formatid
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r15
    BUNDLE 99 {
      $r2 = ADDI32 $r0, 10, implicit-def dead $sfr
    }
    BUNDLE 0 {
      $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    }
...
#--- e2-three-members.mir
--- |
  define void @corrupt_e2_three_members() { ret void }
...
---
name:            corrupt_e2_three_members
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r4, $r5, $r15
    BUNDLE 0, 0, implicit-def $r6, implicit-def $r7, implicit-def $r8, implicit-def dead $sfr, implicit $r0, implicit $r1, implicit $r2, implicit $r3, implicit $r4, implicit $r5 {
      $r6 = ADD32_E3_E0_ALU2_RR $r0, $r1, implicit-def dead $sfr
      $r7 = XOR32_E3_E1_ALU1_RR $r2, $r3, implicit-def dead $sfr
      $r8 = OR32_E3_E2_ALU0_RR $r4, $r5, implicit-def dead $sfr
    }
    BUNDLE 0 {
      $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    }
...
#--- wrong-completion.mir
--- |
  define void @corrupt_wrong_completion() { ret void }
...
---
name:            corrupt_wrong_completion
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r15
    ; Two ALU32s are E3-only in golden (both e0-only under E2), so the
    ; committed shape is the E3 restamp Finalize produces; the corrupted
    ; completion (2 = StubE2Singleton) is then the FIRST violated invariant.
    BUNDLE 1, 2, implicit-def $r4, implicit-def $r5, implicit-def dead $sfr, implicit $r0, implicit $r1, implicit $r2, implicit $r3 {
      $r4 = ADD32_E3_E0_ALU2_RR $r0, $r1, implicit-def dead $sfr
      $r5 = XOR32_E3_E1_ALU1_RR $r2, $r3, implicit-def dead $sfr
    }
    BUNDLE 0 {
      $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    }
...
#--- over-issue.mir
--- |
  define void @corrupt_over_issue() { ret void }
...
---
name:            corrupt_over_issue
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r15
    BUNDLE 1, 0, implicit-def $r8, implicit-def $r9, implicit-def $r10, implicit-def $r11, implicit-def dead $sfr, implicit $r0, implicit $r1, implicit $r2, implicit $r3, implicit $r4, implicit $r5, implicit $r6, implicit $r7 {
      $r8 = ADD32_E3_E0_ALU2_RR $r0, $r1, implicit-def dead $sfr
      $r9 = XOR32_E3_E1_ALU1_RR $r2, $r3, implicit-def dead $sfr
      $r10 = OR32_E3_E2_ALU0_RR $r4, $r5, implicit-def dead $sfr
      $r11 = AND32_E3_E1_ALU1_RR $r6, $r7, implicit-def dead $sfr
    }
    BUNDLE 0 {
      $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    }
...

#--- e2-private-e3-member.mir
--- |
  define void @corrupt_e2_private_e3_member() { ret void }
...
---
name:            corrupt_e2_private_e3_member
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r1, $r15
    ; Private E3 entry-0 member under stamped E2 row must fail closed.
    BUNDLE 0, 0, implicit-def $r2, implicit-def dead $sfr, implicit $r0, implicit $r1 {
      $r2 = ADD32_E3_E0_ALU0_RR $r0, $r1, implicit-def dead $sfr
    }
    BUNDLE 0 {
      $r0 = JALR $r15, 0, implicit $r15, implicit $r0, implicit $r15
    }
...

