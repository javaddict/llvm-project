# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop -run-pass=haydn-fixup-hwloops \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=CHECK,PRODUCT
# RUN: llc -haydn-enable-hwloop-demote=true -mtriple=haydn-unknown-elf -mattr=+hwloop -run-pass=haydn-fixup-hwloops \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=CHECK,PRODUCT
# RUN: llc -haydn-enable-hwloop-demote=false -mtriple=haydn-unknown-elf -mattr=+hwloop -run-pass=haydn-fixup-hwloops \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=CHECK,DEBUGOFF
#
# W0.2 / G-RISK-DEMOTE product lock:
# - Product default (demote ON): out-of-range SET demotes to LoopDec+LoopJNZ.
# - demote=true explicit: same as product (not an experimental opt-in).
# - demote=false: debug-only force erase-setup — SET gone, NO soft edge
#   (once-through body risk). NOT a product setting.
#
# demote_uimm6: spacer MBB between preheader and header makes StartOff > 252
# even with only t−3 NOPs after SET. Shorten cannot pull spacer MIs into the
# preheader, so the product path demotes: SET_HWLOOP is erased and the latch
# gets a countable back-edge (loop_dec + loop_jnz).
#
# shorten_uimm6: many NOPs after SET in the *same* preheader — StartOff would
# exceed uimm6, but shorten moves them before SET while keeping ≥3 after SET.
# SET_HWLOOP is retained (both product and debug-off).

--- |
  define dso_local void @demote_uimm6(ptr nocapture writeonly %out) {
  entry:
    br label %spacer
  spacer:
    br label %body
  body:
    store i32 0, ptr %out, align 4
    br label %exit
  exit:
    ret void
  }

  define dso_local void @shorten_uimm6(ptr nocapture writeonly %out) {
  entry:
    br label %body
  body:
    store i32 0, ptr %out, align 4
    br label %exit
  exit:
    ret void
  }

...
---
name:            demote_uimm6
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r0, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0
    ; Immediate trip count 8; header==latch is %bb.2. Three NOPs for t−3.
    SET_HWLOOP_PSEUDO 0, %bb.2, %bb.2, 8
    NOP
    NOP
    NOP

  ; Spacer: 20× NOP = 320 B > uimm6 252 — forces StartOff overflow that
  ; shorten cannot fix (MIs live in a different MBB).
  bb.1.spacer:
    successors: %bb.2
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP

  bb.2.body:
    liveins: $r1, $r0
    successors: %bb.3
    S_SW_WITH_IMM $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.3.exit:
    liveins: $r15
    RET implicit killed $r15

# CHECK-LABEL: name: demote_uimm6
# Product demote-first: soft countable edge (not erase-only once-through).
# PRODUCT-NOT: SET_HWLOOP
# PRODUCT: LoopDec
# PRODUCT: LoopJNZ
# Debug demote OFF: erase-setup only — no soft edge (once-through risk).
# DEBUGOFF-NOT: SET_HWLOOP
# DEBUGOFF-NOT: LoopDec
# DEBUGOFF-NOT: LoopJNZ
# CHECK: bb.3.exit

...
---
name:            shorten_uimm6
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r0, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0
    SET_HWLOOP_PSEUDO 0, %bb.1, %bb.1, 8
    ; 20 NOPs after SET (320 B) — over uimm6; shorten pulls them before SET
    ; leaving ≥3 for t−3.
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP

  bb.1.body:
    liveins: $r1, $r0
    successors: %bb.2
    S_SW_WITH_IMM $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.2.exit:
    liveins: $r15
    RET implicit killed $r15

# CHECK-LABEL: name: shorten_uimm6
# CHECK: SET_HWLOOP
# CHECK-NOT: LoopDec
# CHECK: bb.1.body
