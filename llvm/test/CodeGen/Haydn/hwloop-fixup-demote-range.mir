# RUN: llc -mtriple=haydn-unknown-elf -mattr=+hwloop -run-pass=haydn-fixup-hwloops \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=CHECK,PRODUCT
# RUN: llc -haydn-enable-hwloop-demote=true -mtriple=haydn-unknown-elf -mattr=+hwloop -run-pass=haydn-fixup-hwloops \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=CHECK,PRODUCT
# RUN: llc -haydn-enable-hwloop-demote=false -mtriple=haydn-unknown-elf -mattr=+hwloop -run-pass=haydn-fixup-hwloops \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=CHECK,DEBUGOFF

# Role: MIR — Product demote lock: - Product default (demote ON): out-of-range SET demotes to SUBI32+BNEZ_W.

# Product demote lock:
# - Product default (demote ON): out-of-range SET demotes to SUBI32+BNEZ_W.
# - Soft edge is exact-committed (BUNDLE + member setDesc via
#   commitLateProductCycle) before second BR — no residual bare MI.
# - demote=true explicit: same as product (not an experimental opt-in).
# - demote=false: debug-only force erase-setup — SET gone, NO soft edge
#   (once-through body risk). NOT a product setting.
#
# demote_uimm6: spacer MBB between preheader and header makes StartOff > 252
# even with only InterveningCycles (=3) NOPs after SET. Shorten cannot pull
# spacer MIs into the preheader, so the product path demotes: SET_HWLOOP_W is
# erased and the latch gets a countable back-edge (subi32 + bnez_w).
#
# shorten_uimm6: many NOPs after SET in the *same* preheader — StartOff would
# exceed uimm6, but shorten moves them before SET while keeping Following >=
# InterveningCycles (3; SetupIssueDistance=4). SET_HWLOOP_W is retained
# (both product and debug-off).

--- |
  define dso_local void @demote_uimm6(ptr nocapture writeonly %out) {
  entry:
    br label %spacer
  spacer:
    br label %body
  body:
    store i32 0, ptr %out, align 4
    br label %exit
  exit:
    ret void
  }

  define dso_local void @shorten_uimm6(ptr nocapture writeonly %out) {
  entry:
    br label %body
  body:
    store i32 0, ptr %out, align 4
    br label %exit
  exit:
    ret void
  }

...
---
name:            demote_uimm6
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r0, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0
    ; Immediate trip count 8; header==latch is %bb.2. Three NOPs =
    ; InterveningCycles (VF0 SetupIssueDistance=4).
    SET_HWLOOP_W 0, %bb.2, %bb.2, 8, implicit-def dead $sfr
    NOP
    NOP
    NOP

  ; Spacer: 20× NOP = 320 B > uimm6 252 — forces StartOff overflow that
  ; shorten cannot fix (MIs live in a different MBB).
  bb.1.spacer:
    successors: %bb.2
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP

  bb.2.body:
    liveins: $r1, $r0
    successors: %bb.3
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.3.exit:
    liveins: $r15
    RET implicit killed $r15

# CHECK-LABEL: name: demote_uimm6
# Product demote-first: final-real soft countable edge (not erase-only).
# PRODUCT-NOT: SET_HWLOOP_W
# PRODUCT-NOT: LoopDec
# PRODUCT-NOT: LoopJNZ
# Each soft-edge MI is an exact-committed ProductFormatID singleton.
# PRODUCT: BUNDLE 0
# PRODUCT: SUBI32
# PRODUCT: BUNDLE 0
# PRODUCT: BNEZ_W
# Debug demote OFF: erase-setup only — no soft edge (once-through risk).
# DEBUGOFF-NOT: SET_HWLOOP_W
# DEBUGOFF-NOT: LoopDec
# DEBUGOFF-NOT: LoopJNZ
# DEBUGOFF-NOT: SUBI32
# DEBUGOFF-NOT: BNEZ_W
# CHECK: bb.3.exit

...
---
name:            shorten_uimm6
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0.entry:
    liveins: $r1, $r0, $r15
    successors: %bb.1

    $r0 = frame-setup XOR32 $r0, $r0
    SET_HWLOOP_W 0, %bb.1, %bb.1, 8, implicit-def dead $sfr
    ; 20 NOPs after SET (320 B) — over uimm6; shorten pulls them before SET
    ; leaving ≥3 for t−3.
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP

  bb.1.body:
    liveins: $r1, $r0
    successors: %bb.2
    ST32 $r0, $r1, 0
    NOP
    NOP
    NOP

  bb.2.exit:
    liveins: $r15
    RET implicit killed $r15

# CHECK-LABEL: name: shorten_uimm6
# Residual generic SET_HWLOOP_W is rewritten to final wide form when kept.
# CHECK: SET_HWLOOP_W
# CHECK-NOT: LoopDec
# CHECK-NOT: LoopJNZ
# CHECK-NOT: SUBI32
# CHECK: bb.1.body
