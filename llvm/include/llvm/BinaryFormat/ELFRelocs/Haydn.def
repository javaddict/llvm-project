#ifndef ELF_RELOC
#error "ELF_RELOC must be defined"
#endif

// Haydn ELF relocations for 3-issue VLIW DSP
// 32-bit baremetal architecture with variable-width bundles

// Basic relocations
ELF_RELOC(R_HAYDN_NONE,          0)
ELF_RELOC(R_HAYDN_32,            1)
ELF_RELOC(R_HAYDN_SImm16,        2)
ELF_RELOC(R_HAYDN_BranchSImm16,  3)
ELF_RELOC(R_HAYDN_CallSImm20,    4)
ELF_RELOC(R_HAYDN_HI20,          5)
ELF_RELOC(R_HAYDN_LO16,          6)
ELF_RELOC(R_HAYDN_32_PCREL,      7)
ELF_RELOC(R_HAYDN_GOT_HI20,      8)
ELF_RELOC(R_HAYDN_TPREL_HI20,    9)
ELF_RELOC(R_HAYDN_TPREL_LO16,   10)
// Narrow absolute DATA relocations (FK_Data_1 / FK_Data_2). Live in data
// sections as plain 1/2-byte values -- distinct from R_HAYDN_SImm16, which is
// a 16-bit field inside a 32-bit instruction word. Reusing SImm16 for .byte/.short
// made LLD's 4-byte read/mask/write clobber the following bytes. See D176/L144.
ELF_RELOC(R_HAYDN_8,             11)
ELF_RELOC(R_HAYDN_16,            12)
// Wide-imm (48-bit) addressing relocations for the LUI(imm12) + ADDI32_W(imm20)
// 2-instruction materialization pair (encoding_manual.md section 5 Class 000,
// D254/D255). These supersede the stale R_HAYDN_HI20/LO16 pair, which assumed a
// 16-bit LUI field; Haydn LUI is uimm12 (bits[31:20]) post-ISA-43.
//   R_HAYDN_HI12     -- LUI imm12 field:           (S + A + 0x80000) >> 20
//   R_HAYDN_LO20     -- ADDI32_W imm20 (absolute): (S + A) & 0xFFFFF
//   R_HAYDN_PC_LO20  -- ADDI32_W imm20 (PC-rel):   (S + A - P) & 0xFFFFF
ELF_RELOC(R_HAYDN_HI12,          13)
ELF_RELOC(R_HAYDN_LO20,          14)
ELF_RELOC(R_HAYDN_PC_LO20,       15)
// WIDE SET_HWLOOP / SET_HWLOOP_F2 (encoding_manual.md §5.11/§5.12) offset
// fields. Two independent offset fields share a single 48-bit parcel:
//   R_HAYDN_HWLoopOff1 -- uimm6_offset1  at bits[31:26], value = (S+A-P) >> 2
//   R_HAYDN_HWLoopOff2 -- uimm12_offset2 at bits[25:14], value = (S+A-P) >> 2
// Both 4-byte-unit PC-relative. BUG-2: the prior single R_HAYDN_BranchSImm16
// mapping clobbered whichever fixup ran second because both wrote to bits[15:0].
ELF_RELOC(R_HAYDN_HWLoopOff1,     16)
ELF_RELOC(R_HAYDN_HWLoopOff2,     17)
// WIDE branch/call fields under product Format E parcels (encoding_manual.md
// §5.5, ÷2 per §5.14 D1). Geometry is Format E entry windows (12-byte parcels);
// FE8 retired Bundle128 / 16-byte product packing:
//   R_HAYDN_WIDE_BranchSImm12    -- I12  one-reg (BEQZ_W/…): imm12 @ bits[15:4]
//   R_HAYDN_WIDE_CallSImm20      -- I20  call (JAL family): imm20 @ bits[23:4]
//   R_HAYDN_WIDE_BranchSImm12_RI -- RI12 two-reg (BEQ_W/BNE_W/…): imm12 @
//                                  bits[19:8] (CB-94; was MC-only → llvm-mc
//                                  crash on unresolved external_target)
// PC-relative, halfword-scaled (ValueShift=1) unless noted otherwise.
ELF_RELOC(R_HAYDN_WIDE_BranchSImm12,    18)
ELF_RELOC(R_HAYDN_WIDE_CallSImm20,      19)
ELF_RELOC(R_HAYDN_WIDE_BranchSImm12_RI, 20)
// Format E LOADSTORE0/LOAD1 RI6: signed imm6 @ parcel bits[33:28] (FieldLsb=28).
// Distinct from R_HAYDN_LO20 (ALU RI20 / retired WIDE LSOff20 geometry @
// bits[31:50]). Must not alias R_HAYDN_SImm16 (16-bit field at bit 0).
ELF_RELOC(R_HAYDN_LS_IMM,               21)
// Format E JALR RI12 symbolic imm12 @ the same window as the RI12 branch
// row (parcel bits[43:32] E2 e0; E3 via resolveFieldLsb). Distinct identity
// so a JALR fixup never borrows R_HAYDN_WIDE_BranchSImm12_RI (W27 / M23).
// ValueShift=0, Align=2; execution stays golden PC = rs + imm12.
ELF_RELOC(R_HAYDN_JALRSImm12,           22)
// Format E CSR I8 uimm8 (CSRW/CSRR). Absolute unsigned 8-bit CSR address
// at the golden I8 window (E2 e0 @ parcel bits[39:32]; E3 via
// HaydnRelocLayout::resolveFieldLsb). Distinct from R_HAYDN_8 (data-section
// 1-byte write). ValueShift=0, Align=1, not PC-relative.
ELF_RELOC(R_HAYDN_CSR_UImm8,            23)
// Entry-qualified relocations (typed (kind, entry, window) mapping — the
// runtime-topic exit row). A Format E parcel can legally carry more than
// one symbolic immediate field (e.g. ADDI32 RI20 at E2 e0 ALU0 and E2 e1
// ALU1 in the same 12-byte parcel). The base kinds above resolve their
// write window by sniffing parcel content (resolveFieldLsb), which is
// ambiguous once two same-kind fields coexist: one member's imm gets
// patched twice, the other never (t_global g=g*3 linked the store base
// as 0; G004 keep-off evidence). These kinds carry the entry identity in
// the TYPE, so r_offset stays the parcel origin (exact code record) and
// the patch window is table-derived, never sniffed:
//   R_HAYDN_LO20_E1 / PC_LO20_E1 — ADDI32 RI20 at E2 e1 ALU1, imm @65.
//     (RI20 is E2-only in golden; LUI never shares a cycle — solo law —
//     so HI12 stays base/e0.)
//   R_HAYDN_WIDE_CallSImm20_E3E1 — JAL I20 at E3 e1, imm @48.
//   R_HAYDN_WIDE_BranchSImm12_E3{E0,E1,E2} — I12 cond at E3, imm @23/54/81.
//   R_HAYDN_WIDE_BranchSImm12_RI_E3{E0,E1} — RI12 cond at E3, imm @23/54.
//   R_HAYDN_JALRSImm12_E3{E0,E1} — JALR RI12 at E3, imm @23/54.
// Value transforms/scales are IDENTICAL to the base kind; only the write
// window differs. MC emits them from encodeSlotSubInst when the symbolic
// member's committed entry is not the base kind's default window; the
// base kinds remain valid for their default entry.
ELF_RELOC(R_HAYDN_LO20_E1,                    24)
ELF_RELOC(R_HAYDN_PC_LO20_E1,                 25)
ELF_RELOC(R_HAYDN_WIDE_CallSImm20_E3E1,       26)
ELF_RELOC(R_HAYDN_WIDE_BranchSImm12_E3E0,     27)
ELF_RELOC(R_HAYDN_WIDE_BranchSImm12_E3E1,     28)
ELF_RELOC(R_HAYDN_WIDE_BranchSImm12_E3E2,     29)
ELF_RELOC(R_HAYDN_WIDE_BranchSImm12_RI_E3E0,  30)
ELF_RELOC(R_HAYDN_WIDE_BranchSImm12_RI_E3E1,  31)
ELF_RELOC(R_HAYDN_JALRSImm12_E3E0,            32)
ELF_RELOC(R_HAYDN_JALRSImm12_E3E1,            33)
